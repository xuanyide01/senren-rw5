.loading{position:absolute;top:234px;left:128px;width:176px;height:46px;text-align:center;font-size:23px;color:#97483d;background-color:#d2e8f5;border-radius:12px;}
.choice-panel{top:0px;height:514px;background-color:#fff8f0;padding:18px;}
.choice-list{width:396px;height:416px;flex-direction:column;}

text{font-family:senrenfont;}
.title-action{height:26px;font-size:18px;}
.chapter{width:170px;height:30px;text-align:right;}
.speaker{width:210px;height:30px;}
.dialogue{width:396px;}

.title-art{height:243px;background-color:#ffffff;}.title-background{width:432px;height:243px;object-fit:contain;}
.title-panel-background{position:absolute;top:243px;left:0px;width:432px;height:271px;}
.title-panel{top:278px;left:0px;height:236px;width:432px;padding:6px 32px;background-color:transparent;align-items:flex-start;}
.title-button{height:44px;width:190px;justify-content:flex-start;align-items:center;}.title-menu-image{width:190px;height:38px;object-fit:contain;}
.portrait-group{position:absolute;left:0px;top:0px;width:432px;height:286px;}
.face-viewport{position:absolute;overflow:hidden;}.face-sheet{position:absolute;}
.dialogue-lines{width:396px;flex-direction:column;}.dialogue-line{width:396px;flex-shrink:0;color:#563931;}
.speaker-row{height:30px;flex-shrink:0;}.speaker{width:190px;}.chapter{width:190px;text-align:right;}
.directory-list{height:368px;width:396px;flex-direction:column;}.directory-card{height:84px;width:396px;margin-bottom:8px;background-color:#f2dfd3;border-radius:12px;padding:12px;font-size:23px;color:#97483d;}
.opening-screen{position:absolute;left:0px;top:0px;width:432px;height:514px;background-color:#000000;}
.opening-viewport{position:absolute;left:24px;top:149px;width:384px;height:216px;overflow:hidden;}
.opening-sheet{position:absolute;top:0px;left:0px;width:384px;height:216px;object-fit:contain;}


/* Rounded-screen safe area: 32px sides, 26px top, 24px bottom. */
.title-panel{top:268px;height:246px;}
.dialogue-panel{padding:12px 32px 24px;}
.speaker-row{width:368px;}.speaker{width:212px;}.chapter{width:144px;}
.dialogue-scroll{width:368px;height:120px;flex-shrink:0;}
.dialogue-lines,.dialogue-line{width:368px;}
.toolbar{width:368px;height:42px;flex-shrink:0;}.tool{padding:6px 8px;}
.overlay{padding:26px 32px 24px;}.reading-action{height:38px;}
.full-panel{padding:26px 32px 24px;}
.slot-list,.directory-list{width:368px;height:352px;flex-shrink:0;}
.slot-card{width:368px;height:82px;margin-bottom:6px;padding:6px 12px;flex-shrink:0;}
.directory-card{width:368px;height:82px;margin-bottom:6px;flex-shrink:0;}
.pager{width:368px;height:44px;flex-shrink:0;}
