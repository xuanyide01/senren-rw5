<template>
  <div class="page" onswipe="swipe">
    <div if="{{mode === 'title'}}" class="title-art">
      <image class="title-background" src="/common/title_bg.png" onerror="backgroundError"></image>
      
    </div>
    <div if="{{mode === 'play'}}" class="art" onclick="advance">
      <image class="background" src="{{backgroundSrc}}" onerror="backgroundError" oncomplete="backgroundLoaded"></image>
      <div for="{{portraits}}" tid="id" class="portrait-group"><image class="body" src="{{$item.src}}" style="width:{{$item.width}}px;height:{{$item.height}}px;left:{{$item.left}}px;top:{{$item.top}}px;opacity:{{$item.opacity}};"></image><div if="{{$item.patch}}" class="face-viewport" style="width:{{$item.patchWidth}}px;height:{{$item.patchHeight}}px;left:{{$item.patchLeft}}px;top:{{$item.patchTop}}px;"><image class="face-sheet" src="{{$item.patch}}" style="width:{{$item.patchAtlasWidth}}px;height:{{$item.patchAtlasHeight}}px;left:{{$item.patchImageLeft}}px;top:{{$item.patchImageTop}}px;opacity:{{$item.opacity}};"></image></div></div>
    </div>
    <image if="{{mode === 'title'}}" class="title-panel-background" src="/common/title_panel.png"></image>
    <div if="{{mode === 'title'}}" class="title-panel">
      <div class="title-button" onclick="startNew"><image class="title-menu-image" src="/common/ui/start.png"></image></div>
      <div class="title-button" onclick="continueGame"><image class="title-menu-image" src="/common/ui/load.png"></image></div>
      <div class="title-button" onclick="openDirectory"><image class="title-menu-image" src="/common/ui/flowchart.png"></image></div>
      <div class="title-button" onclick="openExtra"><image class="title-menu-image" src="/common/ui/extra.png"></image></div>
      <div class="title-button" onclick="openConfig"><image class="title-menu-image" src="/common/ui/system.png"></image></div>
    </div>
    <image if="{{mode === 'title'}}" class="title-divider" src="/common/title_divider.png"></image>
    <image if="{{mode === 'title'}}" class="title-logo" src="/common/title_logo.png"></image>
    <image if="{{mode === 'play'}}" class="dialogue-backdrop" src="/common/dialogue_bg.jpg"></image>
    <div if="{{mode === 'play'}}" class="dialogue-panel">
      <div class="speaker-row"><text class="speaker" style="font-family: {{speakerFont}};">{{speaker}}</text><text class="chapter" style="font-family: {{chapterFont}};">{{chapterLabel}}</text></div>
      <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" ontouchstart="dialogueTouchStart" ontouchmove="dialogueTouchMove" ontouchend="dialogueTouchEnd" onscroll="dialogueScrolled" onclick="dialogueTap"><div class="dialogue-lines" style="height:{{dialogueHeight}}px;"><text for="{{dialogueLines}}" tid="id" class="dialogue-line" style="font-size:{{fontSize}}px;font-family:{{$item.font}};height:{{fontSize===28?38:34}}px;">{{$item.text}}</text></div></scroll>
      <div class="toolbar"><text class="tool" onclick="goBack">上一句</text><text class="tool" onclick="showMenu">菜单</text><text class="tool" onclick="advance">下一句 ›</text></div>
    </div>
    <div if="{{mode === 'choice'}}" class="choice-panel">
      <text class="choice-title">选择下一步</text>
      <scroll class="choice-list" scroll-y="true"><text for="{{options}}" tid="text" class="choice" style="font-family: {{$item.font}};color: {{$item.disabled ? '#8eaac0' : '#97483d'}};" onclick="pick($idx)">{{$item.text}}</text></scroll>
      <text class="small-action" onclick="showMenu">菜单</text>
    </div>
    <div if="{{mode === 'menu'}}" class="overlay">
      <text class="menu-title">阅读菜单</text>
      <text class="menu-action reading-action" onclick="saveGame">保存进度</text>
      <text class="menu-action reading-action" onclick="loadGame">读取进度</text>
      <text class="menu-action reading-action" style="color: {{hasNextChapter ? '#97483d' : '#8eaac0'}};" onclick="goNextChapter">下一章 ›</text>
      <text class="menu-action reading-action" onclick="toggleAuto">{{autoLabel}}</text>
      <text class="menu-action reading-action" onclick="cycleAutoSpeed">{{autoSpeedLabel}}</text>
      <text class="menu-action reading-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action reading-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="menu-action reading-action" onclick="resume">返回游戏</text>
      <text class="menu-action reading-action muted" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'slots'}}" class="full-panel">
      <text class="panel-title">{{slotTitle}}</text>
      <text class="panel-subtitle">{{slotPageLabel}}</text>
      <div class="slot-list">
        <div for="{{slotRows}}" tid="number" class="slot-card" style="background-color: {{$item.occupied ? '#f2dfd3' : '#f7eade'}};" onclick="selectSlot($item.index)">
          <text class="slot-title">{{$item.title}}</text><text class="slot-meta" style="font-family: {{$item.metaFont}};">{{$item.meta}}</text><text class="slot-preview" style="font-family: {{$item.previewFont}};">{{$item.preview}}</text>
        </div>
      </div>
      <div class="pager"><text class="pager-action" onclick="previousSlotPage">‹ 上一页</text><text class="pager-action" onclick="closeSlots">返回</text><text class="pager-action" onclick="nextSlotPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'overwrite'}}" class="overlay">
      <text class="menu-title">{{overwriteTitle}}</text>
      <text class="confirm-text" style="font-family: {{overwriteFont}};">{{overwriteDetail}}</text>
      <text class="menu-action" onclick="confirmOverwrite">确认覆盖</text><text class="menu-action muted" onclick="cancelOverwrite">取消</text>
    </div>
    <div if="{{mode === 'gallery'}}" class="full-panel">
      <text class="panel-title">CG 鉴赏</text><text class="panel-subtitle">{{galleryPageLabel}}</text>
      <div class="gallery-row"><div for="{{galleryTop}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption" style="font-family: {{$item.font}};">{{$item.label}}</text></div></div>
      <div class="gallery-row"><div for="{{galleryBottom}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption" style="font-family: {{$item.font}};">{{$item.label}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="toTitle">返回标题</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'cg'}}" class="cg-panel">
      <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text class="cg-caption" style="font-family: {{cgFont}};">{{cgLabel}}</text>
      <div class="cg-controls"><text class="pager-action" onclick="previousCg">‹ 上一组</text><text class="pager-action" onclick="backToGallery">返回列表</text><text class="pager-action" onclick="nextCg">下一组 ›</text></div>
    </div>
    <div if="{{mode === 'end'}}" class="end-panel"><text class="game-title">{{endingLabel}}</text><text class="subtitle">可返回标题重新开始游戏</text><text class="action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode === 'error'}}" class="overlay"><text class="menu-title">暂时无法继续</text><text class="error-text">{{errorText}}</text><text class="action" onclick="toTitle">返回标题</text></div>

    <div if="{{mode==='config'}}" class="overlay"><text class="menu-title">系统设置</text><text class="menu-action" onclick="toggleSound">{{soundLabel}}</text><text class="menu-action" onclick="toggleFont">{{fontLabel}}</text><text class="menu-action" onclick="toggleSpeed">{{speedLabel}}</text><text class="menu-action" onclick="cycleAutoSpeed">{{autoSpeedLabel}}</text><text class="menu-action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode==='extra'}}" class="overlay"><text class="menu-title">特别鉴赏</text><text class="menu-action" onclick="openGallery">CG 鉴赏</text><text class="menu-action" onclick="playExtraOpening">OP MOVIE</text><text class="menu-action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode==='directory'}}" class="full-panel"><text class="panel-title">{{directoryTitle}}</text><text class="panel-subtitle">{{directoryPageLabel}}</text><div class="directory-list"><text for="{{directoryRows}}" tid="id" class="directory-card" style="font-family:{{$item.font}};" onclick="pickDirectory($idx)">{{$item.title}}</text></div><div class="pager"><text class="pager-action" onclick="previousDirectoryPage">‹ 上一页</text><text class="pager-action" onclick="backDirectory">返回</text><text class="pager-action" onclick="nextDirectoryPage">下一页 ›</text></div></div>
    <div if="{{mode==='op'}}" class="opening-screen" onclick="finishOpening"><div class="opening-viewport"><image class="opening-sheet" src="{{openingSrc}}" style="left:{{openingLeft}}px;top:{{openingTop}}px;"></image></div></div>
    <text if="{{loading}}" class="loading">加载中…</text>
  </div>
</template>

<script>
import file from '@system.file';
import storage from '@system.storage';
import prompt from '@system.prompt';
import audio from '@system.audio';
import {makeTitleMusic} from '../../common/title-music.js';
import {makeOpeningClock} from '../../common/opening.js';
import {graph} from '../../common/graph.js';
import {create,checkpoint,restore,locate,advance,choose,skipChapter,previous,trueAvailable,startTrue as enterTrue} from '../../common/engine.js';
import {autoSpeeds,autoWait} from '../../common/auto-reader.js';
const PREFIX='senren_rw5_';
const FONT='senrenfont';
const HEROINE={yoshino:'芳乃',mako:'茉子',murasame:'丛雨',lena:'蕾娜',koharu:'小春',roka:'芦花'};
function displayPreview(value,limit){return String(value||'').replace(/\\n/g,' ').replace(/[\r\n]+/g,' ').slice(0,limit);}
export default {
  private:{soundEnabled:true,soundLabel:'游戏音量：开启',portraits:[],dialogueLines:[],directoryRows:[],directoryTitle:'路线选择',directoryPageLabel:'',openingSrc:'',openingLeft:0,openingTop:0,mode:'title',backgroundSrc:'/common/title_bg.png',bodySrc:'',bodySecond:'',bodyThird:'',portraitWidth:200,portraitHeight:286,portraitTop:0,portraitLeft:116,portraitSecondWidth:200,portraitSecondHeight:286,portraitSecondTop:0,portraitSecondLeft:216,portraitThirdWidth:144,portraitThirdHeight:286,portraitThirdTop:0,portraitThirdLeft:288,portraitOpacity:1,portraitSecondOpacity:1,portraitThirdOpacity:1,
    speaker:'',displayText:'',dialogueHeight:128,chapterLabel:'',speakerFont:FONT,dialogueFont:FONT,chapterFont:FONT,overwriteFont:FONT,cgFont:FONT,options:[],loading:true,errorText:'',hasNextChapter:true,fontSize:24,textSpeed:0,autoEnabled:false,autoSpeed:1,autoLabel:'自动播放：关闭',autoSpeedLabel:'自动速度：标准',speedLabel:'显示速度：即时',fontLabel:'字号：标准',trueUnlocked:false,slotTitle:'',slotPage:0,slotPageLabel:'',slotRows:[],storageBusy:false,overwriteTitle:'',overwriteDetail:'',endingLabel:'阅读完毕',galleryPage:0,galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgIndex:0,cgVariant:0,cgSrc:'',cgLabel:''},
  onInit(){
    this._settingsReady=false;this._music=makeTitleMusic(audio);this._openingActive=false;this._directoryRoute='';this._directoryPage=0;this._opening=makeOpeningClock(setTimeout,clearTimeout,Date.now,(src,left,top)=>{if(this.openingSrc!==src)this.openingSrc=src;if(this.openingLeft!==left)this.openingLeft=left;if(this.openingTop!==top)this.openingTop=top;},()=>this.finishOpening());this.session=create(graph);this.sequence=0;this.slotSequence=0;this.timer=null;this._autoTimer=null;this._autoGeneration=0;this._alive=true;this._touchReading=false;this._dialogueDragged=false;this._dialogueTouch=null;this.fullText='';this.cachedFile='';this.frames=[];this._progress={};this._progressReady=false;this._progressBusy=false;this._progressDirty=false;this._slotData=[];this._gallery=[];this._hidden=false;
    storage.get({key:PREFIX+'settings_v1',default:'',success:data=>{try{const s=JSON.parse(data);this.soundEnabled=s.soundEnabled!==false;this.fontSize=s.fontSize===28?28:24;this.textSpeed=s.textSpeed===30?30:0;this.autoSpeed=s.autoSpeed===0||s.autoSpeed===2?s.autoSpeed:1;this.refreshSettings();}catch(e){}this._settingsReady=true;this.syncMusic();},fail:()=>{this._settingsReady=true;this.syncMusic();},complete:()=>{}});
    storage.get({key:PREFIX+'progress_v1',default:'{}',success:data=>{try{const p=JSON.parse(data||'{}');this._progress=p&&typeof p==='object'?p:{};this._progressReady=true;this.loading=false;this.refreshProgress();this.syncMusic();}catch(e){this.fail('通关记录读取失败');}},fail:()=>{this.fail('通关记录读取失败，请返回标题重试');},complete:()=>{}});
    console.log('SENREN_RW5 title ready');
  },
  onShow(){this._hidden=false;if(this.mode==='op'){this._opening.resume();this.syncMusic();if(this.soundEnabled)this._music.playOpening(this._opening.position());}else this.syncMusic();this.armAuto();},
  onHide(){this._hidden=true;this._opening.pause();this._music.stop();this._touchReading=false;this.clearTyping();if(this.mode==='play')this.displayText=this.fullText;this.updateLines();this.syncMusic();},
  onDestroy(){this._alive=false;this._opening.stop();this._music.destroy();this.stopAuto();this.clearTyping();this.sequence++;this.slotSequence++;console.log('SENREN_RW5 destroyed');},
  exitApplication(){if(this.loading||this.storageBusy)return;this._alive=false;this.stopAuto();this.clearTyping();this.sequence++;this.slotSequence++;console.log('SENREN_RW5 exit requested');this.$app.exit();},
  backgroundLoaded(){},backgroundError(){console.error('SENREN_RW5 image failed',this.backgroundSrc);},
  clearTyping(){this.clearAuto();this._typingGeneration=(this._typingGeneration||0)+1;if(this.timer!==null){clearTimeout(this.timer);this.timer=null;}},
  clearAuto(){if(this._autoTimer!=null)clearTimeout(this._autoTimer);this._autoTimer=null;this._autoGeneration=(this._autoGeneration||0)+1;},
  canAuto(){return this.autoEnabled&&this._alive&&!this._hidden&&!this._touchReading&&!this.loading&&!this.storageBusy&&this.mode==='play'&&this.timer===null&&this.displayText===this.fullText;this.updateLines();this.syncMusic();},
  armAuto(){
    this.clearAuto();if(!this.canAuto())return;
    const generation=this._autoGeneration,node=this.session.node,index=this.session.index;
    this._autoTimer=setTimeout(()=>{if(generation!==this._autoGeneration)return;this._autoTimer=null;if(!this.canAuto()||this.session.node!==node||this.session.index!==index)return;console.log('SENREN_RW5 auto advance',node,index);this.advance();},autoWait(this.autoSpeed,this.fullText.length));
  },
  stopAuto(){this.autoEnabled=false;this.clearAuto();this.refreshSettings();},
  toggleAuto(){if(this.mode!=='menu')return;this.autoEnabled=!this.autoEnabled;this.clearAuto();this.refreshSettings();console.log('SENREN_RW5 auto enabled',this.autoEnabled);},
  cycleAutoSpeed(){this.autoSpeed=(this.autoSpeed+1)%3;this.refreshSettings();this.persistSettings();console.log('SENREN_RW5 auto speed',this.autoSpeed);},
  refreshProgress(){this.trueUnlocked=trueAvailable(graph,{progress:this._progress});},
  syncProgress(){if(this.session.progression==='chapter')return;const p=this.session.progress;if(JSON.stringify(p)!==JSON.stringify(this._progress)){this._progress=JSON.parse(JSON.stringify(p));this._progressDirty=true;this.refreshProgress();this.writeProgress();}},
  writeProgress(){if(this._progressBusy||!this._progressDirty)return;this._progressBusy=true;this._progressDirty=false;storage.set({key:PREFIX+'progress_v1',value:JSON.stringify(this._progress),success:()=>{this._progressBusy=false;this.writeProgress();},fail:()=>{this._progressBusy=false;this._progressDirty=true;this.toast('通关记录保存失败');},complete:()=>{}});},
  startNew(){if(this.loading||!this._progressReady)return;this._music.stop();this.session=create(graph,this._progress);this.session.progression='story';this.cachedFile='';this.renderFrame();},
  startTrue(){if(this.loading)return;const state=create(graph,this._progress);if(!enterTrue(graph,state)){this.toast('完成好结局和坏结局后解锁');return;}state.history=[];state.progression='story';this.session=state;this.cachedFile='';this.renderFrame();},
  renderFrame(){
    this.clearTyping();let location;
    try{location=locate(graph,this.session);this.syncProgress();}catch(e){this.fail(e.message);return;}
    if(location.type==='op'){this.loading=false;this.playOpening(false);return;}
    if(location.type==='choice'){this.loading=false;this.options=location.items.map(x=>Object.assign({},x,{font:FONT}));this.mode='choice';this.syncMusic();console.log('SENREN_RW5 choice',this.session.node,this.session.flag);return;}
    if(location.type==='end'){this.stopAuto();this.loading=false;this.mode='end';this.syncMusic();this.endingLabel=(this.chapterLabel||'故事')+' · 阅读完毕';this.cachedFile='';this.frames=[];console.log('SENREN_RW5 ending',this.session.flag,JSON.stringify(this.session.progress),this.endingLabel);return;}
    this.chapterLabel=location.title;this.hasNextChapter=true;
    if(this.cachedFile===location.file){this.showFrame(this.frames[location.index]);return;}
    this.loading=true;const token=++this.sequence;
    file.readText({uri:'/common/story/'+location.file,success:data=>{if(token!==this.sequence)return;try{const frames=JSON.parse(data.text);if(!Array.isArray(frames)||!frames[location.index])throw Error('剧情数据格式错误');this.frames=frames;this.cachedFile=location.file;this.showFrame(frames[location.index]);}catch(e){this.fail(e.message);}},fail:(data,code)=>{if(token===this.sequence)this.fail('剧情读取失败：'+code);},complete:()=>{}});
  },
  showFrame(frame){
    if(!frame){this.fail('剧情下标无效');return;}this.loading=false;this.mode='play';this.syncMusic();this.backgroundSrc=frame.art.background;
    this.portraits=(frame.art.sprites||[]).map((s,i)=>Object.assign({},s,{id:s.src+(s.patch||'')+s.left+':'+i}));
    this.speaker=frame.speaker;this.fullText=frame.text;this.sizeDialogue();this.session.preview=frame.text.slice(0,80);this.displayText='';this.updateLines();console.log('SENREN_RW5 frame',this.session.node,this.session.index);
    // Recreate the scroll content by scene key in the template; scrollTo also
    // resets firmware versions that retain the previous scroll offset.
    this._touchReading=false;this._dialogueDragged=false;this._dialogueTouch=null;
    try{this.$element('dialogue-scroll').scrollTo({index:0});}catch(e){}
    const speed=this.autoEnabled?30:this.textSpeed;
    if(speed===0||this._hidden){this.displayText=this.fullText;this.updateLines();this.armAuto();return;}
    const generation=this._typingGeneration;const tick=()=>{if(!this._alive||this._hidden||this.mode!=='play'||generation!==this._typingGeneration)return;const step=this.fullText.codePointAt(this.displayText.length)>65535?2:1;this.displayText=this.fullText.slice(0,this.displayText.length+step);this.updateLines();if(this.displayText.length<this.fullText.length)this.timer=setTimeout(tick,speed);else{this.timer=null;this.armAuto();}};tick();
  },
  sizeDialogue(){const columns=this.fontSize===28?13:15;const lines=String(this.fullText||'').split('\n').reduce((count,line)=>count+Math.max(1,Math.ceil(line.length/columns)),0);this.dialogueHeight=Math.max(128,lines*(this.fontSize===28?38:34));},
  advance(){if(this.loading||this.mode!=='play')return;this.clearAuto();if(this.timer!==null){this.clearTyping();this.displayText=this.fullText;this.updateLines();this.armAuto();return;}try{advance(graph,this.session);this.renderFrame();}catch(e){this.fail(e.message);}},
  dialogueTouchStart(event){this._touchReading=true;this.clearAuto();const touch=event.touches&&event.touches[0];this._dialogueDragged=false;this._dialogueTouch=touch?{x:touch.clientX,y:touch.clientY}:null;},
  dialogueTouchMove(event){const touch=event.touches&&event.touches[0],start=this._dialogueTouch;if(touch&&start&&(Math.abs(touch.clientX-start.x)>10||Math.abs(touch.clientY-start.y)>10))this._dialogueDragged=true;},
  dialogueTouchEnd(){this._touchReading=false;this.armAuto();},
  dialogueTap(){if(!this._dialogueDragged)this.advance();},
  dialogueScrolled(){if(this.mode==='play')this.armAuto();this.syncMusic();},
  pick(index){if(this.loading||this.mode!=='choice')return;try{choose(graph,this.session,index);this.renderFrame();}catch(e){this.fail(e.message);}},
  goBack(){if(this.loading||this.mode!=='play')return;this.stopAuto();try{previous(graph,this.session);this.renderFrame();}catch(e){this.fail(e.message);}},
  showMenu(){if(this.loading||!this.session)return;this.clearTyping();this.displayText=this.fullText;this.updateLines();this.resumeMode=this.mode;this.mode='menu';this.syncMusic();console.log('SENREN_RW5 menu');},
  resume(){this.mode=this.resumeMode||'play';this.syncMusic();this.armAuto();},
  goNextChapter(){if(this.loading||this.mode!=='menu')return;try{skipChapter(graph,this.session);this.renderFrame();}catch(e){this.fail(e.message);}},
  swipe(event){if(this.mode==='play'&&event.direction==='left')this.advance();this.syncMusic();},
  continueGame(){this.openSlots('load');},saveGame(){this.openSlots('save');},loadGame(){this.openSlots('load');},
  openSlots(role){if(this.loading||this.storageBusy)return;this.clearTyping();this._slotRole=role;this._slotsReturnMode=this.mode==='menu'?(this.resumeMode||'play'):this.mode;this.syncMusic();this.mode='slots';this.syncMusic();this.slotPage=0;this.slotTitle=role==='save'?'选择保存栏位':'选择读取栏位';this._slotData=[];this.loading=true;const token=++this.slotSequence;
    const read=index=>{if(token!==this.slotSequence)return;if(index>=30){this.loading=false;this.refreshSlots();console.log('SENREN_RW5 slots ready',role);return;}storage.get({key:PREFIX+'slot_v1_'+(index+1),default:'',success:data=>{if(token!==this.slotSequence)return;try{this._slotData[index]=data?JSON.parse(data):null;}catch(e){this._slotData[index]={invalid:true};}read(index+1);},fail:()=>{if(token!==this.slotSequence)return;this._slotData[index]=null;read(index+1);},complete:()=>{}});};read(0);
  },
  refreshSlots(){this.slotPageLabel='30 个栏位 · 第 '+(this.slotPage+1)+' / 8 页';this.slotRows=[];for(let index=this.slotPage*4;index<Math.min(30,this.slotPage*4+4);index++){const saved=this._slotData[index],node=saved&&saved.state&&graph.nodes[saved.state.node];this.slotRows.push({index,number:index+1,title:'存档 '+('0'+(index+1)).slice(-2),occupied:!!saved,metaFont:FONT,previewFont:FONT,meta:!saved?'空栏位':node?node.title:'存档无法读取',preview:saved&&saved.state?displayPreview(saved.state.preview||'章节开头',18):''});}},
  previousSlotPage(){if(!this.loading&&this.slotPage>0){this.slotPage--;this.refreshSlots();}},nextSlotPage(){if(!this.loading&&this.slotPage<7){this.slotPage++;this.refreshSlots();}},
  closeSlots(){if(this.storageBusy)return;this.slotSequence++;this.loading=false;this.mode=this._slotsReturnMode;this.syncMusic();this.armAuto();},
  selectSlot(index){if(this.loading||this.storageBusy)return;const saved=this._slotData[index];if(this._slotRole==='load'){if(!saved){this.toast('此栏位尚未保存');return;}try{this.session=restore(graph,saved.state);if(this.session.progression!=='chapter')this.session.progress=Object.assign({},this.session.progress,this._progress);this.cachedFile='';this.slotSequence++;console.log('SENREN_RW5 slot loaded',index+1,this.session.node,this.session.index);this.renderFrame();}catch(e){this.toast('此存档无法读取');}return;}this._pendingSlot=index;this._pendingSave={version:1,state:checkpoint(this.session),savedAt:Date.now()};if(saved){this.overwriteTitle='覆盖存档 '+('0'+(index+1)).slice(-2)+'？';this.overwriteDetail=displayPreview(saved.state&&saved.state.preview||'已有进度',45);this.mode='overwrite';this.syncMusic();console.log('SENREN_RW5 overwrite',index+1);return;}this.commitSlot();},
  confirmOverwrite(){this.commitSlot();},cancelOverwrite(){if(!this.storageBusy)this.mode='slots';this.syncMusic();},
  commitSlot(){if(this.storageBusy)return;this.storageBusy=true;this.loading=true;const index=this._pendingSlot;storage.set({key:PREFIX+'slot_v1_'+(index+1),value:JSON.stringify(this._pendingSave),success:()=>{this._slotData[index]=this._pendingSave;this.storageBusy=false;this.loading=false;this.mode=this._slotsReturnMode;this.syncMusic();this.toast('已保存到存档 '+('0'+(index+1)).slice(-2));console.log('SENREN_RW5 slot saved',index+1,this.session.node,this.session.index);this.armAuto();},fail:()=>{this.storageBusy=false;this.loading=false;this.toast('保存失败，请重试');},complete:()=>{}});},
  openGallery(){if(this.loading)return;this.mode='gallery';this.syncMusic();if(this._gallery.length){this.refreshGallery();return;}this.loading=true;const token=++this.sequence;file.readText({uri:'/common/gallery.txt',success:data=>{if(token!==this.sequence)return;try{this._gallery=JSON.parse(data.text);this.galleryPage=0;this.loading=false;this.refreshGallery();}catch(e){this.fail('CG目录读取失败');}},fail:()=>{if(token===this.sequence)this.fail('CG目录读取失败');},complete:()=>{}});},
  refreshGallery(){const rows=this._gallery.slice(this.galleryPage*4,this.galleryPage*4+4).map((x,i)=>({image:x.variants[0],src:x.variants[0],index:this.galleryPage*4+i,label:x.label+'\n'+x.variants.length+' 张',font:FONT}));this.galleryTop=rows.slice(0,2);this.galleryBottom=rows.slice(2);this.galleryPageLabel=this._gallery.length+' 组 · 第 '+(this.galleryPage+1)+' / '+Math.ceil(this._gallery.length/4)+' 页';},
  previousGalleryPage(){if(this.galleryPage>0){this.galleryPage--;this.refreshGallery();}},nextGalleryPage(){if(this.galleryPage<Math.ceil(this._gallery.length/4)-1){this.galleryPage++;this.refreshGallery();}},
  viewCg(index){if(this.loading)return;this.cgIndex=index;this.cgVariant=0;this.mode='cg';this.syncMusic();this.renderCg();},
  renderCg(){const group=this._gallery[this.cgIndex];this.cgSrc=group.variants[this.cgVariant];this.cgLabel=group.label+' · '+(this.cgVariant+1)+' / '+group.variants.length+' · 点击切换';console.log('SENREN_RW5 cg',this.cgIndex,this.cgVariant);},cycleCg(){const group=this._gallery[this.cgIndex];this.cgVariant=(this.cgVariant+1)%group.variants.length;this.renderCg();},previousCg(){if(this.cgIndex>0)this.viewCg(this.cgIndex-1);},nextCg(){if(this.cgIndex<this._gallery.length-1)this.viewCg(this.cgIndex+1);},backToGallery(){this.galleryPage=Math.floor(this.cgIndex/4);this.mode='gallery';this.syncMusic();this.refreshGallery();},
  refreshSettings(){this.soundLabel='游戏音量：'+(this.soundEnabled?'开启':'关闭');this.speedLabel=this.textSpeed===0?'显示速度：即时':'显示速度：逐字';this.fontLabel=this.fontSize===28?'字号：大':'字号：标准';this.autoLabel='自动播放：'+(this.autoEnabled?'开启':'关闭');this.autoSpeedLabel='自动速度：'+autoSpeeds[this.autoSpeed];},
  persistSettings(){storage.set({key:PREFIX+'settings_v1',value:JSON.stringify({soundEnabled:this.soundEnabled,fontSize:this.fontSize,textSpeed:this.textSpeed,autoSpeed:this.autoSpeed}),success:()=>{},fail:()=>{},complete:()=>{}});},toggleSpeed(){this.textSpeed=this.textSpeed===0?30:0;this.refreshSettings();this.persistSettings();},toggleFont(){this.fontSize=this.fontSize===24?28:24;this.sizeDialogue();this.updateLines();this.refreshSettings();this.persistSettings();},
  toTitle(){if(this.storageBusy)return;this.stopAuto();this.syncProgress();this.writeProgress();this._opening.stop();this._openingActive=false;this.clearTyping();this.sequence++;this.slotSequence++;this.loading=false;this.mode='title';this.syncMusic();this.cachedFile='';this.frames=[];this.backgroundSrc='/common/title_bg.png';this.bodySrc='';this.bodySecond='';this.bodyThird='';console.log('SENREN_RW5 title ready');},

  syncMusic(){if(!this._music)return;const ready=this._alive&&!this._hidden&&this._settingsReady&&this._progressReady;const inTitle=['title','config','extra','gallery','cg','directory'].indexOf(this.mode)>=0||(this.mode==='slots'&&this._slotsReturnMode==='title');this._music.update(ready&&this.soundEnabled&&inTitle);},
  toggleSound(){this.soundEnabled=!this.soundEnabled;if(this.soundEnabled)this._music.retry();this.refreshSettings();this.persistSettings();this.syncMusic();},
  openConfig(){this.mode='config';this.syncMusic();this.refreshSettings();},
  openExtra(){this.mode='extra';this.syncMusic();},
  openDirectory(){this._directoryRoute='';this._directoryPage=0;this.mode='directory';this.syncMusic();this.refreshDirectory();},
  refreshDirectory(){
    const routes=[['common','共通剧情'],['yoshino','朝武芳乃'],['mako','常陆茉子'],['murasame','丛雨'],['lena','蕾娜'],['sub','小春／芦花'],['after','后日谈']];
    let all;
    if(!this._directoryRoute)all=routes.map(x=>({title:x[1],route:x[0]}));
    else if(this._directoryRoute==='after')all=(graph.afterStories||[]).map(x=>({title:x.title,node:x.node,locked:!this._progress[x.requires],requires:x.requires}));
    else all=graph.chapters.filter(x=>x.route===this._directoryRoute&&!x.after).map(x=>({title:x.title,node:x.node}));
    this.directoryTitle=this._directoryRoute==='after'?'后日谈':(this._directoryRoute?'章节选择':'路线选择');const pages=Math.max(1,Math.ceil(all.length/4));this._directoryPage=Math.max(0,Math.min(pages-1,this._directoryPage));
    this.directoryRows=[];this.directoryRows=all.slice(this._directoryPage*4,this._directoryPage*4+4).map((x,i)=>Object.assign({},x,{id:(this._directoryRoute||'routes')+':'+this._directoryPage+':'+i,font:FONT,title:x.locked?'未解锁 · '+x.title:x.title}));this.directoryPageLabel='第 '+(this._directoryPage+1)+' / '+pages+' 页';
  },
  pickDirectory(index){const item=this.directoryRows[index];if(!item)return;if(item.route){this._directoryRoute=item.route;this._directoryPage=0;this.refreshDirectory();return;}if(item.locked){this.toast(HEROINE[item.requires]+'线通关后解锁');return;}this.session=create(graph,this._progress);this.session.node=item.node;this.session.progression='chapter';this.cachedFile='';this.renderFrame();},
  previousDirectoryPage(){if(this._directoryPage>0){this._directoryPage--;this.refreshDirectory();}},nextDirectoryPage(){this._directoryPage++;this.refreshDirectory();},
  backDirectory(){if(this._directoryRoute){this._directoryRoute='';this._directoryPage=0;this.refreshDirectory();}else this.toTitle();},
  playOpening(extra){if(this._openingActive)return;this.clearTyping();this._openingExtra=extra;this._openingActive=true;this._music.stop();this.mode='op';this.syncMusic();this._opening.reset();this._opening.resume();if(this.soundEnabled)this._music.playOpening(0);},
  playExtraOpening(){this.playOpening(true);},
  finishOpening(){if(!this._openingActive)return;this._openingActive=false;this._opening.stop();this._music.stop();if(this._openingExtra){this.mode='extra';this.syncMusic();return;}try{advance(graph,this.session);this.renderFrame();}catch(e){this.fail(e.message);}},
  updateLines(){
    const shown=String(this.displayText||''),source=this.fullText&&this.fullText.indexOf(shown)===0?this.fullText:shown;
    if(this._layoutText!==source||this._layoutFont!==this.fontSize){
      let line='',width=0,start=0,out=[],max=368/this.fontSize;
      for(let i=0;i<source.length;){const cp=source.codePointAt(i),c=String.fromCodePoint(cp),step=c.length,cw=cp<128?0.5:1;
        if(c==='\n'){out.push({text:line,start});line='';width=0;i+=step;start=i;continue;}
        if(width+cw>max&&line){out.push({text:line,start});line='';width=0;start=i;}
        line+=c;width+=cw;i+=step;
      }
      out.push({text:line,start});this._layoutText=source;this._layoutFont=this.fontSize;this._dialogueLayout=out;
    }
    const key=this.session?this.session.node+':'+this.session.index+':'+this.fontSize:'';
    this.dialogueHeight=this._dialogueLayout.length*(this.fontSize===28?38:34)+8;
    // Vela keyed text rows must receive a new key when their visible text changes.
    // Layout and line count come from the full sentence, so only the active row changes.
    this.dialogueLines=this._dialogueLayout.map((row,index)=>{const text=row.text.slice(0,Math.max(0,shown.length-row.start))||' ';return{id:key+':'+index+':'+text,text,font:FONT};});
  },
  toast(message){prompt.showToast({message,duration:1500,success:()=>{},fail:()=>{},complete:()=>{}});},
  fail(message){this.stopAuto();this.clearTyping();this.loading=false;this.mode='error';this.syncMusic();this.errorText=String(message);console.error('SENREN_RW5 error',message);}
}
</script>

