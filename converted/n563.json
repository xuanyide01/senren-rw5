[{"speaker":"","text":"收下安晴叔叔和秋穗阿姨的戒指后，我和芳乃的关系好像又进了一层。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"或者说，这让我们的心态产生了变化。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"现在……我们已经在考虑结婚方面的事情了。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"当然了，我们还是学生。","art":{"background":"a528","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"草率结婚只会给周围添麻烦。","art":{"background":"a528","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"对于此事，安晴叔叔和我外公也都表示理解。","art":{"background":"a528","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"而且……我们也并不焦急。","art":{"background":"a528","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"因为我们有信心。","art":{"background":"a528","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我们相信无论发生什么，都无法影响我们的感情。","art":{"background":"a528","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"现在我们依然是约定终身的亲密恋人，住在同一个屋檐下。","art":{"background":"a211","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我们依然时不时会拌嘴，对食物的喜好也并不能说完全一致。","art":{"background":"a211","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"但是我的的确确感受到，我们之间形成了某种纽带。","art":{"background":"a211","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"那纽带带来的幸福至今不见颓意。","art":{"background":"a211","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「多谢款待！」","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「嗯。粗茶淡饭，不成敬意」","art":{"background":"a498","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「今天的便当也很好吃，每天都这么麻烦你，真是辛苦你了」","art":{"background":"a498","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「你能高兴，我也开心」","art":{"background":"a498","sprites":[{"asset":"a492","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「不过……也快该吃腻了吧？」","art":{"background":"a498","sprites":[{"asset":"a1492","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「怎么可能！怎么可能会吃腻」","art":{"background":"a498","sprites":[{"asset":"a1492","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「那就好。但是能做的新菜品也差不多快没了」","art":{"background":"a498","sprites":[{"asset":"a1471","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「谢谢你，为了我做了这么多努力」","art":{"background":"a498","sprites":[{"asset":"a1471","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「在你面前，我真是抬不起头来」","art":{"background":"a498","sprites":[{"asset":"a1471","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「没那回事。你也帮了我那么多」","art":{"background":"a498","sprites":[{"asset":"a510","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「而且……那个……我也一样，一直都在受你关照」","art":{"background":"a498","sprites":[{"asset":"a538","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是吗？我平常做过什么关照你的事吗？」","art":{"background":"a498","sprites":[{"asset":"a538","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「这个，你看，那个……晚上你把我弄得那么舒服」","art":{"background":"a498","sprites":[{"asset":"a489","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊，啊……咳咳」","art":{"background":"a498","sprites":[{"asset":"a489","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「关于那方面……你也让我很舒服」","art":{"background":"a498","sprites":[{"asset":"a2237","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我说过很多遍了，我真的很舒服」","art":{"background":"a498","sprites":[{"asset":"a2237","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「～～～谢、谢谢……你？」","art":{"background":"a498","sprites":[{"asset":"a1495","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「我不太清楚……这种时候该不该道谢……或者说，是很不好意思」","art":{"background":"a498","sprites":[{"asset":"a2238","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不不，我又没在戏弄你，绝对不是在说你坏话」","art":{"background":"a498","sprites":[{"asset":"a2238","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「我知道的。但是……我也一样很舒服」","art":{"background":"a498","sprites":[{"asset":"a2239","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「里面被使劲顶着的时候，真的舒服极了……脑子里都一片空白」","art":{"background":"a498","sprites":[{"asset":"a1508","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「咳，咳咳！咳咳！」","art":{"background":"a498","sprites":[{"asset":"a1508","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「在这里聊那方面的事实在是不太好」","art":{"background":"a498","sprites":[{"asset":"a1508","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「啊……说、说得对。对不起，我一不注意就……」","art":{"background":"a498","sprites":[{"asset":"a1510","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「没事，能听到你这么说我也很开心」","art":{"background":"a498","sprites":[{"asset":"a1510","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「但是要是被其他人听到就麻烦了」","art":{"background":"a498","sprites":[{"asset":"a1510","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"如果只是被熟人听到，或许也只会露出无奈的表情吧。","art":{"background":"a498","sprites":[{"asset":"a1510","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"当然了，再怎么说也不能故意让别人听到。","art":{"background":"a498","sprites":[{"asset":"a1510","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「但是……我心里也会有点想法」","art":{"background":"a498","sprites":[{"asset":"a1468","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哎！？难道……你对我有什么不满？」","art":{"background":"a498","sprites":[{"asset":"a1468","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「不、不是的！不是那样的，倒不如说是我在担心会不会有哪些地方让你不满意」","art":{"background":"a498","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我？对你不满意？」","art":{"background":"a498","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那怎么可能」","art":{"background":"a498","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「但是，我总是把一切都交给你……我也想偶尔为你做些服务」","art":{"background":"a498","sprites":[{"asset":"a1468","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「服务……？」","art":{"background":"a498","sprites":[{"asset":"a1468","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「有……有什么希望我做的事情吗？」","art":{"background":"a498","sprites":[{"asset":"a1481","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「想让你做的事情……今天怎么这么积极……？」","art":{"background":"a498","sprites":[{"asset":"a1481","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「是……吗？」","art":{"background":"a498","sprites":[{"asset":"a860","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「当然了我也不讨厌你积极……不过你已经做得足够了。你看，比如那个……用嘴巴」","art":{"background":"a498","sprites":[{"asset":"a860","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「但是我积极的地方也只有那里了。我觉得，没有新鲜感是不太好的」","art":{"background":"a498","sprites":[{"asset":"a1520","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"今天她真是积极啊……不对，现在想想，芳乃从一开始就挺积极的。","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"芳乃的身体焦躁难耐时，有时甚至会做出袭击我一般的举动。","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"不过似乎还是有点奇怪——","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这又是谁跟你说的？」","art":{"background":"a498","sprites":[{"asset":"a1469","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「……为什么会这么想？」","art":{"background":"a498","sprites":[{"asset":"a478","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「因为我感觉这么积极和平常的你不太一样」","art":{"background":"a498","sprites":[{"asset":"a478","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「是、是吗……果然不应该做不习惯的事啊」","art":{"background":"a498","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那么，到底是被说了什么，才让你这么说的呢？」","art":{"background":"a498","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「其实……我问了问怎么样才能和你一直幸福下去。于是——」","art":{"background":"a498","sprites":[{"asset":"a1477","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「男女若要长期相处下去，必须要有刺激！」","art":{"background":"a938","sprites":[{"asset":"a182","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「最重要的是新鲜！决不能让对象感到厌倦」","art":{"background":"a938","sprites":[{"asset":"a135","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「所以你才说新鲜感啊……哎，又是那个萝莉幽灵」","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「难、难道我又上了当，说了难为情的话……！？」","art":{"background":"a498","sprites":[{"asset":"a814","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不，小雨说得倒也有道理」","art":{"background":"a498","sprites":[{"asset":"a814","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"平常倒也听说过这方面的话题，似乎……重视一下也不为过。","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"但是我还完全没有腻啊……","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不过我们现在并没有腻」","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「所以现在并不用在意那种事情吧？」","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「还有就是……刚才我也说了，偶尔我也想为你做些服务……！」","art":{"background":"a498","sprites":[{"asset":"a814","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「所以说不要有什么奇怪的顾虑，不要忍着，有什么要求尽管说出来」","art":{"background":"a498","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"芳乃的心意让我很高兴……但是我真的没什么不满意的。","art":{"background":"a498","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"她毫不讨厌和我做爱，目前为止，只要能和她肌肤相亲我就已经足够满足了。","art":{"background":"a498","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"但是——","art":{"background":"a498","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「总……总之，就今天吧？你看，正好是星期五」","art":{"background":"a498","sprites":[{"asset":"a693","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"看她现在的表情，我知道她是绝对不会退让的了。","art":{"background":"a498","sprites":[{"asset":"a693","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「能不能给我点时间考虑考虑？」","art":{"background":"a498","sprites":[{"asset":"a693","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯……」","art":{"background":"a543","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我毕竟也是个血气方刚的男人，确实对各种玩法感兴趣。","art":{"background":"a543","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「但是……什么程度才不会让芳乃嫌弃呢？」","art":{"background":"a543","sprites":[]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「哦？你在这儿做什么呢？」","art":{"background":"a543","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「廉太郎」","art":{"background":"a543","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「难道巫女大人那边有什么事让你烦恼？」","art":{"background":"a543","sprites":[{"asset":"a515","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……廉太郎……」","art":{"background":"a543","sprites":[{"asset":"a515","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我说你……不是处男吧？」","art":{"background":"a543","sprites":[{"asset":"a515","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「啊？怎么突然问这问题……总之确实不是……有什么问题吗？」","art":{"background":"a543","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我在烦恼一些事情……那个……」","art":{"background":"a543","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「用道具……会不会被女孩子嫌弃！？」","art":{"background":"a543","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「啊！？你、你说什么呢」","art":{"background":"a543","sprites":[{"asset":"a749","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「总之先冷静，我会认真听你的问题的。还有就是，我们换个地方说」","art":{"background":"a543","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「没有新鲜感确实不太好啊」","art":{"background":"a498","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是否应该认真考虑这方面的事情呢？」","art":{"background":"a498","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「新的刺激确实很重要。如果对什么感兴趣，最好坦白说出来」","art":{"background":"a498","sprites":[{"asset":"a514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「认识双方性癖的差异也是很重要的」","art":{"background":"a498","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「那么，你究竟想要什么？就是刚才说的道具吗？」","art":{"background":"a498","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「有点兴趣」","art":{"background":"a498","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「你的心情可以理解……不过道具啊……」","art":{"background":"a498","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不、不行吗……？」","art":{"background":"a498","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「害怕用道具的女孩子还是挺多的」","art":{"background":"a498","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是这样吗……」","art":{"background":"a498","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「然后就是，既然还没到没有新鲜感的阶段，道具还是先保留为好」","art":{"background":"a498","sprites":[{"asset":"a514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「一开始，最好先尝试普通点的行为」","art":{"background":"a498","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是吗……」","art":{"background":"a498","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「其他还有什么吗？比如说虽然有兴趣，但是难以启齿的事情」","art":{"background":"a498","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「没有」","art":{"background":"a498","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「这回答还真是毫不犹豫啊」","art":{"background":"a498","sprites":[{"asset":"a885","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「毕竟我对现状也没什么不满」","art":{"background":"a498","sprites":[{"asset":"a885","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"最近双方在各种事情上都习惯了不少。","art":{"background":"a498","sprites":[{"asset":"a885","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我也知道了刺激芳乃体内的哪个地方能让她产生什么反应。","art":{"background":"a498","sprites":[{"asset":"a885","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"所以说普通的做爱已经让我够高兴……或者说够开心的了……","art":{"background":"a498","sprites":[{"asset":"a885","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「啊啊，真是浪费。巫女大人不是有那么多有魅力的地方吗」","art":{"background":"a498","sprites":[{"asset":"a521","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「比如说？」","art":{"background":"a498","sprites":[{"asset":"a521","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「那当然看你……比如……腿？」","art":{"background":"a498","sprites":[{"asset":"a514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「脚？嗯，确实挺漂亮的。皮肤也很白很漂亮」","art":{"background":"a498","sprites":[{"asset":"a514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「哎……你根本不懂啊，什么都不懂」","art":{"background":"a498","sprites":[{"asset":"a2240","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「什、什么意思啊？」","art":{"background":"a498","sprites":[{"asset":"a2240","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「巫女大人的皮肤确实很漂亮，但是啊，那并不是重点」","art":{"background":"a498","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「重要的是裤袜啊！！」","art":{"background":"a498","sprites":[{"asset":"a2240","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊？」","art":{"background":"a498","sprites":[{"asset":"a2240","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「这还不明白吗，修长的双腿和将其包裹的黑色裤袜中包含着多少诱惑啊」","art":{"background":"a498","sprites":[{"asset":"a519","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这个，我完全不懂。确实是挺漂亮的……但是说实话，我更在意她的内在」","art":{"background":"a498","sprites":[{"asset":"a519","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「浪费啊，太浪费了！你竟然感觉不到那里的魅力……」","art":{"background":"a498","sprites":[{"asset":"a521","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「总之就按我说的去做，就当是被我骗了。被踩，即会开启新世界的大门」","art":{"background":"a498","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「被踩啊……」","art":{"background":"a498","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哎！？被踩！？」","art":{"background":"a498","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"这种受虐狂似的行为我不是很感兴趣啊……","art":{"background":"a498","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"不过也想不出别的什么了。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"说实话，在做爱方面，还是廉太郎更有经验。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"就当是被他骗了，听听他的意见——真的可以吗？很犹豫啊……","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「那、那个，将臣！」","art":{"background":"a599","sprites":[{"asset":"a1518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"上完课后，芳乃紧张地跑到我跟前。","art":{"background":"a599","sprites":[{"asset":"a1518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「于、于是……怎么样？」","art":{"background":"a599","sprites":[{"asset":"a816","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊，嗯。关于那件事……勉强算是想好了」","art":{"background":"a599","sprites":[{"asset":"a816","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「是……是吗？」","art":{"background":"a599","sprites":[{"asset":"a711","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不过我先要去外公那里，你先回去吧」","art":{"background":"a599","sprites":[{"asset":"a711","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「好的，我知道了」","art":{"background":"a599","sprites":[{"asset":"a907","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊！对了！在家里穿着校服等我」","art":{"background":"a599","sprites":[{"asset":"a907","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「……哎？啊，好吧……我明白了……」","art":{"background":"a599","sprites":[{"asset":"a1513","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"最终我还是决定听从廉太郎的建议。","art":{"background":"a49","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"早早做完平日必做的锻炼之后，我回到家里。","art":{"background":"a49","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"然后终于到了那个时候。","art":{"background":"a938","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我回到房间后，马上就去了芳乃的房间。","art":{"background":"a938","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我们穿着校服，面对着对方。","art":{"background":"a938","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「久、久等了」","art":{"background":"a938","sprites":[{"asset":"a478","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「呃、嗯，我一直在等着你。而且有在穿着校服」","art":{"background":"a938","sprites":[{"asset":"a1491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯，谢谢……」","art":{"background":"a938","sprites":[{"asset":"a1491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「事不宜迟，那个……现在就可以开始吗？」","art":{"background":"a938","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是啊，一直穿着校服也不方便」","art":{"background":"a938","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「这倒是无所谓……校服很重要吗？」","art":{"background":"a938","sprites":[{"asset":"a860","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「很重要」","art":{"background":"a938","sprites":[{"asset":"a860","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"准确来说，是穿制服时穿的裤袜重要。","art":{"background":"a938","sprites":[{"asset":"a860","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"不过这都是跟廉太郎学来的。","art":{"background":"a938","sprites":[{"asset":"a860","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「那么……我该怎么做呢？」","art":{"background":"a938","sprites":[{"asset":"a1513","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「请踩」","art":{"background":"a938","sprites":[{"asset":"a1513","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「哎？踩……」","art":{"background":"a938","sprites":[{"asset":"a800","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「请踩我！」","art":{"background":"a938","sprites":[{"asset":"a860","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「哎，哎哎哎哎哎！？我怎么可能做那种事情……！」","art":{"background":"a938","sprites":[{"asset":"a1495","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"}]