[{"speaker":"将臣","text":"「我喜欢小春，想有朝一日和小春结婚」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「所以，能不能认可我们两人的关系！」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"在小春的父母——也就是我的舅舅舅妈面前，我低下头大声请求道。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"虽说克服了外公这个障碍，但是显然也必须获得他们两人的许可。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"我抱着如此决心，对他们两人说出了我的请求——","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"小春的母亲","text":"「挺好的嘛」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"小春的父亲","text":"「嗯，没问题」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"就好像我的决心完全是白费功夫一样，问题一瞬间就全部解决了。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「那个……这么说可能有点不太好……你们这么干脆就答应了吗」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"小春的母亲","text":"「毕竟我们早就看出来了」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"小春的父亲","text":"「她在家里整天喊着“哥哥，哥哥”，哪能看不出来呢」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"小春","text":"「唔……～～～～～～……！」","art":{"background":"a1","sprites":[{"asset":"a4131","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「那么……真的可以？」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"小春的母亲","text":"「表亲之间可以结婚，没什么好反对的」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"小春的父亲","text":"「你要让小春幸福啊」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「我知道了，谢谢二位！」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「好像……有点扫兴啊」","art":{"background":"a2","sprites":[{"asset":"a61","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「是啊。没想到这么简单就认可了」","art":{"background":"a2","sprites":[{"asset":"a4238","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「不过没发展到外公那时候的情况也是件好事」","art":{"background":"a2","sprites":[{"asset":"a4238","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"要是他们也说要看看我的决心……我估计想哭的心都有了。","art":{"background":"a2","sprites":[{"asset":"a4238","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「那么接下来……还要去和哥哥的爸爸妈妈，和我姑父姑姑说一声」","art":{"background":"a2","sprites":[{"asset":"a66","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「确实还要跟他们说一下……不过估计也同样一下子就能完事了」","art":{"background":"a2","sprites":[{"asset":"a66","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「毕竟我是男性，能和你结婚，他们肯定非常乐意」","art":{"background":"a2","sprites":[{"asset":"a66","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「是吗？」","art":{"background":"a2","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「是啊，像你这么可爱的女孩子，他们肯定非常欢迎」","art":{"background":"a2","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「说不定还会说跟着我是糟蹋了你」","art":{"background":"a2","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「是、是吗……嘿嘿……谢谢哥哥」","art":{"background":"a2","sprites":[{"asset":"a4237","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我一定会让你幸福的，小春」","art":{"background":"a2","sprites":[{"asset":"a4237","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「我也一定会让哥哥幸福」","art":{"background":"a2","sprites":[{"asset":"a95","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「……谢谢小春」","art":{"background":"a2","sprites":[{"asset":"a95","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「嘿嘿」","art":{"background":"a2","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"小春露出羞涩的笑容。","art":{"background":"a2","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"只是看着她的脸，我胸中就满溢着幸福。","art":{"background":"a2","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"和喜欢的人在一起……原来是这么幸福的事啊……","art":{"background":"a2","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「小春……」","art":{"background":"a2","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「嗯？怎么了？」","art":{"background":"a2","sprites":[{"asset":"a66","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我们要幸福地生活。让我们永远永远，都幸幸福福的」","art":{"background":"a2","sprites":[{"asset":"a66","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「……嗯！」","art":{"background":"a2","sprites":[{"asset":"a63","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"}]