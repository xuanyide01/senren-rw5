[{"speaker":"将臣","text":"「要射了，芳乃」","art":{"background":"a2027","sprites":[]},"chapter":"6-2"},{"speaker":"芳乃","text":"「好的……哈，唔唔……快点……射精，快点……唔唔」","art":{"background":"a2022","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「啊啊啊，射了，要射了」","art":{"background":"a2022","sprites":[]},"chapter":"6-2"},{"speaker":"芳乃","text":"「好的，拜托了……射吧……射过来吧……啊，啊，啊，啊，啊」","art":{"background":"a2025","sprites":[]},"chapter":"6-2"},{"speaker":"芳乃","text":"「啊，啊啊啊啊！啊啊啊啊啊啊啊————」","art":{"background":"a2027","sprites":[]},"chapter":"6-2"},{"speaker":"芳乃","text":"「啊啊啊啊，呀，啊！啊，啊啊啊啊————！」","art":{"background":"a2028","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"精液一泄如注。","art":{"background":"a2028","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"精液气势汹涌地喷到芳乃的身体上，连我自己都觉得很惊讶。","art":{"background":"a2028","sprites":[]},"chapter":"6-2"},{"speaker":"芳乃","text":"「啊，呀，唔唔……啊啊啊啊……！」","art":{"background":"a2032","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"我不断射精着！","art":{"background":"a2032","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"粘稠的精液飞溅到洁白如雪的肌肤上。","art":{"background":"a2032","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"芳乃用有些茫然的目光看着眼前的景象。","art":{"background":"a2033","sprites":[]},"chapter":"6-2"},{"speaker":"芳乃","text":"「啊，啊啊……啊啊……啊啊……射精……好厉害……」","art":{"background":"a2033","sprites":[]},"chapter":"6-2"},{"speaker":"芳乃","text":"「这么热、这么粘稠……啊，原来这就是射精……啊啊……！」","art":{"background":"a2031","sprites":[]},"chapter":"6-2"}]