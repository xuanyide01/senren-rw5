[{"speaker":"丛雨","text":"「啊，嗯，啊……」","art":{"background":"a3445","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"在射精的一瞬间，我将阳具从她嘴里拔了出来。","art":{"background":"a3445","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"她的脸一下就沾满了白浊的液体。","art":{"background":"a3445","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「……啊，啊，主人……」","art":{"background":"a3450","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「你射出来的还是这么热这么浓……」","art":{"background":"a3451","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"小雨抬起被精液玷污的脸对我说。","art":{"background":"a3451","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「嘻嘻，是主人的味道……」","art":{"background":"a3446","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「是本座的主人的……」","art":{"background":"a3446","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「昨晚我们做了那么多次，你还能射这么多啊……」","art":{"background":"a3449","sprites":[]},"chapter":"后日谈"}]