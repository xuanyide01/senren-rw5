[{"speaker":"将臣","text":"「还是小春的笑容啊……」","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"脑袋里冒出来的还是小春的脸。","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我想看到小春高兴的表情。","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"为了这个，我应该做出更好的仙贝。","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「……好」","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「外公」","art":{"background":"a3739","sprites":[]},"chapter":"6-3"},{"speaker":"玄十郎","text":"「怎么了，将臣？」","art":{"background":"a3739","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「我有件事想跟你谈谈……好吧，其实是想拜托你一件事」","art":{"background":"a3739","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"玄十郎","text":"「你有事拜托我？」","art":{"background":"a3739","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「不，准确来说不是我，而是来自芦花姐……准确地说是来自田心屋的请求」","art":{"background":"a3739","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"}]