[{"speaker":"将臣","text":"「芦花姐，我要射在里面了，直接射在里面」","art":{"background":"a4503","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「啊、啊、啊……又变大了……嗯、嗯！啊啊啊啊啊啊啊啊啊啊——」","art":{"background":"a4506","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「啊啊啊啊啊啊啊啊啊啊啊啊啊！！！」","art":{"background":"a4506","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"咕嘟、咕嘟……咕嘟……！","art":{"background":"a4507","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"所有的精液都注入了芦花姐的体内。","art":{"background":"a4507","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「嗯啊、啊、啊、啊啊啊啊……好烫……烫烫的射进来好多……嗯嗯嗯」","art":{"background":"a4508","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"咕嘟咕嘟……！","art":{"background":"a4509","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"射精止都止不住。我一次又一次地在芦花姐体内喷射而出。","art":{"background":"a4509","sprites":[]},"chapter":"8-2"}]