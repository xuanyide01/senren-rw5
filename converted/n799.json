[{"speaker":"将臣","text":"「哈啊……哈啊……哈啊……」","art":{"background":"a4334","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我一言不发，上下晃动肩部剧烈喘息，俯视小春的身躯。","art":{"background":"a4334","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「哈啊，哈啊……这算是、成功了吧？」","art":{"background":"a4334","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「我们的初夜算是成功了吧？」","art":{"background":"a4334","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「嗯，成功了。今天真是我最美好的一天，小春」","art":{"background":"a4334","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「对我来说也是哦，哥哥……嘿嘿嘿」","art":{"background":"a4334","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"结果我们依旧手牵着手调整呼吸了一阵子。","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"幸好芦花姐没有回来，我们做好了善后工作，关紧了门窗，走出店内。","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「……」","art":{"background":"a1141","sprites":[{"asset":"a4126","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1141","sprites":[{"asset":"a4126","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「我们做了啊……」","art":{"background":"a1141","sprites":[{"asset":"a4335","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「嗯，做了」","art":{"background":"a1141","sprites":[{"asset":"a4335","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"在做的时候还好……现在再和她说话反倒会害羞……","art":{"background":"a1141","sprites":[{"asset":"a4335","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「这样一来就不是表兄妹了吧。我们……算是正经的情侣了吧」","art":{"background":"a1141","sprites":[{"asset":"a68","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「本来就是情侣嘛」","art":{"background":"a1141","sprites":[{"asset":"a68","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「不过今天过后，我们就是感情更深的情侣了吧」","art":{"background":"a1141","sprites":[{"asset":"a68","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……嗯，是啊，哥哥」","art":{"background":"a1141","sprites":[{"asset":"a64","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「啊，不过这下怎么办。这样一来叫“哥哥”不是会显得奇怪吗？」","art":{"background":"a1141","sprites":[{"asset":"a3262","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「以后也叫我哥哥就好」","art":{"background":"a1141","sprites":[{"asset":"a3262","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「可以吗？」","art":{"background":"a1141","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「毕竟你是像个妹妹一样的女朋友」","art":{"background":"a1141","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「这样挺好的」","art":{"background":"a1141","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯，太好了……哥哥！」","art":{"background":"a1141","sprites":[{"asset":"a66","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"}]