[{"speaker":"芦花","text":"「……」","art":{"background":"a1677","sprites":[{"asset":"a987","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「……」","art":{"background":"a1677","sprites":[{"asset":"a987","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"星期六早上，他们父女四目相对，一脸认真。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"在这样充满火药味的气氛中，我一声不吭，静静地看着他们。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「我想把这个当做新的饮品，正式加入菜单里」","art":{"background":"a1677","sprites":[{"asset":"a987","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「爸爸，你先别急着发表意见，先尝尝再说」","art":{"background":"a1677","sprites":[{"asset":"a1028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「这种咖啡不仅单独喝的时候很好喝，而且还不会影响到咱们家甜品的味道。所以……你先尝尝看」","art":{"background":"a1677","sprites":[{"asset":"a987","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"她把杯子摆在叔叔眼前。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"虽然叔叔的脸上闪过了一丝不情愿的表情，但他还是接过了杯子。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「哼……咖啡有什么好喝的」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「……嗯，喔……」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"这个反应……好像还不错？","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"叔叔长吁了一口气。看上去似乎很惊讶，又似乎是在感叹。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「……果然还是歪门邪道啊」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「哎！？你刚才那一声感叹，明显是觉得味道还不错吧！」","art":{"background":"a1677","sprites":[{"asset":"a2446","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「我，我才没有感叹，你别瞎说」","art":{"background":"a1677","sprites":[{"asset":"a2446","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1677","sprites":[{"asset":"a2446","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"感觉这人就是个傲娇啊。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「妈妈你怎么看？」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的母亲","text":"「我不太喜欢咖啡。而且我还要研究抹茶苏打，你们就不要问我啦」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"然后这边是漠不关心……","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「你先别管是不是歪门邪道，你就说味道怎么样吧」","art":{"background":"a1677","sprites":[{"asset":"a987","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「如果你在味道上有自己的坚持，那就请认真地说出自己关于味道的感想」","art":{"background":"a1677","sprites":[{"asset":"a1028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「……味道……倒也不坏。和以前那种只有苦味的咖啡不一样」","art":{"background":"a1677","sprites":[{"asset":"a1028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「看来正宗的确实跟速溶的不一样」","art":{"background":"a1677","sprites":[{"asset":"a1028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"果然这人就是个傲娇！而且还相当好说话！","art":{"background":"a1677","sprites":[{"asset":"a1028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「那，那就是说……你同意了？」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「……你是社长，你来决定」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「那我就自己做决定了。我会试着卖一点，看看客人的反响」","art":{"background":"a1677","sprites":[{"asset":"a4114","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「要是反响不好的话，就马上下架」","art":{"background":"a1677","sprites":[{"asset":"a4114","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「我知道。万一影响到其他商品的话，我会立刻中止的」","art":{"background":"a1677","sprites":[{"asset":"a1692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「既然知道，那你就自己去试试看吧」","art":{"background":"a1677","sprites":[{"asset":"a1692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「嗯！」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「只不过，味道方面我觉得还可以再考究一下」","art":{"background":"a1677","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「哎……你觉得有什么问题吗？」","art":{"background":"a1677","sprites":[{"asset":"a1692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「整体来说是不是太浓了？我觉得应该更淡一点，才不会影响到甜味」","art":{"background":"a1677","sprites":[{"asset":"a1692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「但是太淡的话又可能会不够醇厚……」","art":{"background":"a1677","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1677","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"他们在积极地讨论着咖啡的问题。","art":{"background":"a1677","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的母亲","text":"「你看他们聊得多起劲」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花的母亲","text":"「这都是多亏了你啊」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「哪里，我也没帮上多大忙啦」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花的母亲","text":"「但是咖啡和抹茶苏打，都是你想出来的主意吧？」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「只是一点想法而已，称不上是主意」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「筛选出味道合适的咖啡，说服叔叔，这靠的都是芦花姐自身的努力」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「太好了……太好了，哈哈」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"芦花姐似乎是真的很开心。","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"这样一来也能稍微减少一点烦恼了吧？","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花的父亲","text":"「好了，别那么兴奋了，赶快去做开店前的准备」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「好的♪」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"简直就像个少女一样……这样说的话她八成会生气。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"但芦花姐就是那么开心，笑得那么天真无邪。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"她都已经从学校毕业开始工作了，我本来还以为她已经很成熟了……没想到内心依然有着少女的一面。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「阿将，阿将！爸爸认可了，他同意把我选的咖啡放进正式菜单了」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「芦花姐，你稍微冷静一下。我怕你开心过头，到时候出了什么岔子」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「说、说的也是。这样可不行。不过我还是忍不住高兴～」","art":{"background":"a1677","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"芦花姐一脸开心地笑着。","art":{"background":"a1677","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"她脸上的笑容和之前的笑容完全不一样……这天真无邪的笑容，让我想起了小时候的她。","art":{"background":"a1677","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"看到她的笑容，连我也不由得露出了笑颜。","art":{"background":"a1677","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"等我回过神来，我已经在微笑着祝贺芦花姐了。","art":{"background":"a1677","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「恭喜你，芦花姐」","art":{"background":"a1677","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「嗯！谢谢你，阿将！」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「今天就能卖咖啡了吗？」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「今天可能不行，还没做好准备呢」","art":{"background":"a1677","sprites":[{"asset":"a3016","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「不过我是打算趁爸爸还没改变主意，能早点开卖就早点开卖」","art":{"background":"a1677","sprites":[{"asset":"a1009","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「阿将，到时候你也要把冲泡的方法学会才行啊」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「那当然了。我会努力学习怎样冲出好喝的咖啡的」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「嗯，拜托你了♪」","art":{"background":"a1677","sprites":[{"asset":"a1573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「早上好」","art":{"background":"a1677","sprites":[{"asset":"a95","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"千代","text":"「早上好」","art":{"background":"a1677","sprites":[{"asset":"a95","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「啊，小春，内藤姐，今天一天也要麻烦你们了」","art":{"background":"a1677","sprites":[{"asset":"a95","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a995","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"千代","text":"「好，好的……我会努力的」","art":{"background":"a1677","sprites":[{"asset":"a95","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a995","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「………？感觉姐姐今天心情好像很好啊」","art":{"background":"a1677","sprites":[{"asset":"a66","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a995","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「咖啡的事叔叔同意了。所以她高兴得不能自已了」","art":{"background":"a1677","sprites":[{"asset":"a66","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a995","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「是这样啊，怪不得那么高兴——哎，哥哥……！」","art":{"background":"a1677","sprites":[{"asset":"a4115","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「早上好，小春」","art":{"background":"a1677","sprites":[{"asset":"a4115","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「早、早早、早上好」","art":{"background":"a1677","sprites":[{"asset":"a4116","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"千代","text":"「早上好，有地」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「嗯，早上好」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「那么我来准备开门吧」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"小春","text":"「是，是啊，要做准备了。那……那我就……先去换个衣服！」","art":{"background":"a1677","sprites":[{"asset":"a4115","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……？」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"小春慌慌张张地跑进了后厨，脚步声大得都有些吵闹了。","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"千代","text":"「小春，你等我一下」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「……难道……她在躲着我？」","art":{"background":"a1677","sprites":[]},"chapter":"4-5"},{"speaker":"小春","text":"「那、那个，麻烦准备下……抹茶芭菲和布丁，拜托了」","art":{"background":"a967","sprites":[{"asset":"a4117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「嗯，了解了」","art":{"background":"a967","sprites":[{"asset":"a4117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「那、那就拜托你了」","art":{"background":"a967","sprites":[{"asset":"a4079","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a967","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「小春，你可以来一下吗？」","art":{"background":"a967","sprites":[]},"chapter":"4-5"},{"speaker":"小春","text":"「什、什么！？哥哥」","art":{"background":"a967","sprites":[{"asset":"a4118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「计时器的电池没电了，你知道新电池放在哪里吗？」","art":{"background":"a967","sprites":[{"asset":"a4118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「电，电池啊……应该在隔壁那个放糯米粉和面粉的架子上的抽屉里」","art":{"background":"a967","sprites":[{"asset":"a4119","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「啊，有、有客人在叫我了我得去一下！」","art":{"background":"a967","sprites":[{"asset":"a4120","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「啊，嗯……谢谢你」","art":{"background":"a967","sprites":[{"asset":"a4120","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「……（偷看）」","art":{"background":"a967","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a967","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「……（偷看），（偷看）」","art":{"background":"a967","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a967","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「那个……」","art":{"background":"a967","sprites":[{"asset":"a4122","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「什、什么事！？」","art":{"background":"a967","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「你有什么事情要和我说吗？」","art":{"background":"a967","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「没有！没有那回事！你可是我表哥啊，那种、那种事情……怎么可能有」","art":{"background":"a967","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「哦，哦……」","art":{"background":"a967","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"我觉得她已经开始语无伦次了……","art":{"background":"a967","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「我、我先去休息了！」","art":{"background":"a967","sprites":[{"asset":"a4124","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「嗯……辛苦了……」","art":{"background":"a967","sprites":[{"asset":"a4124","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"小春慌慌张张地跑走了，仿佛是想要从我这里逃走一样。","art":{"background":"a967","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"在店里跑动可不是什么好事啊，小春。虽然也不是什么大问题。","art":{"background":"a967","sprites":[]},"chapter":"4-5"},{"speaker":"千代","text":"「啊，有地，能麻烦你把门口打扫一下吗？」","art":{"background":"a967","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「好的，我明白了」","art":{"background":"a967","sprites":[]},"chapter":"4-5"},{"speaker":"小春","text":"「啊啊啊～～～呜呜呜～～～」","art":{"background":"a1","sprites":[{"asset":"a4122","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「都怪姐姐瞎说……现在我都没法直视哥哥的脸了……」","art":{"background":"a1","sprites":[{"asset":"a4117","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「虽然我确实有点心动……也觉得哥哥确实很帅气……但是他可是我表哥啊」","art":{"background":"a1","sprites":[{"asset":"a4125","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「我才没有喜欢他呢。才没有……」","art":{"background":"a1","sprites":[{"asset":"a4119","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「……」","art":{"background":"a1","sprites":[{"asset":"a4123","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「啊啊啊～～～呜呜呜～～～」","art":{"background":"a1","sprites":[{"asset":"a4117","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「我必须表现得自然点，否则他会觉得我很奇怪的～～～～……！」","art":{"background":"a1","sprites":[{"asset":"a1695","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……说起来，小春今天有点奇怪啊」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「哈哈，你发现啦」","art":{"background":"a1032","sprites":[{"asset":"a1562","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「芦花姐」","art":{"background":"a1032","sprites":[{"asset":"a1562","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「你很在意小春吗？」","art":{"background":"a1032","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「那当然了。感觉她今天好不自然。但看上去又不像是感冒了……」","art":{"background":"a1032","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「难道是——」","art":{"background":"a1032","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「难道是！？」","art":{"background":"a1032","sprites":[{"asset":"a3261","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「生我的气了？」","art":{"background":"a1032","sprites":[{"asset":"a3261","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「……啊？生气？为什么生气？」","art":{"background":"a1032","sprites":[{"asset":"a1566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「你想啊，在咱们店里，小春算是我前辈吧？」","art":{"background":"a1032","sprites":[{"asset":"a1566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「我一个后辈，竟然对这家店的甜品指指点点，是不是太不给前辈面子了」","art":{"background":"a1032","sprites":[{"asset":"a1566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「……」","art":{"background":"a1032","sprites":[{"asset":"a993","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「你这什么表情，看得我好来气啊」","art":{"background":"a1032","sprites":[{"asset":"a993","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「没什么。只是没想到你竟然是这样一个木头脑袋，有点无语了」","art":{"background":"a1032","sprites":[{"asset":"a1698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「那……难道说是因为我太没用了，所以看到我就觉得烦躁吗？」","art":{"background":"a1032","sprites":[{"asset":"a1698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「……阿将……」","art":{"background":"a1032","sprites":[{"asset":"a993","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「怎么？又猜错了吗？」","art":{"background":"a1032","sprites":[{"asset":"a993","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「唉……算了。反正我觉得她并没有生气」","art":{"background":"a1032","sprites":[{"asset":"a2150","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「是、是吗……」","art":{"background":"a1032","sprites":[{"asset":"a2150","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「那我先走了，阿将」","art":{"background":"a1032","sprites":[{"asset":"a1009","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「咦？你要去哪啊？」","art":{"background":"a1032","sprites":[{"asset":"a1009","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「我要去和供货商见个面。还要跟他们商量下怎么调整咖啡的味道」","art":{"background":"a1032","sprites":[{"asset":"a990","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「所以，店里就交给你了」","art":{"background":"a1032","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「明白了。路上小心啊，社长！」","art":{"background":"a1032","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「都说了不要叫我社长啦」","art":{"background":"a1032","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"芦花姐轻轻戳了我一下，然后走掉了。","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"感觉她的脚步多少有点轻快。","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"虽然叔叔还没有完全同意……但目前的进展也足够让她开心了。","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"毕竟自己的努力得到了认可。","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「……嗯」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"之前那种烦恼、苦闷的情绪已经完全消失了，真是太好了。","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「好了……打扫得也差不多了」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"千代","text":"「辛苦了，有地」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「辛苦了。我打扫完了」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"千代","text":"「谢谢你。那你就趁现在去休息一下吧」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「好的。啊，对了！」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「我想去买个东西，请问可以外出吗？」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"千代","text":"「只要能在规定时间内回来就没问题」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「谢谢」","art":{"background":"a1032","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「呼～结束了～」","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「辛苦了，阿将」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"千代","text":"「辛苦了。那我先走一步了」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「啊，好的。辛苦了」","art":{"background":"a1700","sprites":[{"asset":"a1573","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「好了，那咱们赶快收拾东西吧」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"芦花姐麻利地收拾起了桌子。","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"然后就像平时一样，将盘子和杯子堆在一起——","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「停。力气活应该让我负责」","art":{"background":"a1700","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"我抢过她手中那堆得老高的盘子。","art":{"background":"a1700","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「……你这孩子，瞧你神气的」","art":{"background":"a1700","sprites":[{"asset":"a3703","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"芦花姐虽然嘴上这样说，但她的表情并没有什么不满。","art":{"background":"a1700","sprites":[{"asset":"a3703","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"不如说……看上去似乎有些高兴，又有些害羞。","art":{"background":"a1700","sprites":[{"asset":"a3703","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「其他的事情就拜托芦花姐了」","art":{"background":"a1700","sprites":[{"asset":"a3703","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「好嘞」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"收拾桌子时，有一件事让我非常在意——","art":{"background":"a119","sprites":[]},"chapter":"4-5"},{"speaker":"小春","text":"「唔唔……唔唔……」","art":{"background":"a1700","sprites":[{"asset":"a4111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"不知为何，小春那样子看上去很不自然。","art":{"background":"a1700","sprites":[{"asset":"a4111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"感觉她今天有些奇怪……真的没问题吗？","art":{"background":"a1700","sprites":[{"asset":"a4111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「小春」","art":{"background":"a1700","sprites":[{"asset":"a4111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「啊、在」","art":{"background":"a1700","sprites":[{"asset":"a4110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「你没事吧？感觉你今天有点奇怪啊」","art":{"background":"a1700","sprites":[{"asset":"a4110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「唔，嗯……对不起，让你担心了。我真的没事」","art":{"background":"a1700","sprites":[{"asset":"a4126","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「虽然现在可能有点奇怪，但我很快就会恢复的！不、不用太在意我，哈哈」","art":{"background":"a1700","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「那就好……」","art":{"background":"a1700","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"算了，既然她这么想糊弄过去，那我就不深究了。","art":{"background":"a1700","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「要是有什么为难的事情，你随时都可以找我商量哦。我会给你帮忙的」","art":{"background":"a1700","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「虽然我可能没那么靠谱」","art":{"background":"a1700","sprites":[{"asset":"a70","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「怎么会呢！你对我这么好，又这么能干！」","art":{"background":"a1700","sprites":[{"asset":"a3325","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a3325","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「～～～！？」","art":{"background":"a1700","sprites":[{"asset":"a4128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「对，对不起……我突然喊得这么大声。\n我今天确实很奇怪……」","art":{"background":"a1700","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「没事，你能这么说我很高兴」","art":{"background":"a1700","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"我一边说，一边摸了摸小春的头。","art":{"background":"a1700","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「！？」","art":{"background":"a1700","sprites":[{"asset":"a4110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"在那一瞬间，小春身体一颤，反应十分剧烈。","art":{"background":"a1700","sprites":[{"asset":"a4110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「啊，抱歉……」","art":{"background":"a1700","sprites":[{"asset":"a4110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「啊，不是的，我就是吓了一跳而已。并不是不愿意！不是不愿意！」","art":{"background":"a1700","sprites":[{"asset":"a4115","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「你这样摸我的头，我挺开心的……浑身的疲劳一下子都飞走了」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「是嘛。今天你也辛苦了，就让我来好好慰劳你一下吧」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「嗯。嘿嘿……嘿嘿……」","art":{"background":"a1700","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"我开玩笑似地乱抓着她的头发。","art":{"background":"a1700","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"看着小春那满面的笑容，我真希望她能一直这样开心下去。","art":{"background":"a1700","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「今天……挺抱歉的，一整天都在躲着你」","art":{"background":"a1700","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「等到明天就会恢复平常的样子了」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「是嘛。那我就放心了」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「不过我是说真的，要是有什么困难的话，你可以找我商量的」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「嗯……谢谢你，哥哥。哈哈……」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「不要再摸啦，我的疲劳已经全部飞走了」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「好吧」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「那我就先告辞了」","art":{"background":"a1700","sprites":[{"asset":"a4130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「我送你回去。你再等我一会儿吧」","art":{"background":"a1700","sprites":[{"asset":"a4130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「没事没事，不用在意。我正好想要一个人走走」","art":{"background":"a1700","sprites":[{"asset":"a4127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「我得让脸缓一下再回去……要不然回去了会被廉哥笑话的」","art":{"background":"a1700","sprites":[{"asset":"a4131","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「确实，你的脸一片通红……你这是怎么了？」","art":{"background":"a1700","sprites":[{"asset":"a4131","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「没什么啦，啊哈，哈哈哈」","art":{"background":"a1700","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"小春","text":"「总之今天真的很抱歉。还有……谢谢哥哥。再见了！」","art":{"background":"a1700","sprites":[{"asset":"a4132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「嗯，再见」","art":{"background":"a1700","sprites":[{"asset":"a4132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"虽然她言行举止还有点僵硬……但已经没有白天那么奇怪了。","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「看来并不是惹她生气了」","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"既然如此，那她明天应该就能恢复了吧。","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「……（盯）……」","art":{"background":"a1700","sprites":[{"asset":"a1566","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「怎么了？芦花姐」","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「难道说芦花姐也想让我摸摸头？要我摸摸你吗？」","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「你这小子，真是翅膀硬了啊。我才不用你摸我呢」","art":{"background":"a1700","sprites":[{"asset":"a1028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「我只是不想打扰你们，所以一直在一旁看着」","art":{"background":"a1700","sprites":[{"asset":"a991","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「打扰？」","art":{"background":"a1700","sprites":[{"asset":"a991","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「先不说这个了，阿将，接下来你有时间吗？」","art":{"background":"a1700","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「怎么？要加班？」","art":{"background":"a1700","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「我让他们用新的咖啡豆做了混合咖啡的样品，你能尝尝看吗？」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「嗯……啊，也许这种咖啡更好」","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"芦花姐准备了新的混合咖啡。","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"这种咖啡的余韵更加舒畅，我也更喜欢这种咖啡的香气。","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「你也这么觉得吗？」","art":{"background":"a1700","sprites":[{"asset":"a1564","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「这么说……你也是这样想的咯？」","art":{"background":"a1700","sprites":[{"asset":"a1564","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「虽然有点不甘心，但我还是不得不承认，按爸爸的建议改良后的这种咖啡更加美味」","art":{"background":"a1700","sprites":[{"asset":"a1692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「这大概就是经验上的差距了吧……？」","art":{"background":"a1700","sprites":[{"asset":"a1692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「但是我觉得，能让你爸爸接受咖啡，都是你努力的成果」","art":{"background":"a1700","sprites":[{"asset":"a1692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「所以我觉得你没必要这么消沉」","art":{"background":"a1700","sprites":[{"asset":"a1692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「唉～居然被你这小年轻安慰了，真是丢脸」","art":{"background":"a1700","sprites":[{"asset":"a1565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「这也是没办法的吧？这种环境下，也没几个人能听你发牢骚了」","art":{"background":"a1700","sprites":[{"asset":"a1565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「那我差不多该回去了」","art":{"background":"a1700","sprites":[{"asset":"a2147","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「啊，嗯，抱歉了。谢谢你留下来帮我品尝咖啡」","art":{"background":"a1700","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「这点小事，不算什么」","art":{"background":"a1700","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「对了！我都差点忘了，我还有东西要给你。你稍微等我一下」","art":{"background":"a1700","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「嗯？」","art":{"background":"a1700","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"我从厨房的冰箱里拿出冷藏的奶油点心，还有藏起来没让人看见的花。","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"然后回到了芦花姐身边——","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「辛苦你了。然后，恭喜你」","art":{"background":"a1700","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"我说罢，拿出了奶油泡芙和花束。","art":{"background":"a1700","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「这是什么……怎么了？」","art":{"background":"a1700","sprites":[{"asset":"a2442","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「非洲菊。今天你的努力得到承认，所以纪念下。虽然泡芙是便利店买的」","art":{"background":"a1700","sprites":[{"asset":"a2442","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「而且……我的零花钱没法给你买到真正的花束，实在抱歉」","art":{"background":"a1700","sprites":[{"asset":"a2442","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"我真是没想到……几朵花竟然会这么贵。","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"我的钱不够做成花束，只够买这样几朵。","art":{"background":"a1700","sprites":[]},"chapter":"4-5"},{"speaker":"将臣","text":"「仔细想想，我之前都没给你送过毕业礼物和就职礼物呢」","art":{"background":"a1700","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「虽然用这点东西代替那些礼物似乎有点不太好，但你要是不嫌弃的话，就请收下吧」","art":{"background":"a1700","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「啊，嗯……谢谢你……阿将」","art":{"background":"a1700","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"","text":"面对突如其来的礼物，芦花姐愣在原地，默默接过了我的花束。","art":{"background":"a1700","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「真漂亮……我还是第一次收到别人送的花」","art":{"background":"a1700","sprites":[{"asset":"a4133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「我也是第一次送别人花」","art":{"background":"a1700","sprites":[{"asset":"a4133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「没想到阿将居然这么体贴人……」","art":{"background":"a1700","sprites":[{"asset":"a4134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「真是越来越像个臭男人了」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「你对我的评价，是不是有点太低了啊？」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「没办法呀。毕竟我对你的印象还停留在你小时候」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「可是……唉……算了」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「你要是嫌麻烦的话就扔了吧」","art":{"background":"a1700","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「我才不会呢，怎么可能那么做呢。等会儿我就把花插到收银台那边去」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「嗯。那我就先回去了」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「辛苦了」","art":{"background":"a1700","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"将臣","text":"「那么，今天的晚饭吃什么呢」","art":{"background":"a2966","sprites":[]},"chapter":"4-5"},{"speaker":"","text":"………","art":{"background":"a2966","sprites":[]},"chapter":"4-5"},{"speaker":"芦花","text":"「他送了我……花……」","art":{"background":"a1700","sprites":[{"asset":"a4135","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4136","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「唉……这可麻烦了……你突然来这一手，姐姐我遭不住啊，阿将……」","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「真是想想就觉得难为情……」","art":{"background":"a1700","sprites":[{"asset":"a4138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「但也没想到竟然会这么开心……」","art":{"background":"a1700","sprites":[{"asset":"a4139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"},{"speaker":"芦花","text":"「怎么办啊……这下可真是麻烦了……」","art":{"background":"a1700","sprites":[{"asset":"a4136","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-5"}]