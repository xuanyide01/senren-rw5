[{"speaker":"","text":"在那之后又过去了多久呢？","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"回过神来，院内已经重新被夜色笼罩。","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"那无数的光点，真的像雪花融化一样，消散得无影无踪。","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"原本在宿体中闪烁的光也消失了……一切都如梦似幻……","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"不过……可能是我的心理作用，宿体似乎变得比之前好看了一些。","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"是变得更透明了……还是说变美了呢？","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我也说不太清楚……但在我看来它的美让人过目难忘。","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"芳乃","text":"「终于……平息下来了」","art":{"background":"a1425","sprites":[{"asset":"a2102","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「嗯。宿体中的污秽也成功净化掉了」","art":{"background":"a1425","sprites":[{"asset":"a128","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2102","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「那也就是说，这次是真的……结束了吗」","art":{"background":"a1425","sprites":[{"asset":"a128","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2102","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「我觉得是这样的」","art":{"background":"a1425","sprites":[{"asset":"a1872","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「那个，朝武，关于这个宿体」","art":{"background":"a1425","sprites":[{"asset":"a2102","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"芳乃","text":"「我知道。我会拜托我爸爸，把它好好地供奉在神社里的」","art":{"background":"a1425","sprites":[{"asset":"a1310","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「拜托您了」","art":{"background":"a1425","sprites":[{"asset":"a2798","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「呼……这回真的……解决了吧……」","art":{"background":"a1425","sprites":[{"asset":"a2798","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「是的。抱歉，都怪我太任性了，才把事情闹得这么大」","art":{"background":"a1425","sprites":[{"asset":"a1879","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「没什么。这算不上什么大事」","art":{"background":"a1425","sprites":[{"asset":"a128","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a410","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"芳乃","text":"「丛雨大人说得对。不用这么在意」","art":{"background":"a1425","sprites":[{"asset":"a128","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a471","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"芳乃","text":"「不管怎样，没有造成什么损失就把事情解决了，这已经很好了」","art":{"background":"a1425","sprites":[{"asset":"a128","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a471","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「嗯。只要结果是好的就行」","art":{"background":"a1425","sprites":[{"asset":"a129","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a471","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「所以……本座和芳乃先去把宿体放回原来的地方」","art":{"background":"a1425","sprites":[{"asset":"a137","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a410","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"芳乃","text":"「没错。这个就交给我和丛雨大人吧」","art":{"background":"a1425","sprites":[{"asset":"a137","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a410","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「啊？可是，那个」","art":{"background":"a1425","sprites":[{"asset":"a1872","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「怎么还不明白啊。我们的意思是，让你们两个独处，去亲热个够吧」","art":{"background":"a1425","sprites":[{"asset":"a136","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a410","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"芳乃","text":"「就是啊。你们是不知道，刚才我和丛雨大人装透明人装得多费劲啊」","art":{"background":"a1425","sprites":[{"asset":"a136","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a2799","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「……」","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「将臣……我能遇见你……真是太好了……」","art":{"background":"a2796","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「我能这么幸福，也都是因为遇见了你。现在我简直幸福得浑身发抖」","art":{"background":"a2796","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「应该道谢的是我。现在这一刻是我人生到目前为止……最满足的一刻」","art":{"background":"a2794","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「我会永远喜欢你的」","art":{"background":"a2794","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「我也会永远喜欢你的」","art":{"background":"a2794","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「谢谢你。我真的非常幸福♪」","art":{"background":"a2797","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"这还真是一段羞耻的对话。","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"因为我们完全陷入了二人世界的氛围里……","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"在感谢她们没打扰我们的同时……又觉得尴尬……","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"不对，应该是听着我们对话的她们才觉得尴尬吧。","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"芳乃","text":"「我先去供奉宿体，然后献舞。献舞结束后我关好门窗就回去的」","art":{"background":"a1425","sprites":[{"asset":"a139","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a471","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「虽然应该不会再出什么事了，但本座还是陪芳乃一起去吧」","art":{"background":"a1425","sprites":[{"asset":"a128","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a471","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「对了，安晴应该在等我们回去，你们去把他叫来这里吧」","art":{"background":"a1425","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「哎？可是……」","art":{"background":"a1425","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「笨蛋。本座没有特别的意思。得让他过来吟诵祈祷文才行」","art":{"background":"a1425","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「啊，噢，原来如此」","art":{"background":"a1425","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「我知道了」","art":{"background":"a1425","sprites":[{"asset":"a2800","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我们点了点头，小雨和朝武就到正殿去了。","art":{"background":"a1425","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"剩下的我们俩互相对视……有点难为情地笑了。","art":{"background":"a1425","sprites":[{"asset":"a2801","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"回到家后，焦躁地等待我们归来的安晴叔叔迎了上来。","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"于是我告诉他一切都已顺利解决了。","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"并且转达了小雨的话，请他尽快去吟诵祈祷文，供奉宿体。","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"安晴","text":"「我知道了。这事就交给我吧！」","art":{"background":"a348","sprites":[{"asset":"a359","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"安晴叔叔高兴地点了点头，换好了衣服急忙赶往神社。","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"于是……家里只剩下了我和茉子俩。","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"……我的心情好像比平时更为激动。","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「总算是……把事情顺利解决了」","art":{"background":"a348","sprites":[{"asset":"a2772","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「嗯」","art":{"background":"a348","sprites":[{"asset":"a2772","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"虽然结果可能和茉子最初的设想有些出入。","art":{"background":"a348","sprites":[{"asset":"a2772","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"但是……那些光点确实让我们感受到了温暖。","art":{"background":"a348","sprites":[{"asset":"a2772","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「辛苦你了，将臣」","art":{"background":"a348","sprites":[{"asset":"a2802","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「也辛苦你了，茉子」","art":{"background":"a348","sprites":[{"asset":"a2802","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"这次我们一起露出了爽朗的笑容。","art":{"background":"a348","sprites":[{"asset":"a2802","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「啊，对了。还没庆祝呢」","art":{"background":"a348","sprites":[{"asset":"a2802","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「庆祝？」","art":{"background":"a348","sprites":[{"asset":"a2786","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「真的……辛苦了，茉子……嗯、啾……」","art":{"background":"a348","sprites":[{"asset":"a2786","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「嗯嗯、嗯嗯……！？」","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"兴致高昂的我将茉子拉过来，轻轻地吻了上去。","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"这是个一触即离的庆祝之吻。","art":{"background":"a348","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「嗯啊、啊……嗯，真是的……偷袭也太狡猾啦」","art":{"background":"a348","sprites":[{"asset":"a2803","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「我觉得平时都是你在偷袭我吧」","art":{"background":"a348","sprites":[{"asset":"a2803","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「这个跟那个是两码事。这种时候搞偷袭……太狡猾了」","art":{"background":"a348","sprites":[{"asset":"a2804","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「对不起。做得有点过火了吗？」","art":{"background":"a348","sprites":[{"asset":"a2805","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「不是那个意思……就是……」","art":{"background":"a348","sprites":[{"asset":"a2804","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「你知道吗？在经历了危险之后……性欲是会增加的哦」","art":{"background":"a348","sprites":[{"asset":"a2806","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「这……我还真听说过」","art":{"background":"a348","sprites":[{"asset":"a2806","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"所以我才会兴致勃发，忍不住吻了茉子。","art":{"background":"a348","sprites":[{"asset":"a2806","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我刚这么想着……茉子的动作就开始扭捏起来。","art":{"background":"a348","sprites":[{"asset":"a2806","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「呜……呜呜呜……啊啊，真是的……原来就已经很兴奋了，这时候还被亲了一下……」","art":{"background":"a348","sprites":[{"asset":"a2803","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「开关……要打开啦」","art":{"background":"a348","sprites":[{"asset":"a2807","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「开关……是指什么开关？」","art":{"background":"a348","sprites":[{"asset":"a2807","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「还、还能是什么……做爱开关……？」","art":{"background":"a348","sprites":[{"asset":"a2808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「……做爱开关……」","art":{"background":"a348","sprites":[{"asset":"a2808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"难为情的茉子突然说出了这样的话。","art":{"background":"a348","sprites":[{"asset":"a2808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"虽然她的眼神飘忽不定……但我能从中感受到她那浓烈的热情。","art":{"background":"a348","sprites":[{"asset":"a2808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"看到茉子红着脸，眼神火热……我的身体里好像也燃起一团火……","art":{"background":"a348","sprites":[{"asset":"a2808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我反复念叨着“……做爱开关……”，盯着扭扭捏捏的茉子。","art":{"background":"a348","sprites":[{"asset":"a2808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「茉、茉子！」","art":{"background":"a348","sprites":[{"asset":"a2808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「在、在！？」","art":{"background":"a348","sprites":[{"asset":"a2809","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「刚刚……虽然事情已经顺利结束了，但一开始它闹得很凶吧？」","art":{"background":"a348","sprites":[{"asset":"a2809","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「嗯……是的」","art":{"background":"a348","sprites":[{"asset":"a2810","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「有没有哪里受伤？」","art":{"background":"a348","sprites":[{"asset":"a2811","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「受伤？没有，没伤到什么地方……」","art":{"background":"a348","sprites":[{"asset":"a2812","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「可是你想啊，在自己没意识到的情况下受了伤，也是有可能的吧？」","art":{"background":"a348","sprites":[{"asset":"a2812","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「比如自己看不见的地方。所以能让我……帮你看看吗？」","art":{"background":"a348","sprites":[{"asset":"a2812","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「我想仔细检查一下你有没有受伤」","art":{"background":"a348","sprites":[{"asset":"a2812","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「啊？检查的意思是……各个部位都要看吗？」","art":{"background":"a348","sprites":[{"asset":"a2813","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「不但要看，还要摸一摸仔细检查」","art":{"background":"a348","sprites":[{"asset":"a2813","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「……你、你的眼神……有点吓人」","art":{"background":"a348","sprites":[{"asset":"a2814","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「我一直都是这样啦」","art":{"background":"a348","sprites":[{"asset":"a2814","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「也就是说，你平时一直都在想这些下流的事吗？」","art":{"background":"a348","sprites":[{"asset":"a2811","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「我平时也一直在为我最爱的女人着想！这有什么错！」","art":{"background":"a348","sprites":[{"asset":"a2811","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「哈呜……居、居然这么坦率地承认了……真伤脑筋」","art":{"background":"a348","sprites":[{"asset":"a2804","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「抱歉。可是……我的开关也已经打开了」","art":{"background":"a348","sprites":[{"asset":"a2804","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「……做爱开关吗？」","art":{"background":"a348","sprites":[{"asset":"a2815","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「是的，做爱开关。已经是ＯＮ了。没办法拨回ＯＦＦ了」","art":{"background":"a348","sprites":[{"asset":"a2815","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「呃、啊……呜呜……你这么热切地看着我……心脏……跳得好快」","art":{"background":"a348","sprites":[{"asset":"a2815","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我抱住了茉子，在她耳边呢喃。","art":{"background":"a348","sprites":[{"asset":"a2815","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「那，那里也让我好好检查一下吧」","art":{"background":"a348","sprites":[{"asset":"a2816","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「——！」","art":{"background":"a348","sprites":[{"asset":"a2817","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"茉子的身子震了一下。","art":{"background":"a348","sprites":[{"asset":"a2817","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「等、等一下」","art":{"background":"a348","sprites":[{"asset":"a2818","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「啊？怎么了……？难道说，你不愿意？」","art":{"background":"a348","sprites":[{"asset":"a2818","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「那个……我当然很愿意啊。可是，这身衣服一直是祓禊的时候才穿的，在我心里是神圣的衣物……」","art":{"background":"a348","sprites":[{"asset":"a2804","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「穿着这种衣服做的话……感觉像在触犯禁忌……」","art":{"background":"a348","sprites":[{"asset":"a2819","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「可是我想犯禁忌的开关也打开了」","art":{"background":"a348","sprites":[{"asset":"a2819","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「哎哎哎哎……可是、可是……那、那么让我来满足你……这样如何？」","art":{"background":"a348","sprites":[{"asset":"a2820","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「满足？」","art":{"background":"a348","sprites":[{"asset":"a2820","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「我姑且也算是忍者。这种知识还是有的」","art":{"background":"a348","sprites":[{"asset":"a2821","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「而且呢，就是，那什么……一直都是我被你弄得很舒服。所以我……也学习了一些让你舒服的方法」","art":{"background":"a348","sprites":[{"asset":"a2822","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「学习……」","art":{"background":"a348","sprites":[{"asset":"a2822","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「我觉得……差不多到了该展示学习成果的时候了，你觉得如何？」","art":{"background":"a348","sprites":[{"asset":"a2823","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「觉、觉得如何……这还用问吗……」","art":{"background":"a348","sprites":[{"asset":"a2823","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「拜托你了！！」","art":{"background":"a348","sprites":[{"asset":"a2823","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"}]