[{"speaker":"将臣","text":"「……好，大概就这样了吧」","art":{"background":"a1","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我仔细地用刷子往炭火烤出来的仙贝上涂抹酱汁。","art":{"background":"a1","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"终于完成了。","art":{"background":"a1","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"炭火很旺，热得我稍微出了点汗。","art":{"background":"a1","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"但我接下来必须快速给仙贝翻几次面，现在还不能掉以轻心。","art":{"background":"a1","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"一开始我凭感觉就能做得差不多，但是认真学起来才发现其实并没有那么容易。","art":{"background":"a1","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"就这样，我一边抽时间到店里请教做仙贝的诀窍，一边自己练手。","art":{"background":"a1","sprites":[]},"chapter":"6-4"},{"speaker":"芦花的父亲","text":"「……嗯……嗯。火候大概就控制在这个程度」","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"芦花的父亲","text":"「一开始你的水平就不错，现在这样已经完全可以拿出去卖了」","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「真的吗，多谢夸奖」","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"最近我一直忙着研究仙贝。","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"现在得到了认可，这让我很开心。","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"而且……","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"小春","text":"「嗯，好吃！啊……真幸福……都停不下来了」","art":{"background":"a4155","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"小春说她只是尝尝味道，结果却吃了这么多。","art":{"background":"a4155","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"看来是真的很好吃……","art":{"background":"a4155","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我就是为了看到她的这副笑容才努力到了今天的。","art":{"background":"a4155","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"现在的我光是看着她的这副表情就很幸福了。","art":{"background":"a4155","sprites":[]},"chapter":"6-4"},{"speaker":"小春","text":"「这醇厚的香味可真是……嗯……」","art":{"background":"a4155","sprites":[]},"chapter":"6-4"},{"speaker":"芦花","text":"「谢谢你，阿将。你真是太努力了」","art":{"background":"a1677","sprites":[{"asset":"a990","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「而且多亏你帮我跟玄十郎先生打了个招呼，后面的事情我都办得很顺利」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「这没什么的，别太在意」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「最重要的是，你跟他谈得怎么样了？」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「总之他答应可以先尝尝，尝过以后再决定」","art":{"background":"a1677","sprites":[{"asset":"a1571","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「之后玄十郎先生教了我不少事情，还把志那都庄以外的旅馆介绍给我」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「要是顺利的话，销路应该可以比想象中更广」","art":{"background":"a1677","sprites":[{"asset":"a991","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「噢！那可真是恭喜了」","art":{"background":"a1677","sprites":[{"asset":"a991","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"但芦花姐却苦笑着摇了摇头。","art":{"background":"a1677","sprites":[{"asset":"a1577","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「我们还没站上起跑线呢。真要卖的话，接下来要做的工作才是最重要的」","art":{"background":"a1677","sprites":[{"asset":"a992","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「是、是吗……」","art":{"background":"a1677","sprites":[{"asset":"a992","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"真能卖出去了才能算是成功。","art":{"background":"a1677","sprites":[{"asset":"a992","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"现在的我只能看见眼前的东西，没有看到后续。","art":{"background":"a1677","sprites":[{"asset":"a992","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「所以呢，销量怎样就要看你烤仙贝的技术水平了，交给你啦」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「我、我会努力的」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「肯定没问题的啦，你看你都做得这么好吃了！」","art":{"background":"a1677","sprites":[{"asset":"a989","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「而且口味也越来越多了。这个味噌味的好香……啊……真是太幸福了」","art":{"background":"a1677","sprites":[{"asset":"a1005","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"能看到小春这么高兴，也不枉我一番辛苦了。","art":{"background":"a1677","sprites":[{"asset":"a1005","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花的父亲","text":"「不过……这年头的客人会喜欢酱油味和味噌味吗？」","art":{"background":"a1677","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「唔……带点甜味的粗糖味也算经典口味之一吧？」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「我倒更喜欢那种像雪一样抹上一层砂糖的」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花的父亲","text":"「噢，那种可以用和三盆来做。拿盐做基础调味，然后调整好甜味和咸味……」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「嗯，肯定很好吃」","art":{"background":"a1677","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「定口味需要花不少时间吗？」","art":{"background":"a1677","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花的父亲","text":"「不，不需要多久」","art":{"background":"a1677","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「那最开始先做出酱油味、味噌味和和三盆味三种口味怎样？」","art":{"background":"a1677","sprites":[{"asset":"a991","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花的父亲","text":"「嗯，就这样吧」","art":{"background":"a1677","sprites":[{"asset":"a991","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「那我就这样通知旅馆了……另外，可以的话我希望他们能针对口味做一个小调查」","art":{"background":"a1677","sprites":[{"asset":"a2149","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"芦花","text":"「不过要拜托他们这个恐怕不简单。用常见的那种准备纸笔让想写的客人自己写的方法的话，他们应该会答应吧……」","art":{"background":"a1677","sprites":[{"asset":"a1684","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"芦花姐嘀咕着，像是在思考仙贝的销路。","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我可不能让芦花姐的努力白费。","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"而且，为了能看到小春的笑容……我得努力做出好吃的仙贝才行！","art":{"background":"a1677","sprites":[]},"chapter":"6-4"},{"speaker":"小春","text":"「和三盆糖味啊……好期待，一定很好吃吧」","art":{"background":"a1677","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哥哥快点做给我吃」","art":{"background":"a1677","sprites":[{"asset":"a1687","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「别说得那么简单，真做起来可没那么容易」","art":{"background":"a1677","sprites":[{"asset":"a1687","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「……但我可以期待一下吧？」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「嗯，交给我吧」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「嘿嘿，我真的好期待啊」","art":{"background":"a1677","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「哟，生意不错嘛」","art":{"background":"a1677","sprites":[{"asset":"a60","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「廉太郎？」","art":{"background":"a1677","sprites":[{"asset":"a60","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「我来找你玩了」","art":{"background":"a1677","sprites":[{"asset":"a96","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「你少来妨碍我们工作，快走开」","art":{"background":"a1677","sprites":[{"asset":"a3019","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a96","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「我才没打算妨碍。话说，我听人说了，你们开始卖咖啡了？」","art":{"background":"a1677","sprites":[{"asset":"a3019","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a60","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「咦，你还没喝过吗？」","art":{"background":"a1677","sprites":[{"asset":"a3019","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a60","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「嗯，最近没什么机会来」","art":{"background":"a1677","sprites":[{"asset":"a3019","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a85","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「所以呢，那边的服务员，给我来杯咖啡」","art":{"background":"a1677","sprites":[{"asset":"a3019","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a934","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「……好的，这位客人请稍等」","art":{"background":"a1677","sprites":[{"asset":"a4075","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a934","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「啊，对了，要不要顺便吃点仙贝？」","art":{"background":"a1677","sprites":[{"asset":"a934","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「仙贝？现在还卖这种东西了？」","art":{"background":"a1677","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「不，现在还没。以后倒是可能会变成本店的新商品」","art":{"background":"a1677","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「是吗，那可真是有意思。行吧来一份」","art":{"background":"a1677","sprites":[{"asset":"a85","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「不过既然要吃仙贝，那还得来点喝的啊。服务员，咖啡还没好吗？」","art":{"background":"a1677","sprites":[{"asset":"a1023","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「廉哥，你就不能安安静静地等着吗？来了，让您久等了，这是您点的咖啡」","art":{"background":"a1677","sprites":[{"asset":"a1026","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「噢，好香。那我喝了……（吸）」","art":{"background":"a1677","sprites":[{"asset":"a85","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「哎呀，这个味道，确实还不错啊」","art":{"background":"a1677","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哼哼哼，怎么样，认输了吧？」","art":{"background":"a1677","sprites":[{"asset":"a989","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a87","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「什么认输啊，又没跟你比试什么，而且又不是你做的，你有什么好得意的啊」","art":{"background":"a1677","sprites":[{"asset":"a989","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a933","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「不要挺着你那根本没有的胸部，平胸妹」","art":{"background":"a1677","sprites":[{"asset":"a989","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1023","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「又、又说我平胸妹——」","art":{"background":"a1677","sprites":[{"asset":"a4193","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「冷静点，小春。再闹起来的话，又会像上次一样被芦花姐警告的」","art":{"background":"a1677","sprites":[{"asset":"a4193","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「唔……」","art":{"background":"a1677","sprites":[{"asset":"a1701","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「廉太郎你也别老是缠着她了，跟我说说仙贝怎么样」","art":{"background":"a1677","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「行吧行吧」","art":{"background":"a1677","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"廉太郎耸了耸肩，开始嚼仙贝。","art":{"background":"a1677","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「嗯，嗯……嗯，好吃，挺好吃的」","art":{"background":"a1677","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「是、是吗……那就好……」","art":{"background":"a1677","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哼哼哼，这个可是哥哥做的哦，认输了吧」","art":{"background":"a1677","sprites":[{"asset":"a3701","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「都说了你有什么好——」","art":{"background":"a1677","sprites":[{"asset":"a105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「咦？这个真的是你做的？」","art":{"background":"a1677","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「嗯」","art":{"background":"a1677","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「真的假的……真让人惊讶。你还真有天赋，真好吃」","art":{"background":"a1677","sprites":[{"asset":"a62","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"廉太郎不会对我说客气话。","art":{"background":"a1677","sprites":[{"asset":"a62","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"他应该是真的觉得很好吃。","art":{"background":"a1677","sprites":[{"asset":"a62","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「我自己也很吃惊」","art":{"background":"a1677","sprites":[{"asset":"a62","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"廉太郎","text":"「我不是恭维你，是真的好吃」","art":{"background":"a1677","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「既然你跟叔叔都这么说，我也算有点自信了」","art":{"background":"a1677","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哼……哥哥，我夸就不行吗？」","art":{"background":"a1677","sprites":[{"asset":"a1701","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「不是不行，看到你能这么开心，我当然高兴」","art":{"background":"a1677","sprites":[{"asset":"a1701","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「但是你这么善良，有时我会觉得你是不是在照顾我的感受」","art":{"background":"a1677","sprites":[{"asset":"a1701","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「事关仙贝，我才不会那样做呢」","art":{"background":"a1677","sprites":[{"asset":"a4075","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哥哥你可以更有自信一点」","art":{"background":"a1677","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「……是吗，谢谢你了，小春」","art":{"background":"a1677","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"我不由得摸了摸小春的脑袋。","art":{"background":"a1677","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「啊……嘿嘿……嘿嘿嘿……」","art":{"background":"a1677","sprites":[{"asset":"a4079","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"尽管小春有些惊讶，但她还是开心地笑了。","art":{"background":"a1677","sprites":[{"asset":"a4079","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"接下来我在做日常工作的同时还练了练烤仙贝，今天一天就这样平安结束了。","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"叔叔还在调整和三盆味仙贝的味道，不过试制品已经相当好吃了。","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"那柔和的甜味，加上掺杂其中的轻微咸味，这种口味与酱油味还有味噌味截然不同，我觉得恰到好处。","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"小春尝了之后的感想可就没那么平淡了。","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"小春","text":"「太好吃了！再烤几块！哥哥！」","art":{"background":"a119","sprites":[{"asset":"a1704","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"一开始她兴奋得不得了，直到芦花姐笑盈盈地强调说这样会亏钱，她才终于冷静了下来。","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"接下来就看我能烤得有多完美了！","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「啊呀……今天也好辛苦啊」","art":{"background":"a4158","sprites":[]},"chapter":"6-4"},{"speaker":"小春","text":"「嗯，今天也很忙啊。不过……奇怪的是我竟然感觉很满足」","art":{"background":"a4158","sprites":[{"asset":"a83","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「这是因为你吃了很多试制品仙贝吧？」","art":{"background":"a4158","sprites":[{"asset":"a83","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「啊，对哦……有道理。嘿嘿嘿……」","art":{"background":"a4158","sprites":[{"asset":"a3733","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「这都要怪你把仙贝做得那么好吃」","art":{"background":"a4158","sprites":[{"asset":"a95","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「没办法啊，因为我喜欢看你开开心心吃仙贝的样子啊」","art":{"background":"a4158","sprites":[{"asset":"a95","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「喜、喜欢——！？」","art":{"background":"a4158","sprites":[{"asset":"a4197","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「你吃的时候表情真的很幸福」","art":{"background":"a4158","sprites":[{"asset":"a4197","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「身为下厨的人，看见这样的表情是最开心的。所以我喜欢看你吃我做的东西」","art":{"background":"a4158","sprites":[{"asset":"a4197","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「是、是吗……喜欢……那我就再多吃点吧」","art":{"background":"a4158","sprites":[{"asset":"a4126","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「不过你还是得注意点，不然万一胖了我可管不着」","art":{"background":"a4158","sprites":[{"asset":"a4126","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「呜……哥哥又在说欺负人的话了……」","art":{"background":"a4158","sprites":[{"asset":"a4164","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「抱歉抱歉，不小心就说了」","art":{"background":"a4158","sprites":[{"asset":"a4164","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「但是，你说得对……真要长肉的话，要是长在胸部就好了……唉……」","art":{"background":"a4158","sprites":[{"asset":"a4198","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「……你在这方面有自卑吗？」","art":{"background":"a4158","sprites":[{"asset":"a4198","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「廉哥老是取笑我，今天他还说我平、平、平、平胸妹……」","art":{"background":"a4158","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a4158","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"有那么平吗？","art":{"background":"a4158","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"大虽然不大，可也没到平胸的地步。","art":{"background":"a4158","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「今后还有成长的潜力的」","art":{"background":"a4158","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「希望如此……哥哥，你是不是也觉得女孩子没有胸不行的？」","art":{"background":"a4158","sprites":[{"asset":"a3263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「没这回事啊，可以当田径选手、游泳选手和芭蕾舞者」","art":{"background":"a4158","sprites":[{"asset":"a3263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「全都跟我没关系啊」","art":{"background":"a4158","sprites":[{"asset":"a78","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「……是、是哦……也是，抱歉」","art":{"background":"a4158","sprites":[{"asset":"a78","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哥、哥哥……你更喜欢大的吗？」","art":{"background":"a4158","sprites":[{"asset":"a4199","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「我？我啊……嗯……也不是没兴趣？」","art":{"background":"a4158","sprites":[{"asset":"a4199","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"比如大胸的触感如何，摇起来是什么样的，我都挺在意。","art":{"background":"a4158","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"正常的男性应该大都想去享受巨乳。","art":{"background":"a4158","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"但就算这样，也并非不是巨乳就不喜欢。","art":{"background":"a4158","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"毕竟我现在就觉得小春……","art":{"background":"a4158","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a4158","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「要论喜不喜欢的话，还是有比胸部更重要的东西的」","art":{"background":"a4158","sprites":[{"asset":"a4111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哥哥……」","art":{"background":"a4158","sprites":[{"asset":"a4200","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「噗……哈哈，哈哈哈哈哈！一脸认真地说胸部胸部的……哈哈哈哈」","art":{"background":"a4158","sprites":[{"asset":"a3321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「是、是你自己问的吧！」","art":{"background":"a4158","sprites":[{"asset":"a3321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「对不起。不过哥哥你的表情真的很认真……」","art":{"background":"a4158","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「我又不是在开玩笑」","art":{"background":"a4158","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哈哈哈哈，所以就更好笑了。呼……呼……真有意思」","art":{"background":"a4158","sprites":[{"asset":"a83","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「跟哥哥在一起就是有意思。而且……也可以跟你坦率地聊很多东西」","art":{"background":"a4158","sprites":[{"asset":"a64","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「你不会跟廉太郎聊吗？」","art":{"background":"a4158","sprites":[{"asset":"a64","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「那个笨蛋哥哥老是挖苦我，我才不想跟他聊」","art":{"background":"a4158","sprites":[{"asset":"a2978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"廉太郎挖苦人的模样……很简单就能想象出来。","art":{"background":"a4158","sprites":[{"asset":"a2978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「我说，哥哥……除此之外我还有件事想问你」","art":{"background":"a4158","sprites":[{"asset":"a3751","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「什么？」","art":{"background":"a4158","sprites":[{"asset":"a3751","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「我……有没有稍微长大了一点？」","art":{"background":"a4158","sprites":[{"asset":"a3257","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「长大？什么意思？」","art":{"background":"a4158","sprites":[{"asset":"a3257","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「我……以前一直很羡慕姐姐跟哥哥……羡慕你们能和廉哥在一起玩」","art":{"background":"a4158","sprites":[{"asset":"a2976","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「那时我还小，还无法加入你们……所以一直想长大」","art":{"background":"a4158","sprites":[{"asset":"a2976","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「哥哥你也说过我们是铁杆四人组吧？」","art":{"background":"a4158","sprites":[{"asset":"a3258","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「所以……我在想我有没有长大一点」","art":{"background":"a4158","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「不必担心，你已经长大了」","art":{"background":"a4158","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「而且长得很可爱，我可以保证」","art":{"background":"a4158","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"小春","text":"「……是、是吗……嘿嘿……谢谢你，哥哥」","art":{"background":"a4158","sprites":[{"asset":"a4132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"小春羞涩地笑了。","art":{"background":"a4158","sprites":[{"asset":"a4132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"看着她这副模样，我的心跳又像上次一样加速了。","art":{"background":"a4158","sprites":[{"asset":"a4132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"啊……我就知道。","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"身体的反应不会骗人。","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「（小春长大了）」","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「（已经长成了一个……足以吸引我的、有魅力的女孩子了）」","art":{"background":"a119","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"不过这种话我还是说不出口啊……","art":{"background":"a119","sprites":[]},"chapter":"6-4"}]