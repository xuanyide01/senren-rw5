[{"speaker":"将臣","text":"「好，那我走了」","art":{"background":"a2764","sprites":[]},"chapter":"6-1"},{"speaker":"蕾娜","text":"「我走了」","art":{"background":"a2764","sprites":[{"asset":"a695","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"心子","text":"「慢走啊」","art":{"background":"a2764","sprites":[{"asset":"a52","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「路上小心」","art":{"background":"a2764","sprites":[{"asset":"a52","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a90","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「早上好，哥哥！」","art":{"background":"a49","sprites":[{"asset":"a891","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「小春？」","art":{"background":"a49","sprites":[{"asset":"a891","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"外公和猪谷阿姨目送我们走出旅馆，这时小春开开心心地跑了过来。","art":{"background":"a49","sprites":[{"asset":"a891","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"蕾娜","text":"「小春，早上好」","art":{"background":"a49","sprites":[{"asset":"a705","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a891","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「嗯，蕾娜学姐早上好」","art":{"background":"a49","sprites":[{"asset":"a705","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2084","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「早上好……我说，今天你这是怎么了？」","art":{"background":"a49","sprites":[{"asset":"a705","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2084","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「我想和哥哥一起去上学」","art":{"background":"a49","sprites":[{"asset":"a1652","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「你有什么要办的事吗？」","art":{"background":"a49","sprites":[{"asset":"a1652","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「不，不是的」","art":{"background":"a49","sprites":[{"asset":"a3881","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「只是想跟你一起上学而已……你不愿意吗？」","art":{"background":"a49","sprites":[{"asset":"a889","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「没这回事……可这种事情还是头一次吧？」","art":{"background":"a49","sprites":[{"asset":"a889","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「啊，嗯。但我真的没什么别的意思，只是临时起意想和你一起走」","art":{"background":"a49","sprites":[{"asset":"a1652","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"蕾娜","text":"「……」","art":{"background":"a49","sprites":[{"asset":"a714","position":"右奥","x":280,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a3881","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-1"},{"speaker":"蕾娜","text":"「噢，原来如此，将臣，我先走了」","art":{"background":"a49","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「啊？」","art":{"background":"a49","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"蕾娜","text":"「我忘了有件小事要办，再见再见，嘻嘻」","art":{"background":"a49","sprites":[{"asset":"a695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「啊，嗯，回见……」","art":{"background":"a49","sprites":[{"asset":"a695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"感觉她最后笑的那一下好奇怪啊。","art":{"background":"a49","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"难不成是在照顾我……","art":{"background":"a49","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「她是不是产生了什么奇怪的误会？」","art":{"background":"a49","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「没、没事的……别在意这些。那个……毕、毕竟有可能……不是误会……」","art":{"background":"a49","sprites":[{"asset":"a4172","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……啊？」","art":{"background":"a49","sprites":[{"asset":"a4172","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「……没、没什么！什么都喵有，什么都喵有！不要在意！」","art":{"background":"a49","sprites":[{"asset":"a4087","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「再不快点走就要迟到了，哥哥！」","art":{"background":"a49","sprites":[{"asset":"a4089","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「啊，嗯……」","art":{"background":"a49","sprites":[{"asset":"a4089","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「……嘻嘻♪」","art":{"background":"a493","sprites":[{"asset":"a1215","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「今天你心情不错嘛」","art":{"background":"a493","sprites":[{"asset":"a1215","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「有吗？」","art":{"background":"a493","sprites":[{"asset":"a4173","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「嗯，怎么说呢……这种问题问起来不太礼貌……」","art":{"background":"a493","sprites":[{"asset":"a4173","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「什么？」","art":{"background":"a493","sprites":[{"asset":"a2084","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「昨天你说的那个……女、女孩子的烦恼……解决了吗？」","art":{"background":"a493","sprites":[{"asset":"a2084","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「啊，嗯，那个已经没问题了，我和姐姐聊过以后解决了」","art":{"background":"a493","sprites":[{"asset":"a2084","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是吗，那就好」","art":{"background":"a493","sprites":[{"asset":"a2084","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「抱歉让你担心了。另外……谢谢你，嘿嘿」","art":{"background":"a493","sprites":[{"asset":"a1633","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a493","sprites":[{"asset":"a1633","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「感觉你变开朗多了……看上去好像很开心的样子」","art":{"background":"a493","sprites":[{"asset":"a1633","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「有、有吗？」","art":{"background":"a493","sprites":[{"asset":"a2999","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「也不是说以前你很阴暗，就是感觉你今天格外开心」","art":{"background":"a493","sprites":[{"asset":"a2999","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「……嗯，可能是跟姐姐聊过以后，我放下了负担吧」","art":{"background":"a493","sprites":[{"asset":"a1655","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是吗」","art":{"background":"a493","sprites":[{"asset":"a1655","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「总之，既然事情往乐观的方向发展了那就好」","art":{"background":"a493","sprites":[{"asset":"a1655","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「嗯」","art":{"background":"a493","sprites":[{"asset":"a891","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"小春开心地笑着看向我。","art":{"background":"a493","sprites":[{"asset":"a891","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"她那爽朗的笑容，我看着都觉得高兴。","art":{"background":"a493","sprites":[{"asset":"a891","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「那我们走吧」","art":{"background":"a493","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"就这样，小春跟在我身后走了起来。","art":{"background":"a493","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"她走几步就会小跑一下追上我。","art":{"background":"a493","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「抱歉，是不是我走太快了？真对不起」","art":{"background":"a493","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「不，是我走得太慢了。哥哥不必在意」","art":{"background":"a493","sprites":[{"asset":"a1632","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「你也不用太在意我」","art":{"background":"a493","sprites":[{"asset":"a1632","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「现在跟以前已经不一样了，我是可以好好配合你的速度走的」","art":{"background":"a493","sprites":[{"asset":"a896","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"小春","text":"「那……可以这样吗？」","art":{"background":"a493","sprites":[{"asset":"a4174","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……啊？」","art":{"background":"a493","sprites":[{"asset":"a4174","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"小春忽然拉住了我的袖子。","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我低头一看，她用手指捏住了我的袖管。","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「这、这样距离就不会拉开了……而且，这样哥哥也更容易把握我的速度……」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「要、要是不喜欢的话一定要跟我说哦！」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「也没有不喜欢……就是感觉挺害羞的……哈哈哈」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「可、可是，我觉得这样更不容易分开」","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「而且，不管怎么说，要牵、牵、牵手……我还是做不到的，心脏会爆炸……」","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"看见小春红着脸，低着头，牵着我的袖管……我的心跳突然加速了。","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我觉得她很可爱。","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"之前我也觉得她很可爱……但现在的这种感觉似乎和以前存在着本质区别。","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「那、那……我们走吧」","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「啊，嗯……再不走就要迟到了」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「……」","art":{"background":"a4178","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「跟你这样走着……就会回想起以前」","art":{"background":"a4178","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「啊？」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「你在哭的时候我安慰着你，等你哭完以后和你一起走的时候……你总会牵着我的手」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「有、有吗？」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「有啊。可能你是怕我扔下你一个吧，一直紧紧地握着我的手」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「有过这种事情吗？我、我完全没印象……」","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「没办法，那时你还小嘛」","art":{"background":"a4175","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「我们只差一岁啊」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「哈哈哈，但是我确实没骗你，以前真的是这样的」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「是这样吗……唔……」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"小春似乎想不起来，羞答答地轻声嘀咕着。","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"只知道哭的小孩子可不会露出这样的表情。","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"回想起以前，那时被她牵着袖管我也完全无所谓。","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"可是，现在这是怎么了？为什么我的心会跳得这么快……","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「好了，赶紧走吧，走得这么慢的话真的会迟到的」","art":{"background":"a4176","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「啊，嗯」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我们一起走了起来。","art":{"background":"a4178","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"尽管动作有些生疏，但她的手和我的手腕依然牵在一起。","art":{"background":"a4178","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「嘿嘿……嘿嘿嘿……嘻嘻嘻」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「嗯？」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"小春","text":"「没什么。嘿嘿嘿」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a4177","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「好了，走吧」","art":{"background":"a599","sprites":[]},"chapter":"6-1"},{"speaker":"廉太郎","text":"「今天你也要上班吗？」","art":{"background":"a599","sprites":[{"asset":"a745","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「不是，今天要跟外公锻炼」","art":{"background":"a599","sprites":[{"asset":"a745","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"廉太郎","text":"「那么苦的锻炼，你也真坚持得下来」","art":{"background":"a599","sprites":[{"asset":"a730","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「这么久了，我早就习惯了。何况最近我减少了锻炼的次数」","art":{"background":"a599","sprites":[{"asset":"a730","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「而且之前辛辛苦苦练出了肌肉，怎么能简简单单让它们变成脂肪呢」","art":{"background":"a599","sprites":[{"asset":"a730","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"廉太郎","text":"「啊……确实」","art":{"background":"a599","sprites":[{"asset":"a504","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"廉太郎","text":"「要是突然停下来了，确实很容易胖」","art":{"background":"a599","sprites":[{"asset":"a740","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「嗯，所以我要走了，你一起来吗？」","art":{"background":"a599","sprites":[{"asset":"a740","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"廉太郎","text":"「绝对不去」","art":{"background":"a599","sprites":[{"asset":"a1498","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「哈哈，如果你改变了主意再叫我吧。再见」","art":{"background":"a599","sprites":[{"asset":"a1498","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"廉太郎","text":"「嗯，再见」","art":{"background":"a599","sprites":[{"asset":"a499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"就这样，今天的剑道锻炼开始了。","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我需要用竹刀依次进行素振、击面切返、冲击训练","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"训练内容没怎么变，但时长跟以前完全不一样了。","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"毕竟前段时间我把自己这幅身子骨给累坏了。","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「好，今天就到这里吧」","art":{"background":"a580","sprites":[{"asset":"a569","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「谢谢」","art":{"background":"a580","sprites":[{"asset":"a569","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「对了，兼职那边怎么样？」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「嗯，很顺利。至少我没有拖后腿……吧」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「就是芦花的店吧，听说挺热闹的」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「毕竟芦花姐很努力嘛」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「要是外公有什么想吃的，我去给你买来？」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「我想想。偶尔吃点团子应该不错」","art":{"background":"a2768","sprites":[{"asset":"a602","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「但是如果要吃的话，必须给所有员工都准备一份」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「噢，没错」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"感觉量会很大……提前请芦花姐准备的话，她能不能做给我呢？","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「你今天准备直接回去吗？」","art":{"background":"a2768","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「倒也没什么事要做……」","art":{"background":"a2768","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我准备去一趟芦花姐的店。不是去工作，只是练得有点累了，想补充点糖分」","art":{"background":"a2768","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「好，那代我向芦花问好」","art":{"background":"a2768","sprites":[{"asset":"a772","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「另外，不要回来得太晚」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我知道的」","art":{"background":"a2768","sprites":[{"asset":"a603","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「晚上好」","art":{"background":"a1700","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"进入店里，我听见了一种陌生的声音。","art":{"background":"a1700","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"不过我知道这声音出自哪里。","art":{"background":"a1700","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"这……是三味线吗？","art":{"background":"a1700","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「嗯……咦？阿将，欢迎」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……刚才是你在弹三味线？」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「噢，你说这个啊，我是前段时间开始练的」","art":{"background":"a1700","sprites":[{"asset":"a990","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是吗？」","art":{"background":"a1700","sprites":[{"asset":"a990","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「还很生疏，不太想让人听见，所以一直没有弹」","art":{"background":"a1700","sprites":[{"asset":"a1688","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是吗，你练了一段时间啊」","art":{"background":"a1700","sprites":[{"asset":"a1688","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「只是在没客人的时候才练。啊，另外还得是小春和你都不在的时候我才会练」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「毕竟还在练的时候让人听感觉很羞耻……」","art":{"background":"a1700","sprites":[{"asset":"a1004","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「有吗？我倒觉得你弹得不错」","art":{"background":"a1700","sprites":[{"asset":"a1004","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「还不行呢，老是被骂」","art":{"background":"a1700","sprites":[{"asset":"a1017","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「被谁骂？对哦，你三味线是跟谁学的？」","art":{"background":"a1700","sprites":[{"asset":"a1017","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「在旅馆工作的人里面，有个人以前做过艺伎，我请那个人教我的」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是吗……还有人做过艺伎？」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「也是机缘巧合，那个人改行来旅馆工作，跑到这个小镇来了」","art":{"background":"a1700","sprites":[{"asset":"a1009","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「我呢，就是觉得要是能弹得好的话，说不定能用它招揽客人呢」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「可这个还真挺难的……唉……」","art":{"background":"a1700","sprites":[{"asset":"a3020","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我觉得已经很厉害了，芦花姐。感觉弹三味线的你很帅」","art":{"background":"a1700","sprites":[{"asset":"a3020","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「谢谢。不过……比起夸我帅气，我还是更喜欢你夸我可爱，唉……」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「对了，学校那边怎么样？有没有发生什么事情？比如……小、小春那边」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「小春？她的话不必担心」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「她说跟你谈过之后就想通了，笑得可开朗了」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「今天早上她也跑来跟我一起去上学，完全没有在逞强的感觉」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「是、是吗，她跟你一起上学啊……没想到小春这么主动，是我太小看她了……」","art":{"background":"a1700","sprites":[{"asset":"a3020","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「话说回来，大人跟学生的差距真的是太大了……工作又不能丢下不管……感觉真的要输给她了」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……嗯？」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「不不不，不能在这种时候放弃。都说好了，我要加油……好」","art":{"background":"a1700","sprites":[{"asset":"a1579","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「你在说什么？」","art":{"background":"a1700","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「没什么啦」","art":{"background":"a1700","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「对了，你要喝点什么吗？」","art":{"background":"a1700","sprites":[{"asset":"a1009","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「啊，嗯。谢谢，给我来杯咖啡来份布丁吧」","art":{"background":"a1700","sprites":[{"asset":"a1009","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「好的，请稍等」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「另外……再加一份三味线演奏的背景音乐」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「啊，这……不行呀，我这水平还没法拿出来献丑」","art":{"background":"a1700","sprites":[{"asset":"a4179","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「可这种东西不是让人听了才会进步得更快吗？」","art":{"background":"a1700","sprites":[{"asset":"a4179","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「这……嗯……话是这么说……」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我想听你弹三味线」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「我说，你别这样一脸认真啊……你这样看着我……我还怎么拒绝」","art":{"background":"a1700","sprites":[{"asset":"a4180","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「太棒啦！」","art":{"background":"a1700","sprites":[{"asset":"a4180","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「别急，先让我先去准备咖啡和布丁，你等一下」","art":{"background":"a1700","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"芦花姐似乎还不够熟练。","art":{"background":"a119","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"她的动作有些僵硬，但还是流畅地弹起了三味线。","art":{"background":"a119","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"确实好帅啊……而且也挺适合店里的氛围。","art":{"background":"a119","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"如果芦花姐真的在店里给客人弹奏三味线……肯定能招揽更多客人。","art":{"background":"a119","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"这样一来……芦花姐自己说不定也会越来越出名。","art":{"background":"a119","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「……呼……」","art":{"background":"a1700","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「结束了，谢谢」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"待芦花姐说完，我用力地鼓起了掌。","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「太棒了，芦花姐！你弹得像模像样的……这样讲好像有些没礼貌……」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「总之，就是……挺好的，芦花姐」","art":{"background":"a1700","sprites":[{"asset":"a1029","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「哈哈，哈哈哈……谢谢」","art":{"background":"a1700","sprites":[{"asset":"a3016","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我这种人只碰过竖笛啊迷你电子琴之类的乐器，所以在我看来……」","art":{"background":"a1700","sprites":[{"asset":"a3016","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「你的演奏真的太帅了！」","art":{"background":"a1700","sprites":[{"asset":"a3016","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「……啊、哈哈……又是帅啊」","art":{"background":"a1700","sprites":[{"asset":"a1577","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「不过至少是在夸我。而且……你能夸我，我很开心」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我很崇拜能够演奏乐器的人」","art":{"background":"a1700","sprites":[{"asset":"a1563","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「是、是吗？你很崇拜我……？」","art":{"background":"a1700","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「当然了。不只是乐器，经营店铺也是的」","art":{"background":"a1700","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「在我这种生活散漫的学生看来，你很厉害」","art":{"background":"a1700","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「……这、这还是夸过头了吧……」","art":{"background":"a1700","sprites":[{"asset":"a1581","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「谢谢你，我很开心」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「既然你都这么说了，那你也来实际弹弹看吧」","art":{"background":"a1700","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「可是，我又没弹过」","art":{"background":"a1700","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「我来教你。当然，我也没到能教别人的水平就是了」","art":{"background":"a1700","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「但也可以试着教教。来，到这边来」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「首先用小指和无名指紧紧握住侧面，然后将大拇指抵在这里」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……啊……嗯……」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「之后，跟吉他不一样，弹三味线用不到手指的内侧，要把手指竖起来」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"芦花姐用她暖暖的手握住了我的手。","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"她的手又软又暖……但是更让我在意的是顶在我后背的柔软触感。","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"以前我也感受过这份柔软。","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"那应该是被常陆当成可疑人物的时候。","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"那次毫无遮挡，这次隔了层布。","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"但这种感觉肯定没错，而且芦花姐的胸部……","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「（好大……）」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"感觉比常陆的还要软还要暖。","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"远看着完全感觉不出来……","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「（难不成芦花姐是穿衣显瘦的那种！？）」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「（大概是因为她的衣服比较宽松吧，我完全没发现……难道她真的是巨乳吗……呼……呼……）」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「阿将……阿将，你有在听吗？」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「啊？什、什么，芦花姐？」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「你在发什么呆呢，难得我好心教你」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「没，这是因为……现、现在这个样子……」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"难、难不成她还没察觉？","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「又没有别人在，就算你是第一次弹也没什么好害羞的吧？」","art":{"background":"a4183","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「我不是这个意思……」","art":{"background":"a4183","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「然后要这样，转动手腕，敲打上去」","art":{"background":"a4184","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「（又挤过来了一点！？）」","art":{"background":"a4184","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「大概就是这样。你要从不同的角度敲打对应的线」","art":{"background":"a4183","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「（顶、顶着我的角度也变了！？）」","art":{"background":"a4183","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「你看，基本的演奏方式没那么复杂吧？」","art":{"background":"a4183","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「但是，真要演奏一首曲子，就会突然变得很困难」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「嗯？阿将，喂，你在听我说话吗？」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「抱歉……我完全没在听」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「喂，怎么能不听人家说话呢」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「我知道，可我没法集中注意……」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「为什么？」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「这……因为你顶着我后背啊」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「顶着后背？」","art":{"background":"a4182","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「……」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a4181","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「！？」","art":{"background":"a4185","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"芦花姐这才发现问题在哪，她吓得身子颤了颤。","art":{"background":"a4185","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「那那那那、那个，我这个并不是那个意思，我没有色诱的想法，也没有其他什么奇怪的深层含义……」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「我知道的，我都知道的」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「而且，我我我我我我没想到隔着衣服也能被你感觉到」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「能啊，完全可以」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「芦花姐的胸部……还挺大的吧？」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「你你你你你别乱说啊！」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「可我已经感觉到了啊……」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「而且你一直用力地顶着我呢」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「对、对哦，抱歉，用这种奇怪的玩意儿顶着你，真抱歉！」","art":{"background":"a4186","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「呜……被羞辱了，被阿将羞辱了……」","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「喂！等一下！刚才这个算是我的错吗！？」","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「虽然我这么说听上去像是在找理由，可刚才完全是你自己顶过来的！」","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「你注意到的时候跟我说不就行了，竟然趁机用后背享受我的胸部……太卑鄙，太无耻了」","art":{"background":"a1700","sprites":[{"asset":"a4187","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4187","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"嗯……确实，没说出声来是有些卑鄙。","art":{"background":"a1700","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"可这也没办法啊！我也是个青春少年啊！","art":{"background":"a1700","sprites":[]},"chapter":"6-1"},{"speaker":"芦花","text":"「……你这个色鬼」","art":{"background":"a1700","sprites":[{"asset":"a4188","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4188","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我好色又怎么了」","art":{"background":"a1700","sprites":[{"asset":"a4188","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「啊，你还有理了！」","art":{"background":"a1700","sprites":[{"asset":"a1578","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「而、而且是你不对吧，一个姑娘家的怎么紧贴在男人身上，就像抱着一样」","art":{"background":"a1700","sprites":[{"asset":"a1578","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「你、你那么做，我心跳得好快，脑子里也是一片空白！」","art":{"background":"a1700","sprites":[{"asset":"a1578","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「你……心跳得很快？」","art":{"background":"a1700","sprites":[{"asset":"a4189","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「当然啦……我又不是经常能碰到胸部……」","art":{"background":"a1700","sprites":[{"asset":"a4189","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「是、是吗……」","art":{"background":"a1700","sprites":[{"asset":"a4138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「……另外……你感觉怎么样？我的胸部……碰着舒服吗？」","art":{"background":"a1700","sprites":[{"asset":"a4190","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「芦花姐，你问什么呢！？」","art":{"background":"a1700","sprites":[{"asset":"a4190","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"当然舒服啊！","art":{"background":"a1700","sprites":[{"asset":"a4190","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"但是……我并没有勇气理直气壮地当着她本人说出这种话。","art":{"background":"a1700","sprites":[{"asset":"a4190","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「……对对、对哦，我都在问些什么呢」","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我心跳得好快，脑子里一片空白……所以完全不知道是什么感觉……」","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"最后我说出这样的话当借口。","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"不过也不能完全算是说谎。","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「对、对哦。但是……能让你这么心动，也挺好的」","art":{"background":"a1700","sprites":[{"asset":"a4137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4167","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4167","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花的母亲","text":"「……（盯）……」","art":{"background":"a1700","sprites":[{"asset":"a4167","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「妈妈！？」","art":{"background":"a1700","sprites":[{"asset":"a4187","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「哇！？吓、吓死我了……」","art":{"background":"a1700","sprites":[{"asset":"a4187","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「你、你在做什么呢！？」","art":{"background":"a1700","sprites":[{"asset":"a4187","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花的母亲","text":"「感觉你们气氛不错……本来觉得打扰你们不太好」","art":{"background":"a1700","sprites":[{"asset":"a4187","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「不、不是你想象的那样，不要在这种时候那么贴心啊！」","art":{"background":"a1700","sprites":[{"asset":"a4191","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「好了，好了，该收拾收拾店子了，哈哈，哈哈哈」","art":{"background":"a1700","sprites":[{"asset":"a4170","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我、我……也该回去了……」","art":{"background":"a1700","sprites":[{"asset":"a4170","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芦花","text":"「再见了，阿将」","art":{"background":"a1700","sprites":[{"asset":"a4139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「嗯，再见……」","art":{"background":"a1700","sprites":[{"asset":"a4139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"就这样，我逃也似的从店里跑了出来。","art":{"background":"a2966","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「竟然会发生那样的事……」","art":{"background":"a2966","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"以后的一段时间……我可能会有意无意地注意她的胸部。","art":{"background":"a2966","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"那种触感……她的胸部到底有多大啊？","art":{"background":"a2966","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我一边想着要赶紧忘记……一边感觉自己恐怕再也忘不掉这种感觉了。","art":{"background":"a2966","sprites":[]},"chapter":"6-1"}]