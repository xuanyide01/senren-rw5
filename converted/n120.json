[{"speaker":"","text":"常陆露出了无可奈何的笑容。就在这时，头顶上传来了一阵叫声。","art":{"background":"a498","sprites":[{"asset":"a476","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"不过这声音并不是人发出来的。","art":{"background":"a498","sprites":[{"asset":"a476","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"小猫","text":"「喵」","art":{"background":"a498","sprites":[{"asset":"a476","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「嗯？」","art":{"background":"a498","sprites":[{"asset":"a479","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「……是猫？」","art":{"background":"a498","sprites":[{"asset":"a583","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我们一同抬起头向上看，发现树上有一只小猫。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"它所在树枝的位置不是很高，男性只要跳一跳就能够到。差不多有两米半吧。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「看来它是下不来了呀」","art":{"background":"a498","sprites":[{"asset":"a720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「不能放任不管啊」","art":{"background":"a498","sprites":[{"asset":"a720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"话虽如此，猛地跳过去抓住树枝也太危险了。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「就交给我吧」","art":{"background":"a498","sprites":[{"asset":"a600","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「哎！？这，等一下……你不是恐高吗？」","art":{"background":"a498","sprites":[{"asset":"a600","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「我确实恐高，但这点高度还是没问题的。区区两米，根本难不倒我」","art":{"background":"a498","sprites":[{"asset":"a862","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a862","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"真的没事吗？","art":{"background":"a498","sprites":[{"asset":"a862","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"那树枝确实算不上有多高，但是这个高度完全可能会让有恐高症的人感到眩晕。","art":{"background":"a498","sprites":[{"asset":"a862","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「今天还要祓禊呢。如果小猫受到惊吓掉下来就不好了」","art":{"background":"a498","sprites":[{"asset":"a480","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「你说得我也于心不忍了……」","art":{"background":"a498","sprites":[{"asset":"a480","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我觉得应该不会掉下来，但不怕一万就怕万一。","art":{"background":"a498","sprites":[{"asset":"a480","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「而且你不是说希望我可以信任你吗？」","art":{"background":"a498","sprites":[{"asset":"a512","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我确实说过，怎么？」","art":{"background":"a498","sprites":[{"asset":"a512","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「那你能不能相应地信任我一下呢？」","art":{"background":"a498","sprites":[{"asset":"a511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「好吧。那这件事就交给你了」","art":{"background":"a498","sprites":[{"asset":"a511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「好嘞」","art":{"background":"a498","sprites":[{"asset":"a883","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"常陆挺起胸膛回答了我。","art":{"background":"a498","sprites":[{"asset":"a491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"刚说罢，她就开始蹬着树干麻利地向上爬。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"……就连爬树的方法都那么异于常人。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"竟然能几乎垂直于树干向上蹬，她到底是怎么做到的？","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"就在我还在纳闷的时候，常陆就已经爬上了小猫所在的树枝。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"她温柔地呼唤着小猫。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「我、我我我、我现在就带你下去」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"很遗憾，她的声音都发抖了。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「好、好像……稍微有点高啊……」","art":{"background":"a498","sprites":[{"asset":"a1273","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「（结果她还是恐高了啊！？）」","art":{"background":"a498","sprites":[{"asset":"a1273","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"话虽如此，要是在这时和她搭话的话可就危险了。","art":{"background":"a498","sprites":[{"asset":"a1273","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我还是去她下面等着吧，出了什么意外也好及时应对。","art":{"background":"a498","sprites":[{"asset":"a1273","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"按理来说她应该能从这个高度安全落地……不过她现在并不在状态。","art":{"background":"a498","sprites":[{"asset":"a1273","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「麻烦、麻烦你老实一点哦。来吧……来吧小猫」","art":{"background":"a498","sprites":[{"asset":"a595","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"小猫","text":"「喵」","art":{"background":"a498","sprites":[{"asset":"a533","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「呀！？不要跑，不要乱动，不要摇，不要离开我」","art":{"background":"a498","sprites":[{"asset":"a1274","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a1274","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"常陆俯下身，视线与小猫平齐，并向其拼命伸出手去。","art":{"background":"a498","sprites":[{"asset":"a1274","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"啊，太危险了！","art":{"background":"a498","sprites":[{"asset":"a1274","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「慢慢来……慢慢来……」","art":{"background":"a498","sprites":[{"asset":"a1274","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"常陆在飘摇欲坠的树枝上缓缓伸出手。","art":{"background":"a498","sprites":[{"asset":"a1274","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"小猫","text":"「喵呜」","art":{"background":"a498","sprites":[{"asset":"a1274","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「啊，成功了！抓到小猫了！」","art":{"background":"a498","sprites":[{"asset":"a883","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"小猫","text":"「喵呜，喵呜，喵喵喵！」","art":{"background":"a498","sprites":[{"asset":"a883","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「啊，等一下！麻烦你不要乱动呀」","art":{"background":"a498","sprites":[{"asset":"a1274","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「呀呀呀呀呀，树枝在晃，树枝在晃啊」","art":{"background":"a498","sprites":[{"asset":"a1273","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「啊，呀，呀啊！？」","art":{"background":"a498","sprites":[{"asset":"a1275","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「！？！？！？」","art":{"background":"a498","sprites":[{"asset":"a1275","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"慌慌张张的常陆半个身子都探出了树枝之外。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"在重力的牵引下，她和小猫就这样掉了下来……","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「呃！！！」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"一阵强烈的冲击通过我的双臂传遍了我的全身。","art":{"background":"a1276","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我能够勉强接下这沉重的一击，一定是因为我最近的身体锻炼有了成效。","art":{"background":"a1276","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"而且也多亏了这根树枝并没有多高。","art":{"background":"a1276","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"不过没想到从这个高度就能给我这样的冲击……感觉腰都快断了。","art":{"background":"a1276","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「呃，唔……」","art":{"background":"a1276","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「——」","art":{"background":"a1276","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「常、常陆……你没事吧？」","art":{"background":"a1276","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"听到了我的声音之后，她缓缓地抬起了因恐惧而合上的眼睑。","art":{"background":"a1276","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「哎？哎、哎呀？我这是……」","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"小猫","text":"「喵」","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"常陆一脸茫然。","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"而那只小猫则是悠哉地叫出了声。","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"看来她们并无大碍。","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「没事吧？有没有哪里疼？」","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「啊，嗯……没事，没、没有受伤。一点都不疼」","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「那就好」","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"小猫","text":"「喵」","art":{"background":"a1277","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"小猫并没有要道谢的意思，只是精神饱满地叫了一声，就从常陆的怀中跳了出来。","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"它摇摆着轻快的身姿头也不回地走了，完全想象不到它刚才在树上颤抖的样子。","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「啊……它走了」","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「既然能那样大摇大摆地走路，应该没受伤。真是太好了」","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「是呀。我们已经达成最初目的了。不过……」","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「我好像是从树枝上掉下来了……？」","art":{"background":"a1279","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「你是和小猫一起掉下来的。手一滑就漂亮地掉下来了」","art":{"background":"a1279","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「不过我没感觉疼啊……」","art":{"background":"a1279","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"常陆疑惑地歪了歪头。","art":{"background":"a1279","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"她似乎终于有余力来观察自己的处境了。直到现在，她才发觉自己正被我搂抱着。","art":{"background":"a1279","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「！？！？！？」","art":{"background":"a1280","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「那个、那个，这、这、这就是所谓的……公主抱？」","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「嗯，差不多吧」","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"她直接后背朝下落在了我胳膊上，这意味着在下落时，她根本没来得及调整到安全的姿势。","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"还好我提前靠近了她所在的位置。","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「我见你和小猫从树枝上掉下来了，没反应过来就把你接住了」","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「能接住真是太好了，不然就得受伤了」","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「唔唔」","art":{"background":"a1280","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"常陆睁大了眼睛，红透了脸。","art":{"background":"a1280","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"哇……这样害羞的常陆还真是少见。","art":{"background":"a1280","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"下一刻她就用双手遮住了自己红得像番茄的脸。","art":{"background":"a1280","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「不好意思，不好意思，让你看到我的丢人模样了」","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「没，我倒不介意……你没事吧？」","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「啊，嗯。没事」","art":{"background":"a1283","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「那就好。也就是说你并不是因为疼痛而捂着脸吧？」","art":{"background":"a1283","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「那当然，我哪里都不疼……」","art":{"background":"a1283","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"她一边说一边挪开了双手，那语调听上去比平时要柔弱许多。","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"双手挪开后，绯红的脸颊便露了出来。那四处游移的眼神说什么也不愿意正眼对着我。","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「你挺有力气的嘛……」","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「怎么说也该有抱起女孩子的力气吧。而且我最近还在锻炼」","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「但主要还是因为你挺轻的」","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我真的是没想到她的身体竟会这样轻盈……不过这话说出口就太没礼貌了。","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"毕竟常陆是女孩子，身形又不粗壮。","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我只是经常看她作为忍者冲锋陷阵，所以完全想象不到她会这样柔弱。","art":{"background":"a1278","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「我真没想到，有朝一日我竟然会被这样公主抱」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「我也没想到，现实里竟然真的可以遇到这样的场面」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「我在漫画里看到过这种……但我没想到的是……这个姿势竟然还挺稳的」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「我主要是想着不能让你摔到地上，于是就冲过来了」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「难不成，你很向往这种漫画一样的场面？」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「倒也说不上是向往……只是……我以前确实挺好奇的，一直想知道这到底是怎样的感觉」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「那现在你已经体验了，感觉如何？」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「你的力气……比我想象中的还要大」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……那、那我应该谢谢你的夸奖？」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「啊，不是。呃，刚才只是我的自言自语罢了」","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「那个……那个……十、十分抱歉」","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我搞不懂她为什么要这样道歉，也不懂她为什么又遮住了脸。","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"这般态度又和以往的她完全不同……我似乎又发现了她的新面孔。","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"不过公主抱确实有够羞人的。就连我也觉得害羞。","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"不过我没料到她竟会害羞到如此地步……难不成，她内心非常纯情？","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「你好像有点受不了这种？」","art":{"background":"a1282","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「好像是的……我、我是第一次……被男人这样子抱住……感觉心跳得好快」","art":{"background":"a1285","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「也就是说，并不是受不了男人？」","art":{"background":"a1285","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「嗯。我对男人并没有什么受不了或者厌恶的情绪」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「只是，那个，怎么说呢……就、就是很害羞」","art":{"background":"a1286","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"就算不对男人过敏，也可能会羞于与男性交流……？","art":{"background":"a1286","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"……真搞不懂。我们一起吃香鱼时，她可是一副游刃有余的样子啊。虽然那只是名义上的约会。","art":{"background":"a1286","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「那个，已经没事了！我也没有哪里疼，可以放我下来了」","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「啊，好的。不过……没关系吗？腰使得上劲吗？」","art":{"background":"a1281","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「应该是没问题的，只是……太紧张了，心跳得又快，感觉手脚有点不利索」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「好吧。那我慢慢把你放下来」","art":{"background":"a1284","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「嗯……麻烦你了」","art":{"background":"a1285","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「不好意思，抱了你这么久」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「哪里，说到底这都是我自作自受」","art":{"background":"a498","sprites":[{"asset":"a1287","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「怎么说呢……如果你怕高的话下次就让我来吧」","art":{"background":"a498","sprites":[{"asset":"a1287","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「……好的。这次真是不好意思」","art":{"background":"a498","sprites":[{"asset":"a595","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「先别管我了，你没有受伤吧？身体有没有不适？」","art":{"background":"a498","sprites":[{"asset":"a874","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"听她这么一说，我便试着活动了一下身体。","art":{"background":"a498","sprites":[{"asset":"a874","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我转了转肩膀，伸了伸四肢，扭了扭腰。","art":{"background":"a498","sprites":[{"asset":"a874","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"虽说我受到了一定的冲击，但感觉身上哪里都不疼。","art":{"background":"a498","sprites":[{"asset":"a874","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「没事。哪里都不疼」","art":{"background":"a498","sprites":[{"asset":"a874","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「是吗，那就好……」","art":{"background":"a498","sprites":[{"asset":"a524","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我们都没受伤，真是万幸」","art":{"background":"a498","sprites":[{"asset":"a524","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「实在是抱歉。我没想到你居然会……用公主抱接住我……」","art":{"background":"a498","sprites":[{"asset":"a1288","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「我、我先失陪了」","art":{"background":"a498","sprites":[{"asset":"a1288","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"她留下这句话，一眨眼就跑了。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「喔……好快……」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"看她跑得这样快，身体应该也没什么大碍。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"祟神给她留下的伤似乎也没造成太大的影响。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"不过话说回来……","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「她真的好轻啊」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「而且还很柔软」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"她的触感比我想象中要柔软得多……\n我不得不感叹，这就是女孩子啊。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"而且我也没想到她居然会那么害羞。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"不过仔细想想，公主抱这种操作确实挺羞人的。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「唔……感觉以后有点没法正视她了……」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我要自制，要自制。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我可不能让她觉得我是什么怪异的家伙。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"而且现在处于非常时期，我可不能大意。","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「到了晚上我们还要去祓禊呢」","art":{"background":"a498","sprites":[]},"chapter":"3-5"}]