[{"speaker":"芦花","text":"「哈啊……还以为要死了呢……」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「阿将你太激烈了……说真的，从下次开始要稍微控制一下才行哦」","art":{"background":"a4158","sprites":[{"asset":"a4100","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「还有下次啊？」","art":{"background":"a4158","sprites":[{"asset":"a4100","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「哎？那当然有啊」","art":{"background":"a4158","sprites":[{"asset":"a4","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「不，我就是在担心是不是做得太过火了……」","art":{"background":"a4158","sprites":[{"asset":"a4","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「过火肯定是过火了。不过……我绝对不会因此讨厌你的」","art":{"background":"a4158","sprites":[{"asset":"a6","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「是、是这样啊……那太好了」","art":{"background":"a4158","sprites":[{"asset":"a6","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「因为今天我又有了新的发现啊」","art":{"background":"a4158","sprites":[{"asset":"a4248","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「新发现？」","art":{"background":"a4158","sprites":[{"asset":"a4248","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「那种感觉一定就是绝顶……一定就是高潮」","art":{"background":"a4158","sprites":[{"asset":"a4511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「虽然全身上下麻得不得了……但是那种感觉非常幸福哦。所以……我想让你再让我高潮」","art":{"background":"a4158","sprites":[{"asset":"a4512","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我、我会努力的」","art":{"background":"a4158","sprites":[{"asset":"a4512","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「当然我也会加油的。总觉得……好像抓到一点诀窍了」","art":{"background":"a4158","sprites":[{"asset":"a4513","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a4158","sprites":[{"asset":"a4513","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"芦花姐……对情色之事还挺积极的啊。","art":{"background":"a4158","sprites":[{"asset":"a4513","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"不，这样我也喜闻乐见，所以也没什么。","art":{"background":"a4158","sprites":[{"asset":"a4513","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我说啊，阿将。下次我们一起出门吧？」","art":{"background":"a4158","sprites":[{"asset":"a18","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「当然可以，不过你要去哪？」","art":{"background":"a4158","sprites":[{"asset":"a18","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「去找水果」","art":{"background":"a4158","sprites":[{"asset":"a37","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「你是指用在水晶冰沙上的？」","art":{"background":"a4158","sprites":[{"asset":"a37","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「嗯。我想听一听你的意见」","art":{"background":"a4158","sprites":[{"asset":"a33","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「那当然可以啊……不过我可是个门外汉哦？」","art":{"background":"a4158","sprites":[{"asset":"a33","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「没事没事。顾客也不是专家嘛」","art":{"background":"a4158","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「有时候非专业人士的意见更加重要。而且……你对我来说就像是幸运之神一样」","art":{"background":"a4158","sprites":[{"asset":"a37","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「幸运……之神？」","art":{"background":"a4158","sprites":[{"asset":"a37","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「过去我一直很烦恼。但是自从遇到了你，世界就好像变得豁然开朗了」","art":{"background":"a4158","sprites":[{"asset":"a18","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"她一定是指……咖啡和水晶冰沙的事吧。","art":{"background":"a4158","sprites":[{"asset":"a18","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我并不是觉得有你在身边就会万事顺利」","art":{"background":"a4158","sprites":[{"asset":"a15","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「但如果有你陪在我身边……我就能够努力下去。我就会感觉身体充满了活力」","art":{"background":"a4158","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我并不觉得自己帮了什么大忙啊」","art":{"background":"a4158","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「你能够在身旁支持我就很重要了」","art":{"background":"a4158","sprites":[{"asset":"a8","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……对我来说，你也是我最重要的人。为了看到你开心的表情，我会努力的」","art":{"background":"a4158","sprites":[{"asset":"a8","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我也一样……我喜欢看到你的笑容。就是因为你会为我感到高兴，我才能够努力下去」","art":{"background":"a4158","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「嗯……」","art":{"background":"a4158","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我喜欢你……最喜欢你了。我爱你」","art":{"background":"a4158","sprites":[{"asset":"a36","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我也一样。我最喜欢你了」","art":{"background":"a4158","sprites":[{"asset":"a36","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"能跟喜欢的人在一起……原来是这么幸福的事情。","art":{"background":"a4158","sprites":[{"asset":"a36","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"多亏了丛雨丸，让我真的体验到了很多东西。","art":{"background":"a4158","sprites":[{"asset":"a36","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"我对这座小镇实在是感激不尽。","art":{"background":"a4158","sprites":[{"asset":"a36","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我说芦花姐，你有一整天的休假吗？」","art":{"background":"a4158","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「哎？店里基本是没有休假的……但过年的时候应该能休息？」","art":{"background":"a4158","sprites":[{"asset":"a38","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「过年啊……还很久啊」","art":{"background":"a4158","sprites":[{"asset":"a38","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「既然如此，干脆把我爸妈叫来比较方便吧」","art":{"background":"a4158","sprites":[{"asset":"a38","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「怎么了？有什么事吗？」","art":{"background":"a4158","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我现在都有未婚妻了，必须跟他们好好介绍一下才行」","art":{"background":"a4158","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「……啊……你也真是的，太会讨我开心了」","art":{"background":"a4158","sprites":[{"asset":"a4514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「与其说我会讨你开心，其实只是你太单纯了吧——」","art":{"background":"a4158","sprites":[{"asset":"a4514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「你说什么！？你只有这方面像个人精一样！」","art":{"background":"a4158","sprites":[{"asset":"a11","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「但是我喜欢」","art":{"background":"a4158","sprites":[{"asset":"a7","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「哈哈，瞧你说的」","art":{"background":"a4158","sprites":[{"asset":"a7","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"只要跟芦花姐在一起，我就会觉得心情愉悦又放松。","art":{"background":"a4158","sprites":[{"asset":"a7","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"而且……力量不断涌现而出。","art":{"background":"a4158","sprites":[{"asset":"a7","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"今后走上社会，我想自己一定会遇到很多艰难险阻。","art":{"background":"a4158","sprites":[{"asset":"a7","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"但只要有芦花姐陪在我身边……无论什么障碍我都能跨过去。","art":{"background":"a4158","sprites":[{"asset":"a7","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"她能为我带来这样的自信。","art":{"background":"a4158","sprites":[{"asset":"a7","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「总之，咱们一起去找水果吧」","art":{"background":"a4158","sprites":[{"asset":"a7","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「嗯！要一起去哦♪」","art":{"background":"a4158","sprites":[{"asset":"a44","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"}]