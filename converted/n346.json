[{"speaker":"","text":"第二天。","art":{"background":"a1","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"穗织大地上晴空万里。","art":{"background":"a1","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"于是……","art":{"background":"a1","sprites":[]},"chapter":"9-1"},{"speaker":"廉太郎","text":"「注意了，注意了，不要脱离队伍啊……！」","art":{"background":"a56","sprites":[{"asset":"a3257","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a96","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"小春","text":"「神、神刀活动重开仪式在下午一点举行！」","art":{"background":"a56","sprites":[{"asset":"a2976","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a96","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"外国女性Ａ","text":"「哇噢，今天会有个真正的武士要来是吧？」","art":{"background":"a56","sprites":[{"asset":"a963","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"9-1"},{"speaker":"蕾娜","text":"「没错，将臣要一刀把岩石劈成两半哦！」","art":{"background":"a56","sprites":[{"asset":"a960","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"9-1"},{"speaker":"外国女性Ｂ","text":"「真是太魔幻了！」","art":{"background":"a56","sprites":[{"asset":"a960","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"9-1"},{"speaker":"茉子","text":"「不，没这回事，他只是要把刀刺进岩石里，蕾娜」","art":{"background":"a56","sprites":[{"asset":"a321","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"外国男性Ａ","text":"「ＨＡＨＡＨＡＨＡ！穗织果真是最棒的！你说是不是啊，ＢＲＯＴＨＥＲ！」","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"外国男性Ｂ","text":"「ＹＥＳ！ＢＲＯＴＨＥＲ！武士真是让我超级来电啊！」","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"活动还没开始，会场就挤满了人。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"有几百人……不对，有上千人了吧？","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"芳乃","text":"「好多人啊……」","art":{"background":"a56","sprites":[{"asset":"a1416","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「这是第一次有这么多人聚在这里吧？」","art":{"background":"a56","sprites":[{"asset":"a180","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"安晴","text":"「嗯，游客数量虽说确实比春日祭那些观光季节时要来的多，但这差的可不是一点半点」","art":{"background":"a56","sprites":[{"asset":"a174","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"安晴","text":"「神刀的招客作用还真是有够显著」","art":{"background":"a56","sprites":[{"asset":"a183","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"为仪式而身着正装的安晴叔叔和朝武一边看着鸟居前的人群，一边交流着。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"丛雨","text":"「终于到了这一天了，主人」","art":{"background":"a56","sprites":[{"asset":"a223","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我临时换上了一身武士服。身边，小雨抬头仰望着穿着裤裙的我。","art":{"background":"a56","sprites":[{"asset":"a223","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"她将丛雨丸拿在手中。","art":{"background":"a56","sprites":[{"asset":"a223","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「嗯，是啊」","art":{"background":"a56","sprites":[{"asset":"a223","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我看着她微笑道。","art":{"background":"a56","sprites":[{"asset":"a223","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「有地，是时候了」","art":{"background":"a56","sprites":[{"asset":"a171","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1134","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"安晴","text":"「准备好了吗？」","art":{"background":"a56","sprites":[{"asset":"a183","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1134","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"朝武父女一齐回头看向我们。","art":{"background":"a56","sprites":[{"asset":"a183","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1134","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「嗯，准备好了」","art":{"background":"a56","sprites":[{"asset":"a183","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1134","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我点头回答道。","art":{"background":"a56","sprites":[{"asset":"a183","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1134","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我自己都吃惊了，我的声音居然听起来如此冷静。","art":{"background":"a56","sprites":[{"asset":"a183","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1134","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「你真的一点都不紧张呢……」","art":{"background":"a56","sprites":[{"asset":"a193","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「完全看不出你是第一次执行供奉仪式」","art":{"background":"a56","sprites":[{"asset":"a175","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"安晴","text":"「是啊，简直就像是身经百战的芳乃一样」","art":{"background":"a56","sprites":[{"asset":"a171","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「毕竟难点都交给朝武来做了」","art":{"background":"a56","sprites":[{"asset":"a171","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「我只需将丛雨丸送返它的归宿罢了」","art":{"background":"a56","sprites":[{"asset":"a171","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「我只是行该做之事，送其归于所属罢了」","art":{"background":"a56","sprites":[{"asset":"a171","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我一边看着小雨手中的丛雨丸一边说道。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"想来，它不知帮了我多少次。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"谢谢你。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我将怀着谢意同你一起挥下最后一刀。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"玄十郎","text":"「嗯，说得好，将臣」","art":{"background":"a56","sprites":[{"asset":"a93","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「外公」","art":{"background":"a56","sprites":[{"asset":"a93","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"不知何时，外公站在了我的身边。","art":{"background":"a56","sprites":[{"asset":"a93","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"玄十郎","text":"「你终于达到了这个境界了」","art":{"background":"a56","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"玄十郎","text":"「不错，如今和平盛世，已经不需要用到神刀」","art":{"background":"a56","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"玄十郎","text":"「从今往后，神刀只需要静静地守护着穗织便可……」","art":{"background":"a56","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"玄十郎","text":"「丛雨大人也从此作为普通人，幸福地生活下去便好……」","art":{"background":"a56","sprites":[{"asset":"a602","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"玄十郎","text":"「去给这场漫长的战役画上句号吧，将臣」","art":{"background":"a56","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「好的！」","art":{"background":"a56","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我向着外公深深弯腰致谢。","art":{"background":"a56","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"外公，感谢您一直以来都如此照顾我。","art":{"background":"a56","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"虽然我是个不争气的孙子，但我今后会竭尽全力孝顺您的。","art":{"background":"a56","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"安晴","text":"「真羡慕您能有一个这么了不起的孙子」","art":{"background":"a56","sprites":[{"asset":"a197","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"玄十郎","text":"「嗯，这可是我引以为傲的孙子」","art":{"background":"a56","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「啊？等一下？！外公你说什么？！」","art":{"background":"a56","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我被外公意料之外的发言吓了一跳。","art":{"background":"a56","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「这可是玄十郎第一次在众人面前表扬自家人……」","art":{"background":"a56","sprites":[{"asset":"a474","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「不过，事到如今，你再怎么示好都没用了，他已经是本座的人了！」","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「小雨你也是，都到这时候了胡说什么呢？！」","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我希望这两个人别在这种事上较真了。","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「有地」","art":{"background":"a56","sprites":[{"asset":"a1134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「差不多是时候了」","art":{"background":"a56","sprites":[{"asset":"a1138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「好，我知道了！」","art":{"background":"a56","sprites":[{"asset":"a1138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"被朝武提醒之后，我又把注意力转回了正事上。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我的心再度冷静了下来。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"丛雨","text":"「主人」","art":{"background":"a56","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"小雨用双手将丛雨丸向我递出。","art":{"background":"a56","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「嗯，谢谢你」","art":{"background":"a56","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我也双手接过丛雨丸。","art":{"background":"a56","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"这亲切的手感和重量感让我不禁嘴角上扬。","art":{"background":"a56","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「这次本座不会附于丛雨丸之上」","art":{"background":"a56","sprites":[{"asset":"a223","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「但本座的念想早已灌注其中」","art":{"background":"a56","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「我等即是三位一体，所向披靡」","art":{"background":"a56","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「嗯，你说的对」","art":{"background":"a56","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我右手执丛雨丸，左手轻轻抚摸小雨的头。","art":{"background":"a56","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「有地，我们走吧」","art":{"background":"a56","sprites":[{"asset":"a175","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"伴随着一阵清脆的铃声，我们朝着观众所在方向走去。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「……我走了」","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我最后梳了梳小雨的头发……","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"带着丛雨丸，迈出了步子。","art":{"background":"a56","sprites":[]},"chapter":"9-1"},{"speaker":"丛雨","text":"「嗯，祝一切顺利，主人，芳乃！」","art":{"background":"a56","sprites":[{"asset":"a182","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"安晴","text":"「拜托你们了」","art":{"background":"a56","sprites":[{"asset":"a172","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"外国女性Ａ","text":"「哇噢，真正的武士来了！」","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"外国女性Ｂ","text":"「ＨＥＹ！请朝镜头这边看！」","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"外国男性Ａ","text":"「ＯＨ！ＢＲＯＴＨＥＲ！巫女和武士男孩都来了啊！」","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"外国男性Ｂ","text":"「我真是兴奋到不行啊！」","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"当我和朝武现身，场下便爆发出了雷鸣般的欢呼声。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"人山人海。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"耳边的快门声响个不停。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"廉太郎","text":"「喂，等一下，别推啊！不要推挤！」","art":{"background":"a3365","sprites":[{"asset":"a2979","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"小春","text":"「Ｐ、ＰＬＥＡＳＥ，ＤＯＮ＇Ｔ，ＰＵＳＨ！ＯＫ？！」","art":{"background":"a3365","sprites":[{"asset":"a3255","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"蕾娜","text":"「不可以越过隔离线哦！」","art":{"background":"a3365","sprites":[{"asset":"a1038","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"茉子","text":"「哎呀，他们两个挺有名的嘛」","art":{"background":"a3365","sprites":[{"asset":"a328","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"廉太郎他们和町内会的人们都在拼命地稳住人群。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"看上去真是辛苦。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我很想让他们近距离观看，不过我要挥舞的可是真剑。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"只能让他们在神刀活动后摸摸刀柄凑合一下了。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"芳乃","text":"「……」","art":{"background":"a3365","sprites":[{"asset":"a176","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"朝武停下了步子，闭上眼集中精神。","art":{"background":"a3365","sprites":[{"asset":"a176","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"这和她以往献舞时并无二异。","art":{"background":"a3365","sprites":[{"asset":"a176","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"每到献舞之时，她的专注力就会变得超乎寻常。","art":{"background":"a3365","sprites":[{"asset":"a176","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"现在她肯定已经听不到人群的喧嚣声了。","art":{"background":"a3365","sprites":[{"asset":"a176","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「……！」","art":{"background":"a3365","sprites":[{"asset":"a3366","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"朝武开始了献舞。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"她的动作没有丝毫偏差，舞姿优美流畅。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"人们渐渐不再喧闹。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"他们都看入迷了。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"就和我第一次看到她的舞蹈时一样。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"可是……","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"这次我也是“当事人”。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我原地转身朝向朝武。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"左手执刀鞘。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"右手执刀柄。","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"就在我拔出丛雨丸的一瞬间……","art":{"background":"a1132","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"无数回忆在我脑海中掠过。","art":{"background":"a127","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"其中也有和小雨的回忆。","art":{"background":"a3272","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"谢谢你。","art":{"background":"a3315","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"真的非常感谢你。","art":{"background":"a3315","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我向手中的伙伴致谢。","art":{"background":"a3315","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"因为有你在，我才得以和小雨相遇。","art":{"background":"a3315","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"因为有你在，我才得以平息祟神的怨怒。","art":{"background":"a3315","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"因为有你在，我才……","art":{"background":"a3315","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"能够成就今天的我……！","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「哈啊！」","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"待朝武舞毕，我也接着开始舞刀。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"白虎。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"玄武。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"青龙。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"朱雀。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我向着四相神舞剑，以示供奉。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"一种催人泪下的成就感在我心底若隐若现……","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"其中夹杂着几分寂寥。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"丛雨","text":"「丛雨丸，主人……」","art":{"background":"a3365","sprites":[{"asset":"a196","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"在我舞剑之时，小雨的身影出现在了我的视线之中。","art":{"background":"a3365","sprites":[{"asset":"a196","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我知道她的心中所想。","art":{"background":"a3365","sprites":[{"asset":"a196","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"她心中也有几分寂寥，几分伤痛。","art":{"background":"a3365","sprites":[{"asset":"a196","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我能感觉得到……","art":{"background":"a3365","sprites":[{"asset":"a196","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"因为我们乃是三位一体。","art":{"background":"a3365","sprites":[{"asset":"a196","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"供奉完四象之神，我趁着气势高扬之一瞬……","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「啊，啊！！！！！」","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我拔腿朝着岩石冲去。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"此刻我变换手势，倒持刀柄。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「哈啊！！！！！！！！」","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我运气高呼。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"心中默念数次谢辞行礼。","art":{"background":"a3365","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"……别过了。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我在心中将离别之词赠与我的伙伴，将其送归诸神。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「呼，呼，呼……」","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我握着丛雨丸的刀柄，粗重地喘息着。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"……我以你能做我的操刀人为傲。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"……谢谢你。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「……哎？」","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我环顾四周。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「刚才是谁在说话……？」","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"外国围观群众","text":"『哇哦！！！！！！！！！！』","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"但是我疑惑的话语很快就淹没在了排山倒海的欢呼声中。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"雷鸣般的拍手声和赞许声如暴风雨般向我和朝武袭来。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"芳乃","text":"「有地」","art":{"background":"a86","sprites":[{"asset":"a3367","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"芳乃","text":"「你做得很好」","art":{"background":"a86","sprites":[{"asset":"a3368","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"身着巫女装扮的朝武回过头来，朝我笑了。","art":{"background":"a86","sprites":[{"asset":"a3368","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「哎？啊……」","art":{"background":"a86","sprites":[{"asset":"a3368","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「是吗，我成功了啊……」","art":{"background":"a86","sprites":[{"asset":"a3368","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我握着刀柄，终于察觉到我已经完成了我的使命。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"丛雨","text":"「主人！做得太棒了！」","art":{"background":"a86","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「哎，你要把刀柄握到什么时候！可以松手了」","art":{"background":"a86","sprites":[{"asset":"a771","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"小雨冲向我，温柔地将她的手与我的重叠。","art":{"background":"a86","sprites":[{"asset":"a771","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「小雨，你变回人了？」","art":{"background":"a86","sprites":[{"asset":"a139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「嗯，看来是的」","art":{"background":"a86","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「四肢的感觉比以往更加明晰了」","art":{"background":"a86","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「而且本座听到了丛雨丸的声音」","art":{"background":"a86","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「哎……」","art":{"background":"a86","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"听她这么说，我才反应过来……","art":{"background":"a86","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"那是丛雨丸的声音啊。","art":{"background":"a86","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「我也听到了……」","art":{"background":"a86","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「嗯？主人你也听到了？」","art":{"background":"a86","sprites":[{"asset":"a549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「嗯，它说了“谢谢”。小雨你呢？」","art":{"background":"a86","sprites":[{"asset":"a549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「本座……」","art":{"background":"a86","sprites":[{"asset":"a2956","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"小雨眯起眼看向插在岩石中的神刀。","art":{"background":"a86","sprites":[{"asset":"a2956","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「“一直以来都辛苦你了”」","art":{"background":"a86","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「它还说……“祝你幸福”」","art":{"background":"a86","sprites":[{"asset":"a277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「是吗……」","art":{"background":"a86","sprites":[{"asset":"a277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我和小雨一起握着插在岩石内的丛雨丸，一时间没有松手。","art":{"background":"a86","sprites":[{"asset":"a277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我们都不舍得松开丛雨丸。","art":{"background":"a86","sprites":[{"asset":"a277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"茉子","text":"「二位，差不多应该退场了」","art":{"background":"a86","sprites":[{"asset":"a3369","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a427","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"蕾娜","text":"「想要拔神刀的人都已经排成长龙了」","art":{"background":"a86","sprites":[{"asset":"a3370","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a427","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-1"},{"speaker":"小春","text":"「哥哥，那边有记者想要采访你！啊，丛雨大人也是！」","art":{"background":"a86","sprites":[{"asset":"a63","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"伙伴们都围了过来。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"是啊，没功夫回味了。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我们已经迈出了一步。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"我和她同时松开了丛雨丸的刀柄。","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"","text":"然后……","art":{"background":"a86","sprites":[]},"chapter":"9-1"},{"speaker":"将臣","text":"「走吧，小雨……」","art":{"background":"a1","sprites":[{"asset":"a137","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"将臣","text":"「不，走吧，小绫」","art":{"background":"a1","sprites":[{"asset":"a137","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"丛雨","text":"「……嗯！」","art":{"background":"a1","sprites":[{"asset":"a130","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"},{"speaker":"","text":"我们握紧了对方的手，朝伙伴们所在的方向迈步前进。","art":{"background":"a1","sprites":[{"asset":"a130","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"9-1"}]