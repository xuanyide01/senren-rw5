[{"speaker":"成美","text":"「巫女大人今天带的便当看起来也很好吃啊」","art":{"background":"a1","sprites":[]},"chapter":"4-2"},{"speaker":"芳乃","text":"「因为茉子每天都在很用心地帮我做」","art":{"background":"a1","sprites":[]},"chapter":"4-2"},{"speaker":"蕾娜","text":"「那就不是“看起来很好吃”了。而是肯定“很好吃”」","art":{"background":"a1","sprites":[]},"chapter":"4-2"},{"speaker":"典子","text":"「对啊！蕾娜说得对！」","art":{"background":"a1","sprites":[]},"chapter":"4-2"},{"speaker":"蕾娜","text":"「因为茉子很擅长做菜」","art":{"background":"a599","sprites":[{"asset":"a695","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「感谢夸奖」","art":{"background":"a599","sprites":[{"asset":"a695","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a802","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"芳乃","text":"「茉子，非常感谢你每天帮我备饭」","art":{"background":"a599","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「我本来就喜欢做菜。只要大家觉得好吃，对我来说就足够了」","art":{"background":"a599","sprites":[{"asset":"a511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"常陆带着微笑，和平日一样跟大家坐在一起吃着便当。","art":{"background":"a599","sprites":[{"asset":"a511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「……嗯？怎么了，一直盯着女生那边」","art":{"background":"a599","sprites":[{"asset":"a515","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「不，有点事比较在意」","art":{"background":"a599","sprites":[{"asset":"a515","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"一丰","text":"「什么什么？难道说内裤露出来了？」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「哇。你这人也太恶心了吧。真鄙视你……」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「啊，真的露出来了」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「真的吗！？在哪里啊！？从哪个角度看！？」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「你还有资格鄙视别人吗！」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「啊，可恶，你算计我！？」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「你们讨论得挺热闹啊。不小声点的话，女生都要听见你们说的话了」","art":{"background":"a599","sprites":[{"asset":"a519","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「你倒是没什么反应啊」","art":{"background":"a599","sprites":[{"asset":"a519","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「哎呀……毕竟我在班级里的地位已经岌岌可危了」","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「而且吧，虽然不是说对内裤没兴趣……但比起一块布，我还是更喜欢身体啦」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"看来这家伙真的是经验丰富啊，虽然我之前就预想到了。","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"这股挫败感是怎么回事……","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"我可是连女朋友都没谈过啊。","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「嘁……所以说你这家伙真招人恨……」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「明明手脚不老实，在某些方面却装得特别老练」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"啊，这两个人散发着和我一样的气息！","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"这一定是处男的气息！","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「难兄难弟啊！」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「呃，呃？……怎么了？」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「怎么了？这么突然？」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「没什么，不用太在意」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「所以，你为什么一直盯着看？」","art":{"background":"a599","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「你们觉得……常陆这个人怎么样？」","art":{"background":"a599","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「哎哟……这个问题还真是挺突然的」","art":{"background":"a599","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"一丰","text":"「有地居然会讨论这个，真稀奇啊」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「哎呀哎呀，难道说你喜欢上她了？」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「不是这个意思」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「从正常人眼光来看，常陆很可爱，对吧」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「没错，这么可爱的女生可不是随便去哪都能遇见的」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"忠兴","text":"「说得没错」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"一丰","text":"「巫女大人，常陆同学。蕾娜也是……这么一想，这地方水准还挺高的」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「再让我吸一吸这里的空气吧。吸气————————……」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「原来……你是这么恶心的人啊……」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「之前，我和她聊天的时候聊过关于恋爱的问题……结果她说从来没人和她表白过」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「我实在是不懂，常陆为什么会这么没男人缘。明明大家都觉得她很可爱」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「哦……你说这个啊」","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「朝武的话，毕竟她是这里的巫女，我倒也能理解。可是为什么常陆也这样？」","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"一丰","text":"「这个嘛，我们当然觉得她很可爱，也从没觉得性格不好」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「可是常陆同学她从早到晚，不管是工作日还是休息日，一直都在照顾巫女大人吧？」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「没错」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「你想啊，假设你和她表白了，然后她答应了，可你觉得她会有时间和你约会吗？」","art":{"background":"a599","sprites":[]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「而且她服侍的是巫女大人。“别管工作了，优先陪陪我吧！”这种话也说不出口吧」","art":{"background":"a599","sprites":[{"asset":"a730","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"一丰","text":"「以前我倒是邀请过她一起来玩。可是她一次都没答应」","art":{"background":"a599","sprites":[{"asset":"a730","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"一丰","text":"「不过，巫女大人也是这样」","art":{"background":"a599","sprites":[{"asset":"a730","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「而且从小就是这样了……大家都有目共睹，所以自然也就放弃了」","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「我并不是说她很高冷，但是她跟我们之间确实有种距离感」","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"我也有这种感觉。常陆她确实从早到晚都在忙朝武家的事。","art":{"background":"a211","sprites":[{"asset":"a246","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"我受着他们家的恩惠住在他们屋檐下，所以我清楚地知道常陆到底有多忙。","art":{"background":"a211","sprites":[{"asset":"a246","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「（而且……）」","art":{"background":"a211","sprites":[{"asset":"a246","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"一心一意地努力想要解除诅咒的朝武就在她身边。","art":{"background":"a118","sprites":[{"asset":"a175","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"她肯定无法把朝武丢在一边，自己醉心于恋爱的滋味吧。","art":{"background":"a118","sprites":[{"asset":"a175","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"常陆最优先考虑的是朝武的事，除此之外的事都排在后面。","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"明明不是有意疏远，却让大家感受到了距离感，这也是没办法的事。","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「原来如此……是这样啊」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"原来常陆在自己都没有意识到的情况下，把追求者都甩了啊……","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「常陆家也是不容易啊。每一代人都在服侍巫女大人他们家吧？」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「可是为什么只有他们那还一直保留着这种习俗啊？」","art":{"background":"a530","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「虽然被称为巫女大人，可是现在也只是神主的女儿吧？」","art":{"background":"a530","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"忠兴","text":"「是不是因为常陆家的祖先是重臣，所以延续了古时候的习俗？」","art":{"background":"a530","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"一丰","text":"「我觉得不是这个原因。我上小学的时候查过资料」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「就是那个“家乡历史知多少”的课外活动，按班级分的，你还记得吗？」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「想起来了，确实有过。我当时做的是关于古代筑城的研究」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「我们班级研究的是自己家的祖先和家世」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「当过重臣的是鞍马家和田宫家的祖先，就调查的结果来看，没有和常陆家相关的记载」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「啊！？田宫家是我家吗！？古时候居然当过重臣啊……我第一次知道……」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"廉太郎","text":"「鞍马家就是我们家了吧。不过看爷爷那样也能猜到就是了」","art":{"background":"a530","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"忠兴","text":"「可是，常陆家是忍者世家吧？」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"忠兴","text":"「之所以查不到资料，可能是因为他们家故意不想让人查出底细，但实际上他们也相当于重臣？」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"一丰","text":"「确实也有这种可能」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"我倒是从来没考虑过这方面的事。","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"常陆侍奉朝武的原因……","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"就算世世代代都是忍者，只要身为重臣，至少也会留下一点资料记载才对。","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"除此之外，常陆家的房子也让我有点在意。","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"如果她们家是重臣后代，那房子的地段和周围的环境未免也太随便了一点吧？","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"茉子","text":"「哈哈，这说得真的有点夸张了」","art":{"background":"a530","sprites":[{"asset":"a803","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"蕾娜","text":"「没有的事。我一直是这么想的」","art":{"background":"a530","sprites":[{"asset":"a1233","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"蕾娜","text":"「茉子一定能当个好新娘。如果我是男的，我一定会娶你的」","art":{"background":"a530","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"芳乃","text":"「确实，茉子的家务活也无可挑剔，肯定能当个好新娘」","art":{"background":"a530","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「被你们这么夸，我会不好意思的，哈哈哈」","art":{"background":"a530","sprites":[{"asset":"a1472","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a530","sprites":[{"asset":"a1472","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"常陆笑得很爽朗。","art":{"background":"a530","sprites":[{"asset":"a1472","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"我……一点都不了解她啊……","art":{"background":"a530","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「你还是很有男人缘的」","art":{"background":"a2278","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"在送常陆回去的路上——","art":{"background":"a2278","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"我突然想起了中午的对话，便向她如此说道。","art":{"background":"a2278","sprites":[]},"chapter":"4-2"},{"speaker":"茉子","text":"「……嗯？你刚刚说什么？」","art":{"background":"a2278","sprites":[{"asset":"a2322","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「啊，对不起。求求你了快把苦无收起来，不要杀我啊！」","art":{"background":"a2278","sprites":[{"asset":"a2322","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"是因为我之前夸她“可爱”，她才这么警觉吗？我刚说完她就向我投来了锐利的视线。","art":{"background":"a2278","sprites":[{"asset":"a2322","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「……所以，你是什么意思？」","art":{"background":"a2278","sprites":[{"asset":"a329","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「没什么，只是中午和廉太郎他们聊天来着。我们探讨了你明明很可爱却没有男人缘的问题」","art":{"background":"a2278","sprites":[{"asset":"a329","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「……」","art":{"background":"a2278","sprites":[{"asset":"a2323","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「你、你想啊！如果只有我这么觉得的话，不就是我的审美有问题了吗？」","art":{"background":"a2278","sprites":[{"asset":"a2323","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「我只是想知道我的想法是不是和大家一样而已」","art":{"background":"a2278","sprites":[{"asset":"a2323","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「这个……确实会让人在意」","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「你能理解就好了……」","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"看来我不用被苦无刺死了。","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「然后我问了一下，他们说是因为看你一直忙着伺候朝武，不想给你添麻烦」","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「所以大家都选择了放弃」","art":{"background":"a2278","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「但是他们都和我一样，都说你很有魅力，很可爱」","art":{"background":"a2278","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「……噢……原来是这样啊……」","art":{"background":"a2278","sprites":[{"asset":"a2314","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「我觉得你的可爱毋庸置疑，大家也都是这么想的，这样我就放心了。啊，说出来舒服多了」","art":{"background":"a2278","sprites":[{"asset":"a2314","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「那这个话题就到此为止吧。听到这种事我都不知道该作何反应了」","art":{"background":"a2278","sprites":[{"asset":"a2324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「居然还特意讲出来……你果然是在捉弄我吧」","art":{"background":"a2278","sprites":[{"asset":"a428","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「确实，我自己都觉得自己有点烦人了。我向你道歉」","art":{"background":"a2278","sprites":[{"asset":"a428","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「但我只是不希望你把我的话当作客套话而已」","art":{"background":"a2278","sprites":[{"asset":"a428","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「如果你真的想谈恋爱的话，其实不用那么害怕」","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「……谢谢你。我只是说了一句玩笑话，你却为我考虑了这么多」","art":{"background":"a2278","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「不过我觉得，我还是谈不了恋爱的」","art":{"background":"a2278","sprites":[{"asset":"a626","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「谈不了……为什么？」","art":{"background":"a2278","sprites":[{"asset":"a626","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「就像大家说的，我最优先的事项一定是侍奉芳乃大人」","art":{"background":"a2278","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「现在已经没有诅咒了，可以划一点时间出来给自己用吧？」","art":{"background":"a2278","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"不过我还受着她的照顾，这么说也不太好……","art":{"background":"a2278","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"据我所知，常陆的生活中几乎没有自由时间。","art":{"background":"a2278","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「给自己用的时间啊……」","art":{"background":"a2278","sprites":[{"asset":"a1043","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"常陆说完，慢慢地将视线投向天空，开始思考。","art":{"background":"a2278","sprites":[{"asset":"a1043","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「你这么说我也没什么概念。我觉得还是照顾芳乃大人比较合我胃口」","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「嗯……对你来说确实有可能是这样」","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"刚来这里的时候，我没觉得自己能适应这里的生活。","art":{"background":"a2278","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"对于没经历过的事，一般来说很难想象出实际的感受。","art":{"background":"a2278","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"与此相比，想切实地描绘出常陆幸福的日常生活还是很简单的。","art":{"background":"a2278","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"从早到晚就是做饭、洗衣服。无休无止的每一天。","art":{"background":"a211","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"对她来说，这才是有事可做的、平平稳稳的日子。","art":{"background":"a211","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"以挑战新的菜谱为乐。","art":{"background":"a211","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"偶尔把家里打扫得干干净净，看着扫出来的灰尘，享受着成就感。","art":{"background":"a211","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"看着自己晾起来的衣物，又漂亮又整齐，对此感到满足。","art":{"background":"a211","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"干完活后，去浴池洗净一天的疲劳。然后钻进被窝，进入香甜的睡眠，只为了能按时起床做第二天的家务。","art":{"background":"a211","sprites":[]},"chapter":"4-2"},{"speaker":"","text":"就这样，一天天重复着安稳的日常——","art":{"background":"a211","sprites":[]},"chapter":"4-2"},{"speaker":"将臣","text":"「不对，这样可不行啊！」","art":{"background":"a2278","sprites":[]},"chapter":"4-2"},{"speaker":"茉子","text":"「哇！？吓、吓死我了……」","art":{"background":"a2278","sprites":[{"asset":"a2325","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「怎么突然叫得这么大声？到底什么不行？」","art":{"background":"a2278","sprites":[{"asset":"a279","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「我说你啊！」","art":{"background":"a2278","sprites":[{"asset":"a279","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"“能安心生活的每一天”，虽然听起来很好，但一个人一辈子都这么过下去可不行！","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"常陆所谓的幸福，她所感受到的满足感和成就感全是她自己的，也仅限于她自己。","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"不，我不是说天天一成不变地做着家务的生活是不行的。","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"如果是自愿做出这样的选择，我觉得这也没问题。","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"但常陆她根本什么都不了解。","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"她从小就要接受忍术训练，还要练习家务活，从来都没和朋友出去玩过。","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"","text":"做家务并不能带来所有的快乐，靠自己并不能获得一切的幸福。常陆应该去知晓更多的快乐和幸福。","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「去寻找其他更多的乐趣吧！」","art":{"background":"a2278","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「嗯。你说得对」","art":{"background":"a2278","sprites":[{"asset":"a324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「那明天我就来试着做一道新的菜——」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「你——够——啦——！我说的不是这种乐趣！」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「呃、呃……」","art":{"background":"a2278","sprites":[{"asset":"a323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「不是靠做菜和打扫来获取满足感，而是去寻找之前没体验过的乐趣！」","art":{"background":"a2278","sprites":[{"asset":"a323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「这、这么唐突地和我说这个，我也——」","art":{"background":"a2278","sprites":[{"asset":"a321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「反正明天不用去学校，偶尔也放松一下嘛」","art":{"background":"a2278","sprites":[{"asset":"a321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「可是我突然请假的话，会给芳乃大人和安晴大人带来麻烦的」","art":{"background":"a2278","sprites":[{"asset":"a321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「……我知道了」","art":{"background":"a2278","sprites":[{"asset":"a321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「你终于理解了吗？」","art":{"background":"a2278","sprites":[{"asset":"a626","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「那么，就由我来说服朝武和安晴叔叔吧！」","art":{"background":"a2278","sprites":[{"asset":"a626","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「居然完全没理解？！」","art":{"background":"a2278","sprites":[{"asset":"a2326","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"将臣","text":"「没问题的，这事就交给我吧！」","art":{"background":"a2278","sprites":[{"asset":"a2326","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「你在这种时候倒是挺强硬的……唉……」","art":{"background":"a2278","sprites":[{"asset":"a1710","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-2"},{"speaker":"茉子","text":"「好吧。反正芳乃大人和安晴大人应该都不会同意的」","art":{"background":"a2278","sprites":[{"asset":"a334","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-2"}]