[{"speaker":"丛雨","text":"「啊啊啊！」","art":{"background":"a3360","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"我的睾丸在剧烈地搏动。","art":{"background":"a3360","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"我的精液顺着我的尿道，尽情地挥洒在了小雨的体内。","art":{"background":"a3360","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「啊，哈嗯，嗯，啊……」","art":{"background":"a3361","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「嗯，啊，射、射进来了，哈，哈……」","art":{"background":"a3362","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「主人温热的精液，射到本座的小穴里了……」","art":{"background":"a3363","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「哈啊哈啊，好、好舒服……」","art":{"background":"a3363","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"小雨仍在连连震颤。","art":{"background":"a3364","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"远超蜜穴容量的大量精液溢出了她的蜜穴口，落在了地面上。","art":{"background":"a3364","sprites":[]},"chapter":"8-5"}]