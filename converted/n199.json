[{"speaker":"","text":"就这样又过去了几天时间。","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"自怨念消失的那天晚上起，朝武的脑袋上就不再有耳朵了。","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"当然，祟神也没有再出现过。","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我们的生活正在逐渐恢复以前的模样。","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「啊，早上好，有地」","art":{"background":"a211","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「早上好，朝武」","art":{"background":"a211","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"朝武替我做便当已经有一段日子了。","art":{"background":"a211","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"或许是因为习惯了新的生活规律，最近她也不睡懒觉了。","art":{"background":"a211","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「你现在要去锻炼吗？千万别受伤啊」","art":{"background":"a211","sprites":[{"asset":"a1056","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「好的」","art":{"background":"a211","sprites":[{"asset":"a1056","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我这是为了保持健康，保持体能，要是弄得自己受伤岂不是白费工夫了」","art":{"background":"a211","sprites":[{"asset":"a1056","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「朝武，你身体怎么样？」","art":{"background":"a211","sprites":[{"asset":"a1056","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「挺好的，没事」","art":{"background":"a211","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「我没撒谎，你放心。在那之后我就没感觉到诅咒了」","art":{"background":"a211","sprites":[{"asset":"a956","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是吗，那就好」","art":{"background":"a211","sprites":[{"asset":"a956","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「你每天早上都问我啊」","art":{"background":"a211","sprites":[{"asset":"a923","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「毕竟很担心嘛，不过没事就好」","art":{"background":"a211","sprites":[{"asset":"a923","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"怨念消失，宿体归一，诅咒已经不复存在。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"之前宿体上还留下了别的怨念，但这次不一样。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"朝武家受到的诅咒已经全数被解除。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"所以那样的事情永远不会再发生了，就算我们接吻，朝武也不会长出耳朵。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"话是这么说……可我心底还是有些害怕。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「那我走了」","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……啊」","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我正准备走出起居室，朝武抓住了我的衣角。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……嗯？怎么了？」","art":{"background":"a211","sprites":[{"asset":"a1711","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「我说……你是不是忘了什么？」","art":{"background":"a211","sprites":[{"asset":"a1908","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我忘带什么了吗？」","art":{"background":"a211","sprites":[{"asset":"a1908","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「不是的，你忘了庆功……吻」","art":{"background":"a211","sprites":[{"asset":"a1909","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「呃，可是……」","art":{"background":"a211","sprites":[{"asset":"a1909","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"庆功吻，就是庆祝诅咒解除的吻。","art":{"background":"a211","sprites":[{"asset":"a1909","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我确实跟她约好了要重来一个庆功吻……","art":{"background":"a211","sprites":[{"asset":"a1909","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「可算上今天都第几次了？」","art":{"background":"a211","sprites":[{"asset":"a1909","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"怨念已经消失了好几天。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我自己也没有轻易放过接吻的机会，第二天就重来了一个庆功吻。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"可第二天，第三天，我都再次送出了庆功吻。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"而今天朝武也依然求我吻她。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「这、这是为了庆贺。这么可喜可贺的事情，多做几次又怎么了」","art":{"background":"a211","sprites":[{"asset":"a926","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「可这件事情真的很值得庆贺啊」","art":{"background":"a211","sprites":[{"asset":"a1733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「值得庆贺的事情确实可以庆贺很多次」","art":{"background":"a211","sprites":[{"asset":"a1733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我不由得点了点头。","art":{"background":"a211","sprites":[{"asset":"a1733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我很高兴能被她索吻，我没有什么不乐意的。","art":{"background":"a211","sprites":[{"asset":"a1733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"朝武的嘴唇软软的，碰上去的一瞬，我全身都能感到甜甜的香气……好舒服。","art":{"background":"a211","sprites":[{"asset":"a1733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「那么……嗯」","art":{"background":"a211","sprites":[{"asset":"a1725","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「在这之前我先确认一下」","art":{"background":"a211","sprites":[{"asset":"a1725","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……嗯？什么？」","art":{"background":"a211","sprites":[{"asset":"a926","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"朝武露出一脸扫兴的表情，颇为不满地抬头看着我。","art":{"background":"a211","sprites":[{"asset":"a926","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我先问问你，你应该不是为了照顾我的心情而在勉强自己吧？」","art":{"background":"a211","sprites":[{"asset":"a926","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……勉强自己？」","art":{"background":"a211","sprites":[{"asset":"a935","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我的意思是，你该不会是为了迎合我而强迫自己索吻吧……我有点担心」","art":{"background":"a211","sprites":[{"asset":"a935","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「你在瞎说什么呢，谁会强迫自己去索吻啊」","art":{"background":"a211","sprites":[{"asset":"a1723","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「我只是想跟喜欢的人接吻而已……」","art":{"background":"a211","sprites":[{"asset":"a1717","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「啊！我好像莫名其妙被你套出了什么很羞耻的话！？」","art":{"background":"a211","sprites":[{"asset":"a1763","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我不是这个意思」","art":{"background":"a211","sprites":[{"asset":"a1763","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「而且能听见你的真心话，我很开心」","art":{"background":"a211","sprites":[{"asset":"a1763","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……呜……你是故意让我说出来拿我取乐的吧？」","art":{"background":"a211","sprites":[{"asset":"a1910","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我可没这么坏心眼」","art":{"background":"a211","sprites":[{"asset":"a1910","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……真可疑……你明明就很坏心眼」","art":{"background":"a211","sprites":[{"asset":"a1911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我倒完全没有这个意思……」","art":{"background":"a211","sprites":[{"asset":"a1911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"想到刚才她那不满的神情，我觉得自己确实是担心过头了。","art":{"background":"a211","sprites":[{"asset":"a1911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「要是让你不开心那就没法接吻了，我不会做那种事的」","art":{"background":"a211","sprites":[{"asset":"a1911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……真下流……」","art":{"background":"a211","sprites":[{"asset":"a1711","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「可不知怎的，你这句话还挺有说服力的」","art":{"background":"a211","sprites":[{"asset":"a446","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「所以，把脸转过来吧……」","art":{"background":"a211","sprites":[{"asset":"a446","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我用手扶着她的脸，让她转头看向我。","art":{"background":"a211","sprites":[{"asset":"a432","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"朝武的身体很紧张，绷得紧紧的，她双颊泛红，眼睛水灵灵的，嘴唇也很光润。","art":{"background":"a211","sprites":[{"asset":"a432","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"她的一切都太可爱、太可爱了……接着，她慢慢合上了眼。","art":{"background":"a211","sprites":[{"asset":"a432","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……嗯……」","art":{"background":"a211","sprites":[{"asset":"a439","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我轻轻抱住她，回应她无言的期待，开始品尝她的唇。","art":{"background":"a1912","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"不对，容我修正一下。","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"现在我的生活比之前更加甜蜜。","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「有地，这是今天的便当，拿去吧」","art":{"background":"a211","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「谢谢你！朝武」","art":{"background":"a211","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"朝武交给我的便当盒重得恰到好处，这让我很是期待。","art":{"background":"a211","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"今天的配菜都是些什么呢♪","art":{"background":"a211","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「主人，你整张脸都酥了啊」","art":{"background":"a211","sprites":[{"asset":"a812","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「这可不是吗」","art":{"background":"a211","sprites":[{"asset":"a812","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「也别太期待了吧……虽然我没有偷工减料，可里面的东西跟平时都是一样的啊」","art":{"background":"a211","sprites":[{"asset":"a711","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「我有在注意做得不容易吃腻，但毕竟我没什么经验」","art":{"background":"a211","sprites":[{"asset":"a907","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「这样才好啊」","art":{"background":"a211","sprites":[{"asset":"a907","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我知道你在努力。我吃下去就会感觉到的」","art":{"background":"a211","sprites":[{"asset":"a1491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我能感觉到你在为了我而努力，我很开心」","art":{"background":"a211","sprites":[{"asset":"a1491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「每次感受到你的心意，我都会觉得便当变得越来越好吃。真是太谢谢你了，朝武」","art":{"background":"a211","sprites":[{"asset":"a1491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「没事，你开心……我也开心」","art":{"background":"a211","sprites":[{"asset":"a706","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我当然开心」","art":{"background":"a211","sprites":[{"asset":"a706","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我们彼此对视着。朝武的脸上带着羞涩的笑容。","art":{"background":"a211","sprites":[{"asset":"a492","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"她笑得这么开心，想必内心肯定也很开心。","art":{"background":"a211","sprites":[{"asset":"a492","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"上次我们也经历过从诅咒中解放出来的事情。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"可这次不一样的是，我们可以确信诅咒肯定消失了。这一点朝武能更切身地体会到。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我不知道那时承受了怨念诅咒的她究竟遇到了什么。","art":{"background":"a120","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"但我记得朝武的表情就像放下了什么担子，安晴叔叔的表情也像是心里的一块石头落了地。","art":{"background":"a120","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我问过她究竟是怎么回事，但她并没有回答我。","art":{"background":"a120","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「保密」","art":{"background":"a120","sprites":[{"asset":"a1913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"朝武用可爱的笑容蒙混过去了。","art":{"background":"a120","sprites":[{"asset":"a1913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"要说我不在意，那不可能。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"可看着现在她这开朗的表情，我觉得自己已经很满足了。","art":{"background":"a211","sprites":[]},"chapter":"6-1"},{"speaker":"丛雨","text":"「啊，热死了热死了」","art":{"background":"a211","sprites":[{"asset":"a474","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「今年的夏天来得真早」","art":{"background":"a211","sprites":[{"asset":"a474","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a703","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……」","art":{"background":"a211","sprites":[{"asset":"a1647","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「感觉两位越来越大胆，越来越坦率了啊」","art":{"background":"a211","sprites":[{"asset":"a248","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a491","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「最近他们的午餐都是两个人单独吃的」","art":{"background":"a211","sprites":[{"asset":"a248","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a600","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「那可真是大胆啊」","art":{"background":"a211","sprites":[{"asset":"a263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「你以为这怪谁啊，嗯？」","art":{"background":"a211","sprites":[{"asset":"a694","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「我跟有地什么也不做的时候，你们一个个都问我们为什么不卿卿我我」","art":{"background":"a211","sprites":[{"asset":"a1490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「所以我们才不再遮遮掩掩的了啊」","art":{"background":"a211","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「是啊。哎，你们俩刻意想掩饰的扭捏模样其实挺搞笑的」","art":{"background":"a211","sprites":[{"asset":"a359","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a744","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「爸、爸爸……」","art":{"background":"a211","sprites":[{"asset":"a359","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a594","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「别误会，我没有取笑的意思」","art":{"background":"a211","sprites":[{"asset":"a245","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a594","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「我就是觉得在旁人看来当年我跟秋穗也是这样的啊。因为我也被开了好久的玩笑」","art":{"background":"a211","sprites":[{"asset":"a248","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「看着你们俩我就觉得啊，假惺惺地掩饰确实会惹旁人吃味」","art":{"background":"a211","sprites":[{"asset":"a358","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「想亲热就别害羞，还是堂堂正正的比较好」","art":{"background":"a211","sprites":[{"asset":"a359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「堂堂正正地亲热……」","art":{"background":"a211","sprites":[{"asset":"a359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「不过呢，常识性的东西，该考虑的还是要考虑的」","art":{"background":"a211","sprites":[{"asset":"a309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「比如，在别人能看见的地方接吻确实有些过分了。肯定会被人说闲话的」","art":{"background":"a211","sprites":[{"asset":"a304","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「是啊，毕竟也有很多密闭空间嘛」","art":{"background":"a211","sprites":[{"asset":"a1472","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「先不说什么密闭空间，在人面前我可没勇气做这种事」","art":{"background":"a211","sprites":[{"asset":"a1472","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「哈哈哈，不过如果不是在别人面前接吻那我也没意见。毕竟你们俩是情侣，还订了婚呢」","art":{"background":"a211","sprites":[{"asset":"a248","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"安晴","text":"「就算听见什么奇怪的声音，我也不会推开隔扇的」","art":{"background":"a211","sprites":[{"asset":"a359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「奇怪的声音？奇怪的声音……奇怪的声音……奇怪的声音……」","art":{"background":"a211","sprites":[{"asset":"a800","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……你、你该不会是在说……」","art":{"background":"a211","sprites":[{"asset":"a1514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「本座也会乖乖离开的，放心吧」","art":{"background":"a211","sprites":[{"asset":"a812","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……你们果然是在开我玩笑！」","art":{"background":"a211","sprites":[{"asset":"a1514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「爸爸真是的……」","art":{"background":"a493","sprites":[{"asset":"a1490","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「算啦，这也算是某种祝福」","art":{"background":"a493","sprites":[{"asset":"a1490","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「要是莫名其妙被反对，事情变得麻烦，那样才更棘手」","art":{"background":"a493","sprites":[{"asset":"a1490","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"可是讲荤段子的话，我确实也不知道该怎么接话茬。","art":{"background":"a493","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"而且安晴叔叔是她爸，我就更不知道该怎么办了。这么随意的岳父也很难办啊。","art":{"background":"a493","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"虽然确实也挺好的。","art":{"background":"a493","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……真好吃！」","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「谢谢，粗茶淡饭而已啦」","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我在蓝天下盖上了便当盒的盖子。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"一旁的朝武也刚好吃完，双手合十。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我们俩单独在这里吃午餐。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「今天的便当也很好吃。特别是那汉堡肉！」","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「啊……抱歉，我只会说好吃这个词」","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「但这只是我词穷，我并不是随便应付的」","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「没关系，这我都知道的」","art":{"background":"a498","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「真的吗？那就好」","art":{"background":"a498","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「以前我还会怀疑，但现在不一样了」","art":{"background":"a498","sprites":[{"asset":"a510","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「因为我们变成恋人了？」","art":{"background":"a498","sprites":[{"asset":"a510","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「这也是原因之一……最主要的是看着你的表情，我就觉得没必要听你的感想了」","art":{"background":"a498","sprites":[{"asset":"a589","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「有那么明显？」","art":{"background":"a498","sprites":[{"asset":"a589","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「那当然了，我都看得出来」","art":{"background":"a498","sprites":[{"asset":"a706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"早上接吻，中午单独吃饭。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"就这样，我们知道了彼此陌生的一面。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"虽然这是一个缓慢的过程，但我知道我们俩肯定正在共同向前迈进。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"并且，我们之间的距离也在不断拉近。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"拉进了心灵的距离后，我也能更清晰地体会到朝武的想法。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……嗯……」","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"我伸出手，握住朝武的手。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"朝武吓了一跳，脸稍稍红了一下，但她并没有甩开我的手。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……」","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"她反倒翻过手来，用手指缠住我的手指。","art":{"background":"a498","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「这点动作……让人看见应该也不会被骂吧？」","art":{"background":"a498","sprites":[{"asset":"a1914","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「应该吧」","art":{"background":"a498","sprites":[{"asset":"a1914","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「不过……再进一步的话，万一被人看见就糟糕了」","art":{"background":"a498","sprites":[{"asset":"a1510","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「接吻是不太好。要是让老师知道了，那肯定还是少不了一番说教」","art":{"background":"a498","sprites":[{"asset":"a1510","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……是啊，不过……唔」","art":{"background":"a498","sprites":[{"asset":"a1508","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a1508","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「像这样身体贴在一起……应该没问题吧？毕竟是情侣……」","art":{"background":"a498","sprites":[{"asset":"a1915","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是、是啊」","art":{"background":"a498","sprites":[{"asset":"a1915","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我们将整个手臂贴在一起。","art":{"background":"a498","sprites":[{"asset":"a1915","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"朝武似乎将热量传导到了我身上，我碰着她的半边身子变烫了。","art":{"background":"a498","sprites":[{"asset":"a1915","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"这股热度几乎让我一时不知说什么才好。","art":{"background":"a498","sprites":[{"asset":"a1915","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……好暖」","art":{"background":"a498","sprites":[{"asset":"a1916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「嗯……」","art":{"background":"a498","sprites":[{"asset":"a1916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我只能做出这么简朴的回应。","art":{"background":"a498","sprites":[{"asset":"a1916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"但这样就够了。","art":{"background":"a498","sprites":[{"asset":"a1916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"因为牵在一起的手还有彼此的体温已经在无言中传达了情意。","art":{"background":"a498","sprites":[{"asset":"a1916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a1916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"尽管什么也没说，但我们并没有觉得气氛沉重。","art":{"background":"a498","sprites":[{"asset":"a1916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"就这样，我们沉浸在幸福之中，度过了一段只属于我们两个的时间。","art":{"background":"a498","sprites":[{"asset":"a1916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-58.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"但并不是只有午休时才有这样的2人时光。","art":{"background":"a1","sprites":[]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「都这么晚了啊」","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「好，今天就到这里吧」","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「谢谢您」","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"玄十郎","text":"「那明天见吧」","art":{"background":"a1478","sprites":[{"asset":"a602","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是」","art":{"background":"a1478","sprites":[{"asset":"a602","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我跟外公道别，然后东张西望起来。","art":{"background":"a1478","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"接着……","art":{"background":"a1478","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「啊，找到了」","art":{"background":"a1478","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「有地，你辛苦了」","art":{"background":"a1478","sprites":[{"asset":"a706","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「抱歉让你久等了」","art":{"background":"a1478","sprites":[{"asset":"a706","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「没事，我也没等太久」","art":{"background":"a1478","sprites":[{"asset":"a1491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「那我们走吧」","art":{"background":"a1478","sprites":[{"asset":"a1491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我们一道走在夕阳下。","art":{"background":"a1482","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"手上传来柔软温暖的触感。","art":{"background":"a1482","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「马上就要到家了」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……要不再去别处转转？」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「不必了吧，再转就要转到山里去了」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「是哦」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"这附近几乎只有一条路。","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"即使走到别的路里去，早晚也要原路折返。","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"否则就只能跑进山里走一圈了。","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「而且……现在我们已经随时都能牵手了」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「是啊」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「我喜欢和你牵手」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「我也喜欢你的手的触感……」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「我常锻炼，很粗糙吧？最近生出来的茧应该开始变硬了」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「我喜欢这个，又硬，又大，又有力……」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「能让我感觉到，我正跟喜欢的人联系在一起」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"换个人说的话，这根本就是黄色笑话了吧。","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"想到这里，我不禁咽了口口水。","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"不过，其实光是跟朝武牵着手，我就已经很激动了。","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「你的手真软」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……是吗？这还是第一次有人这样说我」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「话是这么说，但我也不经常跟人牵手……所以也难怪是第一次吧」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「我也是，至今为止我只跟你频繁地牵过手」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「每次体验过去没经历过的事情……我就会真切地感觉到，我真的在跟你交往」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「一起牵手回家也是，一起吃饭也是，还有……接吻也是」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「你别不说话啊……这样会让我更加害羞的」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「抱歉抱歉，你就当我是默认了吧」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「既然要认，那就该说出来，不然我会担心的」","art":{"background":"a1917","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「我也一样」","art":{"background":"a1917","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「跟你一起去探索不知道的事情，我很开心」","art":{"background":"a1917","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……是啊」","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"就这样，我们又陷入了午休时一样的沉默。","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"但这同样并不沉重。甚至可以说，现在这种心动的感觉让我很舒心。","art":{"background":"a1531","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"体验这种从未体验过的事情让我很开心。","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"这一定是因为我能感受到我们俩至今为止积累的回忆。","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"每次感受到这个，我都觉得我们的心灵又靠近了一点。我在感到幸福的同时……","art":{"background":"a580","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"也因此感到揪心的苦闷。","art":{"background":"a580","sprites":[]},"chapter":"6-1"}]