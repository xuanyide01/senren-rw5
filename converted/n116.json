[{"speaker":"","text":"上山之后，我试着用手刨土。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"没刨多久，就刨出了我们想找的透明石头碎片。","art":{"background":"a1234","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「怎么样，找到了吗？」","art":{"background":"a1085","sprites":[{"asset":"a435","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「嗯，找到了」","art":{"background":"a1085","sprites":[{"asset":"a435","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「太好了」","art":{"background":"a1085","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「等一下。我先看看有没有弄错」","art":{"background":"a1085","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我从口袋里取出了比之前更大的碎片。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"这其中有我最初捡到的碎片和小雨找到的碎片。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"也有蕾娜的碎片。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"把那三块碎片合为一体之后，又过了近三周。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"在这期间，小雨又在山中找到了两块碎片。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"除此之外还进行了两次祓禊，每次消灭祟神后都回收了一块碎片。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"现在这七块碎片聚合成了一个宿体。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"现在，我将刚找到的碎片拿到了宿体旁边——","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"只见碎片开始散发光芒，就像是被宿体吸收了一样，慢慢与它合在一起。","art":{"background":"a1266","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"一眨眼的功夫，宿体又稍微变大了一圈。","art":{"background":"a1266","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「变大的速度是越来越慢了啊……」","art":{"background":"a1266","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「不过肉眼能观察出它的变化就是好事啦」","art":{"background":"a1085","sprites":[{"asset":"a956","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a251","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「一开始它还只是个小小的碎片呢」","art":{"background":"a1085","sprites":[{"asset":"a953","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a251","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"确实，反正也只能一点点脚踏实地来做了。","art":{"background":"a1085","sprites":[{"asset":"a953","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a251","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「丛雨大人，您没有找到别的碎片吗？」","art":{"background":"a1085","sprites":[{"asset":"a263","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a449","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「……没找到。本座只能地毯式搜索……要是有效率更高的方法就好了」","art":{"background":"a1085","sprites":[{"asset":"a261","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a449","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「没辙。我们也想不到别的办法」","art":{"background":"a1085","sprites":[{"asset":"a261","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a449","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「我没能帮上忙，真的很抱歉」","art":{"background":"a1085","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「天天让你帮忙，实在是对不住」","art":{"background":"a1085","sprites":[{"asset":"a263","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a957","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「不积跬步，无以成千里。只要能帮上你们的忙，本座就已经很高兴了」","art":{"background":"a1085","sprites":[{"asset":"a129","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a957","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「……谢谢你」","art":{"background":"a1085","sprites":[{"asset":"a129","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a957","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「太感谢您了」","art":{"background":"a1085","sprites":[{"asset":"a429","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「哎呀不要摆出那么严肃的表情说这种话」","art":{"background":"a1085","sprites":[{"asset":"a549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「这……这样不是让本座很难为情吗……行了！趁着天没黑赶紧下山」","art":{"background":"a1085","sprites":[{"asset":"a1267","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「懂啦懂啦」","art":{"background":"a1085","sprites":[{"asset":"a1267","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"正当我把碎片收入口袋中，准备与众人一同下山时——","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我突然回过头去。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"不过我并未发现有什么异样。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「有地？你怎么了？」","art":{"background":"a1085","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「呃，怎么说呢……我感觉好像有人在叫我」","art":{"background":"a1085","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「我没听到有什么声音啊」","art":{"background":"a1085","sprites":[{"asset":"a321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「不，也不是说我听到了谁的声音」","art":{"background":"a1085","sprites":[{"asset":"a321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"可能是错觉吧。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"心里虽然这么想……但总感觉怪怪的。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"于是我朝着身后的方向定睛看去。看了一会儿，突然感觉双腿一软。","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1085","sprites":[]},"chapter":"3-5"},{"speaker":"丛雨","text":"「主人？」","art":{"background":"a1085","sprites":[{"asset":"a263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「有点眼晕……」","art":{"background":"a1085","sprites":[{"asset":"a263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「是身体不太好吗？」","art":{"background":"a1085","sprites":[{"asset":"a926","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「早上训练的时候感觉很正常，也没有发热的迹象」","art":{"background":"a1085","sprites":[{"asset":"a926","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「嗯……呃啊，哈……」","art":{"background":"a1085","sprites":[{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"正当我感到疑惑时，视线的余光瞥见了突然浑身颤抖的朝武。","art":{"background":"a1085","sprites":[{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「芳乃大人？」","art":{"background":"a1085","sprites":[{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a550","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「这难道是……」","art":{"background":"a1085","sprites":[{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a550","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"这时，朝武的身躯猛地一震。","art":{"background":"a1085","sprites":[{"asset":"a1268","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"耳朵“噗呲”一声就出现在了她的头顶上。","art":{"background":"a1085","sprites":[{"asset":"a1268","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「呼，呼……呼……」","art":{"background":"a1085","sprites":[{"asset":"a1268","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「没事吧，芳乃」","art":{"background":"a1085","sprites":[{"asset":"a549","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a310","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「没事……我只是在耳朵出现的时候才会有奇怪的感觉」","art":{"background":"a1085","sprites":[{"asset":"a549","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1269","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「总之还是赶快下山为妙」","art":{"background":"a1085","sprites":[{"asset":"a1175","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1269","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"于是我们立刻下了山，决定到了晚上再来。不过……","art":{"background":"a1","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a528","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我还是很在意那时候的感觉……","art":{"background":"a528","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"虽说朝武长出兽耳就是祟神现身的前兆。","art":{"background":"a528","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「（可是以前这种时候我都没什么感觉……难道是因为这次在山里面，距离很近吗？）」","art":{"background":"a528","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"这种可能性确实很高，可为什么我会觉得被人叫了一声呢？","art":{"background":"a528","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"唔……总感觉哪里不对劲。","art":{"background":"a528","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「有地，你在想什么？」","art":{"background":"a498","sprites":[{"asset":"a479","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「啊，没事」","art":{"background":"a498","sprites":[{"asset":"a479","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「你很在意山上发生的事吗？」","art":{"background":"a498","sprites":[{"asset":"a480","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「我看你上课的时候好像也在想山上的事」","art":{"background":"a498","sprites":[{"asset":"a1270","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「被你看出来了？」","art":{"background":"a498","sprites":[{"asset":"a1270","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「那是当然。我可是忍者呀」","art":{"background":"a498","sprites":[{"asset":"a491","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「上课的时候不能这样开小差哦」","art":{"background":"a498","sprites":[{"asset":"a497","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「道理我都懂」","art":{"background":"a498","sprites":[{"asset":"a497","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「你竟然这么在意那件事……难道说你感觉到了什么巨大的危险？」","art":{"background":"a498","sprites":[{"asset":"a874","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「不，那倒不是」","art":{"background":"a498","sprites":[{"asset":"a874","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我并没有感觉到什么，只是在想下次必须要多加注意罢了」","art":{"background":"a498","sprites":[{"asset":"a874","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「那就好……」","art":{"background":"a498","sprites":[{"asset":"a595","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a595","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我倒是还有点担心你呢，我看你和以平时比起来都没什么精神。没出什么事吧？」","art":{"background":"a498","sprites":[{"asset":"a595","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「是吗？我自己没什么感觉啊……」","art":{"background":"a498","sprites":[{"asset":"a1271","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「其实我还是很担心。因为我现在受了伤，只能老老实实呆着」","art":{"background":"a498","sprites":[{"asset":"a1272","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"常陆的伤势一直未见痊愈。驹川大夫的复诊也证明了这一点。","art":{"background":"a498","sprites":[{"asset":"a1272","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我懂你的感受」","art":{"background":"a498","sprites":[{"asset":"a1272","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我起初也是因为这个才主动帮忙的。","art":{"background":"a498","sprites":[{"asset":"a1272","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「没事。我会负责保护朝武的！你就只管放心好了」","art":{"background":"a498","sprites":[{"asset":"a1272","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「好吧，这话可能没什么说服力。不过我还是希望你能信任我」","art":{"background":"a498","sprites":[{"asset":"a1272","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「哪里！我并没有不信任你，只是……」","art":{"background":"a498","sprites":[{"asset":"a868","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「既然信任我，那你就老老实实地养伤吧。一言为定啊」","art":{"background":"a498","sprites":[{"asset":"a868","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「……好吧。我向你保证」","art":{"background":"a498","sprites":[{"asset":"a476","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"}]