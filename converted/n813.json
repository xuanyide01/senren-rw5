[{"speaker":"将臣","text":"「啊啊————……」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"终于上完了一天的课程，我坐在椅子上大大地伸了个懒腰。","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「该出发了……」","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「今天是要上班？还是要跟平胸妹去约会？」","art":{"background":"a599","sprites":[{"asset":"a515","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「都跟你说了，不要老是说这种话」","art":{"background":"a599","sprites":[{"asset":"a515","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「你就这么想惹小春生气吗？」","art":{"background":"a599","sprites":[{"asset":"a515","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「兄妹就是这种样子啦」","art":{"background":"a599","sprites":[{"asset":"a499","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「难道兄妹之间的交流就是这么一回事吗？」","art":{"background":"a599","sprites":[{"asset":"a499","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「就是这么一回事啦。天天缠在一起才奇怪」","art":{"background":"a599","sprites":[{"asset":"a736","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"就算这样，我觉得也没必要故意挑衅对方吧……难道就该是这样吗？","art":{"background":"a599","sprites":[{"asset":"a736","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"话说，他们之间从很久之前就是这种关系了。","art":{"background":"a599","sprites":[{"asset":"a736","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我实在是无法想象，事到如今还怎么让他们变成关系融洽的好兄妹。","art":{"background":"a599","sprites":[{"asset":"a736","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「所以你到底上不上班？」","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「上啊。所以不好意思，我没时间陪你慢慢聊了」","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「嗯，没事。别在意我。我只是问问而已」","art":{"background":"a599","sprites":[{"asset":"a517","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「顺便问下，你今天有什么安排？」","art":{"background":"a599","sprites":[{"asset":"a517","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「我？」","art":{"background":"a599","sprites":[{"asset":"a745","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"一丰","text":"「喂，鞍马，快点走啦」","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"忠兴","text":"「我们先走一步了，别迟到啊」","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「好，我知道了」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「你准备和他们去什么地方吗？」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「嗯。想去城里逛逛，寻找新的邂逅」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊……去搭讪啊」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"怪不得不喊我一起去。","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"因为我可是已经有小春这个最可爱最棒的女朋友了。","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「很稀罕啊，你竟然出远门去城里」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「那是因为那两个人不停求我让他们见识一下我的搭讪技巧」","art":{"background":"a599","sprites":[{"asset":"a515","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「而且新手在本地周边搭讪还是有各种风险的嘛」","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊……」","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我眼前正好有个不注意规避风险的实例。","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「所以我们就决定去城里了」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我说，你们现在去真的来得及吗？」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「难得有次机会，我们准备顺便买点东西，所以会在那边住一晚」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是这样吗？」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「虽然我对搭讪没啥兴趣……但住一晚好像很有意思」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「没事，等下次有机会我再喊你」","art":{"background":"a599","sprites":[{"asset":"a515","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯，一定别忘了」","art":{"background":"a599","sprites":[{"asset":"a515","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「那我走了」","art":{"background":"a599","sprites":[{"asset":"a3028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「祝你一切顺利」","art":{"background":"a599","sprites":[{"asset":"a3028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"啊……现在可不是我呆呆地目送廉太郎出发的时候。","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"小春","text":"「哥哥，今天你有排班吧？我们赶快出发吧」","art":{"background":"a599","sprites":[{"asset":"a1655","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯，我知道了」","art":{"background":"a599","sprites":[{"asset":"a1655","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「谢谢惠顾」","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"这一天的工作也顺利地结束了。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"干了这么久我早已经干习惯了，我相信现在的自己对甜品屋很有用处。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「好了，赶快收拾收拾吧」","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"小春","text":"「那我来打扫卫生」","art":{"background":"a1700","sprites":[{"asset":"a3700","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「辛苦了」","art":{"background":"a1700","sprites":[{"asset":"a3700","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a985","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「对了，小春。刚才你手机响了」","art":{"background":"a1700","sprites":[{"asset":"a1012","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a991","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「哎？难道说我忘记调成振动模式了吗？」","art":{"background":"a1700","sprites":[{"asset":"a1031","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a991","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「没事，声音还没大到会传到大厅里……话说，看它响了那么久是不是有人给你打电话啊？」","art":{"background":"a1700","sprites":[{"asset":"a1031","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1692","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「这里先别弄了你快去看看吧」","art":{"background":"a1700","sprites":[{"asset":"a1031","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a994","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「嗯。谢谢姐姐」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a994","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"小春急急忙忙地走进后场去了。","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"电话……会是什么人打的……？","art":{"background":"a1700","sprites":[{"asset":"a994","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「别那么担心，不会是其他男人啦。小春才不是那种女孩」","art":{"background":"a1700","sprites":[{"asset":"a1583","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哎！？难道说……我都写在脸上了？」","art":{"background":"a1700","sprites":[{"asset":"a1583","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「写得很清楚哦」","art":{"background":"a1700","sprites":[{"asset":"a1566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我也不是怀疑她……只是不管怎么说总是有点在意嘛……」","art":{"background":"a1700","sprites":[{"asset":"a1566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「我也明白你的想法。啊，她回来了」","art":{"background":"a1700","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是谁的电话？」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「是我妈妈打来的。她说她有个熟人去世了，今晚要去守夜和参加葬礼」","art":{"background":"a1700","sprites":[{"asset":"a980","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……哎？我记得今天廉太郎好像是出去玩了，而且还准备在外面住一晚吧？」","art":{"background":"a1700","sprites":[{"asset":"a980","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「嗯」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「也就是说今天只有小春一个人在家吗？我有点担心……而且你吃饭怎么办？」","art":{"background":"a1700","sprites":[{"asset":"a4073","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「我妈妈已经跟爷爷说过了，应该是没关系吧……」","art":{"background":"a1700","sprites":[{"asset":"a1682","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「……（偷看）……」","art":{"background":"a1700","sprites":[{"asset":"a4358","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……？」","art":{"background":"a1700","sprites":[{"asset":"a4358","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「今天都住满了，没有多余的房间了。所以你可以去将臣的房间睡吗」","art":{"background":"a3739","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「……」","art":{"background":"a3739","sprites":[{"asset":"a4111","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……」","art":{"background":"a3739","sprites":[{"asset":"a4111","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「怎么？有什么问题吗？」","art":{"background":"a3739","sprites":[{"asset":"a90","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊，没有。没有问题，当然没有，根本没有」","art":{"background":"a3739","sprites":[{"asset":"a90","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「嗯。那就拜托你了」","art":{"background":"a3739","sprites":[{"asset":"a602","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……」","art":{"background":"a3739","sprites":[{"asset":"a602","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「……」","art":{"background":"a4007","sprites":[{"asset":"a4164","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……」","art":{"background":"a4007","sprites":[{"asset":"a4164","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那，那个……没想到我们突然就两个人独处了」","art":{"background":"a4007","sprites":[{"asset":"a4164","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「嗯……嗯，是啊」","art":{"background":"a4007","sprites":[{"asset":"a4359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"突然两人独处……我现在依然有些紧张。","art":{"background":"a4007","sprites":[{"asset":"a4359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"而且……我们今天晚上要在这里一起睡觉。","art":{"background":"a4007","sprites":[{"asset":"a4359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"一想到这一点……","art":{"background":"a4007","sprites":[{"asset":"a4359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我说……小春」","art":{"background":"a4007","sprites":[{"asset":"a4359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「怎、怎么了？哥哥？」","art":{"background":"a4007","sprites":[{"asset":"a4360","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那个……今天你要住在这，而且只有我们两个人不是吗？」","art":{"background":"a4007","sprites":[{"asset":"a4360","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「是这样没错……」","art":{"background":"a4007","sprites":[{"asset":"a4159","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我事先确认一下……我，那个……做些……剧烈的运动，也可以吗？」","art":{"background":"a4007","sprites":[{"asset":"a4159","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「剧、剧烈的运动……我都没想到你会问这种事情」","art":{"background":"a4007","sprites":[{"asset":"a4159","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是吗？难道说……我有点激动过头了？」","art":{"background":"a4007","sprites":[{"asset":"a4159","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「不如说……激动过头的，可能……是我」","art":{"background":"a4007","sprites":[{"asset":"a4243","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「你这话是什么意思？」","art":{"background":"a4007","sprites":[{"asset":"a4243","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「所以说，那个……我以为，你根本不会问这种问题……而是会直接做些剧烈的运动的」","art":{"background":"a4007","sprites":[{"asset":"a4131","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……」","art":{"background":"a4007","sprites":[{"asset":"a4131","position":"中","x":0,"y":0,"z