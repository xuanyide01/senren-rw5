aker":"小春","text":"「哥、哥哥……」","art":{"background":"a4007","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「小春……」","art":{"background":"a4007","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"小春","text":"「嘿、嘿嘿……那就拜托你了……」","art":{"background":"a4007","sprites":[{"asset":"a4335","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯」","art":{"background":"a4007","sprites":[{"asset":"a4335","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"}]