[{"speaker":"芦花・小春","text":"『打扰了～』","art":{"background":"a4007","sprites":[{"asset":"a3321","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a44","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「请进。这里不是我家，没必要这么客气」","art":{"background":"a4007","sprites":[{"asset":"a3321","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a44","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「抱歉了，这么晚了还来打扰你」","art":{"background":"a4007","sprites":[{"asset":"a66","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a15","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「店里工作要紧，这也是没办法的。总之先随便坐吧」","art":{"background":"a4007","sprites":[{"asset":"a66","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a15","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「真干净啊。是旅馆的人在帮你打扫吗？」","art":{"background":"a4007","sprites":[{"asset":"a61","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a15","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「没有，除了做饭之外，其他事都是我自己在搞」","art":{"background":"a4007","sprites":[{"asset":"a61","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a15","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「总不能什么事情都麻烦旅馆吧」","art":{"background":"a4007","sprites":[{"asset":"a61","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a29","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「哟呵……没想到你现在这么能干了。我记得小时候你只知道粘着我」","art":{"background":"a4007","sprites":[{"asset":"a61","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a104","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「小、小时候的事情跟现在有什么关系嘛！」","art":{"background":"a4007","sprites":[{"asset":"a61","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a104","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「赶紧先说正事吧」","art":{"background":"a4007","sprites":[{"asset":"a61","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a104","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「好的好的。我都准备好了」","art":{"background":"a4007","sprites":[{"asset":"a33","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"芦花姐一边说着，一边将各种磨好的咖啡豆摆在桌子上。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「姐姐，这些都是你选的味道吗？」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a33","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我参考供货商给的建议，尝试了许多品种和配比之后选了这些」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a36","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"在我提出咖啡的提案之后已经过了快一个星期。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"芦花姐行动得比我想象中更快，在那之后她立刻去找了供货商。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"她让对方提供了好几种配方，并亲自确认了每一种的味道。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"然后在其中选了几种，拜托我们来一起品尝。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「芦花姐，没想到你这么快就把想法付诸实践了」","art":{"background":"a4007","sprites":[{"asset":"a33","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「还好吧。我们店也没多大规模，能马上做的事情还是马上做掉比较好」","art":{"background":"a4007","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「但是，为什么要在哥哥的房间里试饮？既然要试饮，在店里试不是更方便吗？」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我是不想被爸爸看见」","art":{"background":"a4007","sprites":[{"asset":"a27","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我最讨厌事情做到一半的时候被人指手画脚」","art":{"background":"a4007","sprites":[{"asset":"a28","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「嗯……这种感觉我懂」","art":{"background":"a4007","sprites":[{"asset":"a28","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「所以，我想直接把最终结果展示给他，问他到底行不行」","art":{"background":"a4007","sprites":[{"asset":"a27","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「这倒是没问题……但我真的能帮上忙吗？」","art":{"background":"a4007","sprites":[{"asset":"a2976","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a29","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「因为我自己会瞎想各种多余的事情，所以需要一个能凭第一感觉对味道做出评价的人」","art":{"background":"a4007","sprites":[{"asset":"a2976","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a36","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「只是这样的话我倒是也能做」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a36","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「那就拜托你们了」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a28","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「没事，我本来就是姐姐店里的员工，肯定会帮忙的」","art":{"background":"a4007","sprites":[{"asset":"a95","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a28","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「我也是。既然是我怂恿你做这个的，那我肯定会负责」","art":{"background":"a4007","sprites":[{"asset":"a95","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a28","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「谢谢你们。那我们现在就开始泡泡看吧」","art":{"background":"a4007","sprites":[{"asset":"a18","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「听说最开始的焖蒸是最重要的」","art":{"background":"a4007","sprites":[{"asset":"a4","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"她只倒了一点点热水，咖啡的香气就已飘散开来。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「嗯～……香味真不错」","art":{"background":"a4007","sprites":[{"asset":"a4078","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「喝速溶咖啡是绝对体验不到这种泡咖啡的乐趣的」","art":{"background":"a4007","sprites":[{"asset":"a4078","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「我爸爸有时也会喝速溶咖啡，那可没有这么棒的味道」","art":{"background":"a4007","sprites":[{"asset":"a3733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「这就是速溶和正宗咖啡的最大差别」","art":{"background":"a4007","sprites":[{"asset":"a33","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我可是专门请人教了我怎么冲泡的」","art":{"background":"a4007","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「要先这样小心翼翼地注入热水，还要注意不要泡出杂味……」","art":{"background":"a4007","sprites":[{"asset":"a38","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「如果店里确定要提供咖啡，那我也得好好学学才行了」","art":{"background":"a4007","sprites":[{"asset":"a3257","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a29","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「其实泡起来相当困难的。明明用的是同一种豆子，却泡不出相同的味道，这种事还是挺常见的」","art":{"background":"a4007","sprites":[{"asset":"a3257","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「是这样吗？听上去确实有些困难」","art":{"background":"a4007","sprites":[{"asset":"a3257","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「我能做到吗……突然有点没自信了」","art":{"background":"a4007","sprites":[{"asset":"a2978","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「只要好好练习的话肯定没问题的」","art":{"background":"a4007","sprites":[{"asset":"a2978","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a33","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「没事，反正还不确定是否正式上架呢」","art":{"background":"a4007","sprites":[{"asset":"a2978","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a33","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「阿将，你能不能不要说这种话」","art":{"background":"a4007","sprites":[{"asset":"a11","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我之所以这么认真，就是因为我以后想把咖啡当主推商品」","art":{"background":"a4007","sprites":[{"asset":"a27","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「说的也是，抱歉，是我说话没过脑子」","art":{"background":"a4007","sprites":[{"asset":"a27","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「你能明白就好。现在差不多可以尝尝了」","art":{"background":"a4007","sprites":[{"asset":"a4","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"她将三杯咖啡放在我面前。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"也将同样的三杯咖啡放在小春面前。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"芦花","text":"「请慢用。不过，请从左边的开始品尝」","art":{"background":"a4007","sprites":[{"asset":"a34","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春・将臣","text":"『我开动了～』","art":{"background":"a4092","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"我和小春将那杯咖啡端到嘴边。","art":{"background":"a4092","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"首先是轻微的苦味。随后，一丝酸味在口中扩散开来。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"这和速溶咖啡完全不一样。速溶咖啡怎么形容呢……感觉好像尝不清楚是什么味道。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"是苦还是酸，是淡还是浓，根本尝不出……当然也可能是我的冲泡方法有问题，或是选的咖啡种类有问题。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"但是这杯咖啡的味道我能尝出来，苦味跟酸味都非常明显。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"芦花","text":"「感觉怎样？」","art":{"background":"a4007","sprites":[{"asset":"a2982","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「——唔……嗯。感觉……还挺好喝的吧……还有就是香味很不错！」","art":{"background":"a4093","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a4093","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「香气是不错，但苦味是不是太重了？」","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「如果是配上甜食一起吃的话，应该会有不少人不加糖奶直接喝吧」","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"我一边说着，一边尝了口预先准备好的团子。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「啊，和团子的甜味还是蛮搭的」","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「哎？真的吗？我也来尝一口团子～（咬）……（嚼嚼）」","art":{"background":"a4094","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「哈，团子真好吃～……」","art":{"background":"a4095","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a4095","sprites":[]},"chapter":"4-4"},{"speaker":"芦花","text":"「是这样啊。那可能是有点浓了」","art":{"background":"a4007","sprites":[{"asset":"a46","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「那正中间这杯又怎么样呢？」","art":{"background":"a4007","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「这杯……我尝尝……啊，如果光喝咖啡的话，我比较喜欢这种酸苦平衡的」","art":{"background":"a4007","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「和团子……嗯，我觉得也蛮搭的。最后还有一丝余味，这种余味和团子也是挺搭的」","art":{"background":"a4007","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「这样吃团子的话，嗯，团子和咖啡两边的味道都有细微的变化」","art":{"background":"a4007","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「嗯嗯，原来如此。小春呢？」","art":{"background":"a4007","sprites":[{"asset":"a5","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「啊……这杯比较好入口。至于团子……」","art":{"background":"a4096","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「嗯嗯～团子也好好吃～……」","art":{"background":"a4097","sprites":[]},"chapter":"4-4"},{"speaker":"芦花","text":"「看来你们都比较喜欢中间这杯」","art":{"background":"a4097","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「那么，最后一杯……嗯……嗯嗯！？这杯是怎么回事，好好喝！」","art":{"background":"a4097","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「哎！？那我也来……（吸）……」","art":{"background":"a4096","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「啊！是真的，明明咖啡味特别浓却又容易入口……啊，咦？明明没放糖……却依然有甜味」","art":{"background":"a4098","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「好厉害，芦花姐！这杯咖啡比我至今为止喝过的所有咖啡都要好喝！」","art":{"background":"a4098","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「啊，但是……要说和团子搭不搭的话……唔」","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「虽然也不是完全不搭……但考虑到团子的话，我比较喜欢中间这杯」","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「我……我觉得……选中间或者右边这杯比较好」","art":{"background":"a4007","sprites":[{"asset":"a3262","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「这样啊。中间或右边啊……」","art":{"background":"a4007","sprites":[{"asset":"a32","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「有什么问题吗？」","art":{"background":"a4007","sprites":[{"asset":"a32","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「也不是多大的问题，只不过……右边那种，咖啡豆可是相当贵的」","art":{"background":"a4007","sprites":[{"asset":"a23","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「是吗，贵的果然不一样啊」","art":{"background":"a4007","sprites":[{"asset":"a23","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「嗯。味道确实和普通的咖啡不一样」","art":{"background":"a4007","sprites":[{"asset":"a64","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a5","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「这样啊……看来贵的东西都有它贵的道理」","art":{"background":"a4007","sprites":[{"asset":"a64","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a9","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「中间这种呢？这种也比较贵吗？」","art":{"background":"a4007","sprites":[{"asset":"a64","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a9","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「这种倒是一般。考虑到价格的话，这种混合配方倒是比较现实」","art":{"background":"a4007","sprites":[{"asset":"a4099","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「话说姐姐你觉得哪种比较好？」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a29","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我？说实话……我各种咖啡喝得太多，已经完全分不清味道了……只是感觉……这三种之中可能有比较合适的」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a4100","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「不过听了你们的意见之后，我感觉用中间这一种来一决胜负可能比较好」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「我觉得挺好的」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「我也觉得这样不错」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「你要是还不放心的话……要不也去问问外公他们？」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「对哦！这里的人够多！我这就去问一下」","art":{"background":"a4007","sprites":[{"asset":"a43","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「这当然是没问题，就是有人还在工作——」","art":{"background":"a4007","sprites":[{"asset":"a43","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「这点常识我还是有的。你们就好好享用咖啡和团子吧」","art":{"background":"a4007","sprites":[{"asset":"a44","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"芦花姐说完就拿起咖啡豆粉跑掉了。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「……那么……我去趟厨房，小春你在这里等我」","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「哎？啊，嗯……不过为什么要去厨房？」","art":{"background":"a4007","sprites":[{"asset":"a61","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「好了。让你久等了」","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"我一边说着，一边把牛奶和砂糖放到桌子上。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「虽然只是普通的牛奶，但总比没有要好吧？」","art":{"background":"a4101","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「哥哥？」","art":{"background":"a4101","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「小春，其实你几乎尝不出咖啡的味道吧？」","art":{"background":"a4101","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「唔……这个……是的」","art":{"background":"a4102","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「喝不惯黑咖啡也是很正常的事情，你老实说就行了」","art":{"background":"a4102","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「我要是真的那么说的话，感觉就没法给姐姐帮忙了」","art":{"background":"a4102","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「很多客人都会在喝咖啡的时候加砂糖和牛奶，所以你完全可以代表他们提出自己的看法」","art":{"background":"a4102","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「话说……你居然注意到了？」","art":{"background":"a4103","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「这个嘛……看你眉头皱成那样，吃团子的时候又吃得那么开心，我当然能看出来」","art":{"background":"a4103","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「……对不起」","art":{"background":"a4103","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「不用道歉」","art":{"background":"a4103","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「我建议你再尝尝加了牛奶和砂糖之后的味道，然后把你真正的感想告诉芦花姐」","art":{"background":"a4103","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「嗯。谢谢哥哥」","art":{"background":"a4104","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"喜出望外的小春笑嘻嘻地把牛奶和砂糖加进了咖啡里。","art":{"background":"a4104","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「哥哥，没想到你居然能喝下那么苦的咖啡，你喜欢喝苦的吗？」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「倒也不是喜欢喝苦的……我就是不喜欢加一大堆糖，让甜味完全盖过咖啡的苦味」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「而且我们这次喝的咖啡，感觉就算直接喝也很好喝」","art":{"background":"a4007","sprites":[{"asset":"a70","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「啊，我也一样。虽然很苦……但其他的味道也很浓厚」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「你一开始这么说不就行了。我还以为你已经长大了，结果这方面完全没长大啊，哈哈」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「呜……这都是因为哥哥和廉哥总是欺负我嘛」","art":{"background":"a4007","sprites":[{"asset":"a99","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「是我错了。不过呢……我也不是过去那个小孩了。现在我肯定不会像以前那样丢下你不管」","art":{"background":"a4007","sprites":[{"asset":"a99","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「所以你不用勉强自己的。我们现在已经是四人组了」","art":{"background":"a4007","sprites":[{"asset":"a99","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"说罢，我温柔地摸了摸小春的头。","art":{"background":"a4007","sprites":[{"asset":"a99","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「……嗯……谢谢你，哥哥」","art":{"background":"a4007","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"小春也没有任何不情愿，默默地用勺子搅拌着咖啡。","art":{"background":"a4007","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「呵呵……呵呵呵……现在这样……真的会让我回想起以前的事情」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「……嗯？」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「我记得以前我每次一哭，哥哥总是会这样安慰我」","art":{"background":"a4007","sprites":[{"asset":"a95","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「是吗？」","art":{"background":"a4007","sprites":[{"asset":"a95","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「但是……现在和那时候已经完全不一样了。哥哥的手变得好大好大」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「和小时候比那当然变大了」","art":{"background":"a4007","sprites":[{"asset":"a83","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「又大，又粗糙……很像个男子汉……哈哈」","art":{"background":"a4007","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「感觉……你比以前更娇小了」","art":{"background":"a4007","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「是哥哥你长得太高了啦！」","art":{"background":"a4007","sprites":[{"asset":"a3324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「开玩笑的，开玩笑。我觉得你也变得更像个淑女了」","art":{"background":"a4007","sprites":[{"asset":"a3324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「真的吗？我家那个笨蛋哥哥经常会说我“一点都不可爱”」","art":{"background":"a4007","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「亲哥哥就是这样的啦。我过来的第一天，看见你出落得亭亭玉立，我是真的吓了一跳」","art":{"background":"a4007","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「哥哥你真是的，就算你奉承我也没好处给你哦，哈哈哈」","art":{"background":"a4007","sprites":[{"asset":"a4105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"小春笑着说道。她一边说，一边喝了口加了牛奶和砂糖的咖啡。","art":{"background":"a4007","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「啊……真好喝……。这和速溶咖啡完全不一样啊」","art":{"background":"a4106","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「是啊。速溶咖啡可泡不出来这种味道」","art":{"background":"a4106","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「这味道明显不一般。好厉害啊，居然差别这么大……这么好喝的话，我都想在店里点这种咖啡了」","art":{"background":"a4096","sprites":[]},"chapter":"4-4"},{"speaker":"将臣","text":"「你要记得把你的感想告诉芦花姐哦」","art":{"background":"a4096","sprites":[]},"chapter":"4-4"},{"speaker":"小春","text":"「嗯！」","art":{"background":"a4092","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"在那之后，芦花姐又征求了很多人的意见。现在，她已经不再迷茫了。","art":{"background":"a119","sprites":[]},"chapter":"4-4"},{"speaker":"","text":"不仅有了自信，也正式决定要用中间的咖啡来一决胜负了。","art":{"background":"a119","sprites":[]},"chapter":"4-4"},{"speaker":"芦花","text":"「好的，我要加油了。不管爸爸说什么，我都不会轻易退缩」","art":{"background":"a3001","sprites":[{"asset":"a42","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我要用味道让他闭嘴，绝不让他用什么歪门邪道这种主观看法来搪塞我」","art":{"background":"a3001","sprites":[{"asset":"a27","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「我是真心觉得很好喝」","art":{"background":"a3001","sprites":[{"asset":"a27","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「我也是！我觉得咖啡和甜食很搭」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a33","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「谢谢你们」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a6","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「抱歉，今天打扰你到这么晚」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a45","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「我送你回去吧」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a45","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「不用啦。我都这么大的人了。我会把小春也安全送到家的」","art":{"background":"a3001","sprites":[{"asset":"a33","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「哎，我好歹也是个男人」","art":{"background":"a3001","sprites":[{"asset":"a33","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「谢谢你的好意，但你要是送我们，你岂不是得一个人回来」","art":{"background":"a3001","sprites":[{"asset":"a15","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「就算是男人，你现在也是学生。这么晚了不应该在外面乱跑的」","art":{"background":"a3001","sprites":[{"asset":"a37","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"唔……她这么一说，我实在是无法反驳了。","art":{"background":"a3001","sprites":[{"asset":"a37","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「再见啦，阿将。今天真的谢谢你了」","art":{"background":"a3001","sprites":[{"asset":"a66","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「能帮上你的忙就好」","art":{"background":"a3001","sprites":[{"asset":"a66","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「哥哥再见」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"将臣","text":"「嗯，再见」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"","text":"我目送着她们离去。","art":{"background":"a3001","sprites":[]},"chapter":"4-4"},{"speaker":"芦花","text":"「哈～～～……」","art":{"background":"a1141","sprites":[{"asset":"a53","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「今天能把用的咖啡定下来，真是太好了」","art":{"background":"a1141","sprites":[{"asset":"a64","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a53","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「谢谢你，小春。但是……接下来才是最关键的」","art":{"background":"a1141","sprites":[{"asset":"a64","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a15","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「你说得没错，我可能有点心急了」","art":{"background":"a1141","sprites":[{"asset":"a68","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a15","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我在旅馆里听了那么多人的感想，感觉稍微有点自信了。哈……这都是多亏了阿将啊」","art":{"background":"a1141","sprites":[{"asset":"a68","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a34","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「找哥哥来做兼职，真是找对人了」","art":{"background":"a1141","sprites":[{"asset":"a66","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a34","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「嗯，确实。接下来……就看他什么时候能真正成为店里的主力了」","art":{"background":"a1141","sprites":[{"asset":"a66","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a33","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「现在还不行吗？」","art":{"background":"a1141","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a33","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「他记性不差，也没有给店里添麻烦。只是还差那么一点……要是能自己把握工作的走势就好了」","art":{"background":"a1141","sprites":[{"asset":"a12","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「不过这要求可能有点过分了。这毕竟是他第一次做兼职，现在这样已经足够优秀了」","art":{"background":"a1141","sprites":[{"asset":"a18","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「就是啊，哥哥可是非常努力的。他也希望自己能早日独当一面！」","art":{"background":"a1141","sprites":[{"asset":"a2971","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「他又没有打碎盘子，打扫卫生和帮叔叔的忙之类的也做得很好」","art":{"background":"a1141","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「虽然在接待客人这方面还有些不习惯……但是！但是啊！他可是非常努力的！」","art":{"background":"a1141","sprites":[{"asset":"a3325","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「他每天都在认真学习！我相信他很快就能独当一面了！所以姐姐，咱们要相信他——」","art":{"background":"a1141","sprites":[{"asset":"a3257","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「……噗～」","art":{"background":"a1141","sprites":[{"asset":"a100","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「怎……怎么了？」","art":{"background":"a1141","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a100","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我在想，你观察阿将观察得挺仔细啊～」","art":{"background":"a1141","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a6","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「哎？是吗？我只是偶然看到了他努力的样子而已」","art":{"background":"a1141","sprites":[{"asset":"a4107","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a6","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「他毕竟这么努力，所以我就希望你也能认可他」","art":{"background":"a1141","sprites":[{"asset":"a3263","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a6","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我没有不认可啦。倒不如说，正是因为他太优秀了，我才会抱有过高的期待」","art":{"background":"a1141","sprites":[{"asset":"a3263","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a14","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「我其实在各方面都很感谢他」","art":{"background":"a1141","sprites":[{"asset":"a3263","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「各方面……」","art":{"background":"a1141","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「不过啊，阿将是真的长大了……我都有点吓到了」","art":{"background":"a1141","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a4","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「我也吓了一跳。虽然哥哥很温柔，但我对他的印象都只有以前和廉哥一起瞎胡闹的样子……」","art":{"background":"a1141","sprites":[{"asset":"a67","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「他认真起来的表情看起来是那么成熟……身体也长大了……其实，有时候看着他，还会有种心动的感觉」","art":{"background":"a1141","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「是嘛～……心动了呀？」","art":{"background":"a1141","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「哎？！只是稍微有一点点而已啦！」","art":{"background":"a1141","sprites":[{"asset":"a4108","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a33","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「不管怎么说，反正就是心动了，是吧？」","art":{"background":"a1141","sprites":[{"asset":"a4108","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a104","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「这、这个……确实有点心动……不过就只有一点！真的只有一点哦！」","art":{"background":"a1141","sprites":[{"asset":"a4109","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a104","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「……是嘛～？小春，你是第一次这么心动吧？」","art":{"background":"a1141","sprites":[{"asset":"a4109","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a100","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「难道说……你喜欢阿将？」","art":{"background":"a1141","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「……啥！？」","art":{"background":"a1141","sprites":[{"asset":"a4110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「哇哦，脸都红了～」","art":{"background":"a1141","sprites":[{"asset":"a4110","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a7","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「还不是因为姐姐净问些奇怪的问题！」","art":{"background":"a1141","sprites":[{"asset":"a4108","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a7","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「那个……我当然不讨厌哥哥啦。他性格那么好，又那么认真…而且，还那么帅气……」","art":{"background":"a1141","sprites":[{"asset":"a4111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「但是，这可不是姐姐你想象的那种关系！你这种叫做恶意揣测！」","art":{"background":"a1141","sprites":[{"asset":"a4112","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「哎，你不用那么害羞啦。要是你有什么为难的事情，姐姐会帮你参谋哦～？」","art":{"background":"a1141","sprites":[{"asset":"a44","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「所以，到底是怎样，小春♪」","art":{"background":"a1141","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"小春","text":"「都说了才不是那回事——真是的！不管你了！我要回去了！」","art":{"background":"a1141","sprites":[{"asset":"a4113","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"4-4"},{"speaker":"芦花","text":"「抱歉抱歉，不要生气啦。话说，不要丢下我一个人啊——」","art":{"background":"a1141","sprites":[{"asset":"a2984","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"4-4"}]