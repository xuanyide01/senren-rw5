[{"speaker":"小春","text":"「啊，哥哥」","art":{"background":"a1","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「早上好，小春」","art":{"background":"a49","sprites":[{"asset":"a2084","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"小春","text":"「早上好！」","art":{"background":"a49","sprites":[{"asset":"a1655","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「走吧」","art":{"background":"a49","sprites":[{"asset":"a1655","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"小春","text":"「嗯！」","art":{"background":"a49","sprites":[{"asset":"a891","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"几天时间过去了。","art":{"background":"a49","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"在那之后小春每天都会像这样等我跟她一起去上学。","art":{"background":"a49","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"从她来等我的第一天开始，我就模模糊糊地有种感觉，她……","art":{"background":"a49","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「我说，廉太郎」","art":{"background":"a543","sprites":[]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「什么？」","art":{"background":"a543","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「关于小春，我有件事想问你……」","art":{"background":"a543","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「小春？」","art":{"background":"a543","sprites":[{"asset":"a520","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「之前你不是说我木头脑袋吗？你难不成是想说，小春她可能对我……」","art":{"background":"a543","sprites":[{"asset":"a520","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「打住」","art":{"background":"a543","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「我大概猜到你想说什么了。但是啊，这种事情不能由我告诉你」","art":{"background":"a543","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a543","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「之前我也说了吧，由我说不公平。所以我应该是不会回答你的问题的」","art":{"background":"a543","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「……也是，抱歉，当我没说」","art":{"background":"a543","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"如果要问，那我应该直接找小春本人问。","art":{"background":"a543","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"向廉太郎打探实在太卑鄙了。","art":{"background":"a543","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「不过……你终于发现了啊」","art":{"background":"a543","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「可是，那是小春啊。毕竟从小认识，我一直把她当妹妹」","art":{"background":"a543","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「我还以为她是像以前一样仰慕我……觉得她不可能对我有那种想法」","art":{"background":"a543","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"但是，我觉得最近的小春和之前不一样了。","art":{"background":"a49","sprites":[{"asset":"a2084","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"今天早上也是的。","art":{"background":"a49","sprites":[{"asset":"a2084","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"明显到这种地步，就算是我也会察觉。","art":{"background":"a49","sprites":[{"asset":"a2084","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「我倒是一下子就看出来了」","art":{"background":"a543","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「亲哥哥就是不一样」","art":{"background":"a543","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「那个平胸妹的心思太好猜了」","art":{"background":"a543","sprites":[{"asset":"a520","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「不过这也意味着你还是挺关心她的吧」","art":{"background":"a543","sprites":[{"asset":"a520","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「是啊，她胸再平也是我的妹妹嘛」","art":{"background":"a543","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「我说，你别老是讲这种让她生气的话啊」","art":{"background":"a543","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「算了，这种事情我插嘴也没意义」","art":{"background":"a543","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「总之，就算你最终打算拒绝她……也绝对不可以提起裤子不认人」","art":{"background":"a543","sprites":[{"asset":"a520","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「你把我当什么了啊！」","art":{"background":"a543","sprites":[{"asset":"a520","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「那就成。后面就是你们俩的问题了，轮不到我插嘴」","art":{"background":"a543","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a543","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"都到这一步了，我不能逃避，得好好考虑下才行。","art":{"background":"a543","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"}]