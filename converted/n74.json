[{"speaker":"将臣","text":"「我明白你的心情了。但是不行」","art":{"background":"a1044","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「哎……为什么？」","art":{"background":"a1044","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不为什么，就是以防万一。小春也嘱咐过我的」","art":{"background":"a1044","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「朝武由我来教」","art":{"background":"a1044","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「切……小气……」","art":{"background":"a1044","sprites":[{"asset":"a81","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「不过也无所谓。毕竟你也是巫女大人的未婚夫，而且我也想和蕾娜加深关系」","art":{"background":"a1044","sprites":[{"asset":"a85","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「那，蕾娜，我来教你鱼竿怎么用！」","art":{"background":"a1044","sprites":[{"asset":"a963","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a60","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「还请多多指教！」","art":{"background":"a1044","sprites":[{"asset":"a960","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a60","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我事先说一句」","art":{"background":"a1044","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「知道啦。我不会做什么的」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「今天只是单纯来玩的。毕竟这也是爷爷吩咐的事」","art":{"background":"a1044","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「好，我相信你。那边交给你了」","art":{"background":"a1044","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「好嘞」","art":{"background":"a1044","sprites":[{"asset":"a96","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「那我们去那边钓吧，蕾娜」","art":{"background":"a1044","sprites":[{"asset":"a96","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「好的！拜托你了」","art":{"background":"a1044","sprites":[{"asset":"a978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我们也开始吧，朝武」","art":{"background":"a1044","sprites":[{"asset":"a1056","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「好的。所以，那个……能教我钓鱼的方法吗？」","art":{"background":"a1044","sprites":[{"asset":"a925","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「当然可以。首先是挂饵」","art":{"background":"a1044","sprites":[{"asset":"a925","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「要用什么特别的鱼饵吗？」","art":{"background":"a1044","sprites":[{"asset":"a445","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不需要。用的是随处可见的蚯蚓……你怕不怕蚯蚓？」","art":{"background":"a1044","sprites":[{"asset":"a445","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「不，我不怕」","art":{"background":"a1044","sprites":[{"asset":"a623","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"廉太郎事先给了我们蚯蚓。","art":{"background":"a1044","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"朝武毫不犹豫地伸出手，将蚯蚓掰成小段，挂在鱼钩上。","art":{"background":"a1044","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1044","sprites":[{"asset":"a956","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「怎么了？」","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不，倒不是什么大事……你敢摸蚯蚓啊？」","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"我还以为她会抱怨说什么“不敢碰蚯蚓”“好恶心”之类的话呢，没想到完全没这回事。","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"倒不如说，她貌似比我还下得去手。","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「毕竟家里也会出现各种各样的虫子，必须自己动手处理」","art":{"background":"a1044","sprites":[{"asset":"a430","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「是、是吗？」","art":{"background":"a1044","sprites":[{"asset":"a430","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「比如椿象之类的……到了梅雨时期，早上起来枕头边还会有蜈蚣呢」","art":{"background":"a1044","sprites":[{"asset":"a923","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「哇！！！！？」","art":{"background":"a1044","sprites":[{"asset":"a923","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「你害怕蜈蚣吗？」","art":{"background":"a1044","sprites":[{"asset":"a436","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「谁不怕蜈蚣啊。被咬的话会起红肿……出现蜈蚣的时候你是怎么办的？」","art":{"background":"a1044","sprites":[{"asset":"a436","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「基本是用杀虫剂吧。没有的话就用热水」","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「是、是这样啊……」","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"乡村真可怕！","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"我还以为女孩子都怕虫呢……本地的人承受能力好强啊。","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不用举过头顶。轻轻投进河面就可以」","art":{"background":"a1044","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「嗯，我知道了」","art":{"background":"a1044","sprites":[{"asset":"a915","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"朝武一脸紧张地将鱼钩投进了河里。","art":{"background":"a1044","sprites":[{"asset":"a915","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「鱼要是上钩了，会扯得着竿轻轻下沉，这时你把鱼竿往上拉就行」","art":{"background":"a1044","sprites":[{"asset":"a915","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「鱼竿下沉是什么样的感觉呢？」","art":{"background":"a1044","sprites":[{"asset":"a435","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我也不知道有没有具体的感觉……反正鱼上钩了你就知道了」","art":{"background":"a1044","sprites":[{"asset":"a435","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「是这样吗……呀，刚才轻轻动了一下」","art":{"background":"a1044","sprites":[{"asset":"a940","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1044","sprites":[{"asset":"a940","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「啊，动来动去的好瘆人啊」","art":{"background":"a1044","sprites":[{"asset":"a1057","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「（感觉……好色情啊）」","art":{"background":"a1044","sprites":[{"asset":"a1057","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「可以了吗？可以往上拉了吗？」","art":{"background":"a1044","sprites":[{"asset":"a1058","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「啊，嗯，可以」","art":{"background":"a1044","sprites":[{"asset":"a1058","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「啊！鱼咬钩了！钓上来了！」","art":{"background":"a1059","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「这是什么鱼？是香鱼？还是红点鲑？」","art":{"background":"a1060","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「我平时也只是为了打发时间才钓鱼，所以也不明白详细的种类……应该就是雅罗鱼吧？」","art":{"background":"a1060","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「能吃吗？」","art":{"background":"a1060","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「别担心，能吃。装进桶里带回去吧」","art":{"background":"a1060","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「好的！」","art":{"background":"a1060","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「现在把鱼线往回拉，取下鱼钩」","art":{"background":"a1060","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「拉回手上……啊，一动一动的，好恶心啊，还滑溜溜的」","art":{"background":"a1061","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「（她为什么……能如此无意识地说出这么色情的词语呢）」","art":{"background":"a1061","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「呜呜……哇，啊，讨厌……这么光滑……我有点受不了这种」","art":{"background":"a1061","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"看到蜈蚣都那么冷静，鱼就不行吗……","art":{"background":"a1061","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"对我来说，蜈蚣可比鱼恶心多了。","art":{"background":"a1061","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"而且她还能这么淡定地摸蚯蚓……感觉真奇怪。","art":{"background":"a1061","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「我来取吧？」","art":{"background":"a1061","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「不、不用。都到这一步了，我想自己努力到最后」","art":{"background":"a1062","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「是吗？那你就试试吧」","art":{"background":"a1062","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「但、但是，能给我些建议吗？」","art":{"background":"a1062","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「这还能有什么建议……忍一忍它的光滑，然后取下鱼钩。除此之外我也想不出别的建议」","art":{"background":"a1062","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「是、是吗……看来只能忍一忍了」","art":{"background":"a1062","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"朝武下定决心，将手伸向鱼。","art":{"background":"a1062","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「哇……哇，滑溜溜的，一动一动的……嗯嗯嗯」","art":{"background":"a1063","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「然后取下鱼钩。取的时候小心不要受伤」","art":{"background":"a1063","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「好的。取下鱼钩的时候不要受伤，慢慢地……」","art":{"background":"a1063","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「取下来了！啊，还在一跳一跳的」","art":{"background":"a1064","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「啊，别松手。快扔进桶里」","art":{"background":"a1064","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"鱼在桶里来回转圈子。","art":{"background":"a1044","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我扔进几片树叶，给它挡挡阳光。","art":{"background":"a1044","sprites":[]},"chapter":"3-2"},{"speaker":"芳乃","text":"「这是我钓到的鱼，嘻嘻」","art":{"background":"a1044","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"朝武开心地注视着桶内。","art":{"background":"a1044","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"……她那天真无邪的笑容也很可爱。","art":{"background":"a1044","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"至少在我眼中，这天真无邪的笑容比平时的那个她更加有魅力。","art":{"background":"a1044","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1044","sprites":[{"asset":"a953","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「……嗯？怎么了？」","art":{"background":"a1044","sprites":[{"asset":"a935","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「哎！？啊，不，没什么……」","art":{"background":"a1044","sprites":[{"asset":"a935","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「你骗人」","art":{"background":"a1044","sprites":[{"asset":"a426","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"她毫不犹豫地拆穿了我。","art":{"background":"a1044","sprites":[{"asset":"a426","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「你肯定是在隐瞒什么吧」","art":{"background":"a1044","sprites":[{"asset":"a254","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不，真的……没这回事哦」","art":{"background":"a1044","sprites":[{"asset":"a254","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「为什么语气变得跟蕾娜一样？好——可——疑——」","art":{"background":"a1044","sprites":[{"asset":"a425","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"朝武的视线从鱼身上移到了我这边。","art":{"background":"a1044","sprites":[{"asset":"a425","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"她紧紧地盯着我的脸，离我越来越近。","art":{"background":"a1044","sprites":[{"asset":"a425","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"好近好近好近好近！","art":{"background":"a1044","sprites":[{"asset":"a425","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「啊，你怎么把脸转过去了」","art":{"background":"a1044","sprites":[{"asset":"a426","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不，这是……」","art":{"background":"a1044","sprites":[{"asset":"a426","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"没办法的啊！我区区一个处男，怎么有胆量跟她这么近距离对视啊！","art":{"background":"a1044","sprites":[{"asset":"a426","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"啊，心脏跳得好快！","art":{"background":"a1044","sprites":[{"asset":"a426","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"心、心跳声……朝武应该听不见吧……？","art":{"background":"a1044","sprites":[{"asset":"a426","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「真的没什么啦。好了，继续钓吧！得多钓些鱼当晚餐啊！」","art":{"background":"a1044","sprites":[{"asset":"a426","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「……我知道了」","art":{"background":"a1044","sprites":[{"asset":"a253","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"虽然朝武还在怀疑，但还是不情愿地让步了。","art":{"background":"a1044","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"然后我的心脏总算勉强恢复了平静。","art":{"background":"a1044","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"啊……可爱的女生离自己这么近，对心脏太不好了。","art":{"background":"a1044","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我一边按着依旧在狂跳不止的心脏，一边钓起了鱼。","art":{"background":"a1044","sprites":[]},"chapter":"3-2"}]