[{"speaker":"将臣","text":"「——呼！」","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我紧握丛雨丸，势如疾风，手起刀落。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"随着一道明确的打击感，祟神的触手被我一刀两断，散作一阵黑雾。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"断了半截触手的本体就像在咆哮一般剧烈地颤动着身躯。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「朝武！」","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「好的！」","art":{"background":"a374","sprites":[{"asset":"a391","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"朝武应声而出，从祟神的侧面冲了过来。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"她手中紧紧攥着的鉾铃尖端直奔祟神的心窝刺去。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"祟神的触手在乱舞。","art":{"background":"a374","sprites":[{"asset":"a271","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"而我也不能愣住。我一个大跨步朝祟神接近！","art":{"background":"a392","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「吃我一招！」","art":{"background":"a392","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"这次我将触手连根斩飞。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「呀！」","art":{"background":"a374","sprites":[{"asset":"a391","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"被斩去触手的祟神还没来得及动弹，朝武的鉾铃就已经刺入了它的体内。","art":{"background":"a126","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"污泥一般的黑色身影不住颤抖，随后便像它的触手一样雾散而去。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「哈……哈……」","art":{"background":"a374","sprites":[{"asset":"a1289","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"清除了污秽之后，朝武头上的耳朵也慢慢消失了。","art":{"background":"a374","sprites":[{"asset":"a1290","position":"100%","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「朝武，你没有受伤吧？」","art":{"background":"a374","sprites":[{"asset":"a1290","position":"100%","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「我没事，你受伤了吗？你的手腕应该还没有痊愈吧？」","art":{"background":"a374","sprites":[{"asset":"a1291","position":"100%","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「这些绷带只是用来固定保护伤口的薄膜，以防它们错位罢了。我的手腕其实已经不疼了」","art":{"background":"a374","sprites":[{"asset":"a1291","position":"100%","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「那就好」","art":{"background":"a374","sprites":[{"asset":"a1292","position":"100%","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"就在我们都放下心来时，丛雨丸渐渐褪去了光芒。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"光芒散去后，小雨出现在了我们眼前。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"丛雨","text":"「你们可不要忘了碎片啊。本座还能感觉到它的气息」","art":{"background":"a374","sprites":[{"asset":"a134","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「嗯，我记得的」","art":{"background":"a374","sprites":[{"asset":"a134","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「需要我帮你用光照一照吗？」","art":{"background":"a374","sprites":[{"asset":"a1293","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「不用，我能感觉到它在哪……虽然并不明确」","art":{"background":"a374","sprites":[{"asset":"a1293","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"这是块透明的碎片。哪怕是在白天，在远处看也很难能找到它。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"但不知为什么，我却可以感知到碎片大致掉落在哪个方位。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"之前也是如此。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我就像是被牵引了一样，视线自然地就朝着一个地方看去。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「嗯，找到了」","art":{"background":"a780","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我拾起了新的碎片。","art":{"background":"a780","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"朝武的耳朵已经消失，应该没问题了。","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「我们回去吧。常陆肯定在担心我们呢」","art":{"background":"a374","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「茉子真是太爱操心了……」","art":{"background":"a374","sprites":[{"asset":"a1294","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「（坐立不安）……（心神不宁）……」","art":{"background":"a348","sprites":[{"asset":"a1295","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我们回来了」","art":{"background":"a348","sprites":[{"asset":"a1295","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「芳乃大人！有地！丛雨大人！」","art":{"background":"a348","sprites":[{"asset":"a278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「你们都平安无事呀！太好了……真是太好了……」","art":{"background":"a348","sprites":[{"asset":"a260","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"常陆似乎是打心底长舒了一口气。","art":{"background":"a348","sprites":[{"asset":"a260","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我感觉她的泪水好像都快要夺眶而出了……","art":{"background":"a348","sprites":[{"asset":"a260","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「你真是爱瞎操心」","art":{"background":"a348","sprites":[{"asset":"a1296","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a252","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「没办法呀……我就是没法放下心来呀。我真受不了一直等着你们……」","art":{"background":"a348","sprites":[{"asset":"a1296","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a957","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「我和有地还有丛雨大人在一起，没什么好担心的」","art":{"background":"a348","sprites":[{"asset":"a1297","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a957","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「而且芳乃和主人最近的配合可谓是行云流水」","art":{"background":"a348","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「这个我知道，但还是免不了会担心啊……这样真是对心脏不好」","art":{"background":"a348","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「你的伤怎么样了？还需要绑绷带吧？」","art":{"background":"a348","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「以防万一还是绑着，据说明天复诊时可以取下来。我自己是感觉早就痊愈了……」","art":{"background":"a348","sprites":[{"asset":"a242","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「要遵从美津叶大夫的医嘱才行」","art":{"background":"a348","sprites":[{"asset":"a1298","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「……这我当然知道……」","art":{"background":"a348","sprites":[{"asset":"a567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「不过说的也是，抱怨来抱怨去也没什么用。反正也不差这点时间了」","art":{"background":"a348","sprites":[{"asset":"a241","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「话说宿体现在怎么样了？」","art":{"background":"a348","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「现在变成这样了。这次也找到了新的碎片」","art":{"background":"a348","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「……能让我看看吗？」","art":{"background":"a348","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「拿着吧」","art":{"background":"a348","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"常陆轻轻地捏起宿体，盯着宿体内部看了一会儿。","art":{"background":"a348","sprites":[{"asset":"a630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「我怎么感觉……这里边的白雾变浓了一点」","art":{"background":"a348","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「说起来，我们这样收集宿体……它的气息也会发生变化吗？」","art":{"background":"a348","sprites":[{"asset":"a959","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「嗯。它的气息越来越强了」","art":{"background":"a348","sprites":[{"asset":"a384","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「以前本座不靠近宿体都感觉不到它们，现在隔着一段距离都能感受得到」","art":{"background":"a348","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「那么……芳乃大人和有地也能感觉到什么变化吗？」","art":{"background":"a348","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「怎么说呢……我对宿体的感知从一开始就没有那么强烈」","art":{"background":"a348","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「之前白天下山的时候，主人不是说感觉被谁叫了一声吗？」","art":{"background":"a348","sprites":[{"asset":"a1299","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「其实我并没有听到什么声音，只是“有这样一种感觉”而已」","art":{"background":"a348","sprites":[{"asset":"a1299","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「难道说是祟神在呼唤你？」","art":{"background":"a348","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「我记得当时芳乃大人正好也长出了耳朵」","art":{"background":"a348","sprites":[{"asset":"a282","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a323","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「说巧未免有些太巧了，反而令人怀疑」","art":{"background":"a348","sprites":[{"asset":"a144","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a323","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「难道是因为我拿着宿体……？」","art":{"background":"a348","sprites":[{"asset":"a144","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a323","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「那要不咱们现在就来确认一下？」","art":{"background":"a348","sprites":[{"asset":"a428","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我紧紧攥住了常陆递过来的宿体。","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"说实话，这种尝试我平时已经做过很多次了。","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"要不就试着让自己的注意力更集中一些……？","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我开始聚精会神地观察宿体的反应。","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"……","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"朝武和常陆可能是在注视我的举动。","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"她们也默不做声。","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"周围很安静。安静到让我感觉空气都很沉重。","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「（一点声音都没有啊）」","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"虽然那时我也没听到有确切的声音，不过现在甚至连一点感觉都没有。","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"宿体那凉丝丝的触感倒是很鲜明。","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"除此之外我感觉不到什么别的东西……","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「（说到底……为什么会没有反应呢？）」","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「（如果它真的想要集齐宿体的碎片，那他应该希望有人能帮它才对）」","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「（要是……它能再多给我一点反馈就好了……）」","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「（……）」","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"还是不行。我什么都感觉不到。","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"就在我放下紧张感的那一刻……","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"手中的宿体突然开始发热。","art":{"background":"a126","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"然而这份热量马上就消散了，宿体又变得冰凉。","art":{"background":"a126","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「我怎么感觉宿体突然变热了……还发出了奇异的光」","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「——难道是我的错觉」","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"丛雨","text":"「这也太含糊了吧」","art":{"background":"a348","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「因为那感觉真的很微弱」","art":{"background":"a348","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「而且可能也只是因为我捏着它，把它捂热了」","art":{"background":"a348","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我松开了手，又重新检查了一下宿体。","art":{"background":"a1300","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"但我并没有看到有什么变化。","art":{"background":"a1300","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「除此之外也没什么值得我注意的地方了」","art":{"background":"a1300","sprites":[]},"chapter":"3-5"},{"speaker":"茉子","text":"「那接下来让芳乃大人试试吧」","art":{"background":"a348","sprites":[{"asset":"a1301","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「以前你摸到宿体的时候有什么感觉吗？」","art":{"background":"a348","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a412","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「唔，我之前说的好像是……看到它心里就很有安全感……」","art":{"background":"a348","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1302","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「我记得当时在诊所，您不是被电了一下吗？」","art":{"background":"a348","sprites":[{"asset":"a1301","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「唔，那个触电的感觉……还挺吓人的……」","art":{"background":"a348","sprites":[{"asset":"a1303","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"她应该并不是怕疼，而是害怕那种突然吓一跳的感觉。","art":{"background":"a348","sprites":[{"asset":"a1303","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"朝武的表情都有点扭曲了。","art":{"background":"a348","sprites":[{"asset":"a1303","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「我是真的有点受不了这种，就跟练胆子似的……」","art":{"background":"a348","sprites":[{"asset":"a1302","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"朝武畏畏缩缩地慢慢伸出手指。","art":{"background":"a348","sprites":[{"asset":"a1302","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「实在害怕的话就算了吧？」","art":{"background":"a348","sprites":[{"asset":"a1302","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「没事，我们必须确认一下」","art":{"background":"a348","sprites":[{"asset":"a1298","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「唔……唔唔………………」","art":{"background":"a348","sprites":[{"asset":"a1294","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"尽管她将食指伸了过来，但她的身体却是能躲多远躲多远。","art":{"background":"a348","sprites":[{"asset":"a1294","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"……看着好可爱啊。","art":{"background":"a348","sprites":[{"asset":"a1294","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"随后，他的指尖轻轻碰了一下碎片……","art":{"background":"a348","sprites":[{"asset":"a1294","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「……有什么反应？」","art":{"background":"a348","sprites":[{"asset":"a1294","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「啊……没反应，一点反应都没有。啊……真是太好了」","art":{"background":"a348","sprites":[{"asset":"a1304","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「好吧」","art":{"background":"a348","sprites":[{"asset":"a1304","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「唔，怎么感觉你好像很失望的样子？」","art":{"background":"a348","sprites":[{"asset":"a1305","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「啊，抱歉。是我的措辞不太对，对不起啊」","art":{"background":"a348","sprites":[{"asset":"a1305","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「真是的……我真的是怕得要死啊」","art":{"background":"a348","sprites":[{"asset":"a1306","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"朝武直接将宿体拿在手上。可能是因为刚才没有被电到，她现在似乎已经不怕了。","art":{"background":"a348","sprites":[{"asset":"a409","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"只见她双手包住碎片，静静地闭上了眼睛，就像是在祈祷着什么。","art":{"background":"a348","sprites":[{"asset":"a1307","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"而我们则在一旁看着。","art":{"background":"a348","sprites":[{"asset":"a1307","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"差不多过了一分钟。","art":{"background":"a348","sprites":[{"asset":"a1307","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"沉默的朝武慢慢地睁开双眼，摊开双手。","art":{"background":"a348","sprites":[{"asset":"a1307","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「我也什么都没感觉到……」","art":{"background":"a348","sprites":[{"asset":"a1308","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「是吗。不过，没有变化或许也说明我们的进展足够顺利」","art":{"background":"a348","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「确实有这种可能。说不定我们收集碎片的同时，也平息了它的怨怒」","art":{"background":"a348","sprites":[{"asset":"a324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「有地，宿体你继续拿着吧」","art":{"background":"a348","sprites":[{"asset":"a410","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我接过宿体，小心翼翼地将它收了起来。","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"之所以让我保管，是为了能把它放在丛雨丸旁边，以备不虞。","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「那我先去换衣服了」","art":{"background":"a348","sprites":[{"asset":"a1310","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「啊，那要不您先去洗个澡吧？入浴前的准备工作我都做好了」","art":{"background":"a348","sprites":[{"asset":"a1310","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「你也跟我一起洗吧」","art":{"background":"a348","sprites":[{"asset":"a410","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「可以吗？」","art":{"background":"a348","sprites":[{"asset":"a410","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a289","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「那当然」","art":{"background":"a348","sprites":[{"asset":"a471","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a289","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「那我就恭敬不如从命了」","art":{"background":"a348","sprites":[{"asset":"a471","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1010","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「对了，有地要不要也来一起洗呀？」","art":{"background":"a348","sprites":[{"asset":"a246","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「可以一起吗？」","art":{"background":"a348","sprites":[{"asset":"a246","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「怎么可能让你一起洗啊！别这样理所当然地反问行不行！」","art":{"background":"a348","sprites":[{"asset":"a1311","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「茉子你也真是的，瞎说什么呢！」","art":{"background":"a348","sprites":[{"asset":"a1298","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a328","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「开玩笑而已啦。干嘛这么认真嘛」","art":{"background":"a348","sprites":[{"asset":"a1298","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a292","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「要是他当真了那就麻烦了！行了别说胡话了，快去洗澡」","art":{"background":"a348","sprites":[{"asset":"a1312","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a292","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"茉子","text":"「来啦来啦。那我们先行一步」","art":{"background":"a348","sprites":[{"asset":"a913","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「啊，好」","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「呼……」","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我泡在浴池内，身体从内到外都暖融融的。","art":{"background":"a473","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"温暖的感觉真是舒服。","art":{"background":"a473","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「差不多该出去了」","art":{"background":"a473","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「我泡完了」","art":{"background":"a348","sprites":[{"asset":"a1313","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「趁身子没冷下来，赶紧睡吧」","art":{"background":"a348","sprites":[{"asset":"a1314","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「你也别熬夜哦」","art":{"background":"a348","sprites":[{"asset":"a1314","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「嗯。我本来就准备睡了……就是突然感觉有点渴」","art":{"background":"a348","sprites":[{"asset":"a1315","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「那喝点热的东西吧？」","art":{"background":"a348","sprites":[{"asset":"a1315","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「需要我帮你热点牛奶吗？」","art":{"background":"a348","sprites":[{"asset":"a1315","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「不用了，用不着这么麻烦」","art":{"background":"a348","sprites":[{"asset":"a1316","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「嗯……咕嘟，哈……」","art":{"background":"a348","sprites":[{"asset":"a1317","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"朝武一口气把杯中的茶水饮尽。","art":{"background":"a348","sprites":[{"asset":"a1317","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"有这么渴吗？等等……她的脸好像有点红。","art":{"background":"a348","sprites":[{"asset":"a1317","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「哈，呼……」","art":{"background":"a348","sprites":[{"asset":"a1318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「难不成你发烧了？」","art":{"background":"a348","sprites":[{"asset":"a1318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「应该没有吧……」","art":{"background":"a348","sprites":[{"asset":"a1319","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「让我摸摸看」","art":{"background":"a348","sprites":[{"asset":"a1319","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我轻轻地将手贴在朝武的额头上。","art":{"background":"a348","sprites":[{"asset":"a1319","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「……」","art":{"background":"a348","sprites":[{"asset":"a1320","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「确实，应该没有发烧」","art":{"background":"a348","sprites":[{"asset":"a1320","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「………………」","art":{"background":"a348","sprites":[{"asset":"a1321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「那、那个！」","art":{"background":"a348","sprites":[{"asset":"a1322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「嗯？怎么了？」","art":{"background":"a348","sprites":[{"asset":"a1322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「普通朋友之间……也会做这种事吗？」","art":{"background":"a348","sprites":[{"asset":"a1323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「啊？……啊，抱歉」","art":{"background":"a348","sprites":[{"asset":"a1323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「不、不是，我没有要责备你的意思。只是，怎么说呢……」","art":{"background":"a348","sprites":[{"asset":"a841","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「我只是在好奇，朋友之间也会用这种方式来测体温的吗……」","art":{"background":"a348","sprites":[{"asset":"a1324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我觉得因人而异吧」","art":{"background":"a348","sprites":[{"asset":"a1324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「不过，如果是异性的普通朋友，一般来说可能不会这么做」","art":{"background":"a348","sprites":[{"asset":"a1324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「是我太欠考虑了……也没多想就伸手了」","art":{"background":"a348","sprites":[{"asset":"a1324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「没、没关系的。我真的不介意的，请不要太在意」","art":{"background":"a348","sprites":[{"asset":"a1325","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「只是……没想到会这么羞人。我本来没有发烧，你这弄得我反而要发烧了」","art":{"background":"a348","sprites":[{"asset":"a841","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「确、确实是……」","art":{"background":"a348","sprites":[{"asset":"a841","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"听她这么说……我才察觉到自己心跳加速。","art":{"background":"a348","sprites":[{"asset":"a841","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"我摸了女孩子……意识到这一点后，我感觉自己的脸也烫起来了……","art":{"background":"a348","sprites":[{"asset":"a841","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a348","sprites":[{"asset":"a841","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「……」","art":{"background":"a348","sprites":[{"asset":"a843","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「……盯……」","art":{"background":"a348","sprites":[{"asset":"a843","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃・将臣","text":"『——啊！？』","art":{"background":"a348","sprites":[{"asset":"a1326","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「上啊主人，机会来了。推倒她，让本座看看你的男子气慨。哟哟——」","art":{"background":"a348","sprites":[{"asset":"a624","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃・将臣","text":"『……』","art":{"background":"a348","sprites":[{"asset":"a1327","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃・将臣","text":"『呀啊啊——————！』","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「丛、丛雨大人，您是什么时候在这的！？」","art":{"background":"a348","sprites":[{"asset":"a812","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a842","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「你们接吻的时候本座就在了」","art":{"background":"a348","sprites":[{"asset":"a128","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a842","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「别乱套我们的话！我们没接吻啊」","art":{"background":"a348","sprites":[{"asset":"a128","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a842","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「不必在意本座。本座这就消失在这堵墙的另一侧」","art":{"background":"a348","sprites":[{"asset":"a812","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"『你们继续吧，本座不打扰你们』","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"丛雨","text":"『你们不是要接吻吗？不是要嘴对嘴吗？不是还要做这种事情那种事情吗？』","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「——！？」","art":{"background":"a348","sprites":[{"asset":"a842","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「不是！我们没有……」","art":{"background":"a348","sprites":[{"asset":"a842","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"『说呀，说出来呀。从自己的嘴里说出来呀』","art":{"background":"a348","sprites":[{"asset":"a842","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「那种话怎么可能说得出口啊」","art":{"background":"a348","sprites":[{"asset":"a842","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「你真的是误会了！麻烦你不要再学色鬼大叔讲话了！」","art":{"background":"a348","sprites":[{"asset":"a842","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我说小雨，这种没羞没臊的场面你不是应付不来的吗」","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"丛雨","text":"「唔……自己来的话确实受不了」","art":{"background":"a348","sprites":[{"asset":"a1192","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「但是在一旁看着倒是很有意思！」","art":{"background":"a348","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「这是人干的事吗！」","art":{"background":"a348","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「我刚才就只是帮朝武测了一下体温而已！」","art":{"background":"a348","sprites":[{"asset":"a263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「测体温？还真是，芳乃的脸有点红啊」","art":{"background":"a348","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「您净说胡话，还开我玩笑，我能不脸红吗」","art":{"background":"a348","sprites":[{"asset":"a1318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"朝武如此说道，不满地撅起了嘴。","art":{"background":"a348","sprites":[{"asset":"a1318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「你们毕竟是名义上的未婚夫妻，本座还以为你们终于要迈出一步了呢」","art":{"background":"a348","sprites":[{"asset":"a605","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1318","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「迈、迈出这一步……」","art":{"background":"a348","sprites":[{"asset":"a605","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a841","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「怎么说呢，我们作为朋友，关系确实有所进展，这也算迈出了一步吧……？」","art":{"background":"a348","sprites":[{"asset":"a135","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a841","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「啊，对。没错，这个解释没问题」","art":{"background":"a348","sprites":[{"asset":"a135","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1328","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「也是，芳乃现在总算是愿意对主人敞开心扉了」","art":{"background":"a348","sprites":[{"asset":"a771","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1328","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"丛雨","text":"「毕竟你最开始那会儿态度实在太恶劣」","art":{"background":"a348","sprites":[{"asset":"a815","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1328","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「以前的事情就不要再提了呀。我自己也有在反省的好吗」","art":{"background":"a348","sprites":[{"asset":"a815","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1329","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「真、真是的！我睡了，晚安！」","art":{"background":"a348","sprites":[{"asset":"a1330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「啊，嗯。晚安」","art":{"background":"a348","sprites":[{"asset":"a1330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"朝武逃跑似的离开了起居室。","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"感觉她的脸比刚才我的手贴上去的时候更红了……没问题吧？","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"可能正如她本人所说，只是因为被开了玩笑，有点害羞了吧。","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"至少她走路还是走得很稳。明天早上再多观察一下吧。","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「我也睡了」","art":{"background":"a348","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"我铺上被褥，做好了睡前准备。","art":{"background":"a360","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「啊，对了。得把宿体和丛雨丸放在一起」","art":{"background":"a360","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「可是……那时候的光和热到底是怎么一回事……？」","art":{"background":"a360","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"再检查一下宿体吧。","art":{"background":"a360","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……唔……」","art":{"background":"a1300","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"可是不管我再怎么看，也看不出什么变化。","art":{"background":"a1300","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「没办法。睡吧」","art":{"background":"a360","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「……唉……」","art":{"background":"a1331","sprites":[{"asset":"a1332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"都怪丛雨大人瞎说……说得我心脏怦怦直跳，一直跳到现在。","art":{"background":"a1331","sprites":[{"asset":"a1333","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「呜，我明明想要睡觉的……现在都静不下心来了」","art":{"background":"a1331","sprites":[{"asset":"a1318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「而且我刚刚才喝的茶，结果嚷嚷了几声现在喉咙又渴了」","art":{"background":"a1331","sprites":[{"asset":"a1334","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「丛雨大人真是的……说得我们好像有那个意思似的。怎么可能……」","art":{"background":"a1331","sprites":[{"asset":"a1323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「怎么可能……」","art":{"background":"a1331","sprites":[{"asset":"a1333","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"这是为什么呢。","art":{"background":"a1331","sprites":[{"asset":"a1333","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"当有地的手摸到我的额头时……我的心里有种莫名其妙的感觉。","art":{"background":"a1331","sprites":[{"asset":"a1333","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"","text":"一想到这，心里就感觉痒痒的。","art":{"background":"a1331","sprites":[{"asset":"a1333","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「这是怎么一回事……」","art":{"background":"a1331","sprites":[{"asset":"a1335","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「……呜……」","art":{"background":"a1331","sprites":[{"asset":"a846","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「我到底是怎么了呀……」","art":{"background":"a1331","sprites":[{"asset":"a1336","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「睡、睡吧！钻到被窝里就能睡着了！」","art":{"background":"a1331","sprites":[{"asset":"a1337","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「晚安」","art":{"background":"a1331","sprites":[{"asset":"a1332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「唔……嗯……唔……嗯……睡不着」","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"……","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「嗯……唔……」","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"……","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「嗯，嗯……嗯……」","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"……","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「呼……呼……」","art":{"background":"a119","sprites":[]},"chapter":"3-5"},{"speaker":"芳乃","text":"「……」","art":{"background":"a1331","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"——起身。","art":{"background":"a1331","sprites":[{"asset":"a1338","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"芳乃","text":"「……」","art":{"background":"a1331","sprites":[{"asset":"a1339","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-5"},{"speaker":"将臣","text":"「……呼……呼……」","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"——刷啦。","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……嗯，嗯……？」","art":{"background":"a0","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"什么情况？感觉……好像撞到了什么东西？","art":{"background":"a1340","sprites":[]},"chapter":"3-5"},{"speaker":"将臣","text":"「……唔、嗯……？」","art":{"background":"a1340","sprites":[]},"chapter":"3-5"},{"speaker":"","text":"哎，管它呢……睡吧。","art":{"background":"a1340","sprites":[]},"chapter":"3-5"}]