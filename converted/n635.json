[{"speaker":"将臣","text":"「用脸接着吧。用你的脸接我的精液」","art":{"background":"a2914","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「我明白了。请射出大量的精液吧……啊、啊……」","art":{"background":"a2922","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"听到我请求的茉子开心地搓弄着阴茎。","art":{"background":"a2922","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"她把龟头放到自己的面前，准备按照我的请求用脸接受射精。","art":{"background":"a2922","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「随时都可以哦，请把精液尽情喷在我的脸上吧……」","art":{"background":"a2914","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「茉、茉子，要、要射了哦」","art":{"background":"a2914","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嗯，射吧……快点射吧……用精液沾满我的脸吧」","art":{"background":"a2914","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「射了！」","art":{"background":"a2914","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嗯噗、嗯、嗯、嗯嗯——————」","art":{"background":"a2923","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"咻！咻噜噜！牵着丝的精液喷射而出，灌注在茉子的脸上。","art":{"background":"a2923","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嗯、嗯唔、嗯唔……嗯嗯嗯——啊、啊、啊……好烫、好粘……味道也好重」","art":{"background":"a2923","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"茉子的脸上一片狼藉，我甚至担心她能不能睁开眼睛。","art":{"background":"a2923","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「啊、嗯嗯……好像连脑袋里都被精液糊满了……嗯嗯」","art":{"background":"a2923","sprites":[]},"chapter":"后日谈"}]