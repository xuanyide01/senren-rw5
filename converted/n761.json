[{"speaker":"","text":"今天，我们跑出来度蜜月。","art":{"background":"a49","sprites":[]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「哇噢，将臣！这房间真棒」","art":{"background":"a2888","sprites":[{"asset":"a665","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊，嗯，房间不错，虽然感觉好像在哪里见过」","art":{"background":"a2888","sprites":[{"asset":"a665","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"但是，我们却跑来了志那都庄。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"心子","text":"「感谢两位客人光临」","art":{"background":"a2888","sprites":[{"asset":"a50","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"至少猪谷阿姨这位职业服务业从业者没有甩下一句“你们全都很熟悉吧”。","art":{"background":"a2888","sprites":[{"asset":"a50","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"只要正常付钱正常住宿，她就会以招待客人的礼节招待我们吧。","art":{"background":"a2888","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"所谓的度蜜月，实际上也只是我们自己制造的名义。","art":{"background":"a2888","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"简而言之，就跟玩角色扮演差不多。","art":{"background":"a2888","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「谢谢你给我们用房间啊，掌柜的！」","art":{"background":"a2888","sprites":[{"asset":"a665","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a50","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「没事的，反正不是旺季」","art":{"background":"a2888","sprites":[{"asset":"a665","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a691","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"啊，恢复正常了。","art":{"background":"a2888","sprites":[{"asset":"a665","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a691","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「但是，既然都要出钱，还是去其他旅馆更有旅行的感觉吧？」","art":{"background":"a2888","sprites":[{"asset":"a554","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「没事，蕾娜似乎特别中意志那都庄」","art":{"background":"a2888","sprites":[{"asset":"a554","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「是的，今天我就当自己失忆了，准备好好享受一番」","art":{"background":"a2888","sprites":[{"asset":"a3916","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「嗯，你能这么说我很高兴……可是怎么说呢」","art":{"background":"a2888","sprites":[{"asset":"a688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「你也经常住这里的吧，包括客房之外的房间」","art":{"background":"a2888","sprites":[{"asset":"a3698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"是的，没错。","art":{"background":"a2888","sprites":[{"asset":"a3698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"感觉很不好意思啊！","art":{"background":"a2888","sprites":[{"asset":"a3698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「话是这么说……但我很想制造属于我们两个人的回忆」","art":{"background":"a2888","sprites":[{"asset":"a3551","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「因为我很快就要……」","art":{"background":"a2888","sprites":[{"asset":"a3561","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「……回到自己的国家去了」","art":{"background":"a2888","sprites":[{"asset":"a656","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「是啊，你要更新签证，需要回国两周，我也批准了你的假期了吧」","art":{"background":"a2888","sprites":[{"asset":"a52","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「竟、竟然要回去两周！」","art":{"background":"a2888","sprites":[{"asset":"a3574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「是的，竟然有两周」","art":{"background":"a2888","sprites":[{"asset":"a3552","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「唉，可是我听说三天以后，巫女大人、小春和廉太郎要一道去毕业旅行」","art":{"background":"a2888","sprites":[{"asset":"a3604","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「他们说要去你家暂住一段时间来着？」","art":{"background":"a2888","sprites":[{"asset":"a3698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"是的，我们准备去蕾娜家住，还准备一起去圣诞老人村观光。","art":{"background":"a2888","sprites":[{"asset":"a3698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"终于到了兑现约定的日子……","art":{"background":"a2888","sprites":[{"asset":"a3698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「三天……」","art":{"background":"a2888","sprites":[{"asset":"a3551","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……有三天不能见面，简直就是折磨」","art":{"background":"a2888","sprites":[{"asset":"a3551","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「我坐飞机的时候甚至不能跟将臣发邮件打电话！整整１１个小时啊」","art":{"background":"a2888","sprites":[{"asset":"a642","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「蕾娜」","art":{"background":"a2888","sprites":[{"asset":"a642","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「将臣！」","art":{"background":"a2888","sprites":[{"asset":"a3561","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「……」","art":{"background":"a2888","sprites":[{"asset":"a688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"不管三七二十一，先拥抱一个再说。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「所以……为了不让将臣在我离开的时候感到寂寞，我想为他制造一些回忆」","art":{"background":"a2888","sprites":[{"asset":"a668","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是啊，我也很难受，但这样就能忍耐一下了」","art":{"background":"a2888","sprites":[{"asset":"a668","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「嘿嘿，今天一天我就是将臣的老婆了，是吧老公？」","art":{"background":"a2888","sprites":[{"asset":"a3549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哎呀，好期待啊♪」","art":{"background":"a2888","sprites":[{"asset":"a3549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"最近大家都说我除了态度之外，情绪的变化也变得十分激烈，","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我觉得那是他们想太多了。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"要我说，三天不能见女朋友，换谁都得变成这样。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"心子","text":"「那么，就请两位享受本旅店的新婚旅行套餐吧」","art":{"background":"a2888","sprites":[{"asset":"a3589","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「餐饮方面也一定会让两位满意」","art":{"background":"a2888","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"你看，猪谷阿姨面不改色的，这不是说明我们很正常吗。","art":{"background":"a2888","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「哇噢，代我向厨师长问好！」","art":{"background":"a2888","sprites":[{"asset":"a692","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a50","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"心子","text":"「好的」","art":{"background":"a2888","sprites":[{"asset":"a692","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a52","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"猪谷阿姨略显拘谨地鞠了一躬就离开了房间。","art":{"background":"a2888","sprites":[{"asset":"a692","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"房里只剩我们两个，我不禁伸手缠住了蕾娜的手指。","art":{"background":"a2888","sprites":[{"asset":"a692","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「将臣……你就没有什么话要对你的新娘子说吗？」","art":{"background":"a2888","sprites":[{"asset":"a3917","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「有很多，太多了，我都不知道从哪里说起」","art":{"background":"a2888","sprites":[{"asset":"a3917","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我将自己的额头贴了上去，蕾娜则将手搭在了我肩上。","art":{"background":"a2888","sprites":[{"asset":"a3917","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「没事，你可以慢慢考虑，我们有的是时间」","art":{"background":"a2888","sprites":[{"asset":"a3572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「不过……在你想好之前，可别离开我哦」","art":{"background":"a2888","sprites":[{"asset":"a653","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哈哈哈，那我更愿意什么都不说，永远和你待在一起」","art":{"background":"a2888","sprites":[{"asset":"a653","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不过，也是」","art":{"background":"a2888","sprites":[{"asset":"a653","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「最近我有个新发现」","art":{"background":"a2888","sprites":[{"asset":"a653","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「告诉我吧」","art":{"background":"a2888","sprites":[{"asset":"a4027","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我可以把老婆这个词读作“天使”」","art":{"background":"a2888","sprites":[{"asset":"a4027","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「哇噢，嘿嘿……我的老公真厉害，这可是全新的发现啊」","art":{"background":"a2888","sprites":[{"asset":"a685","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「那这样的话，我也有一个新发现」","art":{"background":"a2888","sprites":[{"asset":"a692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「什么，告诉我」","art":{"background":"a2888","sprites":[{"asset":"a692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「我可以把老公这个词读作“快吻我”」","art":{"background":"a2888","sprites":[{"asset":"a3917","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「噗……哈哈」","art":{"background":"a2888","sprites":[{"asset":"a3917","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「嘿嘿」","art":{"background":"a2888","sprites":[{"asset":"a664","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「太勉强了」","art":{"background":"a2888","sprites":[{"asset":"a664","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"不过表达爱意还是越直白越好。","art":{"background":"a2888","sprites":[{"asset":"a664","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「啾♪……嘻嘻」","art":{"background":"a2888","sprites":[{"asset":"a3549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「老公，今天我们好好享受一下吧」","art":{"background":"a2888","sprites":[{"asset":"a653","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯」","art":{"background":"a2888","sprites":[{"asset":"a653","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"然而我并没有发现，蕾娜说的享受竟然有那么直白的意思。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"在那之后，我们一起打了乒乓，打了桌球……","art":{"background":"a580","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"还在家庭浴池里一起洗了澡。","art":{"background":"a580","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"……没做该做的事，要说奇怪也是有点怪，不过反正已经洗完了。","art":{"background":"a580","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"甚至可以说，正因为没做该做的事，我们才能更纯粹地享受旅行。","art":{"background":"a580","sprites":[]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「不愧是厨师长，每道菜都很棒！」","art":{"background":"a4007","sprites":[{"asset":"a665","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是啊，不论什么时候吃，志那都庄的菜都是最棒的」","art":{"background":"a4007","sprites":[{"asset":"a665","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"但是，端上来的菜是烤鳗鱼还有打成粉的山药……","art":{"background":"a4007","sprites":[{"asset":"a692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"牡蛎脆皮烙菜，甲鱼火锅……新婚旅行套餐都这样的吗？","art":{"background":"a4007","sprites":[{"asset":"a692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我不禁这样想道。","art":{"background":"a4007","sprites":[{"asset":"a692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"甚至让我们在最后把甲鱼血和烧酒掺一起一饮而尽……","art":{"background":"a4007","sprites":[{"asset":"a692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我照做之后，现在感觉浑身发热。","art":{"background":"a4007","sprites":[{"asset":"a692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"或者说，身体的某部分特别热。所以我应该不是醉了。","art":{"background":"a4007","sprites":[{"asset":"a692","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「嘻嘻嘻，你怎么了，老公」","art":{"background":"a4007","sprites":[{"asset":"a3549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"蕾娜贴在我肩上，向我撒娇。","art":{"background":"a4007","sprites":[{"asset":"a3549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「你看不出来吗？而且，你应该已经知道了吧？」","art":{"background":"a4007","sprites":[{"asset":"a3549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「真是的，老公，这是新婚旅行，那样的事情……当然都要……算在里面啦」","art":{"background":"a4007","sprites":[{"asset":"a3720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是啊」","art":{"background":"a4007","sprites":[{"asset":"a3720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我本来也打算做那种事。","art":{"background":"a4007","sprites":[{"asset":"a3720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"而且这么多次了，我也没必要客气什么。","art":{"background":"a4007","sprites":[{"asset":"a3720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"所以我毫不客气地抱住了蕾娜的肩。","art":{"background":"a4007","sprites":[{"asset":"a3720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「啊，不行呀，代官大人」","art":{"background":"a4007","sprites":[{"asset":"a4028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哈哈哈，来嘛，来嘛」","art":{"background":"a4007","sprites":[{"asset":"a4028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"感觉就像个好色的大叔，不过这种时候还是这样做更有趣。","art":{"background":"a4007","sprites":[{"asset":"a4028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"嗯，我应该还是有点醉了！","art":{"background":"a4007","sprites":[{"asset":"a4028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"可蕾娜的巨乳压过来之后，我一下就冷静不下来了。","art":{"background":"a4007","sprites":[{"asset":"a4028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……嗯！？」","art":{"background":"a4007","sprites":[{"asset":"a4028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「哎呀，你怎么了，将臣？」","art":{"background":"a4007","sprites":[{"asset":"a683","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「没，这点肢体接触……我还以为自己早就习惯了」","art":{"background":"a4007","sprites":[{"asset":"a683","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「噢，噢……」","art":{"background":"a4007","sprites":[{"asset":"a3569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"看来蕾娜已经注意到了我双腿之间的情况。","art":{"background":"a4007","sprites":[{"asset":"a3569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「喝了甲鱼血，变成这样很正常啊」","art":{"background":"a4007","sprites":[{"asset":"a660","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「还真是因为那个啊」","art":{"background":"a4007","sprites":[{"asset":"a660","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「是的……就算什么也不做，也会变成这样的，很正常」","art":{"background":"a4007","sprites":[{"asset":"a683","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「唔，嗯，可是……」","art":{"background":"a4007","sprites":[{"asset":"a683","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"感觉蕾娜比平时可爱了两分。","art":{"background":"a4007","sprites":[{"asset":"a683","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"当然，她一直是全世界最可爱的，可现在竟然看上去更可爱了……","art":{"background":"a4007","sprites":[{"asset":"a683","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我的老婆真是个天使啊」","art":{"background":"a4007","sprites":[{"asset":"a683","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「你的眼神都变成大灰狼了」","art":{"background":"a4007","sprites":[{"asset":"a3565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"嗯，说实话，我自己也有自知之明。","art":{"background":"a4007","sprites":[{"asset":"a3565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"可蕾娜却挑逗着我，在我胸口画圈圈。","art":{"background":"a4007","sprites":[{"asset":"a3565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「我呢……觉得被大灰狼吃掉，也没什么不好的」","art":{"background":"a4007","sprites":[{"asset":"a3998","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这、这样的话，蕾娜，我……」","art":{"background":"a4007","sprites":[{"asset":"a3998","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「嘻嘻，还是算了」","art":{"background":"a4007","sprites":[{"asset":"a3917","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"简直是折磨啊！","art":{"background":"a4007","sprites":[{"asset":"a3917","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「说不定不是大灰狼吃掉天使」","art":{"background":"a4007","sprites":[{"asset":"a647","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「其实……天使或许更想吃掉大灰狼哦」","art":{"background":"a4007","sprites":[{"asset":"a653","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……什么意思？」","art":{"background":"a4007","sprites":[{"asset":"a653","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「嘻嘻嘻，老公……今晚让我们好好疼爱彼此吧♪」","art":{"background":"a4007","sprites":[{"asset":"a4029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"}]