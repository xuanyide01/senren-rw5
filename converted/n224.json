[{"speaker":"将臣","text":"「……」","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"我听从小雨的建议，决定今晚出去吹吹风。","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"虽然太阳已经完全下山，但风吹起来并不算很凉。","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"这也说明夏天已经快到了。","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"我一边胡思乱想，一边随意地散着步。","art":{"background":"a2277","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「很难整理出头绪啊……」","art":{"background":"a2277","sprites":[]},"chapter":"3-8"},{"speaker":"茉子","text":"「……嗯？有地？你在这里做什么啊？」","art":{"background":"a2277","sprites":[{"asset":"a322","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「哎？哦，是常陆啊」","art":{"background":"a2277","sprites":[{"asset":"a322","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「只是散散步罢了」","art":{"background":"a2277","sprites":[{"asset":"a322","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「这么晚了还散步吗？」","art":{"background":"a2277","sprites":[{"asset":"a631","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「嗯……在想一些事情」","art":{"background":"a2277","sprites":[{"asset":"a631","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「想事情……这样啊」","art":{"background":"a2277","sprites":[{"asset":"a324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"常陆只回了一句话，她轻轻点了点头，之后就没有再多说什么了。","art":{"background":"a2277","sprites":[{"asset":"a324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「你现在要回去了？」","art":{"background":"a2277","sprites":[{"asset":"a322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「是的。明天早上我再来」","art":{"background":"a2277","sprites":[{"asset":"a324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「说起来……你家在哪里啊？」","art":{"background":"a2277","sprites":[{"asset":"a324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「不是在这附近吧？」","art":{"background":"a2277","sprites":[{"asset":"a324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「嗯，不在附近。我家在小镇西面的最边上」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「最边上……那岂不是很远？」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「刚好可以运动一下嘛」","art":{"background":"a2277","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"我有些吃惊。","art":{"background":"a2277","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"因为她每天都在朝武家帮忙做家务，我还以为一定住得很近……","art":{"background":"a2277","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「你不搬到附近来吗？」","art":{"background":"a2277","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「或者干脆住进来也行」","art":{"background":"a2277","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"她和朝武家关系这么好。","art":{"background":"a2277","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"这点小事，安晴叔叔和朝武应该会立刻答应的。","art":{"background":"a2277","sprites":[{"asset":"a628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「住进来可不行，这种厚待我怎么担当得起」","art":{"background":"a2277","sprites":[{"asset":"a565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「可是要搬家的话，这附近既没有公寓也没有空房」","art":{"background":"a2277","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「但这样很辛苦吧？」","art":{"background":"a2277","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「我并不觉得辛苦。因为我很喜欢走路」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「能多走路可是好事。特别是在早晨，走走路就能感受到季节的气息」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「但是路上行人很少的时间段让女孩子独自走回去，我不是很放心」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「我送送你吧」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「没问题的。这个镇上没有那种坏人」","art":{"background":"a2277","sprites":[{"asset":"a322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「而且我是忍者啊」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「……」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"说的也对。单看她在祓禊时展露出的本事，就知道她肯定比我强多了。","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"可是——","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「即便这样我还是会担心。就算是忍者，你依然是个女孩子啊」","art":{"background":"a2277","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「……女孩子……」","art":{"background":"a2277","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「难道不是吗？」","art":{"background":"a2277","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「哎？你该不会说……自己是带把的吧？难不成其实你是“伪娘”，只是我一直没发现？」","art":{"background":"a2277","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"而且胸部也是很有料的啊……","art":{"background":"a2277","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「啊，你误会了。我当然是女生。无论从身心、户籍，还是生理学角度上来看，都是货真价实的女生」","art":{"background":"a2277","sprites":[{"asset":"a330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「就是说啊，啊……吓了我一跳」","art":{"background":"a2277","sprites":[{"asset":"a330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"第一次相遇时背后碰到的那种胸部的触感。","art":{"background":"a236","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"明明是那么柔软……","art":{"background":"a236","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"那不可能不是真的……！","art":{"background":"a236","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"啊……到现在还记忆犹新。那种无与伦比的柔软触感，以及那份温暖……","art":{"background":"a236","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"那天对我来说就是胸部纪念日。","art":{"background":"a236","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「……」","art":{"background":"a2277","sprites":[]},"chapter":"3-8"},{"speaker":"茉子","text":"「……有地？有——地——？」","art":{"background":"a2277","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「哎？啊、嗯，什么事？」","art":{"background":"a2277","sprites":[]},"chapter":"3-8"},{"speaker":"茉子","text":"「你一脸色眯眯的样子哦」","art":{"background":"a2277","sprites":[{"asset":"a1086","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「哎！？啊、不，这是——」","art":{"background":"a2277","sprites":[{"asset":"a1086","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「你在想什么猥亵的事情吧？哈哈，好下流哦～」","art":{"background":"a2277","sprites":[{"asset":"a566","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「……才不是什么猥亵的事」","art":{"background":"a2277","sprites":[{"asset":"a566","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「被你这种人护送回家，感觉比一个人走回家还要危险呢」","art":{"background":"a2277","sprites":[{"asset":"a1348","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「喂！？虽然我知道你在开玩笑，但这话还是有点伤人啊」","art":{"background":"a2277","sprites":[{"asset":"a1348","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「不过嘛……会被你这么说，确实是我自己的问题」","art":{"background":"a2277","sprites":[{"asset":"a1348","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「嘻嘻，对不起」","art":{"background":"a2277","sprites":[{"asset":"a247","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「不过……既然如此那我就恭敬不如从命，请你送我一程好了」","art":{"background":"a2277","sprites":[{"asset":"a330","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「包在我身上！」","art":{"background":"a2277","sprites":[{"asset":"a330","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「话说，你在烦恼什么？」","art":{"background":"a2278","sprites":[{"asset":"a630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「哎？」","art":{"background":"a2278","sprites":[{"asset":"a630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「毕竟你平时都没有在晚上散步的习惯嘛」","art":{"background":"a2278","sprites":[{"asset":"a281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「这个嘛……」","art":{"background":"a2278","sprites":[{"asset":"a281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「有什么牢骚可以跟我说，如果你不介意的话」","art":{"background":"a2278","sprites":[{"asset":"a322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「……」","art":{"background":"a2278","sprites":[{"asset":"a322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「本来是我打算送你回家，难道反而是你在担心我？」","art":{"background":"a2278","sprites":[{"asset":"a322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「别说得那么夸张，就是闲聊几句而已」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「还是说……这个话题不谈为妙？」","art":{"background":"a2278","sprites":[{"asset":"a630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"常陆边问边打量我的表情。","art":{"background":"a2278","sprites":[{"asset":"a630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"她的眼神似乎透露着对我的关心。","art":{"background":"a2278","sprites":[{"asset":"a630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「……没有到烦恼那么严重啦」","art":{"background":"a2278","sprites":[{"asset":"a630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「你还记得吗，之前我们有一次坐在这里聊天，就是我们一起吃盐烤香鱼的时候」","art":{"background":"a2278","sprites":[{"asset":"a323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「嗯。我当然记得。当时我们坐在一起吃香鱼串烧……我的心还怦怦直跳呢」","art":{"background":"a2278","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"可当时你表现得非常自然啊……","art":{"background":"a2278","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"好吧，那并不是正题。","art":{"background":"a2278","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「当时的聊天内容你还记得吗？」","art":{"background":"a2278","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「那么，如果诅咒解除了你打算做什么？」","art":{"background":"a633","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「那时的问题，好像必须尽快作出答复了……快得有些出乎意料」","art":{"background":"a2278","sprites":[{"asset":"a284","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「我也没料到那个时刻会这么快到来」","art":{"background":"a2278","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「这种感觉很不真实。怎么说呢……就像是有人突然把结局摆到你面前」","art":{"background":"a2278","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「我都不知道该从何考虑……」","art":{"background":"a2278","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「你说过在这里的生活也不赖对吧？」","art":{"background":"a2278","sprites":[{"asset":"a281","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「周围有可爱的女孩子所以你很高兴，我记得当时是因为这种不纯洁的理由」","art":{"background":"a2278","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「我都说了，对男人来说这才叫正常啊」","art":{"background":"a2278","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「哈哈，说的也是」","art":{"background":"a2278","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「现在……你还是很烦恼吗？」","art":{"background":"a2278","sprites":[{"asset":"a323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"我……很烦恼吗？","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"要说自己现在很迷茫……感觉也不太像。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"我心中当然有回去的念头。因为那是我的故乡，朋友也多。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"可是——","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「先不说我的想法到底算不算正常」","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「我毕竟在穗织度过了一段非常充实的时光」","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「解了诅咒就拍拍屁股走人……这样似乎有些无情」","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"茉子","text":"「你多虑了。事到如今，没人会觉得你是个无情的人」","art":{"background":"a2278","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「不用在意细枝末节，做出不会后悔的选择才是最好的」","art":{"background":"a2278","sprites":[{"asset":"a324","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「如果即便这样你依然选择留下的话，那就再好不过了」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「真的吗？不会嫌我麻烦？」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「我怎么会有这么失礼的念头呢」","art":{"background":"a2278","sprites":[{"asset":"a281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「你把我当成是那种人了吗？如果是这样的话倒是有些令人伤心啊」","art":{"background":"a2278","sprites":[{"asset":"a326","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「抱歉抱歉。当然是半开玩笑的啦」","art":{"background":"a2278","sprites":[{"asset":"a326","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「有一半是真心话吗？」","art":{"background":"a2278","sprites":[{"asset":"a318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「也不能这么说吧……毕竟确实一直在给你添麻烦啊」","art":{"background":"a2278","sprites":[{"asset":"a318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「至少在各方面都让你费了不少心思吧」","art":{"background":"a2278","sprites":[{"asset":"a318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「我从来没这么想过。我反而挺乐意的」","art":{"background":"a2278","sprites":[{"asset":"a330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「跟你说个秘密……自从你来了之后，朝武家的氛围就有了改变。变得更明快开朗了」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「是这样吗」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「虽然以前也不是说非常压抑，但芳乃大人和安晴大人基本都是那种安静内敛的人」","art":{"background":"a2278","sprites":[{"asset":"a281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「我更喜欢现在的氛围。而且……听到你对我的料理大加赞赏，我也很开心」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「很高兴你能这么想」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「我想芳乃大人和安晴大人他们一定也是这么想的」","art":{"background":"a2278","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「如果你回去的理由是会给我们添麻烦，这样反而会令人伤心」","art":{"background":"a2278","sprites":[{"asset":"a334","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「是吗……」","art":{"background":"a2278","sprites":[{"asset":"a334","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「即便你选择回去，也千万不要怀着这种消极的想法」","art":{"background":"a2278","sprites":[{"asset":"a284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「……」","art":{"background":"a2278","sprites":[{"asset":"a284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"我们一起跨越了诅咒这道难关。","art":{"background":"a2278","sprites":[{"asset":"a284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"虽不是亲生的兄弟姐妹，但彼此的关系比起普通朋友应该是深厚了许多。","art":{"background":"a2278","sprites":[{"asset":"a284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"如果事到如今对方还对自己特别客气，换作是我也会觉得很见外。","art":{"background":"a2278","sprites":[{"asset":"a284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「我明白了。谢谢你，常陆」","art":{"background":"a2278","sprites":[{"asset":"a284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「至少我不会再把别人拿来当借口了」","art":{"background":"a2278","sprites":[{"asset":"a284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「这就好」","art":{"background":"a2278","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"这么一说……其实答案已经呼之欲出了。","art":{"background":"a2278","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"生怕自己给别人添麻烦，也就意味着想留在这里。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「……」","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"承认了这一点之后……没想到心里好像忽然轻松了许多。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「话说回来——」","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"将臣","text":"「你今后有什么打算吗？」","art":{"background":"a2278","sprites":[{"asset":"a323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「我？」","art":{"background":"a2278","sprites":[{"asset":"a791","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「诅咒解开之后你就没有什么想做的事吗？」","art":{"background":"a2278","sprites":[{"asset":"a791","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"虽然那时她用一句“这是少女的秘密”把我打发了。","art":{"background":"a2278","sprites":[{"asset":"a791","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「啊、噢……是那件事吗」","art":{"background":"a2278","sprites":[{"asset":"a241","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「如果你有什么想做的事，最好也要做出不让自己后悔的选择」","art":{"background":"a2278","sprites":[{"asset":"a241","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「关于这个嘛，我只能说……有机会再说吧」","art":{"background":"a2278","sprites":[{"asset":"a286","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「顺便问一下，你那件想做的事是——」","art":{"background":"a2278","sprites":[{"asset":"a286","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「这是少女的秘密」","art":{"background":"a2278","sprites":[{"asset":"a427","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「我就知道你会这么说」","art":{"background":"a2278","sprites":[{"asset":"a427","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「哈哈，非常抱歉」","art":{"background":"a2278","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「现在不想说也没事，反正如果有什么需要我帮忙的，尽管跟我说就是了」","art":{"background":"a2278","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「平时承蒙你照顾，我至少也该还还人情」","art":{"background":"a2278","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「非常感谢你。既然你都这么说了……」","art":{"background":"a2278","sprites":[{"asset":"a286","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「以后如果遇到了什么难事，我会跟你说的」","art":{"background":"a2278","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"常陆面带着一如既往的微笑。","art":{"background":"a2278","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"看着眼前的这副笑容，我很怀疑她会不会真的来寻求我的帮助……","art":{"background":"a2278","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「……」","art":{"background":"a2278","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"仔细一想……我和常陆其实并没有特别亲近。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"我们的关系固然不错。我应该也没有被她讨厌。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"但总觉得还是有点距离感。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"感觉我不是她的朋友，而更像是她的熟客……？","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"即使我像这样想要主动拉近关系，她似乎也会刻意避开。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"茉子","text":"「……嗯？怎么了？」","art":{"background":"a2278","sprites":[{"asset":"a959","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「不，没什么……」","art":{"background":"a2278","sprites":[{"asset":"a959","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"就比如朝武吧，虽然她一开始很不给我面子，但之后能清楚感受到彼此的距离在拉近。","art":{"background":"a2278","sprites":[{"asset":"a959","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"常陆则是原本就没有摆出拒人千里的态度。","art":{"background":"a2278","sprites":[{"asset":"a959","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"然而我也从未感受到我俩的距离有在缩短。","art":{"background":"a2278","sprites":[{"asset":"a959","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「那么，送到这里就足够了」","art":{"background":"a2278","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「哎？可是，接下来路上的行人会越来越少吧？」","art":{"background":"a2278","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「而且天色已经暗下来了，我还是把你送到家吧」","art":{"background":"a2278","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「不用了，现在已经到我家附近了」","art":{"background":"a2278","sprites":[{"asset":"a281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「但是这一带……离后山很近吧？」","art":{"background":"a2278","sprites":[{"asset":"a281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「我刚才不就说了吗，我家在最边上」","art":{"background":"a2278","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"每天从这里前往朝武家好像很费劲啊。","art":{"background":"a2278","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「过了那个转角，没多远就是我家了」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「可是都已经走到这里了，如果你不嫌弃的话，就让我送到最后吧」","art":{"background":"a2278","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「……有地，你太狡猾了」","art":{"background":"a2278","sprites":[{"asset":"a2279","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「如果我拒绝的话，岂不就等于我嫌弃你吗」","art":{"background":"a2278","sprites":[{"asset":"a334","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「我不能让女孩子独自走行人稀少的夜路」","art":{"background":"a2278","sprites":[{"asset":"a334","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「你不必那么担心，我可是个忍者」","art":{"background":"a2278","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「即便是忍者也一样，这是两码事」","art":{"background":"a2278","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「变态可不会管你是不是忍者。他们可能会突然偷袭你」","art":{"background":"a2278","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「嗯……这句话确实有些道理。不过门外汉的偷袭对我来说——」","art":{"background":"a2278","sprites":[{"asset":"a286","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「太天真了！你的自大会要了你的命！」","art":{"background":"a2278","sprites":[{"asset":"a286","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「如果对方是袒露下体的裸男呢？你也能毫不犹豫地将其击退吗？」","art":{"background":"a2278","sprites":[{"asset":"a323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「下、下体！？这个嘛……因为灯光昏暗，要摆平他应该还是有办法的……」","art":{"background":"a2278","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「……」","art":{"background":"a2278","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"……也是，毕竟她有苦无。还能够进行远距离攻击。","art":{"background":"a2278","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"有生命危险的反而应该是犯人。","art":{"background":"a2278","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「但、但是！如果被袒露下体的男人公主抱的话你怎么办！」","art":{"background":"a2278","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「什么怎么办……那种莫名其妙的变态是哪来的」","art":{"background":"a2278","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「所谓的变态，就是拥有常人难以理解的嗜好的人。所以才会被称为变态」","art":{"background":"a2278","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「道理是没错啦」","art":{"background":"a2278","sprites":[{"asset":"a1160","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「你只不过被我公主抱就已经动弹不得了吧」","art":{"background":"a2278","sprites":[{"asset":"a1160","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「如果发生了意料之外的状况，你认为自己真的能够冷静应对吗？」","art":{"background":"a2278","sprites":[{"asset":"a1160","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「呃……被你拿这个说事，实在是让人难以反驳……」","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"常陆的回答结结巴巴，刚才的那番自信已经逐渐消失。","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"大概她也觉得实际的后果会不堪设想吧。","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"那是当然。被裸男公主抱的话，即便是我也会全身僵硬，不知对方要干什么。","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「但只要在男性的陪同下，遭遇这种事的可能性就会大为降低」","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「跟实际上的强弱无关，关键在于有男性在身边」","art":{"background":"a2278","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「……但是过去从来没出现过那样的变态啊」","art":{"background":"a2278","sprites":[{"asset":"a318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「那是过去！即便没有先例，凡事也都有可能遭遇第一次！」","art":{"background":"a2278","sprites":[{"asset":"a318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「我并不是在怀疑镇上的人，但是这里游客也很多啊。还是小心点为妙！」","art":{"background":"a2278","sprites":[{"asset":"a318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「或者这么跟你说吧，都已经送到这里了，你就不能让我爽爽快快地送到最后吗？」","art":{"background":"a2278","sprites":[{"asset":"a318","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「……明白了。我认输了」","art":{"background":"a2278","sprites":[{"asset":"a286","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「多谢！」","art":{"background":"a2278","sprites":[{"asset":"a286","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「真的是有够偏僻的啊……」","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"常陆的家在从小路拐进去的最深处。","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"路上昏暗无光，周围的民居也很少。","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"再往里走的话好像什么都没有，甚至连路都没有了。","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"真的是名副其实的偏远边际。","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"茉子","text":"「今天真的非常感谢你特地送我回家」","art":{"background":"a119","sprites":[{"asset":"a332","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「不不，我才要谢谢你」","art":{"background":"a119","sprites":[{"asset":"a332","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「因为都是多亏了你，我的脑袋清爽多了」","art":{"background":"a119","sprites":[{"asset":"a332","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「能帮上你的忙太好了，呵呵」","art":{"background":"a119","sprites":[{"asset":"a249","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-8"},{"speaker":"茉子","text":"「那就晚安了。有地」","art":{"background":"a119","sprites":[{"asset":"a324","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-8"},{"speaker":"将臣","text":"「晚安，常陆」","art":{"background":"a119","sprites":[{"asset":"a324","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-8"},{"speaker":"","text":"于是我与常陆道别，沿着原路返回。","art":{"background":"a119","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"奇妙的是，此刻脑海中那种不知如何是好的烦恼已经消失无踪。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"},{"speaker":"","text":"看样子今晚能睡个安稳觉了。","art":{"background":"a2278","sprites":[]},"chapter":"3-8"}]