[{"speaker":"将臣","text":"「呼……呼……」","art":{"background":"a0","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「将臣，太阳晒屁股啦。将——臣——」","art":{"background":"a0","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯？嗯、嗯嗯嗯……」","art":{"background":"a0","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「你还要去锻炼的吧？而且今天是周一，还要上学啊」","art":{"background":"a0","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……咦？」","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"一觉醒来，我发现自己躺在旅馆的房间里。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「（还有点不适应啊）」","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"明明只是在朝武家借住了短短几个月而已……","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我好像已经完全习惯了在那边的生活。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我还没有适应这个房间。在最近这段时间，我每次一觉醒来都会有点诧异。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"被闪耀飞雪祝福的那一夜过后，又过了不少时日。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"所以变化也是在所难免的。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"首先第一点，就是茉子又回自己家住了。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"既然附身已解除，她就没必要继续住在朝武家了，天天上门服侍的生活又重新开始。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"而我也离开了朝武家。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我已经不是朝武的未婚夫，而且诅咒也已经消除，所以也不能继续赖在他们家里。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"当然了，朝武和安晴叔叔都让我不要介意。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"但我并不能这么做。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"外公也和我说了要搬出来住，而且我现在有个很出色的女朋友。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"所以我离开了他们家。现在借住在外公旅馆的一个房间，每天从这里出发前往学校。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"而最大的改变——","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「早上好，将臣」","art":{"background":"a2888","sprites":[{"asset":"a249","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"应该就是茉子会像这样来叫我起床吧。","art":{"background":"a2888","sprites":[{"asset":"a249","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「早上好，茉子」","art":{"background":"a2888","sprites":[{"asset":"a284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「早安。今天的天气也很好哦」","art":{"background":"a2888","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「谢谢你每天都特地来叫我起床」","art":{"background":"a2888","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「在去朝武家前先绕来这里，其实也挺麻烦的吧？」","art":{"background":"a2888","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「没关系的。其实……主要是我自己想来」","art":{"background":"a2888","sprites":[{"asset":"a281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「所以，如果不打扰你的话，就请让我来叫醒你吧」","art":{"background":"a2888","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「当然没问题。早上第一眼看到的就是心上人，这种事让人特别开心」","art":{"background":"a2888","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「既然茉子自己愿意，那今后也请你一定要来叫我起床」","art":{"background":"a2888","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嗯。包在我身上」","art":{"background":"a2888","sprites":[{"asset":"a330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"不管怎么说，我们的幸福生活一直延续到了现在。","art":{"background":"a2888","sprites":[{"asset":"a330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"虽然住处变了，但并没有影响到我们两个之间的感情。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"不，可能是因为能够在一起的时间比之前更有限的缘故吧？","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我们更加珍惜能够独处的机会，在一起的时光变得更加浓情蜜意。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"比奈实","text":"「啊，打铃了吗。那上午的课就上到这了」","art":{"background":"a528","sprites":[{"asset":"a526","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"等老师边说边走出教室，我就猛地从椅子上站了起来。","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「噢噢……很有干劲嘛」","art":{"background":"a599","sprites":[{"asset":"a513","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那当然。毕竟能吃到茉子亲手做的料理的机会变少了」","art":{"background":"a599","sprites":[{"asset":"a513","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「也对……你搬到爷爷那去住了对吧」","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是啊」","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"早餐和晚餐都是旅馆为我准备的。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"虽然吃的只是员工餐罢了。","art":{"background":"a2888","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"不，即便如此也是专业大厨做出来的，当然很好吃。","art":{"background":"a530","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"好吃是好吃……不过对我来说，最好吃的还是茉子亲手做的料理。","art":{"background":"a530","sprites":[]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「也真是没想到，常陆竟然会和你凑成一对。先问一下，你们处得还顺利吧？」","art":{"background":"a599","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那当然了」","art":{"background":"a599","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「怎么说呢……常陆全身洋溢着的一股健康美很不错啊」","art":{"background":"a599","sprites":[{"asset":"a519","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……喂」","art":{"background":"a599","sprites":[{"asset":"a519","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「不，我没别的意思。也不是想挑衅你」","art":{"background":"a599","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「我只是从正常的角度进行评价啦。漂亮的女生，可爱的女生是挺常见的，但是拥有健康美的女生就难得一见了」","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这倒也是」","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"这点确实是茉子的一大魅力。","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"可能是她平时会运动吧，要说“柔美”似乎也不太准确……或许“健康美”这个说法确实是最贴切的。","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"虽然她自己却因为腿粗而耿耿于怀，但正是茉子的那双腿尤为美妙。","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"说起来，我第一次看她穿校服时……她穿紧身裤的模样真是惊艳到我了。","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「久等了，将臣。那我们走吧」","art":{"background":"a599","sprites":[{"asset":"a494","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊，嗯。赶紧走吧」","art":{"background":"a599","sprites":[{"asset":"a494","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"于是我们就带着便当，前往能够两个人独处的地方。","art":{"background":"a599","sprites":[]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「早点回来，别迟到了～」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「路上小心」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"接着我们去了常去的老地方。","art":{"background":"a1044","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"在这里亲热已经成了每天的保留项目。","art":{"background":"a1044","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「多谢款待！」","art":{"background":"a1044","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「粗茶淡饭而已」","art":{"background":"a1044","sprites":[{"asset":"a511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯，跟平常一样好吃，谢谢你」","art":{"background":"a1044","sprites":[{"asset":"a511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「不用不用。毕竟我也做得很开心啊」","art":{"background":"a1044","sprites":[{"asset":"a476","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「一边想象着你吃的时候的表情一边做菜……最后又真能让你吃得很开心，我就很满足了」","art":{"background":"a1044","sprites":[{"asset":"a600","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「啊，我绝对不是在逞强哦」","art":{"background":"a1044","sprites":[{"asset":"a583","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我知道。我又没有在怀疑你」","art":{"background":"a1044","sprites":[{"asset":"a583","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「而且还能得到奖励嘛。今天也可以吗？」","art":{"background":"a1044","sprites":[{"asset":"a828","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「到我这来吧」","art":{"background":"a1044","sprites":[{"asset":"a828","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我张开双臂，茉子便开心地扑进了我的怀里。","art":{"background":"a1044","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「将臣……蹭蹭～」","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"茉子用脸颊蹭着我，心情看起来非常好。","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我温柔地抱着她，如同享用甜点般享受着她身体的温暖。","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「哈哈……靠着将臣好暖和，好棒」","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「在我看来，你靠着我的时候也很暖和，我更舒服」","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"最近茉子只要一抓到机会就会像这样跟我拼命撒娇。","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"这说明她已经完全对我敞开了心扉。","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"能够切身体会到茉子对我的感情，我非常高兴。","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「今天的便当味道怎么样？」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「当然没得说，太好吃了」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「真的很感谢你一直做便当给我吃，茉子」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「很高兴听你这么说……不过现在能不能把我抱得更紧一些？」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「好啦好啦，当然没问题」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嘿嘿……非常感谢，哈哈♪」","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊～……你闻起来真的好香」","art":{"background":"a2690","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「你又要开始做奇怪的事了吗？」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哪里奇怪了。你真的很好闻」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我吸～～～你闻闻，味道多香啊。香得我一闻就要兴奋起来了」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「你真的很下流啊，真是的……」","art":{"background":"a2695","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不过，就算我这么下流，你也很喜欢我，对吧？」","art":{"background":"a2695","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「那当然了。毕竟我自己也很下流啦……说不得别人」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……你现在已经有感觉了？」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嗯……有感觉了。像这样……被温柔地抱着……当然会来感觉啦」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「这阵子彼此都很忙……那种机会也很少嘛。所以就特别……有感觉」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……你的意思是……」","art":{"background":"a2693","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"贴在我胸前的茉子抬起头。","art":{"background":"a1044","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"她用湿润的双眸直勾勾地看着我。","art":{"background":"a1044","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「应该差不多……可以挑战新事物了」","art":{"background":"a1044","sprites":[{"asset":"a2889","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……（吞口水）」","art":{"background":"a1044","sprites":[{"asset":"a2889","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊不……虽然我非常赞成你的意见。不过换衣服是个问题吧？」","art":{"background":"a1044","sprites":[{"asset":"a2889","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「其实，那个……今天我其实……带了备用的衣服哦……」","art":{"background":"a1044","sprites":[{"asset":"a2889","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……（吞口水）」","art":{"background":"a1044","sprites":[{"asset":"a2889","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我觉得茉子可能还是比我更色。","art":{"background":"a1044","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"脑袋里这么想，身体却擅自动了起来。","art":{"background":"a1044","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嗯啾、啾、啾唔唔……嗯嗯、滋溜、啾、啾唔唔……嗯嗯」","art":{"background":"a2697","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"像这样接了吻的结果就是——","art":{"background":"a2697","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我的双腿之间已经硬到没法再关掉性欲开关了。","art":{"background":"a2697","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「滋溜、啾、啾唔……嗯唔、滋溜滋溜……嗯嗯，噗啊」","art":{"background":"a2697","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「啊、啊……嗯嗯、将臣……」","art":{"background":"a1044","sprites":[{"asset":"a2705","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「茉子……稍等一下」","art":{"background":"a1044","sprites":[{"asset":"a2705","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「哎？为什么……啊？」","art":{"background":"a1044","sprites":[{"asset":"a2623","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"茉子回应道，她的声音听上去有些幽怨。","art":{"background":"a1044","sprites":[{"asset":"a2623","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"从那湿润的双眸来看，她的开关好像已经打开了。","art":{"background":"a1044","sprites":[{"asset":"a2623","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"面对这样的她，我也不可能停得下来。","art":{"background":"a1044","sprites":[{"asset":"a2623","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"准确来说我自己心中更是热血沸腾——","art":{"background":"a1044","sprites":[{"asset":"a2623","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那个……我有一个请求，不知道你同不同意」","art":{"background":"a1044","sprites":[{"asset":"a2623","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「……什么请求？」","art":{"background":"a1044","sprites":[{"asset":"a824","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「之前我就对紧身裤这种东西有非同寻常的兴趣……其实——」","art":{"background":"a1044","sprites":[{"asset":"a824","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「哎哎哎哎哎哎哎哎哎哎哎！？」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「久、久等了……」","art":{"background":"a1044","sprites":[{"asset":"a2706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「噢噢！」","art":{"background":"a1044","sprites":[{"asset":"a2706","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「我已经……脱了哦……」","art":{"background":"a1044","sprites":[{"asset":"a2434","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「噢噢噢噢！太感谢了，茉子！」","art":{"background":"a1044","sprites":[{"asset":"a2434","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那么……」","art":{"background":"a1044","sprites":[{"asset":"a2434","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嗯、嗯……」","art":{"background":"a1044","sprites":[{"asset":"a2432","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"}]