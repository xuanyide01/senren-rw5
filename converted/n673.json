[{"speaker":"将臣","text":"「小雨，你没事吧？有没有哪里疼？」","art":{"background":"a3154","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"兴奋感慢慢冷却，我一边意犹未尽一边担心起她的身体。","art":{"background":"a3154","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「……嗯，没事」","art":{"background":"a3154","sprites":[{"asset":"a3248","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「回头可能会有些疼……」","art":{"background":"a3154","sprites":[{"asset":"a3249","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「但那也无妨」","art":{"background":"a3154","sprites":[{"asset":"a3250","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「毕竟能用肉身将第一次献给喜欢的男人……」","art":{"background":"a3154","sprites":[{"asset":"a3251","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「本座从今往后不会有什么遗憾了……」","art":{"background":"a3154","sprites":[{"asset":"a3252","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"啊？","art":{"background":"a3154","sprites":[{"asset":"a3252","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「小雨，你这是什么意思？」","art":{"background":"a3154","sprites":[{"asset":"a3252","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「……」","art":{"background":"a3154","sprites":[{"asset":"a3253","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"小雨盯着我的脸。","art":{"background":"a3154","sprites":[{"asset":"a3253","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「得洗干净啊，主人」","art":{"background":"a3154","sprites":[{"asset":"a3252","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"她微笑着，但并没有回答我。","art":{"background":"a3154","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「晚安，主人」","art":{"background":"a360","sprites":[{"asset":"a3131","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「嗯，晚安，小雨」","art":{"background":"a360","sprites":[{"asset":"a3131","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-4"},{"speaker":"","text":"我们互道晚安后立刻关了灯。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"虽说是第二次，但男女之事确实很累人。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"洗完澡之后，我们吃过晚餐立刻就睡了。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「呼……呼……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"很快小雨那边就传来了鼻息。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"但我却睡不着。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"虽然身体很累，但我的意识很清晰。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"因为有件事情我很在意。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「小雨，你下定决心恢复人身了吗？」","art":{"background":"a2768","sprites":[{"asset":"a3189","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「……不知道」","art":{"background":"a2768","sprites":[{"asset":"a3107","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「说实话，本座在思考自己是不是不应该恢复人身」","art":{"background":"a2768","sprites":[{"asset":"a3175","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「毕竟能用肉身将第一次献给喜欢的男人……」","art":{"background":"a3154","sprites":[{"asset":"a3251","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"丛雨","text":"「本座从今往后不会有什么遗憾了……」","art":{"background":"a3154","sprites":[{"asset":"a3252","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-4"},{"speaker":"将臣","text":"「……小雨」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我很在意她那时说的话。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我翻过身看着睡在我一旁的她。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"她依然背对着我。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「主人，你睡不着吗？」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「你醒着？」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「刚醒」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「因为感觉到主人在看本座」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「本座可是丛雨丸的管理者，对人的气息或者视线很敏感的」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「是吗，可我不会对你做什么的」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「好好休息吧」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「骗人，肯定是想做色色的事情吧」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「哼，本座已经全部看穿了，主人」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"小雨背对着我嘻嘻笑了起来。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"她的肩膀在颤抖。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「就算是我女友，我也不会做出这样的事情」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我可没那么不要脸。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「开玩笑的」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「谁让本座的主人那么温柔呢……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「也、也不是这样的」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"忽然被夸奖，我很害羞。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「主人不必谦虚」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「正因主人温柔，丛雨丸才能使出原本的力量，平息祟神的怒火」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「主人保护了本座、芳乃和茉子」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「冒着生命危险，保护了我们……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「主人的所有行为，里面都不带有丝毫私心」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「光凭这点，本座就很敬佩主人」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「小雨……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"她怎么突然说这种话。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我觉得有些担心。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"小雨究竟在想什么呢？","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「主人」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"她背对着呼唤我。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「怎么？」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「……你的父母还健在吗？」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「啊？啊，嗯，还健在的」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"为什么要提到我父母？","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我很疑惑。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「待振兴小镇的事情告一段落之后，你就可以回去了，主人」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「……什么？」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「如你所知，穗织确实是个特殊的地方」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「而且生活不便，财政又吃紧」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「从长远来看，让主人留在这里不是好事」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「话是这么说，可是」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我已经喜欢上穗织了。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"不，我喜欢的是在这里的人们。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"而且，小雨也在这里……","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「最重要的是」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"不待我开口，小雨就继续说了下去。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「主人的亲人不在这里」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「亲人……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「本座深有体会，主人。这是本座发自内心的忠告」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「要珍惜你的家人」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「常言道……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「子欲养而亲不待……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「小雨……」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"小雨的声音很平静。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"但我能感觉她说得很坚定，不容我反驳。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我只能将自己想说出口的话留在心中。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「晚安，主人」","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"这就是小雨今晚说的最后一句话。","art":{"background":"a1340","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我犹豫了很久，但最后还是什么也没说就睡了。","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"她在成为祭品的时候与许多人，不，是与所有人道别了。","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"其中当然有她的家人。","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「……只让她恢复人身不行啊」","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我这才意识到她背负的东西有多沉重。","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我真是太傻了。","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我竟然没设想到她真正的痛苦与悲伤。","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"但是……","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"但是，我……","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「呼……呼……」","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"祝你好梦。","art":{"background":"a0","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我听着她微弱的鼻息声，如是祈祷道。","art":{"background":"a0","sprites":[]},"chapter":"6-4"}]