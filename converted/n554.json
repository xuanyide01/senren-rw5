[{"speaker":"芳乃","text":"「啊、啊、啊啊啊……嗯嗯、嗯啊啊啊啊、快点、快点快点、不然、我又要自己一个人……啊啊啊！」","art":{"background":"a2210","sprites":[]},"chapter":"7-3"},{"speaker":"将臣","text":"「我们一起……射在里面了」","art":{"background":"a2210","sprites":[]},"chapter":"7-3"},{"speaker":"芳乃","text":"「啊啊啊，好、好的、好的……请在、我的里面、射出来、啊啊啊」","art":{"background":"a2208","sprites":[]},"chapter":"7-3"},{"speaker":"芳乃","text":"「我要、去了……啊啊啊啊、去了去了、去了……嗯、嗯嗯嗯————————！」","art":{"background":"a2210","sprites":[]},"chapter":"7-3"},{"speaker":"将臣","text":"「芳乃！」","art":{"background":"a2210","sprites":[]},"chapter":"7-3"},{"speaker":"芳乃","text":"「嗯嗯嗯嗯嗯嗯嗯——————————————！！」","art":{"background":"a2212","sprites":[]},"chapter":"7-3"},{"speaker":"","text":"芳乃白皙的背部一阵阵地痉挛。","art":{"background":"a2212","sprites":[]},"chapter":"7-3"},{"speaker":"","text":"与此同时，我也将沸腾的欲望尽情地倾泻在她的体内。","art":{"background":"a2212","sprites":[]},"chapter":"7-3"},{"speaker":"芳乃","text":"「嗯、嗯、嗯嗯嗯……嗯呜、嗯、呼……呼——哈、啊、啊、啊啊啊……啊啊啊啊啊……」","art":{"background":"a2213","sprites":[]},"chapter":"7-3"},{"speaker":"","text":"虽然气势很强，但毕竟已经是第三次了。","art":{"background":"a2213","sprites":[]},"chapter":"7-3"},{"speaker":"","text":"我的射精没过多久就停息了。","art":{"background":"a2213","sprites":[]},"chapter":"7-3"},{"speaker":"芳乃","text":"「啊、哈、啊啊……啊啊……好强烈、的高潮……啊、啊啊……」","art":{"background":"a2214","sprites":[]},"chapter":"7-3"},{"speaker":"将臣","text":"「我也是。没想到能连续高潮这么多次……我也是第一次」","art":{"background":"a2214","sprites":[]},"chapter":"7-3"},{"speaker":"","text":"我连根将阴茎插在她的体内，然后跟她一起瘫软了下去。","art":{"background":"a2214","sprites":[]},"chapter":"7-3"},{"speaker":"","text":"啊啊……视野一闪一灭的，意识似乎要断线了……","art":{"background":"a2214","sprites":[]},"chapter":"7-3"},{"speaker":"将臣","text":"「芳乃……我拔出来了」","art":{"background":"a2214","sprites":[]},"chapter":"7-3"},{"speaker":"芳乃","text":"「啊、啊啊……啊、啊……嗯嗯、啊啊啊啊……●棒拔出来了……嗯啊啊」","art":{"background":"a2215","sprites":[]},"chapter":"7-3"},{"speaker":"","text":"在我抽出阴茎的瞬间，从扩张的洞穴处潺潺地流出白色的精液。","art":{"background":"a2216","sprites":[]},"chapter":"7-3"}]