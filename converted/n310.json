[{"speaker":"蕾娜・小春・廉太郎","text":"「小雨变回人了？！」\n「丛雨大人变回人了啊？！」\n「丛雨大人变回人了？！」","art":{"background":"a599","sprites":[{"asset":"a3113","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a3114","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a2240","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"午休时刻。","art":{"background":"a599","sprites":[{"asset":"a3113","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a3114","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a2240","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我一边和振兴小镇筹备委员会的各位成员吃午餐，一边跟她们讲了昨天的事情。","art":{"background":"a599","sprites":[{"asset":"a3113","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a3114","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a2240","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「我明白了，将臣！」","art":{"background":"a599","sprites":[{"asset":"a911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"不知为何廉太郎是最兴奋的那个，跟我讲话的时候连米粒都喷出来了。","art":{"background":"a599","sprites":[{"asset":"a911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「干啥啊，脏死了！」","art":{"background":"a599","sprites":[{"asset":"a911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我摆着右手让他快滚。","art":{"background":"a599","sprites":[{"asset":"a911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「也就是说我们也能看见丛雨大人了吧？」","art":{"background":"a599","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「我也能瞻仰和风美少女的模样了吧？！」","art":{"background":"a599","sprites":[{"asset":"a911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"廉太郎两眼放光，双手握拳喊叫着。","art":{"background":"a599","sprites":[{"asset":"a911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"敢情他的目的是这个啊。","art":{"background":"a599","sprites":[{"asset":"a911","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"小春","text":"「真是的，廉哥，你的动机太邪恶了……」","art":{"background":"a599","sprites":[{"asset":"a893","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"妹妹则在一旁用看垃圾的眼神看着她的哥哥。","art":{"background":"a599","sprites":[{"asset":"a893","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"廉太郎在小春心中的形象又崩塌了一些。","art":{"background":"a599","sprites":[{"asset":"a893","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"蕾娜","text":"「将臣，我们能去探病吗？」","art":{"background":"a599","sprites":[{"asset":"a1224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「唔，才刚刚开始治疗呢」","art":{"background":"a599","sprites":[{"asset":"a1224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「先等两三天看看情况再来探病吧？」","art":{"background":"a599","sprites":[{"asset":"a1224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"蕾娜","text":"「好的」","art":{"background":"a599","sprites":[{"asset":"a721","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"蕾娜","text":"「代我向小雨问好，让她保重身体」","art":{"background":"a599","sprites":[{"asset":"a695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"蕾娜笑着向我递来三颗糖。","art":{"background":"a599","sprites":[{"asset":"a695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"蕾娜","text":"「这是木瓜味的润喉糖」","art":{"background":"a599","sprites":[{"asset":"a903","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"蕾娜","text":"「请拿去给小雨吃吧」","art":{"background":"a599","sprites":[{"asset":"a902","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「谢谢，她肯定会很开心的」","art":{"background":"a599","sprites":[{"asset":"a902","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"这份温柔的关怀。","art":{"background":"a599","sprites":[{"asset":"a902","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"跟廉太郎完全不一样。","art":{"background":"a599","sprites":[{"asset":"a902","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"小春","text":"「哥哥，我也会跟蕾娜学姐一起去探病的」","art":{"background":"a599","sprites":[{"asset":"a500","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「嗯，除了廉太郎，其他人我都欢迎」","art":{"background":"a599","sprites":[{"asset":"a500","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「为什么啊！也让我见见啊！」","art":{"background":"a599","sprites":[{"asset":"a884","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「你去了也只会和她搭讪，不行」","art":{"background":"a599","sprites":[{"asset":"a884","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「唔……你这口气就像你是她男朋友一样！」","art":{"background":"a599","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「不是像，我就是她的男朋友」","art":{"background":"a599","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我也不打算隐瞒了，于是就这样堂堂正正地宣布出来。","art":{"background":"a599","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「什、什么？！」","art":{"background":"a599","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「真的假的？！你竟然交到女朋友了？！」","art":{"background":"a599","sprites":[{"asset":"a884","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「你来穗织才几天啊！」","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「见鬼，我的女友候补又少了一个！」","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"廉太郎啜泣起来。","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"这家伙竟然把小雨算进了候补。","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"他连小雨的样子都没见过啊，某种角度来说他也是挺厉害的。","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"茉子","text":"「等丛雨大人恢复之后，她也能以人类的模样来参加振兴小镇的会议了」","art":{"background":"a599","sprites":[{"asset":"a492","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a524","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"芳乃","text":"「好好期待吧」","art":{"background":"a599","sprites":[{"asset":"a510","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a524","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「你们俩这是在绕着弯子叫我别去探病吧？！」","art":{"background":"a599","sprites":[{"asset":"a884","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「这回你倒是听懂了」","art":{"background":"a599","sprites":[{"asset":"a884","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「可恶，我到底要被排挤到什么时候啊？」","art":{"background":"a599","sprites":[{"asset":"a739","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"当然要等到你把你对待女孩子的态度改了的时候。","art":{"background":"a599","sprites":[{"asset":"a739","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"小春","text":"「好期待呀，好想快点见到她」","art":{"background":"a599","sprites":[{"asset":"a897","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"妹妹没理会抱着脑袋发愁的哥哥，开心地笑了起来。","art":{"background":"a599","sprites":[{"asset":"a897","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"比奈实","text":"「那么今天的课到此为止」","art":{"background":"a528","sprites":[{"asset":"a525","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"比奈实","text":"「值日生别忘了打扫」","art":{"background":"a528","sprites":[{"asset":"a526","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我立刻站起身来。","art":{"background":"a599","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「朝武，常陆！」","art":{"background":"a599","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"我叫住了正准备收拾东西回家的两人。","art":{"background":"a599","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「抱歉，今天的会议我要请假」","art":{"background":"a599","sprites":[{"asset":"a509","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a479","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「在小雨恢复之前我暂时不能出席，真的很抱歉！」","art":{"background":"a599","sprites":[{"asset":"a509","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a479","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我捧着她们的手恳求道。","art":{"background":"a599","sprites":[{"asset":"a509","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a479","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-2"},{"speaker":"茉子","text":"「没事，我们都理解的」","art":{"background":"a599","sprites":[{"asset":"a492","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a524","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-2"},{"speaker":"芳乃","text":"「没关系的，我们自己会好好组织会议的」","art":{"background":"a599","sprites":[{"asset":"a510","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a524","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"她们俩笑着答应了我。","art":{"background":"a599","sprites":[{"asset":"a510","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a524","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-2"},{"speaker":"蕾娜","text":"「将臣，你就快点回去照顾她吧」","art":{"background":"a599","sprites":[{"asset":"a695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「行了行了，快走吧」","art":{"background":"a599","sprites":[{"asset":"a738","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"蕾娜和廉太郎也笑着对我说道。","art":{"background":"a599","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「非常感谢！再见！」","art":{"background":"a599","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"我向他们四人用力挥了挥手，转头就跑出了教室。","art":{"background":"a599","sprites":[]},"chapter":"6-2"},{"speaker":"蕾娜","text":"「哇噢，将臣在全力狂奔耶」","art":{"background":"a599","sprites":[{"asset":"a698","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「就算正常走回去，也只会晚个十分钟吧」","art":{"background":"a599","sprites":[{"asset":"a698","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a513","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"茉子","text":"「这也说明了他有多担心丛雨大人」","art":{"background":"a599","sprites":[{"asset":"a511","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"芳乃","text":"「是啊」","art":{"background":"a599","sprites":[{"asset":"a510","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"芳乃","text":"「嘻嘻，有种令人欣慰的感觉」","art":{"background":"a599","sprites":[{"asset":"a492","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"蕾娜","text":"「是的，我也想恋爱了」","art":{"background":"a599","sprites":[{"asset":"a713","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a491","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"茉子","text":"「是啊，也不知道在哪里能找到出色的男生呢？」","art":{"background":"a599","sprites":[{"asset":"a713","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2409","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「这里这里这里！」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"茉子","text":"「……在哪里能找到出色的男生呢？」","art":{"background":"a599","sprites":[{"asset":"a745","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a809","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"廉太郎","text":"「喂，别无视我啊，常陆！」","art":{"background":"a599","sprites":[{"asset":"a2240","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a809","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「呼，呼，呼」","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"我全速冲出校门，跑上了回去的路。","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"我急急忙忙的，非常焦急。","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"好想快点见到小雨。","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"虽说就算有我陪着，她的病情也不会更快好转。","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「啊」","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"半路上我停下了脚步。","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"虽然我治不好病……","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「改变目的地！」","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"我立刻转身。","art":{"background":"a493","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"接着再度全力奔跑起来。","art":{"background":"a19","sprites":[]},"chapter":"6-2"},{"speaker":"芦花","text":"「欢迎光临，阿将」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「呼、呼，你、你好……」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我喘着气跟芦花姐打了个招呼。","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"芦花","text":"「你出了好多汗啊，来，快擦擦」","art":{"background":"a1677","sprites":[{"asset":"a1571","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"芦花姐拿出手帕，给我擦了擦汗。","art":{"background":"a1677","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"有股肥皂的味道。","art":{"background":"a1677","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"芦花","text":"「所以，你有什么事？」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「急单，给我来个芭菲」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「要打包」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「啊，之后的一段时间我每天都会来买的」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"芦花","text":"「是、是吗」","art":{"background":"a1677","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"芦花","text":"「好的，我这就去做，你坐着休息休息」","art":{"background":"a1677","sprites":[{"asset":"a990","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"芦花姐眨了眨眼，但她还是立刻跑进里面去了。","art":{"background":"a1677","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「呼……」","art":{"background":"a1677","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"我坐在椅子上，终于理顺了呼吸。","art":{"background":"a1677","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"好了。","art":{"background":"a1677","sprites":[]},"chapter":"6-2"},{"speaker":"","text":"希望她能开心吧。","art":{"background":"a1677","sprites":[]},"chapter":"6-2"},{"speaker":"将臣","text":"「小雨，我回来了」","art":{"background":"a275","sprites":[]},"chapter":"6-2"},{"speaker":"丛雨","text":"「噢，主人」","art":{"background":"a275","sprites":[{"asset":"a3115","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"小雨正坐在被子上看杂志，她抬起头来。","art":{"background":"a275","sprites":[{"asset":"a3115","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「怎么这么早？振兴小镇会议呢？」","art":{"background":"a275","sprites":[{"asset":"a3116","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「那个我暂时请假了」","art":{"background":"a275","sprites":[{"asset":"a3116","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我在小雨身边坐下后说道。","art":{"background":"a275","sprites":[{"asset":"a3116","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「唔，真的可以吗，主人」","art":{"background":"a275","sprites":[{"asset":"a3117","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「没事的」","art":{"background":"a275","sprites":[{"asset":"a3117","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「反正在你痊愈之前，我也只会一直担心，根本顾不上振兴小镇的事」","art":{"background":"a275","sprites":[{"asset":"a3117","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「……！？」","art":{"background":"a275","sprites":[{"asset":"a3118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"小雨的脸以肉眼可见的速度变红了。","art":{"background":"a275","sprites":[{"asset":"a3118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「我说小雨，你是不是发烧了？」","art":{"background":"a275","sprites":[{"asset":"a3118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「……哇？！」","art":{"background":"a275","sprites":[{"asset":"a3119","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我将手掌搭在她额头上。","art":{"background":"a275","sprites":[{"asset":"a3119","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「啊，啊呜啊呜啊呜……」","art":{"background":"a275","sprites":[{"asset":"a3120","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"小雨的肩膀耸动着。","art":{"background":"a275","sprites":[{"asset":"a3120","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「抱歉，你暂时别乱动」","art":{"background":"a275","sprites":[{"asset":"a3120","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「主、主人，没、没事的！」","art":{"background":"a275","sprites":[{"asset":"a3121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「没发烧！本座一点事都没有！」","art":{"background":"a275","sprites":[{"asset":"a3122","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「可是，额头好像有点热吧？」","art":{"background":"a275","sprites":[{"asset":"a3122","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「那还不是怪你！」","art":{"background":"a275","sprites":[{"asset":"a3122","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"哎？","art":{"background":"a275","sprites":[{"asset":"a3122","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我在担心她呢，她怎么就生气了？","art":{"background":"a275","sprites":[{"asset":"a3122","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「总之本座没发烧」","art":{"background":"a275","sprites":[{"asset":"a3123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「别担心，主人」","art":{"background":"a275","sprites":[{"asset":"a3124","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「那就好」","art":{"background":"a275","sprites":[{"asset":"a3124","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"听小雨这么说，我才挪开手。","art":{"background":"a275","sprites":[{"asset":"a3124","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「本座的主人还真是的……」","art":{"background":"a275","sprites":[{"asset":"a3125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「根本就不懂少女心……」","art":{"background":"a275","sprites":[{"asset":"a3126","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「明明知道本座的心意！」","art":{"background":"a275","sprites":[{"asset":"a3127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"小雨嘀嘀咕咕的，不知道在说什么。","art":{"background":"a275","sprites":[{"asset":"a3127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"为什么突然就心情不好了啊。","art":{"background":"a275","sprites":[{"asset":"a3127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"女孩子真难懂。","art":{"background":"a275","sprites":[{"asset":"a3127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"啊，对了。","art":{"background":"a275","sprites":[{"asset":"a3127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「小雨，来，这个」","art":{"background":"a275","sprites":[{"asset":"a3127","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我将从芦花姐那里买来的东西递给她。","art":{"background":"a275","sprites":[{"asset":"a3116","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「噢！这难道是……」","art":{"background":"a275","sprites":[{"asset":"a3128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"小雨的眼睛突然闪闪发光。","art":{"background":"a275","sprites":[{"asset":"a3128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「如果没有不舒服的话，那就吃吧」","art":{"background":"a275","sprites":[{"asset":"a3128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「舒服极了！现在本座舒服极了，主人！」","art":{"background":"a275","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「那就好，来，吃吧」","art":{"background":"a275","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"","text":"我将芭菲交给小雨。","art":{"background":"a275","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「本座不客气了，主人！」","art":{"background":"a275","sprites":[{"asset":"a3130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「吃吧吃吧」","art":{"background":"a275","sprites":[{"asset":"a3130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「（狼吞虎咽）」","art":{"background":"a275","sprites":[{"asset":"a3131","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「……咕嘟」","art":{"background":"a275","sprites":[{"asset":"a3132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"将臣","text":"「好吃吗？」","art":{"background":"a275","sprites":[{"asset":"a3132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":"丛雨","text":"「嗯，芭菲的味道真是太棒了，主人！」","art":{"background":"a275","sprites":[{"asset":"a3115","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-2"},{"speaker":