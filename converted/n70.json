[{"speaker":"将臣","text":"「我也钓鱼吧」","art":{"background":"a1044","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「那我就先去摘野菜啦」","art":{"background":"a1044","sprites":[{"asset":"a434","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a324","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「茉子，小心点。万一出什么事就大声呼救」","art":{"background":"a1044","sprites":[{"asset":"a421","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a324","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「好的，谢谢您的关心。那我走了，回头见」","art":{"background":"a1044","sprites":[{"asset":"a421","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"刚说完这话，常陆就嗖地一下爬上了陡峭的山坡。","art":{"background":"a1044","sprites":[{"asset":"a421","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"看这样子是不需要担心什么了。","art":{"background":"a1044","sprites":[{"asset":"a421","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"接下来就开始钓鱼吧。","art":{"background":"a1044","sprites":[{"asset":"a421","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「我说，可以让我去教巫女大人吗？」","art":{"background":"a1044","sprites":[{"asset":"a1055","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1044","sprites":[{"asset":"a1055","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「你那什么眼神嘛。没想到你这么不信任我，我好伤心」","art":{"background":"a1044","sprites":[{"asset":"a106","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「听了班里那些传闻，谁还敢信你」","art":{"background":"a1044","sprites":[{"asset":"a106","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「不该干的事情我不会干的。我只是想借此机会跟她说说话而已」","art":{"background":"a1044","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「毕竟能跟巫女大人一起玩的机会可是很难得的啊」","art":{"background":"a1044","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"}]