[{"speaker":"小春","text":"「嘿嘿……」","art":{"background":"a493","sprites":[{"asset":"a901","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"小春傻笑道。","art":{"background":"a493","sprites":[{"asset":"a901","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"现在我陪在她身边倒好……要是她一个人走路的时候这样笑，肯定会被当成个怪人。","art":{"background":"a493","sprites":[{"asset":"a901","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"不过……笑起来的小春这么可爱，应该也不会引得别人起疑心的。","art":{"background":"a493","sprites":[{"asset":"a901","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"说来——","art":{"background":"a493","sprites":[{"asset":"a901","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「你怎么这么开心啊」","art":{"background":"a493","sprites":[{"asset":"a901","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「……哎？这当然是因为……嘿嘿……」","art":{"background":"a493","sprites":[{"asset":"a1633","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「呃……有什么好事让你乐成这样？」","art":{"background":"a493","sprites":[{"asset":"a1633","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「……」","art":{"background":"a493","sprites":[{"asset":"a887","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"就在我这么问之后，刚还在傻笑的小春突然就露出一副不满的表情。","art":{"background":"a493","sprites":[{"asset":"a887","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「怎、怎么？小春……你生气了？发、发生了什么？」","art":{"background":"a493","sprites":[{"asset":"a887","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「都怪哥哥你问这种没礼貌的问题啊」","art":{"background":"a493","sprites":[{"asset":"a507","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「啊！？不、不可以问吗？」","art":{"background":"a493","sprites":[{"asset":"a507","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「不是不能问，是你为什么要这么问啊……」","art":{"background":"a493","sprites":[{"asset":"a2999","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「你自己想想……还能有什么原因会让我这么开心啊」","art":{"background":"a493","sprites":[{"asset":"a507","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「这……」","art":{"background":"a493","sprites":[{"asset":"a507","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「那当然是因为……能和喜欢的人在一起啊」","art":{"background":"a493","sprites":[{"asset":"a2945","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a493","sprites":[{"asset":"a2945","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"原来如此。","art":{"background":"a493","sprites":[{"asset":"a2945","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"和喜欢的人一起上学确实是有点像青春漫画中才有的剧情。","art":{"background":"a493","sprites":[{"asset":"a2945","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「哥哥你都没有这样想过吗？」","art":{"background":"a493","sprites":[{"asset":"a896","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「这个嘛，能和你在一起我当然感到很幸福」","art":{"background":"a493","sprites":[{"asset":"a896","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「你是我最喜欢的人，这一点我们都一样」","art":{"background":"a493","sprites":[{"asset":"a896","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「你嘴上是这么说……但我怎么没见你有多高兴呢？」","art":{"background":"a493","sprites":[{"asset":"a2999","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「那你好好想想」","art":{"background":"a493","sprites":[{"asset":"a2999","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「你确实很可爱，但我这样的男的要是一边走路一边傻笑的话……」","art":{"background":"a493","sprites":[{"asset":"a896","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「路人肯定会报警，弄得像是发生了什么案件一样的吧」","art":{"background":"a493","sprites":[{"asset":"a896","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「我觉得倒不至于会惊动警察……而且我觉得应该没什么问题吧」","art":{"background":"a493","sprites":[{"asset":"a4085","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「毕竟哥哥你这么帅。你这张脸不管是认真起来还是笑起来都很好看，嘿嘿」","art":{"background":"a493","sprites":[{"asset":"a891","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「那还真是谢谢你夸奖了」","art":{"background":"a493","sprites":[{"asset":"a891","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「你也一样，不论什么时候都很可爱，都是个非常漂亮的女孩子」","art":{"background":"a493","sprites":[{"asset":"a891","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「是、是吗？谢谢夸奖啦，哥哥」","art":{"background":"a493","sprites":[{"asset":"a3881","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「小孩子就是好逗啊……」","art":{"background":"a493","sprites":[{"asset":"a3881","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「你你你、你在这里做什么啊，廉哥！？难不成你在偷窥！？」","art":{"background":"a493","sprites":[{"asset":"a4141","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a730","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「谁要偷窥你们啊。是你们走得太慢了，碰巧我就赶上你们了」","art":{"background":"a493","sprites":[{"asset":"a4141","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a516","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「啊……确实……时候不早了」","art":{"background":"a493","sprites":[{"asset":"a4141","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a516","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"一般来说这个时候我都到教室了。","art":{"background":"a493","sprites":[{"asset":"a4141","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a516","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"看来我是想要和小春呆在一起，下意识地就放慢了脚步。","art":{"background":"a493","sprites":[{"asset":"a4141","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a516","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「小春，我们走快点把。再这样下去就要迟到了」","art":{"background":"a493","sprites":[{"asset":"a896","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「嗯。好的」","art":{"background":"a493","sprites":[{"asset":"a1215","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「话说回来……你们都这个岁数了，不如再好好考虑一下“情侣”这层关系的意义？」","art":{"background":"a493","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「你想表达什么？」","art":{"background":"a493","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「再像个孩子一样满足于“可爱”啊“好帅”啊之类的褒奖，这关系可维持不了多久哦」","art":{"background":"a493","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「你小子啊」","art":{"background":"a493","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「我没有挑拨你们的关系的意思，也没有想刁难你们。只是实话实说罢了」","art":{"background":"a493","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「小春就不提了，将臣你也是第一次有女朋友吧？」","art":{"background":"a493","sprites":[{"asset":"a745","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「这……确实是，但又如何？」","art":{"background":"a493","sprites":[{"asset":"a745","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「你们都是第一次，所以不懂怎么样加深感情吧？」","art":{"background":"a493","sprites":[{"asset":"a514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「都、都是第一次……你、你这不要脸的哥哥一大清早在说什么呢！」","art":{"background":"a493","sprites":[{"asset":"a4258","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「啊？我只是在说加深感情的方法罢了。我又没有刻意说得容易让人误解」","art":{"background":"a493","sprites":[{"asset":"a4141","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a517","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「一大清早的你都在想什么呢……到底是谁不要脸啊，嘿嘿」","art":{"background":"a493","sprites":[{"asset":"a4141","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a499","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「唔唔…………………………」","art":{"background":"a493","sprites":[{"asset":"a4259","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a499","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「不过，我可没有开玩笑的意思」","art":{"background":"a493","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「你们肯定是在想到底怎么才能拉手，怎么挽起对方的胳膊，怎么接吻吧」","art":{"background":"a493","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「这……」","art":{"background":"a493","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「……」","art":{"background":"a493","sprites":[{"asset":"a4260","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"这确实挺棘手的……","art":{"background":"a493","sprites":[{"asset":"a4260","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「谁叫你们是表兄妹呢。作为亲戚都知根知底的，要做情侣可比起一般的男女要难」","art":{"background":"a493","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「关系好的情侣可是会手拉手一起上学的」","art":{"background":"a493","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「……」","art":{"background":"a493","sprites":[{"asset":"a4172","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「要……要拉手……吗？」","art":{"background":"a493","sprites":[{"asset":"a4172","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「这、这还不、简单……吗？」","art":{"background":"a493","sprites":[{"asset":"a4146","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「那、那……唔」","art":{"background":"a493","sprites":[{"asset":"a4146","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"我伸出了手。","art":{"background":"a493","sprites":[{"asset":"a4146","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「嗯，好……」","art":{"background":"a493","sprites":[{"asset":"a4261","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"小春也伸出手想要握住我的手……就在这时她的手抖了一下。","art":{"background":"a493","sprites":[{"asset":"a4262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"就像是触电了一样，不过我知道并不是这回事。","art":{"background":"a493","sprites":[{"asset":"a4262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「……我盯……」","art":{"background":"a493","sprites":[{"asset":"a520","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「………………嗯嗯！」","art":{"background":"a493","sprites":[{"asset":"a4259","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"小春像是下定了决心似的握住了我的手。","art":{"background":"a493","sprites":[{"asset":"a4259","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「噢，噢……」","art":{"background":"a493","sprites":[{"asset":"a4259","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"她的手比我想象中的还要小，不过却是如此温暖、柔软。","art":{"background":"a493","sprites":[{"asset":"a4259","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"哪怕她已经长大了……但她的手还是和以前一样。","art":{"background":"a493","sprites":[{"asset":"a4259","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"不，应该是我长大之后变化比较大吧？","art":{"background":"a493","sprites":[{"asset":"a4259","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「感……感觉有点害羞啊……」","art":{"background":"a493","sprites":[{"asset":"a4088","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「哦、哦……是啊……」","art":{"background":"a493","sprites":[{"asset":"a4088","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"还是表兄妹的时候……我们明明可以毫无顾虑地牵起对方的手。","art":{"background":"a493","sprites":[{"asset":"a4088","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"可为什么如今我们成为情侣之后却那么紧张呢……","art":{"background":"a493","sprites":[{"asset":"a4088","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「牵个手就这样了，那做爱的时候可就更了不得了吧」","art":{"background":"a493","sprites":[{"asset":"a516","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a4263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「做……」","art":{"background":"a493","sprites":[{"asset":"a516","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a4141","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「你还不是在往这个方向上说！你这个下流哥哥！」","art":{"background":"a493","sprites":[{"asset":"a4258","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「话虽这么说，但要是第一次没发挥好，日后可是会有阴影的啊」","art":{"background":"a493","sprites":[{"asset":"a4264","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a730","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「哎……会、会的吗……？」","art":{"background":"a493","sprites":[{"asset":"a4142","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a730","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「一生只有一次初夜。你肯定也想留个美好的回忆吧？」","art":{"background":"a493","sprites":[{"asset":"a4142","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a517","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「作为你哥，我只是在替你担心罢了，妹妹啊」","art":{"background":"a493","sprites":[{"asset":"a4142","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a502","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「骗、骗人骗人！你明明只是在拿我开玩笑！」","art":{"background":"a493","sprites":[{"asset":"a4149","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a502","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「哎呀，虽然这也没错」","art":{"background":"a493","sprites":[{"asset":"a499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「气死我了——！」","art":{"background":"a493","sprites":[{"asset":"a4265","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「不过那件事还是不要出错为妙，真的」","art":{"background":"a493","sprites":[{"asset":"a514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「……难不成你小子在这方面出过什么岔？」","art":{"background":"a493","sprites":[{"asset":"a514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「一开始没做过这种事，兴奋过头了……连早泄都算不上，甚至还没进去就……唉」","art":{"background":"a493","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「早、早泄……」","art":{"background":"a493","sprites":[{"asset":"a4146","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「当时我信心严重受挫，过了好久才重振旗鼓」","art":{"background":"a493","sprites":[{"asset":"a732","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「难不成……这其中有两层意思？」","art":{"background":"a493","sprites":[{"asset":"a732","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「没想到你听黄段子还挺上道的嘛」","art":{"background":"a493","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「毕竟是男的嘛」","art":{"background":"a493","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「哥哥！你别再和廉哥聊这种奇怪的话题了！他会得寸进尺的！」","art":{"background":"a493","sprites":[{"asset":"a4265","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「好吧，抱歉抱歉」","art":{"background":"a493","sprites":[{"asset":"a4265","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"不过我确实挺在意的……我想听听有经验的人的意见。","art":{"background":"a493","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"话说，这家伙果然不是处男了……","art":{"background":"a493","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"感觉有点不甘心……","art":{"background":"a493","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「哎呀总之我想说的就是，你们认识这么久了，肯定也足够了解对方了。但是表兄妹和情侣又是完全不同的两回事」","art":{"background":"a493","sprites":[{"asset":"a516","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「要是你们满足于“表兄妹”，那你们的关系可就岌岌可危了，这是忠告」","art":{"background":"a493","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「想不到你的忠告还挺正经的嘛」","art":{"background":"a493","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「那当然。谁都不希望自己的兄弟姐妹过上不幸福的生活啊」","art":{"background":"a493","sprites":[{"asset":"a504","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「……」","art":{"background":"a493","sprites":[{"asset":"a896","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「哎，反正我也没打算多管闲事。而且我对表兄妹之间的爱情也没什么兴趣」","art":{"background":"a493","sprites":[{"asset":"a518","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「总之我劝你们认真考虑考虑“情侣”这层关系的意义」","art":{"background":"a493","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「嗯，谢谢提醒，廉太郎」","art":{"background":"a493","sprites":[{"asset":"a517","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「谢……谢谢你替我们操心啦……廉哥……」","art":{"background":"a493","sprites":[{"asset":"a2999","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a518","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「……」","art":{"background":"a493","sprites":[{"asset":"a2999","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a745","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「哇真恶心。我怀疑今天要下雪喔，哈哈哈!」","art":{"background":"a493","sprites":[{"asset":"a2999","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a3028","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"廉太郎似笑非笑，飞一般地逃走了。","art":{"background":"a493","sprites":[{"asset":"a2999","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「什么！你这笨蛋哥哥！」","art":{"background":"a493","sprites":[{"asset":"a1217","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「停停停。再闹下去真要迟到了」","art":{"background":"a493","sprites":[{"asset":"a1217","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「行了，我们走吧」","art":{"background":"a493","sprites":[{"asset":"a1217","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"说完我便扯了扯小春的手。","art":{"background":"a493","sprites":[{"asset":"a1217","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"小春","text":"「啊……嗯」","art":{"background":"a493","sprites":[{"asset":"a1655","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"结果我身边的小春露出了欣喜的神情。","art":{"background":"a493","sprites":[{"asset":"a1655","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"看她这番反应……我不知怎的松了一口气。","art":{"background":"a493","sprites":[]},"chapter":"8-1"}]