[{"speaker":"","text":"——在那之后，半年过去了。","art":{"background":"a1","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"在梦境中，我和蕾娜与白山狛男神对峙之后，大家齐心协力将我们平安地带回了现实。","art":{"background":"a118","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"不……倒也不能说平安。","art":{"background":"a118","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我本以为哪怕在梦中受了伤，现实中的身体也不会受到影响，但事实并没有我想得那么美。","art":{"background":"a118","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"现实中的我，也是伤得不轻。","art":{"background":"a118","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我比蕾娜晚了整整三天才苏醒。","art":{"background":"a864","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"也就是说，指望梦中不受伤，才是真的做梦……","art":{"background":"a864","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「将臣……你终于醒了」","art":{"background":"a864","sprites":[{"asset":"a3548","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「蕾、蕾娜……？」","art":{"background":"a864","sprites":[{"asset":"a3548","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「不是说好了要大家一起迎接完美结局的吗？」","art":{"background":"a864","sprites":[{"asset":"a3560","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「你要是不在了……我也没法活了你知不知道」","art":{"background":"a864","sprites":[{"asset":"a654","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"你不也是以身犯险，做了那么多吓人的事情吗。","art":{"background":"a864","sprites":[{"asset":"a654","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"不过，我确实感到挺抱歉的。","art":{"background":"a864","sprites":[{"asset":"a654","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"毕竟让自己最重要的人担心成这样。","art":{"background":"a864","sprites":[{"asset":"a654","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「总之……你能苏醒过来，真是太好了」","art":{"background":"a864","sprites":[{"asset":"a692","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「欢迎回家，将臣」","art":{"background":"a864","sprites":[{"asset":"a3998","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「嗯，我回来了，蕾娜」","art":{"background":"a864","sprites":[{"asset":"a3998","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"当然了，一听说我醒了，其他朋友也立刻跑来看望我。","art":{"background":"a3095","sprites":[]},"chapter":"尾声"},{"speaker":"芳乃","text":"「有地！你终于醒了啊」","art":{"background":"a3095","sprites":[{"asset":"a3000","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「哈哈，我就知道你不会有什么事的，毕竟你之前也扛住了好几次大伤」","art":{"background":"a3095","sprites":[{"asset":"a3000","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a803","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"芳乃","text":"「真是的，你就知道让别人担心」","art":{"background":"a3095","sprites":[{"asset":"a711","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a803","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「唔，抱……抱歉」","art":{"background":"a3095","sprites":[{"asset":"a711","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a803","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"茉子","text":"「哈哈，我想说的是，对我和芳乃大人来说，你是很重要的朋友」","art":{"background":"a3095","sprites":[{"asset":"a711","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a4013","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「总之，这下可算是大团圆了」","art":{"background":"a3095","sprites":[{"asset":"a942","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"接下来的半年，她们三人的生活都发生了翻天覆地的变化。","art":{"background":"a3095","sprites":[{"asset":"a942","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"变化最大的当属小雨。","art":{"background":"a3095","sprites":[{"asset":"a942","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"不过，这就是题外话了。","art":{"background":"a3095","sprites":[{"asset":"a942","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"廉太郎","text":"「哟，将臣，我把刚收获的甜瓜拿来了」","art":{"background":"a3095","sprites":[{"asset":"a738","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「哎？真有你的啊，你是怎么弄到的？」","art":{"background":"a3095","sprites":[{"asset":"a738","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"小春","text":"「这个……他突然跑到别人田里面去，不停地求人家分他一颗，真是不害臊，我看着都不好意思了」","art":{"background":"a3095","sprites":[{"asset":"a4014","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"廉太郎","text":"「喂，小春！你说出来干嘛，我这还不是为了哥们着想！」","art":{"background":"a3095","sprites":[{"asset":"a4015","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a522","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"小春","text":"「你骗谁啊！我还不知道你那点心思，你肯定是自己想吃吧！」","art":{"background":"a3095","sprites":[{"asset":"a2945","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a522","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"美津叶","text":"「各位同学，这里好歹是医院啊」","art":{"background":"a3095","sprites":[{"asset":"a872","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"美津叶","text":"「希望大家安静点，不要大声喧哗」","art":{"background":"a3095","sprites":[{"asset":"a544","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"反正在那之后，我那喧闹又和睦的日常生活总算是回来了。","art":{"background":"a3095","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我真的是松了一口气。","art":{"background":"a3095","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"对了，在现实中，宿体也确实从蕾娜的体内分离了出来。","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"安晴","text":"「我觉得，我必须用我能想到的最郑重的方式供奉他们」","art":{"background":"a56","sprites":[{"asset":"a171","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"玄十郎","text":"「我身为氏子总代表，也会尽力出资的」","art":{"background":"a56","sprites":[{"asset":"a94","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"大人们似乎准备在供奉土地神的正殿旁边再建一座专门供奉从云和白狛的副殿。","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"虽说是副殿，但建造神社可不是那么容易的事，不仅花时间，还非常花钱。","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"据说要等到几年之后才能建好。","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"安晴","text":"「毕竟，我们得把它建成一座一千年以后也会有人来参拜的神社，否则就没有意义」","art":{"background":"a56","sprites":[{"asset":"a174","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a107","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"玄十郎","text":"「虽然感恩并不能用钱来表示，但是为了留下一座能够永远延续下去的神社，必要的经费是少不了的」","art":{"background":"a56","sprites":[{"asset":"a174","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a170","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"这也算是对未来的一种投资了。","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"而且我们的目的不仅仅是向神灵传达我们的感恩之情，我们更需要让后人了解心怀感恩的重要性。","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我真心期望，这样的传统能流传后世。","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"至于全新的春日祭，也早就提上了议程。年底前能做什么？具体该怎么举办？","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"大家早已开始了紧锣密鼓的准备。","art":{"background":"a56","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"终于，半年之后的今天——我迎来了第二次春日祭。","art":{"background":"a1","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"这次，有她陪在我身边。","art":{"background":"a1","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「哇哦，将臣！那家店卖的什么呀！？」","art":{"background":"a4016","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「应该是杏子糖吧？一般是用李子之类的水果裹上糖稀，放在最中皮上吃」","art":{"background":"a4016","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「哎，最近还有用菠萝和草莓做的杏子糖啊」","art":{"background":"a4016","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「我想尝尝！」","art":{"background":"a4017","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「可以啊，但你还吃得下吗？」","art":{"background":"a4017","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「日本的庆典活动上有太多没见过的东西了，我全部都想要嘛，啊！」","art":{"background":"a4016","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「快看！那里还有鱼，有个水槽里面全是鱼啊！这个是什么呀？」","art":{"background":"a4016","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「你没听说过捞金鱼吗？……旁边竟然还有钓泥鳅，确实够稀罕」","art":{"background":"a4016","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「是吗？我听说今年的摊位比以前更多」","art":{"background":"a4018","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我们并排走在参道上，挨个逛着参道两旁的每一家摊位。","art":{"background":"a4018","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"蕾娜看着各种各样的摊位，两眼放光。","art":{"background":"a4018","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"但是对我来说，蕾娜身穿浴衣的模样才是最耀眼的。","art":{"background":"a4018","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"春日祭真是太棒了！","art":{"background":"a4018","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「嗯？怎么了，将臣？」","art":{"background":"a4019","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「没什么，我就是觉得……你是这个世上最美的女神」","art":{"background":"a4019","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"蕾娜说我的说话方式越来越像个欧美人了。","art":{"background":"a4019","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「嘿嘿……那你就是日本第一武士了，可谓是“酷日本”的代言人呀」","art":{"background":"a4017","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「蕾娜！」","art":{"background":"a4017","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「将臣！」","art":{"background":"a4017","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我们肩并肩，脸颊也紧紧地贴在一起，一秒都不愿意分开。","art":{"background":"a4017","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"虽然她这话说得让人搞不清到底是夸还是贬，但她的出发点一定是爱。","art":{"background":"a4017","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「对了，将臣，刚才买的章鱼烧就快凉了，你快喂我一个吧……啊～」","art":{"background":"a4020","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「好啊，很烫的，你慢点吃啊」","art":{"background":"a4020","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「好烫好烫……呼呼」","art":{"background":"a4021","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「太好吃了！」","art":{"background":"a4021","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我感觉我们天天都在干这些事。","art":{"background":"a4021","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「将臣？芳乃的舞蹈应该还没开始吧？」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「还没呢，那可是重头戏，咱们哪能错过」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「不过，她给我们准备了内部人员专用席位，我们可以再逛一会儿的」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「好想快点看她跳舞啊，春日祭好玩的东西实在太多，我们根本逛不完，真是遗憾」","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"而且蕾娜一会儿还得回旅馆干活。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"最近是最忙的时期，但她还是挤出了一些时间，在去看舞蹈之前陪我逛了逛。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「嗯，从今年开始，神乐舞也不再是朝武一个人跳，而是她和孩子们一起跳吧」","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「是的！穗织的孩子们练得可认真了！」","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「不过最遗憾的是……昨天的铠甲武士游行我只看了一点点」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「哈哈，幸亏你只看了一点点。毕竟今年我也被迫参加了」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「你在说什么呢！你穿着那一身行头可帅气了」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「当时我就想，你真的是日本第一武士……」","art":{"background":"a4025","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"日本第一，对我来说还很遥远啊。","art":{"background":"a4025","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"但既然蕾娜愿意这么想，那倒也挺好。","art":{"background":"a4025","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「对了，我突然想起来，其实有一件事我一直想不通」","art":{"background":"a4025","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「是关于春日祭的事情吗？」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「不是，是我在梦中体验宿体的记忆时留下的疑惑」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「怎么现在突然搬出那么早以前的事？我现在都只记得个大概了」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「……确实」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"不过，也许正因为今天是春日祭，我才会把这件事拿出来说。","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"毕竟一年就这一次机会，还是说出来看看吧。","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「你还记得那个跟我合体的武士吗？」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「那个人，是真的长得像我吗？」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「是的，那个人的风貌和气质真的非常像你，这件事你想不通吗？」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「怎么说呢，当时你说他像我，我还以为他是我家的祖先，或者是鞍马家的祖先」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「毕竟他最开始就是个普通家臣而已」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「所以我当时以为，他的主公是朝武家的祖先」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「但实际上，他本人才是朝武家的祖先」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「于是我就想，我跟那个武士真的仅仅只是脸长得像而已吗？虽然这件事真的非常无所谓」","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"所以我才一直没说出口。","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"但不知为何，蕾娜突然沉默了。而且看上去好像有点生气。","art":{"background":"a4022","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「…………哼～」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「蕾娜？」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「哼哼～～」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"明明皱着眉头，却看上去这么可爱，这太犯规了。","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「呃，那个，你怎么了？」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「这件事你不需要知道答案」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「等等，什么意思啊？？」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「我这只是随口一问而已，难道真的有什么含义在里面吗！」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「倒不是说有什么含义在里面……」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"蕾娜还是不太愿意开口。","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"不过，也不知是这节日气氛让她改变了想法，还是她觉得半年前的事情已经无所谓——","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"她接下来说的这些，让我大吃一惊。","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「我在丛云那边，看到了她的记忆」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「……嗯」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「所以，我差不多能猜到」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「丛雨丸在挑选主人的时候，会考察这个人跟丛云的初恋对象长得有几分相似」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「至少，长得像的人可以放宽要求」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「哎？为什么？」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「唔～将臣，你这么不懂女人心，我都不知道是该高兴还是该叹息」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「简单来说，你的外表是丛云喜欢的类型啦」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「……啊？」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「喔——」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"原来如此，如果她还有意识，那就确实有这种可能性！","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「这点事，你怎么说得这么不情愿啊？」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「……将臣，你这情商有点说不过去了哦」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「这么棒的男生，却连女孩子的小心思都看不出来，我好担心啊」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「不不，没你想得那么严重啦……嗯？」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"难道蕾娜是在嫉妒吗？","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"什么嘛，原来是这样。","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「哎，你不要笑呀。也不要闭着嘴巴笑啊，将臣」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「我忍不住呀」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「放心吧，我眼里只有你」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"也许正因如此，我才不会去想那些不必要的事情。","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"因为我知道我根本不可能喜欢上其他女孩子。","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「我的女神只有你一个」","art":{"background":"a4024","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「嗯……哼～哼……噗」","art":{"background":"a4026","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"蕾娜还是没能维持住生气的表情。","art":{"background":"a4026","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「嘿嘿，真是拿你没办法」","art":{"background":"a4026","sprites":[]},"chapter":"尾声"},{"speaker":"蕾娜","text":"「毕竟我是全世界最爱你的人！」","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"在这片土地相遇后，她成了我最重要的人。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"本来居住在世界另一端的她，如今却在我身边。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"来到穗织之后，我体验了各式各样的伤痛。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"外公的特训，真是辛苦得要命。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"有时候我都感觉自己快要累死了。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"但是，这片土地确实为我带来了奇迹，让我邂逅了无可替代的她。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"所以，在这个万物复苏的季节，我想借此机会传达我的感恩。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"愿千年之恋，有朝一日能使万花怒放。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"愿我们的感情，也能枝繁叶茂。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"愿我们能成为懂得奉献，懂得互助的人。","art":{"background":"a4023","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"感谢你们。","art":{"background":"a1","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"感谢让我们怀有如此心境的所有人，所有事物。","art":{"background":"a1","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"愿春日祭，今后也能走过无数个春秋。","art":{"background":"a1","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我在心中默默地祈祷着。","art":{"background":"a1","sprites":[]},"chapter":"尾声"}]