[{"speaker":"将臣","text":"「啊、啊……啊啊……射出来好多」","art":{"background":"a2274","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「啊、啊啊啊……全身都是黏黏的精液……好下流……啊、啊……唔、唔唔」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我真的很舒服，芳乃」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「我也是。就好像大脑里都被你搅得泛滥了一样……深深体会到了做爱的感觉……啊啊啊」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「明明是那么羞耻的姿势……我却那么兴奋……」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「原来我是这么下流的女孩」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「没事，我要下流得多」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「哎？啊，你这……呀、啊、热的东西……碰到了屁股……」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我用射精后仍不见颓势的阳具贴到芳乃的屁股上。","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「芳乃……能再来一次吗？」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「…………好的……」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不过这次尽量忍住声音吧」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「我的声音有那么大吗？」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「要注意别让常陆听到……好吗？」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「……好……」","art":{"background":"a2276","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"就这样，我们不断索求着对方，直至欲望彻底枯竭。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「然而全都听得一清二楚啊」","art":{"background":"a211","sprites":[{"asset":"a319","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「这个嘛，他们幸福就好」","art":{"background":"a211","sprites":[{"asset":"a605","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a319","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「话是这么说……」","art":{"background":"a211","sprites":[{"asset":"a605","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1458","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「但是这样下去的话，连我都要欲求不满了……哎……」","art":{"background":"a211","sprites":[{"asset":"a1097","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「没事，等过一段时间，那两人也会冷静下来的」","art":{"background":"a211","sprites":[{"asset":"a771","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a957","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"茉子","text":"「希望如此吧」","art":{"background":"a211","sprites":[{"asset":"a771","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a913","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"}]