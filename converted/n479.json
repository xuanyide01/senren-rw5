[{"speaker":"小春","text":"「谢谢啦！」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「好了，是时候关门了。小春，麻烦你把广告板收一下」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「好」","art":{"background":"a1700","sprites":[{"asset":"a968","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a995","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「然后阿将，麻烦你今天也帮忙收拾下厨房，打扫下卫生吧」","art":{"background":"a1700","sprites":[{"asset":"a991","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「好的」","art":{"background":"a1700","sprites":[{"asset":"a991","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"我照芦花姐吩咐开始打扫厨房。","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我洗了餐具厨具，又扫净了地面……","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「差不多了，辛苦你们了」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「辛苦您了。那个……虽然刚刚打扫完就这么说不太妥，不过我有一事相求」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「嗯？什么事？」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「能不能让我稍微练一下烤仙贝呢」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「现在？」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「可能这个请求有点任性，不知您可否答应？」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「这个嘛……如果只烤仙贝的话应该可以。毕竟还剩了些料」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「然后就看社长同不同意了」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「谢谢您」","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「社长！我有一事相求！」","art":{"background":"a1700","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「等你什么时候不用这个称谓叫我了我再听你说」","art":{"background":"a1700","sprites":[{"asset":"a1028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「芦花姐……其实我想练习一下烤仙贝，」","art":{"background":"a1700","sprites":[{"asset":"a1028","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「仙贝？」","art":{"background":"a1700","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我不会练多久的。我只是用剩下的料来做。可以吗？」","art":{"background":"a1700","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「唔……你只是练手的话倒可以」","art":{"background":"a1700","sprites":[{"asset":"a1002","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「没办法。那我也留下来吧……」","art":{"background":"a1700","sprites":[{"asset":"a4091","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「哎？不用了吧，芦花姐你应该也累了，还是先回去吧」","art":{"background":"a1700","sprites":[{"asset":"a4091","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我怎么可能把员工留下来，自己一个人先回去呢。我也不是不信任你……」","art":{"background":"a1700","sprites":[{"asset":"a4091","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「那……」","art":{"background":"a1700","sprites":[{"asset":"a4091","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"对哦，说来也是。","art":{"background":"a1700","sprites":[{"asset":"a4091","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「反正我还有点资料要整理。你去吧，要做的话就赶紧咯」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「谢谢芦花姐！」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯？你们在说什么？」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「哎呀，小春。小春你待会也能稍微晚点回去吗？我想让你尝尝我做的仙贝，看看你觉得怎么样」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「仙贝!？我要吃我要吃！」","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「……行，那我就回店里做事了」","art":{"background":"a1700","sprites":[{"asset":"a991","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「你们弄完了就叫我一声。还有，注意别弄太晚哦」","art":{"background":"a1700","sprites":[{"asset":"a1692","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯！谢谢姐姐」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1692","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「这种小事不用在意啦」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a985","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"芦花姐挥挥手，消失在了门帘之后。","art":{"background":"a1700","sprites":[{"asset":"a970","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「（难道……她在故意给我们留相处的空间？）」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「真的太谢谢你了……姐姐……」","art":{"background":"a1700","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……？」","art":{"background":"a1700","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"她在说什么呢？","art":{"background":"a1700","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"小春嘀咕这话的时候感觉看上去莫名有些成熟……","art":{"background":"a1700","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「来吧哥哥，你要做什么样的仙贝呢？」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「等我做完你就知道了」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「我开动啦」","art":{"background":"a4266","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"小春开心地捧着我刚做好的仙贝。","art":{"background":"a4266","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"难得有机会练习，我就没有做以往的酱油味，而是用了海苔来做。","art":{"background":"a4266","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「哈唔……嗯！海苔味好香啊……」","art":{"background":"a4267","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「好吃吗？」","art":{"background":"a4267","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯！那当然了！」","art":{"background":"a4268","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「啊……哥哥做的仙贝真好吃」","art":{"background":"a4267","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「你喜欢就好」","art":{"background":"a4267","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「对了，这个你也试吃看看？」","art":{"background":"a4267","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「哇！？怎么会有这种颜色，这……是失败品？」","art":{"background":"a4269","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「我觉得不是。其实这是我尝试做的抹茶口味」","art":{"background":"a4269","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「哇……抹茶味的仙贝……见倒是见过，但我还没吃过呢」","art":{"background":"a4270","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「那还请你评价评价！」","art":{"background":"a4270","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯！那我试试……啊唔」","art":{"background":"a4271","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「……唔……唔……」","art":{"background":"a4272","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「怎……怎么样？」","art":{"background":"a4272","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「……有点苦……」","art":{"background":"a4273","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「不好吃吗？」","art":{"background":"a4273","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「唔……感觉……还需要改进」","art":{"background":"a4274","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「是吗……还不行啊……我还在想这苦味能不能作为它的特点之一呢」","art":{"background":"a4274","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「我觉得也会有人好这一口……不过并不多吧？」","art":{"background":"a4274","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a4274","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"唉，反正这也是第一次做。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"不可能什么事都一开始就做得很完美。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「不过为什么突然要做仙贝呢？」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我在想要是真的把仙贝作为商品销售的话，我多少能帮上一些忙吧」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「这样啊……哥哥，你这么替我们店着想啊」","art":{"background":"a1700","sprites":[{"asset":"a1012","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「唔……怎么说呢，也确实是在为咱们店考虑，但这只是一方面……」","art":{"background":"a1700","sprites":[{"asset":"a1012","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯？还有别的主要原因吗？」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「因为每次有仙贝的时候你都很开心，所以我才执着于仙贝的」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……哎？」","art":{"background":"a1700","sprites":[{"asset":"a4118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「虽然你一直都很开朗，但是你吃仙贝的时候看上去真的很幸福」","art":{"background":"a1700","sprites":[{"asset":"a4118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我喜欢你笑起来的样子……如果我做出的仙贝能让你露出笑容，那我就更高兴了！」","art":{"background":"a1700","sprites":[{"asset":"a4118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「所以为了你的笑容，我无论如何也想把仙贝做好」","art":{"background":"a1700","sprites":[{"asset":"a4118","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「是、是吗……嘿、嘿嘿……感觉有点害羞呀」","art":{"background":"a1700","sprites":[{"asset":"a4079","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「我只是贪吃而已……不过我好高兴哥哥能这样为我着想」","art":{"background":"a1700","sprites":[{"asset":"a4275","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「因为我希望你能笑容常在，所以我才会想尝试做一些新的口味」","art":{"background":"a1700","sprites":[{"asset":"a4275","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「是吗……嗯，哥哥你的心意让我好高兴……」","art":{"background":"a1700","sprites":[{"asset":"a4276","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"把自己的想法诚实地说出来……还挺羞人的。","art":{"background":"a1700","sprites":[{"asset":"a4276","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"不过这样告诉她，也让我感到很高兴。","art":{"background":"a1700","sprites":[{"asset":"a4276","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「唉……不知道为什么，虽然你之前就时不时说我很可爱，但是……」","art":{"background":"a1700","sprites":[{"asset":"a4277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「刚才你说的那句话……最让我高兴。我开心得……心怦怦直跳」","art":{"background":"a1700","sprites":[{"asset":"a4278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「说不定这就是廉太郎所说的表兄妹和情侣的不同之处吧」","art":{"background":"a1700","sprites":[{"asset":"a4278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「是吗……哎，那个蠢蛋哥哥偶尔也会说一点正经话嘛」","art":{"background":"a1700","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「确实，也只是偶尔罢了」","art":{"background":"a1700","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……哈哈，哈哈哈哈！」","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「哈哈哈！」","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"就在我和小春相视而笑之时……","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"一阵我从未听见过的叫声从门帘后传来。","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「哎哎哎！？」","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「——嗯！？」","art":{"background":"a1700","sprites":[{"asset":"a981","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「刚才……是姐姐在叫？」","art":{"background":"a1700","sprites":[{"asset":"a1030","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「应该是……发生什么了？」","art":{"background":"a1700","sprites":[{"asset":"a1030","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"我们疑惑地歪了歪头，而芦花姐也慌慌张张地冲了出来。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「姐姐，怎么了？」","art":{"background":"a1700","sprites":[{"asset":"a982","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「原料商那边似乎有点麻烦事」","art":{"background":"a1700","sprites":[{"asset":"a982","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2984","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我现在去协调一下！」","art":{"background":"a1700","sprites":[{"asset":"a982","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「现在去？」","art":{"background":"a1700","sprites":[{"asset":"a1030","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「不去的话会影响明天工作的。我现在就出发」","art":{"background":"a1700","sprites":[{"asset":"a1030","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「嗯，一路顺风，注意安全」","art":{"background":"a1700","sprites":[{"asset":"a1030","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「对了对了。我可能会晚点回来，你们负责锁门吧」","art":{"background":"a1700","sprites":[{"asset":"a14","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"芦花姐将大门钥匙抛给了我。","art":{"background":"a1700","sprites":[{"asset":"a14","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「这把是备用钥匙。你们记得把门关好了再回去。麻烦你们了，我先走了」","art":{"background":"a1700","sprites":[{"asset":"a980","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯，我们会的」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2982","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"芦花姐急急忙忙地离开了店里。","art":{"background":"a1700","sprites":[{"asset":"a986","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"我和小春呆呆地望着她离去的背影。","art":{"background":"a1700","sprites":[{"asset":"a986","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「当个老板还真是麻烦啊……」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「是啊……」","art":{"background":"a1700","sprites":[{"asset":"a980","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a980","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a1693","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春・将臣","text":"「嘿嘿嘿」\n「啊哈哈」","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"我们都害羞地笑了。","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「我、我要把仙贝都吃完了哦」","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「嗯，请吧」","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"这样悠闲的时光对我来说……是无比的幸福。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「我吃饱啦」","art":{"background":"a1700","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「哦，你都吃完了啊」","art":{"background":"a1700","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯，毕竟是哥哥做的嘛」","art":{"background":"a1700","sprites":[{"asset":"a1012","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「不过你不是说抹茶味的比较苦吗」","art":{"background":"a1700","sprites":[{"asset":"a1012","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「苦是苦，但也没有到吃不下去的程度啦」","art":{"background":"a1700","sprites":[{"asset":"a1012","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「只要再调整一下口味……可能就会变得很好吃的样子」","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「不过这也只是假设罢了」","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「尝来尝去我还是喜欢普通的酱油味啊……嘿嘿」","art":{"background":"a1700","sprites":[{"asset":"a1005","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「那我们趁早回去吧？」","art":{"background":"a1700","sprites":[{"asset":"a1012","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「唔……如果不介意的话，我们能不能再在这里慢慢呆一会儿呢？」","art":{"background":"a1700","sprites":[{"asset":"a1012","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「哎？」","art":{"background":"a1700","sprites":[{"asset":"a980","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「那个，毕竟很少能有像现在这样……悠哉悠哉两个人独处的机会」","art":{"background":"a1700","sprites":[{"asset":"a980","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……啊……嗯、嗯」","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「是、是吗……两个人独处啊……」","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……是啊……」","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"在这之前我们也有过二人独处的经历。","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"比如最近我们两个人开始一起上学。","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"不知怎的……现在感觉与那时完全不一样，有些紧张。","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"难不成……是因为现在是晚上，而我们在屋内独处？","art":{"background":"a1700","sprites":[{"asset":"a4157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"屋内一片沉寂。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"在这种环境下，我们几乎能听见对方的气息声……而我们在屏息一阵之后……","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「……呼……哈……呼……哈……」","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"怎、怎么办？我是怎么呼吸的来着？","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我以前呼吸有那么大声吗？","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯唔……嗯唔……」","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「嗯？小春？」","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯嗯…………唔……噗哈！哈……哈……」","art":{"background":"a1700","sprites":[{"asset":"a3017","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「怎、怎么了……？」","art":{"background":"a1700","sprites":[{"asset":"a3017","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「就是，那个……感觉我的气息声太明显了……就不知道该怎么办才好……」","art":{"background":"a1700","sprites":[{"asset":"a4117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「所以……你就决定要屏住呼吸？」","art":{"background":"a1700","sprites":[{"asset":"a4117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……唔……嗯」","art":{"background":"a1700","sprites":[{"asset":"a4117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「哈哈哈哈」","art":{"background":"a1700","sprites":[{"asset":"a4117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「不要笑，不要笑我啊，哥哥！」","art":{"background":"a1700","sprites":[{"asset":"a4121","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「没，抱歉抱歉。我没有在嘲笑你」","art":{"background":"a1700","sprites":[{"asset":"a4121","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「只是因为我想的和你一样」","art":{"background":"a1700","sprites":[{"asset":"a4121","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「哥哥，你也屏住了呼吸？」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「也没有到那个地步，不过就是很在意自己的气息声」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「是、是吗……哥哥也是啊……」","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「一般人在这种时候都会说些什么啊？」","art":{"background":"a1700","sprites":[{"asset":"a4125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「谁知道呢。怎么说我也是第一次交到女朋友……」","art":{"background":"a1700","sprites":[{"asset":"a4125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"在我们还只是表兄妹的时候，这样的沉默对我们来说不痛不痒。","art":{"background":"a1700","sprites":[{"asset":"a4125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"但当我们成为了情侣之后就觉得要说些什么，感觉很焦躁。","art":{"background":"a1700","sprites":[{"asset":"a4125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"真的就像廉太郎说的一样……","art":{"background":"a1700","sprites":[{"asset":"a4125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……情侣……情侣，我们是情侣啊」","art":{"background":"a1700","sprites":[{"asset":"a4125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「哥、哥哥……你、你觉得情侣都会做些什么？」","art":{"background":"a1700","sprites":[{"asset":"a4279","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「做什么……」","art":{"background":"a1700","sprites":[{"asset":"a4279","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「比如约会吧？还可以一起吃饭吧？还要牵手吧？」","art":{"background":"a1700","sprites":[{"asset":"a4279","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「只有这些？」","art":{"background":"a1700","sprites":[{"asset":"a4280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「还有……就是，接吻……之类……性、性、性行为，之类的？」","art":{"background":"a1700","sprites":[{"asset":"a4280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"小春听了我的话之后红透了脸。","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"随后她便羞涩地低下了头。","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「呃，我也不是说现在就要怎样怎样。我只是在回答你的问题罢了……」","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「可是……你也很在意这个吧？所以你才会做出这样的回答的啊」","art":{"background":"a1700","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「这个嘛……确实」","art":{"background":"a1700","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「你很可爱，我也很喜欢你。最重要的是你已经长成有魅力的女孩子了」","art":{"background":"a1700","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「实话实说，那个……我确实挺在意那个」","art":{"background":"a1700","sprites":[{"asset":"a4121","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……嗯……」","art":{"background":"a1700","sprites":[{"asset":"a4122","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「其、其其其其其其其实，我我我我我我也在意那个」","art":{"background":"a1700","sprites":[{"asset":"a4281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「冷、冷静一点。你的声音抖得让我听不清了」","art":{"background":"a1700","sprites":[{"asset":"a4281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯、嗯……抱歉……」","art":{"background":"a1700","sprites":[{"asset":"a1695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「不用道歉，你冷静下来就好。你刚才想说什么？」","art":{"background":"a1700","sprites":[{"asset":"a1695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「那个，那个……我也在意那个。包括接吻啊，还有……性、性行为……之类……」","art":{"background":"a1700","sprites":[{"asset":"a4282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[{"asset":"a4282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「也、也是，你也是个健康的适龄女子了。这很正常，嗯……」","art":{"background":"a1700","sprites":[{"asset":"a4282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「可、可是啊，我……我完全不了解那些……所以有点担心……」","art":{"background":"a1700","sprites":[{"asset":"a4123","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「要是真的到了要做的时候做不好，被哥哥你讨厌了该怎么办……」","art":{"background":"a1700","sprites":[{"asset":"a4283","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我怎么会因为这种事情讨厌你」","art":{"background":"a1700","sprites":[{"asset":"a4283","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「可是，你想啊，廉哥他都说……会留下心理阴影之类的了」","art":{"background":"a1700","sprites":[{"asset":"a4277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「啊……他确实说过」","art":{"background":"a1700","sprites":[{"asset":"a4277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「所、所以呀，哥哥！」","art":{"background":"a1700","sprites":[{"asset":"a4284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「怎、怎么了？！」","art":{"background":"a1700","sprites":[{"asset":"a4284","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「能不能……提前教教我呢？」","art":{"background":"a1700","sprites":[{"asset":"a4285","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「你说……要我教你？」","art":{"background":"a1700","sprites":[{"asset":"a4285","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"}]