[{"speaker":"小春","text":"「哥哥，我们来啦！」","art":{"background":"a599","sprites":[{"asset":"a891","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"到了中午，小春一如既往地单手提着便当盒来到了我们的教室。","art":{"background":"a599","sprites":[{"asset":"a891","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「好，我们一边吃一边开会。廉太郎」","art":{"background":"a599","sprites":[{"asset":"a891","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"廉太郎","text":"「好嘞！」","art":{"background":"a599","sprites":[{"asset":"a499","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我和廉太郎一起搬动桌子，将它们拼在一起。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"由此拼成了一个能坐下六人的简易餐桌。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"蕾娜","text":"「今天我们也要好好讨论讨论」","art":{"background":"a599","sprites":[{"asset":"a902","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「我们都已经提出了好多方案」","art":{"background":"a599","sprites":[{"asset":"a479","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「方案数多了很多」","art":{"background":"a599","sprites":[{"asset":"a479","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「是啊。可是并没有哪个是特别出彩的……」","art":{"background":"a599","sprites":[{"asset":"a490","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我们一边吃午饭，一边热热闹闹地讨论着。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我们已经提出了超过两百种想法。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"这些想法都是有可行性的。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"都是大家绞尽脑汁认真思考的结果。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"可是……","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「可是我们提出的这些方案格局都好小啊……」","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"一旦着眼于可行性，这便是必然的结果。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"可是所谓“想法”也是需要跳出局限的。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"但要想出一个又可行，又可以吸引游客目光的活动还真是难。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"廉太郎","text":"「……说实话，我们现在遇到瓶颈了啊」","art":{"background":"a599","sprites":[{"asset":"a730","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「是啊。我们提出的方案都开始重复了」","art":{"background":"a599","sprites":[{"asset":"a714","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a866","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"蕾娜","text":"「就不能在这些方案里选一个做吗？」","art":{"background":"a599","sprites":[{"asset":"a712","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a866","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「可是这些方案都没有神刀活动那么吸引人啊」","art":{"background":"a599","sprites":[{"asset":"a797","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「嗯，是啊」","art":{"background":"a599","sprites":[{"asset":"a797","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"就算研制出了一些新的特色菜，也没法在第一时间成为话题。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"要做吉祥物的话，一不小心就会落得个无人问津的下场。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我们需要象征穗织独特文化的东西……","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"可以匹敌朝武的舞蹈的东西……","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"小春","text":"「可能只凭我们的话，再怎么烦恼也不会有结果的」","art":{"background":"a599","sprites":[{"asset":"a1210","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"小春","text":"「哥哥，我们把这本记事本让爷爷或者安晴叔叔看看怎么样？」","art":{"background":"a599","sprites":[{"asset":"a892","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「最后还是要依靠外公他们吗……」","art":{"background":"a599","sprites":[{"asset":"a892","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"他们明明说了要用这事来磨砺我们年轻人。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"不过这也没办法。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"现在能多一个人的意见都好。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「好的。今天放学以后我就去找外公」","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"既然都决定了，那就兵贵神速。","art":{"background":"a599","sprites":[]},"chapter":"7-2"},{"speaker":"廉太郎","text":"「那就拜托你了，会长！」","art":{"background":"a599","sprites":[{"asset":"a499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"廉太郎轻轻拍了拍我的肩膀。","art":{"background":"a599","sprites":[{"asset":"a499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「对了，不如你也一起来？」","art":{"background":"a599","sprites":[{"asset":"a499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"廉太郎","text":"「呃，不，我还有一点事……」","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"廉太郎把视线从我身上移向半空，眼神飘忽不定。","art":{"background":"a599","sprites":[{"asset":"a733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"小春","text":"「廉哥，你还要怕外公怕多久呢？」","art":{"background":"a599","sprites":[{"asset":"a887","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a518","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"廉太郎","text":"「可能是一辈子！」","art":{"background":"a599","sprites":[{"asset":"a887","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a499","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「这值得那么骄傲吗」","art":{"background":"a599","sprites":[{"asset":"a887","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a499","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"真拿他没办法。","art":{"background":"a599","sprites":[{"asset":"a887","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a499","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"到了放学时间。","art":{"background":"a1","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我为了去见外公，提早走出教室。","art":{"background":"a1","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「主人」","art":{"background":"a498","sprites":[{"asset":"a137","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"小猫","text":"「喵」","art":{"background":"a498","sprites":[{"asset":"a137","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「哦，乖哦乖哦」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「你这小家伙真可爱」","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨正在学校前和小猫玩耍。","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「你怎么在这？」","art":{"background":"a498","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「嗯，茉子刚才通过手机联络本座了」","art":{"background":"a498","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「小雨，你有手机了啊」","art":{"background":"a498","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「嗯，安晴给本座的」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「这东西真好玩啊，主人」","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「本座每天都会抽个10次」","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「小雨，手游氪金要适度才行哦」","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"安晴叔叔看到下个月的账单的时候可能会昏过去。","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「你不是要去找玄十郎吗」","art":{"background":"a498","sprites":[{"asset":"a139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「本座也要去，主人」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「原来你是在等我啊」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「要是本座在场的话，那个严厉的外公也会变得好说话一点嘛」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「这个，确实是这样……」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我现在面对外公还会难免有一点紧张。","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨在我旁边的话可能确实会好些。","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"小猫","text":"「喵，喵呜」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「嗯？怎么了？」","art":{"background":"a498","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨抱着的小白猫突然叫了起来。","art":{"background":"a498","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「啊，小雨，你看那个」","art":{"background":"a498","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我指向了草丛的一角。","art":{"background":"a498","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"在我手指的方向有一只长得与这只小猫相似，但是却大了一圈的白猫。它在一动不动地盯着我们。","art":{"background":"a498","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「它是你的爸爸或妈妈吗？」","art":{"background":"a498","sprites":[{"asset":"a549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"小猫","text":"「喵」","art":{"background":"a498","sprites":[{"asset":"a549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小猫叫了一声，似乎在表达肯定。","art":{"background":"a498","sprites":[{"asset":"a549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「是吗，那你快回到它身边去吧」","art":{"background":"a498","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「孩子就该和父母在一起」","art":{"background":"a498","sprites":[{"asset":"a624","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨轻轻地将小猫放在地上。","art":{"background":"a498","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小猫便朝着大猫的方向直奔而去。","art":{"background":"a498","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"见到孩子回来的大猫则用脸颊来回蹭着小猫。","art":{"background":"a498","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"最后，它们一同缓缓离去。","art":{"background":"a498","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「保重」","art":{"background":"a498","sprites":[{"asset":"a624","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「希望你们能一直和睦地生活下去」","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨眯起了眼睛，挥手向它们道别。","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"或许是小雨的话语传达到了它们心中，它们回过头来又叫了一声。","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"随后再次迈开了步伐。","art":{"background":"a498","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨一直注视着这对大猫小猫的背影。","art":{"background":"a498","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"她的目光十分温柔。","art":{"background":"a498","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"不过却夹杂了几分寂寞。","art":{"background":"a498","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"心子","text":"「不好意思啊，将臣，丛雨大人」","art":{"background":"a49","sprites":[{"asset":"a688","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「没事，我们突然到访，是我不对」","art":{"background":"a49","sprites":[{"asset":"a688","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「嗯，玄十郎确实是个忙碌的人」","art":{"background":"a49","sprites":[{"asset":"a136","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我们专程到这来，但不凑巧的是外公不在。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"据说是要前去出席町内会的临时的会议。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"心子","text":"「需要我带个口信吗？」","art":{"background":"a49","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「不用，我会再来的」","art":{"background":"a49","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「这件事还是直接和他谈比较好」","art":{"background":"a49","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"心子","text":"「我知道了」","art":{"background":"a49","sprites":[{"asset":"a52","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「抱歉，打扰你工作了」","art":{"background":"a49","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"心子","text":"「没事，那我先行告退」","art":{"background":"a49","sprites":[{"asset":"a52","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"猪谷阿姨礼貌地低头行礼，又静悄悄地消失在了门后。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我不禁感叹她的一举一动还是那么的典雅。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"不愧是名门旅馆的掌柜。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「安晴应该也会参加所谓町内会会议的吧」","art":{"background":"a49","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「看来现在也没法和安晴谈了啊，主人」","art":{"background":"a49","sprites":[{"asset":"a196","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「是啊，怎么办呢」","art":{"background":"a49","sprites":[{"asset":"a196","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"再把众人叫来开个会吗？","art":{"background":"a49","sprites":[{"asset":"a196","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"可是，我们这班子人再怎么讨论也……","art":{"background":"a49","sprites":[{"asset":"a196","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"很烦恼。","art":{"background":"a49","sprites":[{"asset":"a196","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「没办法，主人」","art":{"background":"a49","sprites":[{"asset":"a277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「我们一边散散心，一边考虑吧」","art":{"background":"a49","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨轻轻扯了下我校服的袖口。","art":{"background":"a49","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「一直闷在房间里思考是不好的」","art":{"background":"a49","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「主人你最近也没有和玄十郎练刀。你还是运动运动比较好」","art":{"background":"a49","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「嗯，你说得对」","art":{"background":"a49","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"最近身体可能都有点僵硬了。","art":{"background":"a49","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"而且……","art":{"background":"a49","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「这样也能帮你适应肉体，就这么办吧」","art":{"background":"a49","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「唔，再怎么适应也是有极限的啊」","art":{"background":"a49","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨面露难色。","art":{"background":"a49","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「嗯？这是什么意思？」","art":{"background":"a49","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「就像之前说的一样，现在本座只不过是附身于自己的躯体之上」","art":{"background":"a49","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「再怎么适应，也没法像主人你们这样自在」","art":{"background":"a49","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"是吗。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"最近小雨的一举一动都和一般人无异，以至于我都忘了。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨还不是人类。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"她到底打算怎么办呢？","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「主人」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「怎么？」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「……你的父母还健在吗？」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「啊？啊，嗯，是啊」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「待振兴小镇的事情告一段落之后，主人，你就回去吧」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「……什么？」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「如主人所知，穗织确实是个特殊的地方」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「而且生活不便，财政又吃紧」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「从长远来看，让主人留在这里不是好事」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「话是这么说，可是」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「最重要的是」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「主人的家人不在这里」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「家人……」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「本座深有体会，主人。这是本座发自内心的忠告」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「要珍惜你的家人」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「常言道……」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「子欲养而亲不待……」","art":{"background":"a1340","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我想起了那时的对话……","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨曾叫我回去。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"她的意思是，她终有一天会和我分开吗。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"如果我真的回去了，那小雨以后会怎样……","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「主人，我们走」","art":{"background":"a49","sprites":[{"asset":"a129","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「啊，好」","art":{"background":"a49","sprites":[{"asset":"a129","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"小雨拉起我的手，打断了我的思绪。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我的手上传来了她的体温和柔软的触感。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我不想放开她。","art":{"background":"a49","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「都走到这种地方来了啊……」","art":{"background":"a1044","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨一直拉着我的手走，而我也跟着她走上了越来越崎岖的道路。","art":{"background":"a1044","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"等我反应过来，我们已经走到了河边。","art":{"background":"a1044","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"没想到她居然拉着我走出了小镇。","art":{"background":"a1044","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「毕竟我们就是要来解决主人运动不足的问题嘛」","art":{"background":"a1044","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「才走这么点路，都不够热身呢」","art":{"background":"a1044","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"丛雨","text":"「好，我们到河里去玩吧，主人！」","art":{"background":"a1044","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"话音刚落，小雨就大胆地趟入了河中。","art":{"background":"a1044","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「哇哦！好凉！水好凉啊主人！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「对啊，河水的触感就是这样的啊！」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「啊哈哈哈！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨大肆嬉闹。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「小雨，水都溅到我身上了！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"毕竟这是她时隔五百年的戏水，也难怪她这样兴奋。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「主人快也来玩啊！」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「快点来和本座互相泼水，然后说出“居然敢泼我，站住，看我怎么泼回去♪”这样的话啊」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「情侣之间好像都会这样玩的」","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「小雨，这句是在夏日海边玩的时候说的台词」","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"她到底是从哪里学会这些东西的。","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「也可以在春天的河川里这样玩呀！」","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「看招看招！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨撩起水向我泼来。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「喂喂喂！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我的校服都湿了。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「找回童心也是好事哦，主人」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「你不一直都童心未泯吗」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「什么？！你对活过了如此悠久的时间的本座说些什么呢！」","art":{"background":"a3274","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"生气的幼刀继续展开泼水攻击。","art":{"background":"a3274","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「顺带一提，本座说的是“悠久”，不是“有酒”！」","art":{"background":"a3274","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「行了我知道了！我知道你想说的是“悠久”！」","art":{"background":"a3274","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我放弃了抵抗，也踏入了河水中。","art":{"background":"a3274","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"反正我也已经被水打湿了。","art":{"background":"a3274","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我就好好陪小雨玩玩吧。","art":{"background":"a3274","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「主人终于来啦」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「嘿嘿，现在和之前不同。现在本座有了和主人一样的肉身」","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「这样更有“一起玩耍”的感觉了」","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨面带微笑，又踢起一阵水花。","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"原本平静的水面瞬间激起一条水柱。","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「你喜欢玩水吗？」","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我也和她做了相同的动作。","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"不过我没法踢出她哪样大的水柱。","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"是有什么窍门吗。","art":{"background":"a3273","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「与其说是喜欢玩水，不如说是除了山上、河里，没有别的地方玩了」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「只要不是冬天，本座就尽是玩这些」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「不仅仅是本座，村子里的孩子们都是这样的」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨一边踢水，一边眯起了眼。","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「对哦，那时候又不像现在可以玩手机」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「嗯，也没有什么别的玩具」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「男孩子们也就会用木棍来演武戏」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「女孩子们则用母亲亲手做的人偶来玩过家家」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「不过那时孩子们也要劳作，也只是在休息时间玩玩罢了」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「小雨那个年代的孩子还要劳作啊」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「嗯，不劳不获嘛」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「真是不容易啊」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「不过要是碰到了饥荒，那可就连肚子都填不饱了」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「穗织是一片肥沃的土地。我们有幸得它恩泽」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「我们是很幸福的」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「……但也只限于那场战争之前」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨的表情上掠过一丝阴霾。","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"而我也无言以对。","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我很想安慰她……","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我很想给她加油打气，但我做不到。","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"像我这种活在和平年代的人，又怎么能轻易去开解他们。","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「……别露出这种表情啊，主人」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「本座并不后悔」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「本座不后悔做了祭品」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「因为本座这么做了，穗织才得以保全」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「也得以和主人相遇」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「所以，本座并不后悔！」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨笑着，又踢起了水花。","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"水花直接溅到了我的脸上。","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「喂，不要往我这边踢！」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「啊哈哈哈！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「只能怪主人你自己太大意了！」","art":{"background":"a3272","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「看招，看招！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"她又向我踢来了更多的水。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「你这家伙，看我怎么报仇！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我也故作激动说着台词，捧起一掬水向她泼去。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"丛雨","text":"「啊哈哈哈！」","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"小雨的笑容是那么光彩夺目。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"但却又显得有些脆弱。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"穗织这片土地，是小雨放弃了自己本应享受的人生，才守护下来的。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"这是她放弃了一切都要守护的地方。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我绝不能让这片土地衰落。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我一边和小雨玩水，一边在心中起誓。","art":{"background":"a3271","sprites":[]},"chapter":"7-2"}]