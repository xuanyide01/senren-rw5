[{"speaker":"将臣","text":"「早上好」","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"芦花","text":"「啊，阿将！你来得正好！」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"周六，轮到我上早班了。我刚到店里，芦花姐就跑了过来。","art":{"background":"a1677","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「什、什么？怎么了？」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「我想到了一个推销仙贝的办法」","art":{"background":"a1677","sprites":[{"asset":"a1573","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「是吗，什么办法？」","art":{"background":"a1677","sprites":[{"asset":"a1573","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「做旅馆的茶点！」","art":{"background":"a1677","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「你的意思是……客人刚进房时上的点心？」","art":{"background":"a1677","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「是的。在那时候上给客人，或者放在旅馆的商店销售」","art":{"background":"a1677","sprites":[{"asset":"a2963","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「啊……至少比放在这家店卖要好」","art":{"background":"a1677","sprites":[{"asset":"a2963","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"首先要让大家知道这个味道。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"旅馆的那个茶点有不少人会吃。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"一开始可能会有反效果，不过还是有机会挽回的。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"芦花","text":"「一上来就量产风险也太高了」","art":{"background":"a1677","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「首先要这样让大家了解它，这是最重要的」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「嗯，我觉得是个好主意」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「谢谢。所以，首先……我想先去过问一下玄十郎先生的意见」","art":{"background":"a1677","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「好主意。现在志那都庄的茶点……好像是日式馒头」","art":{"background":"a1677","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「如果旁边再放几块仙贝，看上去也不会很奇怪」","art":{"background":"a1677","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「外公应该愿意听你意见的」","art":{"background":"a1677","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「是吗，那就好」","art":{"background":"a1677","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「那我先跟他约个时间见面……」","art":{"background":"a1677","sprites":[{"asset":"a1576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「不过……涉及到旅馆经营方面，我也没办法帮你说话」","art":{"background":"a1677","sprites":[{"asset":"a1576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「我知道的。虽然时日尚短，但我好歹也是经营店铺的人」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「不过我会先把这件事告诉外公的。这样回头你说的时候也简单些」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「真的吗？太好了！谢谢你，阿将」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「这个主意不错。以前我在哪里见过说外国人喜欢仙贝」","art":{"background":"a1677","sprites":[{"asset":"a970","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「是吗」","art":{"background":"a1677","sprites":[{"asset":"a970","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「而且……有仙贝吃的话我也开心♪」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「哈哈，原来这才是你的目的啊」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「嘿嘿……抱歉我那么贪吃」","art":{"background":"a1677","sprites":[{"asset":"a1008","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「这下有个好话题带回去跟外公聊了」","art":{"background":"a1677","sprites":[{"asset":"a1008","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「叔叔做的仙贝肯定会受好评的」","art":{"background":"a1677","sprites":[{"asset":"a989","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「我也觉得」","art":{"background":"a1677","sprites":[{"asset":"a989","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「然后如果受欢迎的话，兴许会出很多种不同的味道」","art":{"background":"a1677","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「你只是自己想吃吧？」","art":{"background":"a1677","sprites":[{"asset":"a1697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「嘿嘿嘿……暴露了？」","art":{"background":"a1677","sprites":[{"asset":"a4192","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「当然了。我看你口水都快流下来了」","art":{"background":"a1677","sprites":[{"asset":"a4192","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「才、才没那么夸张呢」","art":{"background":"a1677","sprites":[{"asset":"a4193","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「哈哈哈，开玩笑的」","art":{"background":"a1677","sprites":[{"asset":"a4193","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「但是，要做新的口味……那又要给叔叔增加负担了」","art":{"background":"a1677","sprites":[{"asset":"a986","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「确实，有可能」","art":{"background":"a1677","sprites":[{"asset":"a1693","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「这个挺让人头疼的……」","art":{"background":"a1677","sprites":[{"asset":"a1693","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1017","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「芦花姐」","art":{"background":"a1677","sprites":[{"asset":"a980","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1017","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「小春，不管怎么说，你也不该工作的时候做这种事吧？」","art":{"background":"a4194","sprites":[]},"chapter":"6-3"},{"speaker":"小春","text":"「你在说什么呢，姐姐，咱们只是在探讨店里的商品而已呀」","art":{"background":"a4194","sprites":[]},"chapter":"6-3"},{"speaker":"芦花","text":"「嘻嘻嘻」","art":{"background":"a4195","sprites":[]},"chapter":"6-3"},{"speaker":"小春","text":"「嘿嘿嘿」","art":{"background":"a4195","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a4195","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"这、这两个人……是怎么回事？","art":{"background":"a4195","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"这两人之间仿佛有暗流涌动，散发着令人不安的气息。","art":{"background":"a4195","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"在她们的身后简直就像出现了水獭和奶猫的幻影一样。","art":{"background":"a4196","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"……这种小打小闹反而让人觉得挺可爱的……","art":{"background":"a4196","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「话、话说，芦花姐，是什么事让你头疼啊？」","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"芦花","text":"「你也知道，决定这家店口味的人是我爸，但是他年纪也大了，我希望他能爱护好自己的身体」","art":{"background":"a1677","sprites":[{"asset":"a1565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「现在各方面的负担都集中在我爸身上」","art":{"background":"a1677","sprites":[{"asset":"a1685","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「好像确实是的……」","art":{"background":"a1677","sprites":[{"asset":"a1693","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1685","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「所以我希望，以后能在菜单上增加一些不用依靠我爸也能做的菜品」","art":{"background":"a1677","sprites":[{"asset":"a1693","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1571","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"芦花姐把咖啡也加入了菜单，很大程度上应该也是出于这方面的原因。","art":{"background":"a1677","sprites":[{"asset":"a1693","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1571","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「那让哥哥学学做点心呗？」","art":{"background":"a1677","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「我？」","art":{"background":"a1677","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"也是……除了我之外的员工都固定是在前厅做的。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"芦花姐身为老板还要负责接待客人，阿姨基本上只负责厨房。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"她们要做饮品还有容易准备的餐点，比如芭菲或者蕨饼之类的，其实已经相当忙了。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"这么一想，没有固定位置，能随意分配工作的……就是我了。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「我毕竟还要上学，可能没法帮多大的忙」","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"芦花","text":"「但是……我还是希望你能多少学一些」","art":{"background":"a1677","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「可是吧……我根本就没有下厨的经历啊」","art":{"background":"a1677","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「没事，谁都有第一次的。总之……先试试吧？」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「你学会了以后可以考虑给你加工资」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"我在这里干活并不是图钱……不过一定要给我加薪的话，我也挺开心的。","art":{"background":"a1677","sprites":[{"asset":"a1012","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1009","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"听她们俩这么说，我也想挑战一下了。","art":{"background":"a1677","sprites":[{"asset":"a1012","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1009","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「那……总之先试试吧？」","art":{"background":"a1677","sprites":[{"asset":"a1012","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1009","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「真的吗？谢谢你，阿将」","art":{"background":"a1677","sprites":[{"asset":"a1012","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「不过我该做些什么呢……」","art":{"background":"a1677","sprites":[{"asset":"a1012","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「仙贝！做仙贝吧，哥哥」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「你只是自己想吃才这么说的吧？」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1563","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「不是的，这个只是众多原因里的一小个原因啦」","art":{"background":"a1677","sprites":[{"asset":"a1687","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1563","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「你还不就是想吃嘛」","art":{"background":"a1677","sprites":[{"asset":"a1687","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1571","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「也就只有那么一点点嘴馋而已啦。我说让你做仙贝，主要是因为这是咱们的新业务嘛」","art":{"background":"a1677","sprites":[{"asset":"a1008","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「啊……对，有道理，可以这么想」","art":{"background":"a1677","sprites":[{"asset":"a1001","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"我们的目的是创造新口味，而不是依赖叔叔已经做出来的口味。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"既然如此，学做新商品当然是更好的。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"芦花","text":"「总之先去跟我爸商量一下吧」","art":{"background":"a1677","sprites":[{"asset":"a991","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花的父亲","text":"「你想烤仙贝？」","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「我并没有觉得烤仙贝很容易」","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「只是我既然来这里工作，就希望自己也能为店里尽一份力」","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"芦花的父亲","text":"「……嗯，行吧，反正材料都有」","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"芦花","text":"「哎呀……没想到这么干脆地就同意了」","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"芦花的父亲","text":"「考虑到商品化，我们也确实需要酱油味之外的其他口味」","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"芦花的父亲","text":"「所以也需要年轻人的知识。而且……把传统传承下去也不是什么坏事」","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「请多指教」","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"就这样，我忽然开始学做仙贝了。","art":{"background":"a1","sprites":[]},"chapter":"6-3"},{"speaker":"小春","text":"「好厉害！哥哥烤得仙贝真好吃！」","art":{"background":"a1677","sprites":[{"asset":"a1011","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「有、有吗？你不是在奉承我，讨好我吧？」","art":{"background":"a1677","sprites":[{"asset":"a1011","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「才不是奉承呢！」","art":{"background":"a1677","sprites":[{"asset":"a1005","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「嗯，我也觉得很好吃，阿将」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「是、是吗？被你们这么夸……感觉有点难为情啊」","art":{"background":"a1677","sprites":[{"asset":"a996","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"但这不过是两个人的意见。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"专业的人判断时应该会更加严格！","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"芦花的父亲","text":"「做得很棒啊」","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"……没想到竟然并不严格。","art":{"background":"a1677","sprites":[]},"chapter":"6-3"},{"speaker":"小春","text":"「是吧是吧，我就说很好吃嘛！」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「可、可是，调味是叔叔做的」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花的父亲","text":"「先不管这个，其他方面对你这个第一次做的来说已经很出色了」","art":{"background":"a1677","sprites":[{"asset":"a970","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「哎，能让爸爸一顿好夸，厉害啊，阿将」","art":{"background":"a1677","sprites":[{"asset":"a970","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a994","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"我也吓了一跳……甚至怀疑他们是不是在抬举我。","art":{"background":"a1677","sprites":[{"asset":"a970","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a994","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花的父亲","text":"「看来增加新口味的时候可以好好期待你们的表现了」","art":{"background":"a1677","sprites":[{"asset":"a970","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a994","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「哥哥一定可以发明新的口味的」","art":{"background":"a1677","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「要是有什么困难，我也可以帮忙」","art":{"background":"a1677","sprites":[{"asset":"a2642","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「嗯，谢谢小春」","art":{"background":"a1677","sprites":[{"asset":"a2642","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「看来真的要考虑给你工资里加手艺费了……不过，你能帮上这种忙真的很棒」","art":{"background":"a1677","sprites":[{"asset":"a999","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「接下来就该考虑新的菜单了」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a1677","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"小春","text":"「好厉害！哥哥烤得仙贝真好吃！」","art":{"background":"a1677","sprites":[{"asset":"a1011","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2150","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花","text":"「嗯，我也觉得很好吃，阿将」","art":{"background":"a1677","sprites":[{"asset":"a1011","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a996","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芦花的父亲","text":"「做得很棒啊」","art":{"background":"a1677","sprites":[{"asset":"a1011","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a996","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"竟然被大夸了一番……","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「还挺开心的」","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"以后我也要努力才行，我越来越有干劲了。","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"而且……","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"小春","text":"「好厉害！哥哥烤得仙贝真好吃！」","art":{"background":"a1677","sprites":[{"asset":"a1011","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小春的笑容太可爱，非常惹人怜爱……","art":{"background":"a1677","sprites":[{"asset":"a1011","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"但是……仙贝这方面还是需要叔叔的品鉴。","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"芦花姐想要的是一些不需要叔叔亲自出力的新产品。","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"如果我能做出符合她要求的新产品……","art":{"background":"a4007","sprites":[]},"chapter":"6-3"},{"speaker":"芦花","text":"「这次真是多亏了你，太谢谢了」","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"或许，我又能看见芦花姐那样的笑容。","art":{"background":"a1677","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"她们俩的笑容对我来说都很重要……可我更想看到的是……","art":{"background":"a4007","sprites":[]},"chapter":"6-3"}]