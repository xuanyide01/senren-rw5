[{"speaker":"将臣","text":"「那我这次就射在嘴里了」","art":{"background":"a2849","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「好的，我知道了……啊啊啊唔……嗯唔、嗯、嗯嗯、吸溜」","art":{"background":"a2852","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"茉子高兴地含着我的肉棒。","art":{"background":"a2852","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"像是等不及要喝下精液一样，她又吸又吮，把舌头缠上了我的肉棒。","art":{"background":"a2852","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「嗯、嗯吸溜、啾啵啵啵……嗯唔、嗯、嗯嗯———咻啵啾啵、啾噗噗噗」","art":{"background":"a2848","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「茉、茉子，这个太爽了」","art":{"background":"a2848","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「啾啵啾啵、嗯唔……射出来吧……把我的嘴射得满满的……啾啵啾啵」","art":{"background":"a2852","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「啾噗噗噗……啾啵、啾啵、嗯唔唔……嗯、啾——嗯、嗯嗯、嗯、嗯、嗯、嗯、嗯嗯嗯嗯！」","art":{"background":"a2848","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「茉子，要射了！」","art":{"background":"a2848","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「嗯噗呜！？嗯、嗯嗯—————！？」","art":{"background":"a2856","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"咕嘟！咕嘟咕嘟！！","art":{"background":"a2857","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我的肉棒剧烈抖动，新射出的精液冲进了茉子的口中。","art":{"background":"a2857","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"面对完全不亚于上一次的强烈射精，茉子睁大了眼睛，但丝毫没有松口。","art":{"background":"a2857","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「嗯唔……嗯呼、嗯呼呜呜…嗯唔、嗯唔……嗯嗯嗯……咕嘟、咕嘟……咕啾」","art":{"background":"a2858","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「姆唔唔、噗啊！哈、啊——啊——、咳、呕……咳……」","art":{"background":"a2859","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"茉子没能喝下去的精液正在一滴一滴从嘴中淌出来。","art":{"background":"a2859","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"她现在的样子……也很淫荡……","art":{"background":"a2859","sprites":[]},"chapter":"尾声"},{"speaker":"茉子","text":"「哈、啊——啊——射得好多……对不起，我浪费了一些精液……」","art":{"background":"a2860","sprites":[]},"chapter":"尾声"}]