[{"speaker":"将臣","text":"「芦花姐……我要射了，又要射了」","art":{"background":"a4503","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「嗯嗯、嗯啊！嗯啊！啊啊啊、又要来了、来了来了、嗯、嗯啊啊啊啊啊啊——」","art":{"background":"a4506","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「啊啊啊啊啊啊啊啊啊啊啊啊————————！！」","art":{"background":"a4506","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"噗咻！噗咻咻咻！","art":{"background":"a4507","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"在高潮之前，我从芦花姐的体内拔了出来，把她那红通通的炙热肌肤染成一片白色。","art":{"background":"a4507","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「嗯啊……啊、啊……嗯唔、嗯啊！哈啊、哈啊、哈啊、哈啊」","art":{"background":"a4510","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"朝着芦花姐不断痉挛的身体迸射而出的大量白浊液，在她身上留下了星星点点的印迹。","art":{"background":"a4510","sprites":[]},"chapter":"8-2"}]