[{"speaker":"将臣","text":"「那各位明天见！」","art":{"background":"a599","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"小雨恢复人身已经过去了三天。","art":{"background":"a599","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"今天我依然在放学后立刻冲出了教室。","art":{"background":"a599","sprites":[]},"chapter":"6-3"},{"speaker":"廉太郎","text":"「……我连个招呼都没来得及跟他打」","art":{"background":"a599","sprites":[{"asset":"a885","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"蕾娜","text":"「将臣今天似乎也很忙啊」","art":{"background":"a599","sprites":[{"asset":"a1224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"蕾娜","text":"「照顾小雨有那么累人吗？」","art":{"background":"a599","sprites":[{"asset":"a1209","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「不，并不累」","art":{"background":"a599","sprites":[{"asset":"a491","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「她恢复得很好，差不多该痊愈了，甚至可以说身体已经很健康了」","art":{"background":"a599","sprites":[{"asset":"a590","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芳乃","text":"「是的，有地有些担心过头了」","art":{"background":"a599","sprites":[{"asset":"a797","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1676","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「也可以说是太勤快了」","art":{"background":"a599","sprites":[{"asset":"a797","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a476","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"蕾娜","text":"「将臣是那么尽心尽力的男生啊」","art":{"background":"a599","sprites":[{"asset":"a1236","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"蕾娜","text":"「突然有点羡慕小雨」","art":{"background":"a599","sprites":[{"asset":"a701","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"廉太郎","text":"「蕾娜，别看我这样，我也是会尽心尽力的！怎么样？」","art":{"background":"a599","sprites":[{"asset":"a714","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a499","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"蕾娜","text":"「唔，算了吧」","art":{"background":"a599","sprites":[{"asset":"a695","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a499","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"廉太郎","text":"「为什么？」","art":{"background":"a599","sprites":[{"asset":"a884","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"小春","text":"「因为廉哥尽心尽力是出于不可告人的目的」","art":{"background":"a599","sprites":[{"asset":"a893","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a516","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"廉太郎","text":"「闭嘴！不对，你什么时候来的？！」","art":{"background":"a599","sprites":[{"asset":"a893","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a911","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「小雨，我回来了！」","art":{"background":"a275","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「主人，欢迎回来」","art":{"background":"a275","sprites":[{"asset":"a3144","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「你今天回来得也好早啊」","art":{"background":"a275","sprites":[{"asset":"a3116","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「感觉一天比一天早啊」","art":{"background":"a275","sprites":[{"asset":"a3117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「应该是因为习惯了吧，来」","art":{"background":"a275","sprites":[{"asset":"a3117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"我拿出每日的见面礼送给小雨。","art":{"background":"a275","sprites":[{"asset":"a3117","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「噢，今天是抹茶布丁啊！」","art":{"background":"a275","sprites":[{"asset":"a3145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小雨笑得特别灿烂。","art":{"background":"a275","sprites":[{"asset":"a3145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"她的笑脸在闪闪发光。","art":{"background":"a275","sprites":[{"asset":"a3145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「所以只要在早上１０点之前点一杯咖啡，就会送吐司面包和煮蛋」","art":{"background":"a1107","sprites":[{"asset":"a3116","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「哦？城里的咖啡厅还有这种服务啊」","art":{"background":"a1107","sprites":[{"asset":"a3131","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「好想找机会去一次看看」","art":{"background":"a1107","sprites":[{"asset":"a3132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"我跟小雨天南地北一阵聊。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我跟她聊城市生活，她跟我聊五百年前的生活。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我们对彼此的话题都很感兴趣。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"不管怎么聊都聊不完。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"茉子","text":"「打扰了」","art":{"background":"a1107","sprites":[{"asset":"a246","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「丛雨大人，洗澡水烧好了，今天您要洗澡吗？」","art":{"background":"a1107","sprites":[{"asset":"a1459","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「哎？都这么晚了？」","art":{"background":"a1107","sprites":[{"asset":"a1459","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「有地，已经是傍晚了」","art":{"background":"a1107","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"听常陆这么说，我才注意到时间。","art":{"background":"a1107","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"照进房间里的阳光已经彻底染上了橘色。","art":{"background":"a1107","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「嗯，洗澡应该已经没问题了」","art":{"background":"a1107","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「让本座第一个洗没问题吗？茉子」","art":{"background":"a1107","sprites":[{"asset":"a3146","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a246","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「当然没问题」","art":{"background":"a1107","sprites":[{"asset":"a3146","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a251","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「既然要洗的话，要不要我来帮您搓背？」","art":{"background":"a1107","sprites":[{"asset":"a3146","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a284","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……」","art":{"background":"a1107","sprites":[{"asset":"a3140","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「（瞟）」","art":{"background":"a1107","sprites":[{"asset":"a3147","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"嗯？","art":{"background":"a1107","sprites":[{"asset":"a3119","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「（瞟瞟瞟）」","art":{"background":"a1107","sprites":[{"asset":"a3148","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小雨红着脸看着我。","art":{"background":"a1107","sprites":[{"asset":"a3148","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"怎么？我怎么了？","art":{"background":"a1107","sprites":[{"asset":"a3148","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「哦，是这样啊」","art":{"background":"a1107","sprites":[{"asset":"a1043","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"而常陆突然露出一副懂了的表情……","art":{"background":"a1107","sprites":[{"asset":"a1043","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「哎唷唷，我可真是的」","art":{"background":"a1107","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「竟然扔下丛雨大人的男友有地，想做这种僭越的事情」","art":{"background":"a1107","sprites":[{"asset":"a1348","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「啊？」","art":{"background":"a1107","sprites":[{"asset":"a1348","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"我没听懂她的意思，只得张着嘴露出疑惑的神情。","art":{"background":"a1107","sprites":[{"asset":"a1348","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「有地，交给你了」","art":{"background":"a1107","sprites":[{"asset":"a247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「那么请二位慢慢享受♪」","art":{"background":"a1107","sprites":[{"asset":"a287","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"常陆微笑之后便关上隔扇走掉了。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「她是要我做什么……」","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"迷茫的我就这样被留在了原地。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「来吧，主人」","art":{"background":"a1107","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小雨立刻起身拉住我的手。","art":{"background":"a1107","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「哎？去哪？」","art":{"background":"a1107","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「这、这还用问吗」","art":{"background":"a1107","sprites":[{"asset":"a3149","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「去浴室啦」","art":{"background":"a1107","sprites":[{"asset":"a3150","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小雨红着脸，坚决地说道。","art":{"background":"a1107","sprites":[{"asset":"a3150","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"哎？！","art":{"background":"a1107","sprites":[{"asset":"a3150","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「为、为什么？！","art":{"background":"a1107","sprites":[{"asset":"a3146","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"被她忽然这么一说，我被吓得慌张了起来。","art":{"background":"a1107","sprites":[{"asset":"a3146","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"同时我的脸也变得滚烫。","art":{"background":"a1107","sprites":[{"asset":"a3146","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「来帮本座搓背」","art":{"background":"a1107","sprites":[{"asset":"a3151","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「本座是病人，需要护理，由主人这个男友来照顾不是很正常吗」","art":{"background":"a1107","sprites":[{"asset":"a3152","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「刚才咱们还有说有笑啊？你很有精神才对啊？！」","art":{"background":"a1107","sprites":[{"asset":"a3152","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"不管怎么看都已经能一个人洗澡了。","art":{"background":"a1107","sprites":[{"asset":"a3152","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「呃，身体突然变得好重，主人……」","art":{"background":"a1107","sprites":[{"asset":"a3125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「虽然本座很想洗净汗水，但怕的是一个人泡澡会泡晕……」","art":{"background":"a1107","sprites":[{"asset":"a3117","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「啊！谁来可怜可怜本座，带本座一起去洗澡呢？！」","art":{"background":"a1107","sprites":[{"asset":"a3125","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小雨作出哭泣状趴倒在地。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"一看就能看出来是假哭。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「唉……行吧」","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「我跟你一起洗，帮你搓背吧」","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「嗯，就该这么做，主人」","art":{"background":"a1107","sprites":[{"asset":"a3115","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「走，去浴室吧」","art":{"background":"a1107","sprites":[{"asset":"a3145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小雨忽然开心起来，她蹦蹦跳跳地朝着浴室跑了过去。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"很有精神啊。而且好现实。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「……跟小雨一起洗澡……」","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我咽了一口口水。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我回想起了三天前的第一次体验。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"那天，我与小雨合为一体。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「我能控制住自己吗……」","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我又不能跟在养病的小雨做那种事情。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"可与此同时我也是个健全的男性。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「这下难办了……」","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"拜托，暂时消失吧，我的杂念。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「主人，你在干什么呢」","art":{"background":"a1107","sprites":[{"asset":"a3153","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「快走吧」","art":{"background":"a1107","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「啊，是！」","art":{"background":"a1107","sprites":[{"asset":"a3129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"我拍了拍自己的脸颊。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我鼓起干劲，和小雨一起向浴室走去。","art":{"background":"a1107","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「噢……」","art":{"background":"a3154","sprites":[{"asset":"a3155","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「噢！」","art":{"background":"a3154","sprites":[{"asset":"a3156","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小雨一丝不挂，将手插进浴缸，发出惊叹声。","art":{"background":"a3154","sprites":[{"asset":"a3156","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"那小小的屁股摇来晃去的。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"这叫我往哪看啊。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"为了不让我裹在腰部的毛巾下的家伙竖起来，我开始拼命数质数。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「是热水的感觉……」","art":{"background":"a3154","sprites":[{"asset":"a3157","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「好烫……但是好舒服！」","art":{"background":"a3154","sprites":[{"asset":"a3158","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"她嬉闹的模样就像个小孩。","art":{"background":"a3154","sprites":[{"asset":"a3158","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"天真无邪。","art":{"background":"a3154","sprites":[{"asset":"a3158","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"明明现在是少男少女赤裸相对的香艳场景啊。","art":{"background":"a3154","sprites":[{"asset":"a3158","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"看来她在这方面的感觉跟普通的女孩子还是不一样的。","art":{"background":"a3154","sprites":[{"asset":"a3158","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"看着天真烂漫的小雨，我也勉强冷静下来了。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"现在我要专心思考怎样温暖她、帮她洗净身体。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「小雨，快泡进去吧」","art":{"background":"a3154","sprites":[{"asset":"a3159","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「之后我再给你搓背」","art":{"background":"a3154","sprites":[{"asset":"a3159","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「嗯！」","art":{"background":"a3154","sprites":[{"asset":"a3158","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"小雨立刻将全身泡了进去。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"水花四溅。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「进去的时候动作小一点！」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「哈哈哈！好暖和，暖和！」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"根本没听我说话。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"也难怪，她有五百年没洗过澡了。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"就让她享受享受吧。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「那就麻烦你了，主人！」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「啊，嗯……」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"跟小雨一起泡完之后，终于该进入正题了。","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"眼前是少女纤细的曲线和柔嫩的肌肤。","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我曾经与眼前的这个少女共度良宵。","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"但上次我并没有在这么明亮的地方观察她的身体。","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"不好，脑子里正在生成邪恶的念头！","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"质数！去数质数啊，将臣！","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「嗯？主人？」","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「你怎么了？」","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"小雨回头看着手持毛巾呆站着的我。","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"那双眸子一尘不染。","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「没、没什么！」","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「我只是在回想３１７之后的质数是什么」","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「是３３１。可是，你怎么在数质数？」","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「行了，我开始洗了，小雨」","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我拼命用理性控制自己，开始搓洗小雨娇小的后背。","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「噢，真舒服……」","art":{"background":"a3162","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「想来本座曾经给父母搓背，但从没人给本座搓过」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「这是第一次的体验啊」","art":{"background":"a3162","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「小雨，现在别说什么第一次体验之类的话」","art":{"background":"a3162","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"故意的吧？她肯定是故意的吧？","art":{"background":"a3162","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"莫非她现在正在戏弄我？","art":{"background":"a3162","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「主人，加大点力气吧」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「这、这样吗？」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我稍稍加大了力道。","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"少女肌肤的触感隔着毛巾传达到我手上，让我的心情难以平静。","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"不好，质数，质数！","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……嗯」","art":{"background":"a3163","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……啊、嗯，舒服，好舒服啊，主人……」","art":{"background":"a3164","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……太舒服了……嗯！」","art":{"background":"a3164","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"小雨的声音越来越诱人。","art":{"background":"a3164","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我的心脏狂跳起来。","art":{"background":"a3164","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"卷在腰上的毛巾底下已经涨得没法见人了。","art":{"background":"a3164","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「呼、呼，主人……」","art":{"background":"a3164","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「啊、嗯、啊……」","art":{"background":"a3164","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「能再加大点力气吗……」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「这、这样吗？」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我已经任她指挥了。","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"为了抵抗性欲，我的理性已经到达了极限。","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"完全没工夫思考其他事情……","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「啊」","art":{"background":"a3160","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「啊！」","art":{"background":"a3165","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我沾满肥皂的手滑了一下，碰到了小雨的胸部。","art":{"background":"a3165","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我的指尖，感觉到了……","art":{"background":"a3165","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"小小的、但肯定已经硬起来的乳头。","art":{"background":"a3165","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「啊、嗯、啊！」","art":{"background":"a3164","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「主、主人……」","art":{"background":"a3165","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「对、对不起！」","art":{"background":"a3165","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"一阵手忙脚乱。","art":{"background":"a3165","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「我、我不是故意的」","art":{"background":"a3165","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「本、本座知道……」","art":{"background":"a3163","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「而且本座又不……」","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"……哎？","art":{"background":"a3161","sprites":[]},"chapter":"6-3"},{"speaker":"茉子","text":"「我说，两位没事吧？」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"茉子","text":"「洗了那么久，不会是泡晕了吧……」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"突然传来的声音打断了我的想法，让我恢复了冷静。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"回头一看，隔着毛玻璃可以看见常陆的影子。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「马、马上出来！」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「我、我们俩没事，你、你不必在意，常陆！」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我尽量用开朗而健全的声音回答那个人影。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"茉子","text":"「好的」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"茉子","text":"「晚餐已经准备好了」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"话毕，常陆就离开了更衣间。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我松了口气。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「出去吧，小雨」","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「啊，嗯」","art":{"background":"a3154","sprites":[{"asset":"a3166","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"将臣","text":"「我先出去了，你尽快洗完吧！」","art":{"background":"a3154","sprites":[{"asset":"a3166","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"","text":"我不想让小雨看见我双腿之间的那玩意儿有多精神，所以立刻离开了浴室。","art":{"background":"a3154","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……主人」","art":{"background":"a3154","sprites":[{"asset":"a3167","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……本座都这么积极地暗示了……」","art":{"background":"a3154","sprites":[{"asset":"a3168","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「不过，他应该只是因为顾虑着本座的身体吧……」","art":{"background":"a3154","sprites":[{"asset":"a3169","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……唉……」","art":{"background":"a3154","sprites":[{"asset":"a3170","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……恢复健康之后，他还愿意再跟本座同床共枕吗……」","art":{"background":"a3154","sprites":[{"asset":"a3171","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「希望下次是主人主动来找本座……」","art":{"background":"a3154","sprites":[{"asset":"a3172","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「嘻嘻，嘻嘻……」","art":{"background":"a1104","sprites":[{"asset":"a913","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「噗，呵呵，嘻嘻……」","art":{"background":"a1104","sprites":[{"asset":"a1099","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芳乃","text":"「怎么了，茉子？」","art":{"background":"a1104","sprites":[{"asset":"a244","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"安晴","text":"「发生了什么有趣的事情吗？」","art":{"background":"a1104","sprites":[{"asset":"a308","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「嘻嘻，啊，嗯……」","art":{"background":"a1104","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「我刚跟在洗澡的丛雨大人和有地搭了话」","art":{"background":"a1104","sprites":[{"asset":"a1099","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「有地那狼狈模样真是太搞笑了……噗，嘻嘻……」","art":{"background":"a1104","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"安晴","text":"「喂……」","art":{"background":"a1104","sprites":[{"asset":"a243","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芳乃","text":"「哎？难、难道有地和丛雨大人……」","art":{"background":"a1104","sprites":[{"asset":"a1131","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"芳乃","text":"「在、在浴室做了说不出口的淫乱行为？！」","art":{"background":"a1104","sprites":[{"asset":"a3173","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「不是的不是的，不管怎么说有地也不会对生病的女孩子做那种事情的」","art":{"background":"a1104","sprites":[{"asset":"a292","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「但他毕竟是个男孩子嘛」","art":{"background":"a1104","sprites":[{"asset":"a252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「肯定是在一边数质数一边忍耐吧♪」","art":{"background":"a1104","sprites":[{"asset":"a257","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"安晴","text":"「茉子，你别太欺负将臣了」","art":{"background":"a1104","sprites":[{"asset":"a244","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a328","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"安晴","text":"「那个年龄的男孩子特别单纯」","art":{"background":"a1104","sprites":[{"asset":"a243","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a328","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「我倒觉得我已经很照顾他了」","art":{"background":"a1104","sprites":[{"asset":"a243","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a252","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「我还想让他们的关系更进一步呢」","art":{"background":"a1104","sprites":[{"asset":"a243","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a552","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"茉子","text":"「只要丛雨大人和有地成了，那她肯定就愿意恢复人身了」","art":{"background":"a1104","sprites":[{"asset":"a243","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a251","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"安晴","text":"「话是这么说」","art":{"background":"a1104","sprites":[{"asset":"a1405","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a251","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-3"},{"speaker":"芳乃","text":"「我觉得茉子的做法有些激进了」","art":{"background":"a1104","sprites":[{"asset":"a429","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-3"},{"speaker":"丛雨","text":"「呼……呼……」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我看着睡得香甜的小雨的脸。","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「呼……呼……」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"她睡得很安心。","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"光是看着她的这张睡脸，连我都觉得安心起来了。","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「呜……」","art":{"background":"a2989","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「呜，呜……」","art":{"background":"a2989","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「呜……」","art":{"background":"a2989","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「父亲，母亲……」","art":{"background":"a2987","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「请你们保佑本座，保佑绫……」","art":{"background":"a2989","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"那天晚上，她一个人哭泣着。","art":{"background":"a2989","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"现在我也无法忘记。","art":{"background":"a2989","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"那一晚，在月光下耷拉着肩膀哭泣的小雨。","art":{"background":"a2989","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"不，我那时……","art":{"background":"a2989","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「……别再哭了」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"为此……","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我什么都愿意做。","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「呼……呼……」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「我会永远陪在你的身边的」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「……小雨，你不必独自背负一切」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我轻轻掀开她的刘海。","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"然后在她的额头上轻轻吻了一口。","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"只是这样的话应该没问题吧？","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「做个好梦」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"将臣","text":"「晚安，小雨」","art":{"background":"a1340","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我躺进了自己的被窝。","art":{"background":"a0","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"很快我就睡着了。","art":{"background":"a0","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「……」","art":{"background":"a0","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「主人……真是太温柔了……」","art":{"background":"a0","sprites":[]},"chapter":"6-3"},{"speaker":"丛雨","text":"「啾……」","art":{"background":"a0","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"我的嘴唇似乎轻轻碰到了什么。","art":{"background":"a0","sprites":[]},"chapter":"6-3"},{"speaker":"","text":"某个又甜又软的……","art":{"background":"a0","sprites":[]},"chapter":"6-3"}]