[{"speaker":"将臣","text":"「那我也去挖野菜吧」","art":{"background":"a1044","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「我一个人也没问题的，不用担心我」","art":{"background":"a1044","sprites":[{"asset":"a552","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不，这可不行。要是有个万一怎么办」","art":{"background":"a1044","sprites":[{"asset":"a552","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「那我就和巫女大人一起去钓鱼了」","art":{"background":"a1044","sprites":[{"asset":"a85","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「你可别干不该干的事啊」","art":{"background":"a1044","sprites":[{"asset":"a85","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「怎么连你都要说跟小春一样的话……稍微信任我一点啊」","art":{"background":"a1044","sprites":[{"asset":"a105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「我哪敢对巫女大人乱来啊」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「那就好」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「还有，蕾娜那边也交给你了」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「那个，我想现在就开始钓鱼，请问这个可以就这样投进河里吗？」","art":{"background":"a1044","sprites":[{"asset":"a445","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「不。首先需要将当鱼饵的蚯蚓挂在鱼钩上」","art":{"background":"a1044","sprites":[{"asset":"a85","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「用蚯蚓是吧，我明白了」","art":{"background":"a1044","sprites":[{"asset":"a85","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a622","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1044","sprites":[{"asset":"a85","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a622","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"朝武在穗织是一位身份很特别的女孩。","art":{"background":"a1044","sprites":[{"asset":"a431","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"廉太郎也一直叫她巫女大人……应该不会干什么不该干的事吧。","art":{"background":"a1044","sprites":[{"asset":"a431","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"既然和朝武在一起，那他为了避免自己被当成变态，应该也不会对蕾娜做什么。","art":{"background":"a1044","sprites":[{"asset":"a963","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"他应该也明白，如果干了什么不该干的，回去以后肯定会被外公教训。","art":{"background":"a1044","sprites":[{"asset":"a963","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「那我们走吧」","art":{"background":"a1044","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「酸模的话这附近到处都有……除此之外还需要什么野菜？」","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「这个嘛……蜂斗菜、楤木芽、蕨菜、紫萁……还有土当归、茖葱……有这些的话就好了」","art":{"background":"a1085","sprites":[{"asset":"a249","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「你果然很懂啊」","art":{"background":"a1085","sprites":[{"asset":"a249","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「因为要当忍者，必须要有野草相关的知识」","art":{"background":"a1085","sprites":[{"asset":"a291","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「可是……我也不懂哪个是哪个」","art":{"background":"a1085","sprites":[{"asset":"a291","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"我虽然见过蕨菜和紫萁，但要分清山里长的野菜都是些什么，我觉得很难。","art":{"background":"a1085","sprites":[{"asset":"a291","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「那你可不可以帮我找找艾蒿和虎杖？还有笔头菜……不过现在还不到时节」","art":{"background":"a1085","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我知道了。不过艾蒿除了配丸子和年糕，还有别的吃法吗？」","art":{"background":"a1085","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「做成天妇罗很好吃的。你就好好期待晚饭吧」","art":{"background":"a1085","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我很期待」","art":{"background":"a1085","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"然后，我开始以艾蒿和虎杖为中心寻找野菜。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「啊，对了」","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「艾蒿和乌头草很相似，所以请小心千万不要误采到乌头草了」","art":{"background":"a1085","sprites":[{"asset":"a428","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「哎！？乌、乌头草！？」","art":{"background":"a1085","sprites":[{"asset":"a428","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「吃下去会引发呕吐、呼吸困难、内脏不适等不良反应――」","art":{"background":"a1085","sprites":[{"asset":"a565","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「可能一下子就ＢＡＤ　ＥＮＤ了哦」","art":{"background":"a1085","sprites":[{"asset":"a1086","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1085","sprites":[{"asset":"a1086","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"我忍不住咽了口唾沫。","art":{"background":"a1085","sprites":[{"asset":"a1086","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「哈哈……是不是有点吓到你了」","art":{"background":"a1085","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「你放心吧，我从来没在这座山里见过乌头草」","art":{"background":"a1085","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「你、你也真是……吓了我一跳」","art":{"background":"a1085","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「但为了以防万一，你千万不要一个人在那品尝味道啊」","art":{"background":"a1085","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「哪怕是能吃的野草，也不适合生吃。搞不好会拉肚子的」","art":{"background":"a1085","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我、我知道了。我不会生吃的」","art":{"background":"a1085","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「嗯，说好了，不准生吃啊。那我先去了」","art":{"background":"a1085","sprites":[{"asset":"a632","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「～～～♪」","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"常陆一边哼着小曲儿，一边麻利地摘着各种野菜。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"突然，我听见了一阵细小的声音。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"声音虽细，但并不是拨开草木的声音。这声音……","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「……是鸟叫声？」","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「这是雏鸟的叫声吧」","art":{"background":"a1085","sprites":[{"asset":"a628","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「是从这边传来的」","art":{"background":"a1085","sprites":[{"asset":"a628","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"而且不是从头上，是从脚下。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我拨开草丛仔细观察，发现眼前有一只雏鸟，正在拍打着很小很小的翅膀。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「看样子是从鸟窝里掉下来了」","art":{"background":"a1085","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「放回去比较好吧」","art":{"background":"a1085","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「但是……很高啊……能爬上去吗？而且还要抱着雏鸟」","art":{"background":"a1085","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「别担心。交给我吧」","art":{"background":"a1085","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"常陆温柔地用双手捧住雏鸟。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"她朝树木一踢，就像是跑步一样爬了上去。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「哇……居然能这样爬上去……太厉害了」","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"该怎么做才能像这样爬树呢？","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"这个我实在模仿不来……她简直比普通人强太多了。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「可别再掉下来了哦」","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"她慢慢地将雏鸟放回鸟巢。","art":{"background":"a1085","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「这样就好了」","art":{"background":"a1087","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「你居然能这样爬树啊」","art":{"background":"a1087","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「毕竟我是忍者啊。这点本事根本不算什么，对我来说轻而易举，呵呵呵」","art":{"background":"a1087","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「对了，有地」","art":{"background":"a1087","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「什么事？」","art":{"background":"a1087","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「你知道“稻草人救火——自身难保”这句歇后语吗？」","art":{"background":"a1087","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「知道是知道……」","art":{"background":"a1087","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「等等，你难道……！？」","art":{"background":"a1087","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「呵，呵呵……呼呼呼呼呼啊啊啊啊啊啊啊好高……\n好高啊……」","art":{"background":"a1088","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「常陆，你有恐高症？」","art":{"background":"a1088","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「是、是的……你说的没错」","art":{"background":"a1089","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「虽然说出来很害羞，但我实在是很害怕高的地方……\n呜啊！？」","art":{"background":"a1088","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「那你干嘛爬上去！？」","art":{"background":"a1088","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「可是，雏鸟一直掉在地上太可怜了嘛」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「话是这么说，可你怕高的话直接让我来爬不就好了」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「这怎么行，很危险的」","art":{"background":"a1091","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「有恐高症的人去爬更危险！」","art":{"background":"a1091","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「呜呜呜……非常抱歉……」","art":{"background":"a1089","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「爬上去很简单，但要下来就很困难……」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我仔细一看，她的脚在不停地发抖。","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"似乎不是在开玩笑……","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「你不要勉强自己！很危险的！」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「明、明白……很抱歉」","art":{"background":"a1089","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"常陆拼命地搂着树木。","art":{"background":"a1089","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"不过，这可怎么办啊……","art":{"background":"a1089","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"如果有梯子一类的东西，就能帮她下来了。","art":{"background":"a1089","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「……啊哇哇哇哇哇哇哇哇哇哇哇……」","art":{"background":"a1092","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"可我实在不能扔下这个状态的常陆一个人去取梯子。","art":{"background":"a1092","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"虽然爬树我也能办到……但要抱着常陆安全下来实在是很难。","art":{"background":"a1092","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"十有八九会在途中摔下来。","art":{"background":"a1092","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"但如果没有别的方法，那也只能这样做了。","art":{"background":"a1092","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「不能用什么忍术吗？」","art":{"background":"a1092","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「忍……忍术？」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「你以前不是用过什么变身术之类的吗」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「那招的原理是以圆木吸引敌方注意力，趁机遁入敌方死角……并不是调换了身体」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「所以，对不会被吓到的祟神也没有任何用处」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「是这样吗……？」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"这种像漫画一样厉害的绝招竟然没用……","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「那有什么道具能让你安全下来吗？没有绳子之类的吗？」","art":{"background":"a1090","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「绳子……绳子！有的，我有钩绳！」","art":{"background":"a1093","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「用那条绳子能安全下来吗？」","art":{"background":"a1093","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「这、这个大概是没问题的」","art":{"background":"a1093","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「我爬上去帮你怎么样？」","art":{"background":"a1093","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「不、不用，我一个人没问题。呃，呃，绳子、绳子、绳子」","art":{"background":"a1094","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「不是苦无，不是分铜锁，不是手甲钩，不是撒菱，也不是圆木――」","art":{"background":"a1094","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"为预防最糟糕的事态发生，我在下方做好了随时接住她的准备。","art":{"background":"a1094","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"可完全焦急起来的常陆随手抓出一堆无关的东西，全都从我脑袋上砸了下来。","art":{"background":"a1094","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「哇哇哇哇！？」","art":{"background":"a1094","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「别乱扔！不要乱扔危险物！」","art":{"background":"a1094","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"话说这么多道具她都是收在哪里的啊！？","art":{"background":"a1094","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"这么大的圆木怎么可能藏在身上！还有，分铜锁不是也可以替代绳子用吗！","art":{"background":"a1094","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「啊哇哇，非、非常抱歉，非常抱歉。我太慌张了」","art":{"background":"a1095","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「没事，你没受伤就好。总之先冷静，慢慢地下来」","art":{"background":"a1095","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「呼……呼……呼……」","art":{"background":"a1096","sprites":[{"asset":"a957","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"好不容易从树上下来的常陆一屁股坐在地上，让急促的呼吸平复下来。","art":{"background":"a1096","sprites":[{"asset":"a957","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「你恐高的话老老实实说出来不就好了」","art":{"background":"a1096","sprites":[{"asset":"a957","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「非常抱歉，给你添麻烦了」","art":{"background":"a1096","sprites":[{"asset":"a957","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不过我还真没想到，原来你怕高啊」","art":{"background":"a1096","sprites":[{"asset":"a957","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「我从小就一直怕高……」","art":{"background":"a1096","sprites":[{"asset":"a1097","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「是这样啊」","art":{"background":"a1096","sprites":[{"asset":"a1097","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「实在是羞愧难当」","art":{"background":"a1096","sprites":[{"asset":"a1098","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我是觉得没必要害羞……」","art":{"background":"a1096","sprites":[{"asset":"a1098","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「要是以后再遇到什么困难，你别勉强自己，拜托我就好了」","art":{"background":"a1096","sprites":[{"asset":"a1098","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我也是能帮上一点忙的。不过……我不懂得分辨野草就是了」","art":{"background":"a1096","sprites":[{"asset":"a1098","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「哈哈，你已经足够可靠了」","art":{"background":"a1096","sprites":[{"asset":"a1099","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「芳乃大人很少像今天这样活蹦乱跳的……这么说可能有点夸张了，但她确实很久没这么开心过了，这都是多亏了你」","art":{"background":"a1096","sprites":[{"asset":"a281","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「所以，非常感谢你」","art":{"background":"a1096","sprites":[{"asset":"a913","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「呃，那个……我觉得我也没做什么大不了的事……」","art":{"background":"a1096","sprites":[{"asset":"a913","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「像现在这样和大家一起玩，我也很开心」","art":{"background":"a1096","sprites":[{"asset":"a247","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"感觉……好难为情啊。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我倒是觉得自己总是在给大家拖后腿。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「好了……那我们继续挖野菜吧」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「好、好的。虽然我很想这么做……」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「但是我现在有点直不起腰……」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"啊，是吗。怪不得她从刚才起就一直瘫坐在地上……","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「……抱歉」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「用不着道歉，但是现在该怎么办呢？」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「需要我去把朝武或者其他人叫来吗？」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「不、不用。不需要如此劳师动众，反正我已经从树上下来了」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「能给我一些时间吗？」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「……那就稍微休息一下吧」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我坐在常陆身边。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"常陆红着脸低了下头。","art":{"background":"a1096","sprites":[{"asset":"a1100","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「真的很抱歉。我会用今晚的晚饭来向你表示歉意的」","art":{"background":"a1096","sprites":[{"asset":"a1101","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「听起来真不错啊。我会很期待的」","art":{"background":"a1096","sprites":[{"asset":"a1101","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「好的，包在我身上吧」","art":{"background":"a1096","sprites":[{"asset":"a1102","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"就这样，我们一直闲聊到常陆能站起来为止。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"}]