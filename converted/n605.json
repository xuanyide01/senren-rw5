[{"speaker":"将臣","text":"「啊、啊……嗯嗯、啊啊……茉子、这次做得太爽了……啊、啊……」","art":{"background":"a2751","sprites":[]},"chapter":"7-1"},{"speaker":"茉子","text":"「嗯嗯、嗯啊、啊——好爽、精液、好热……嗯、啊啊啊……」","art":{"background":"a2751","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"茉子的屁股不断颤抖着。","art":{"background":"a2751","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"可能是因为射精的缘故，疲劳感飞速袭来，但我依然俯视着茉子的后背。","art":{"background":"a2751","sprites":[]},"chapter":"7-1"},{"speaker":"茉子","text":"「啊、啊——啊——谢谢你……射了、这么多……嗯嗯、嗯嗯……啊啊……好粘啊」","art":{"background":"a2752","sprites":[]},"chapter":"7-1"},{"speaker":"将臣","text":"「嗯。感觉脑子里都变得粘乎乎的了……」","art":{"background":"a2752","sprites":[]},"chapter":"7-1"},{"speaker":"茉子","text":"「我也是……脑子里一片空白……嗯、嗯嗯……啊、不行了……」","art":{"background":"a2752","sprites":[]},"chapter":"7-1"},{"speaker":"茉子","text":"「身体已经、使不上力了……嗯嗯……啊啊啊……」","art":{"background":"a2752","sprites":[]},"chapter":"7-1"},{"speaker":"将臣","text":"「那就让我来帮你弄干净吧」","art":{"background":"a2752","sprites":[]},"chapter":"7-1"},{"speaker":"茉子","text":"「什么？啊、不要、现在还很敏感……嗯嗯！不能这么摸……嗯啊啊……！」","art":{"background":"a2752","sprites":[]},"chapter":"7-1"},{"speaker":"茉子","text":"「我已经……动不了了……」","art":{"background":"a119","sprites":[]},"chapter":"7-1"},{"speaker":"将臣","text":"「我也已经不行了」","art":{"background":"a119","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"到底过了多久呢？","art":{"background":"a360","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"茉子和我都高潮了无数次……现在连动一下身子也很困难了。","art":{"background":"a360","sprites":[]},"chapter":"7-1"},{"speaker":"茉子","text":"「真的已经不行了吗？」","art":{"background":"a360","sprites":[{"asset":"a2753","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「……啊？这、这个……因为各方面都已经被掏空了，我觉得不太行……」","art":{"background":"a360","sprites":[{"asset":"a2753","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「不过如果你还想要的话，我可以再努力试一下」","art":{"background":"a360","sprites":[{"asset":"a2753","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「不用努力了，已经够了！再做下去我真的要受不了！」","art":{"background":"a360","sprites":[{"asset":"a2596","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「那你为什么要问这个？」","art":{"background":"a360","sprites":[{"asset":"a2595","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「这个嘛」","art":{"background":"a360","sprites":[{"asset":"a2754","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"她一边笑着，一边把身子靠了过来。","art":{"background":"a360","sprites":[{"asset":"a2755","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"和刚刚的爱抚不同，她温柔地抱住了我，就像是在确认彼此的存在一样。","art":{"background":"a360","sprites":[{"asset":"a2755","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「啊哈，嗯……真暖和……能紧紧地抱住我吗？」","art":{"background":"a360","sprites":[{"asset":"a2615","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「那当然」","art":{"background":"a360","sprites":[{"asset":"a2615","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"我紧紧地，温柔地抱住了茉子。","art":{"background":"a360","sprites":[{"asset":"a2615","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"啊……又软又暖和，多么棒的触感。","art":{"background":"a360","sprites":[{"asset":"a2615","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"但是就像我刚刚说的，我已经被掏空了，所以下体并没有起反应。","art":{"background":"a360","sprites":[{"asset":"a2615","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「如果只是让我抱抱你的话，也不用问刚刚的问题吧？」","art":{"background":"a360","sprites":[{"asset":"a2615","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「因为……如果你抱住我之后又开始做色色的事的话，我真的会死掉的」","art":{"background":"a360","sprites":[{"asset":"a2569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「所以我想着如果你还要做的话……我就跑回房间去。不过既然你没打算做的话就没事啦」","art":{"background":"a360","sprites":[{"asset":"a2615","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「抱紧……嗯嘿嘿」","art":{"background":"a360","sprites":[{"asset":"a2598","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"茉子高兴地把脸埋进我的胸口。","art":{"background":"a360","sprites":[{"asset":"a2598","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「今晚就这样一起睡觉……可以的吧？」","art":{"background":"a360","sprites":[{"asset":"a2756","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「当然。我还想拜托你陪我一起睡呢」","art":{"background":"a360","sprites":[{"asset":"a2756","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「哈哈，谢谢」","art":{"background":"a360","sprites":[{"asset":"a2757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「嘿嘿……嘿嘿嘿……啊啊，好暖和……」","art":{"background":"a360","sprites":[{"asset":"a2758","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「好软和」","art":{"background":"a360","sprites":[{"asset":"a2758","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「又说那种下流的话……今天真的不能再做了哦」","art":{"background":"a360","sprites":[{"asset":"a2733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「我都说了，我已经被你掏空了」","art":{"background":"a360","sprites":[{"asset":"a2733","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"这句话一点都不夸张，精力和体力都已经见了底。","art":{"background":"a360","sprites":[{"asset":"a2595","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"茉子应该也一样，不知不觉中她已经在我身边发出了平稳的呼吸声，八成是睡着了。","art":{"background":"a360","sprites":[{"asset":"a2595","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「嗯，呼——呼——」","art":{"background":"a360","sprites":[{"asset":"a2759","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「这么快就睡着了……真的做过头了吗……？」","art":{"background":"a360","sprites":[{"asset":"a2759","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"但是……这份懒散和茉子的体重让我觉得很惬意……","art":{"background":"a119","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"我享受着这份惬意，意识也随之变得越来越模糊——","art":{"background":"a119","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"不知不觉中，眼皮已经撑不住了。","art":{"background":"a119","sprites":[]},"chapter":"7-1"},{"speaker":"野兽","text":"『我先声明一下——』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『我从来没有像你们那样傻乎乎地过日子』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「你说的是今天中午的事吗？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a628","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『我既没有像婴儿一样跟人撒过娇，也没有被人撒娇过』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a628","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「可是，难道你们就没有一起欣赏过景色吗？看看河流看看树木之类的」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a323","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『你今天根本就没看什么河流树木吧』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『只是一直在和那个男的亲热而已吧』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「不……没那回事……真的……」","art":{"background":"a120","sprites":[{"asset":"a2438","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『哼……不过，今天的体验确实让我感到有些怀念』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a628","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「也就是说我们的尝试还是有意义的，是吗？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a281","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『是的……多亏了你，我回想起了和她在一起的日子……想起来了很多重要的事』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a281","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『光凭这个，我就觉得附在你身上或许还挺值的』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a281","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「你能这么想那就太好了」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a332","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『……你真是个奇怪的家伙。我附在你身上明明给你带来了不少的麻烦』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a332","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「除了最开始的时候，我也没再变过狗，所以算不上什么麻烦啦」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a281","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「而且……我能像现在这样收获自己的幸福，也可以说是多亏了你附身于我」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a2626","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『真是无心插柳柳成荫。没想到我的所作所为居然取悦了一个人类……哼』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a2626","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『也到了该分别的时候了……我有一件事要拜托你』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a2626","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「哎……？那倒没问题，不过没想你竟然会拜托我……到底是什么事呢？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a628","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『除掉我吧』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「除、除掉……？」","art":{"background":"a120","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『也就是说，让你们消灭我这个污秽』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「可是……请稍等一下！」","art":{"background":"a120","sprites":[{"asset":"a278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『你别会错意了。我不是为了你才这么做的。谁会为了人类做这种事啊』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a550","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「那……到底是为什么？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a321","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『我刚刚说了吧……我想起来了许多重要的事』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a321","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『虽然还不太明白何谓恋爱……但我想起来了，我也有过珍惜他人的感情』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『对我来说……她是特别的……』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『但是……我现在的所作所为，是在给她抹黑』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「这是什么意思？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a280","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『封印我的那块石头……就是她留下的。那石头对我来说有着很特殊的意义』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a280","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「所以……石头被打碎之后，你才会那么生气……」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a280","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『我非常珍视那块石头，因为那相当于是她的遗物。然而我却将它污染了』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a280","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『这样简直就跟我憎恨的那个男人一样……跟那个为了自己的欲望而利用她的卑鄙男人一样啊……』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a280","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"茉子","text":"「可是，即便如此，我觉得这方式也太极端了……」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a321","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『我已经死了。我不想再继续给她脸上抹黑了』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a321","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"野兽","text":"『所以除掉我吧，这是我最后的请求了』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"7-1"}]