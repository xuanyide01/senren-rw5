[{"speaker":"","text":"做完之后，我和小雨整理了一下衣服。","art":{"background":"a3423","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"然后我将窗户整个打开，清扫了地板。","art":{"background":"a3423","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"得消灭证据才行。","art":{"background":"a3423","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……这样就没问题了吧？」","art":{"background":"a3423","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「唔，外表看上去是没事了……」","art":{"background":"a3423","sprites":[{"asset":"a3462","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「但是味道可能还在」","art":{"background":"a3423","sprites":[{"asset":"a3388","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哎？有吗？」","art":{"background":"a3423","sprites":[{"asset":"a3388","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我闻了闻周围的空气。","art":{"background":"a3423","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「没什么味道啊」","art":{"background":"a3423","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「是吗？」","art":{"background":"a3423","sprites":[{"asset":"a3375","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「可我们是当事者……」","art":{"background":"a3423","sprites":[{"asset":"a3399","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「嗅觉可能已经失灵了」","art":{"background":"a3423","sprites":[{"asset":"a3404","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"小雨也歪着个脑袋。","art":{"background":"a3423","sprites":[{"asset":"a3404","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「再等一会儿，先不要把窗户关上」","art":{"background":"a3423","sprites":[{"asset":"a3388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这样更稳妥」","art":{"background":"a3423","sprites":[{"asset":"a3388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「嗯，就这样吧」","art":{"background":"a3423","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"小雨微笑道，然后走到了我身边。","art":{"background":"a3423","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我抱住了她的肩膀。","art":{"background":"a3423","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「主人，你要贴紧本座倒也可以」","art":{"background":"a3423","sprites":[{"asset":"a3401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「可这才刚清扫干净，就算你想做，也不能再在这里做啊」","art":{"background":"a3423","sprites":[{"asset":"a3401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不，我不会再在这个地方做啦」","art":{"background":"a3423","sprites":[{"asset":"a3401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"在教室里做爱，真是太大胆了。","art":{"background":"a3423","sprites":[{"asset":"a3401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"万一被发现了，那肯定得停学了。","art":{"background":"a3423","sprites":[{"asset":"a3401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「不说这个了，得好好考虑考虑你参加社团的事情」","art":{"background":"a3423","sprites":[{"asset":"a3401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「以后咱得仔细去寻找你喜欢的事物……」","art":{"background":"a3423","sprites":[{"asset":"a3401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「慢着，主人」","art":{"background":"a3423","sprites":[{"asset":"a3428","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"小雨打断了我，抱住了我的手臂。","art":{"background":"a3423","sprites":[{"asset":"a3428","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「那个不用再考虑了」","art":{"background":"a3423","sprites":[{"asset":"a3403","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「本座已经有答案了」","art":{"background":"a3423","sprites":[{"asset":"a3400","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊？是吗？」","art":{"background":"a3423","sprites":[{"asset":"a3400","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"小雨似乎终于知道了……","art":{"background":"a3423","sprites":[{"asset":"a3400","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"自己喜欢什么，想做什么。","art":{"background":"a3423","sprites":[{"asset":"a3400","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「小雨喜欢的是什么？」","art":{"background":"a3423","sprites":[{"asset":"a3400","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我看着偎依在我身上的她问道。","art":{"background":"a3423","sprites":[{"asset":"a3400","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「嘻嘻……本座之前竟然一直没注意到这么简单的事情，真是神奇」","art":{"background":"a3423","sprites":[{"asset":"a3389","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「不过刚才和主人交合后本座终于明白了」","art":{"background":"a3423","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「本座最喜欢的……」","art":{"background":"a3423","sprites":[{"asset":"a3463","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「就是主人啦♪」","art":{"background":"a3423","sprites":[{"asset":"a3387","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊？」","art":{"background":"a3423","sprites":[{"asset":"a3387","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"她的回答让我很疑惑。","art":{"background":"a3423","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"就这样……","art":{"background":"a3423","sprites":[]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「喂，你又这样了，又只用手的力量在挥了！」","art":{"background":"a1","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「不是说了要把刀当成手臂的延长线吗！」","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是、是！」","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"放学后，我在请外公教我练刀。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「主人！加油！」","art":{"background":"a1","sprites":[{"asset":"a3464","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"旁边是我拿着毛巾和喇叭筒的私人经理。","art":{"background":"a1","sprites":[{"asset":"a3464","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"也就是小雨。","art":{"background":"a1","sprites":[{"asset":"a3464","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「……话说回来，您确定要这样吗，丛雨大人」","art":{"background":"a1","sprites":[{"asset":"a3464","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a569","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「要是想做经理，不如去加入校内的社团吧」","art":{"background":"a1","sprites":[{"asset":"a3110","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a571","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「不是的！本座只是想照顾主人而已！」","art":{"background":"a1","sprites":[{"asset":"a3464","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a571","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「所以根本不需要参加学校社团！」","art":{"background":"a1","sprites":[{"asset":"a3185","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a571","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「行了，玄十郎，本座也会顺便照顾你的，你就好好努力吧！」","art":{"background":"a1","sprites":[{"asset":"a3112","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a571","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「多、多谢……」","art":{"background":"a1","sprites":[{"asset":"a3112","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a570","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"外公的神情很复杂。","art":{"background":"a1","sprites":[{"asset":"a3112","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a570","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"他应该也没想到，自己竟然会在这个年纪忽然得到一个看上去跟孙女一样的经理。","art":{"background":"a1","sprites":[{"asset":"a3112","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a570","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「外公，抱歉把你卷进来了」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我向外公低下头。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「呼，算了」","art":{"background":"a1","sprites":[{"asset":"a3291","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「比起你这样的男丁，我更喜欢可爱的丛雨大人陪在身边」","art":{"background":"a1","sprites":[{"asset":"a573","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「外公，你心态好年轻啊！」","art":{"background":"a1","sprites":[{"asset":"a573","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"对哦。","art":{"background":"a1","sprites":[{"asset":"a573","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"他也是廉太郎的爷爷。","art":{"background":"a1","sprites":[{"asset":"a573","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「好，素振之后是跑步！」","art":{"background":"a1","sprites":[{"asset":"a3465","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「你们俩一起跑到山脚吧！」","art":{"background":"a1","sprites":[{"asset":"a3464","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「被本座超过的人，回头会遭天谴哦」","art":{"background":"a1","sprites":[{"asset":"a3174","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"小雨一只手拿着喇叭筒，跨上了自行车。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「要我们跑过自行车吗？！」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「我也要跟着跑？！」","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「少废话，快走！」","art":{"background":"a1","sprites":[{"asset":"a3112","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a577","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"小雨开开心心地骑着自行车在人行道上飙了起来。","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「不好，得赶紧追上丛雨大人！」","art":{"background":"a1","sprites":[{"asset":"a620","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「将臣，快点！」","art":{"background":"a1","sprites":[{"asset":"a575","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"外公慌慌张张地跑了起来。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「喂，怎么可能追上自行车啊！」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我也追在了外公身后。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"玄十郎","text":"「你想遭天谴吗！」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「外公，小雨已经是普通的女孩子了！」","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「哇哈哈哈！你们俩，赶紧的！」","art":{"background":"a1","sprites":[{"asset":"a3464","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我跟外公慌慌张张地追在小雨身后。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"三个人在人行道上落下三个活蹦乱跳的影子。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"今天的天气也很好。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"不，有点热，热得我会闷出汗。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「玄十郎！主人！」","art":{"background":"a1","sprites":[{"asset":"a3464","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「加油！加油！」","art":{"background":"a1","sprites":[{"asset":"a3466","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"看着小雨愉快的背影，跑在风中的我……","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"感觉到了初夏的香气……","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"感觉到了新的季节即将到来……","art":{"background":"a1","sprites":[]},"chapter":"后日谈"}]