[{"speaker":"","text":"这一轮射精射得我头昏眼花。","art":{"background":"a2683","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"我也是头一回射得这么激烈。","art":{"background":"a2683","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「哈咿、哈、哈啊——哈啊——粘乎乎的……」","art":{"background":"a2683","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「这就是……精液啊……」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"茉子用微微失神的眼睛注视着我射向她的精液。","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「哈啊……哈啊……啊啊啊啊……嗯嗯」","art":{"background":"a2683","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「谢谢你，茉子。真的非常爽」","art":{"background":"a2683","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「我、我也一样……非常舒服……」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「应该说是舒服过头了……没、没错……」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「那今天就别再继续做了吧？」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「……哎哎……难不成你还没有满足吗？」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「不不，我很满足。我只是说我还有余力而已……」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「是、是这样啊……说起来它没有软掉呢……男人还真厉害啊」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「如果你想做的话，我、我也……」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「啊，但是你已经累坏了吧」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"而且这是她的第一次。","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"即便茉子身体再好……还是会出血的。","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「不，今天已经够了」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「你不用顾虑我的……」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「我怎么能不在意呢。你可是我最喜欢的女孩啊」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「而且不用着急。随时都有机会的。毕竟今后我们都会在一起啊」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「……将臣……」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「所以现在……我们俩就好好休息吧」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「……嗯……」","art":{"background":"a2684","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「我回来了——」","art":{"background":"a119","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「我回来了」","art":{"background":"a119","sprites":[]},"chapter":"6-5"},{"speaker":"芳乃","text":"「欢迎回来」","art":{"background":"a348","sprites":[{"asset":"a420","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「欢迎回来，两位」","art":{"background":"a348","sprites":[{"asset":"a130","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a420","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「有发生什么意外状况吗？」","art":{"background":"a348","sprites":[{"asset":"a130","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a420","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「放心吧。什么事都没有」","art":{"background":"a348","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「那就太好了」","art":{"background":"a348","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「那你们呢？那个……你们今天的约会……感觉怎么样？」","art":{"background":"a348","sprites":[{"asset":"a426","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯，非常感谢。我们度过了一段非常有意义的时光」","art":{"background":"a348","sprites":[{"asset":"a426","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a324","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「那就好……咳、咳咳。那么……这、这下应该神清气爽了吧？」","art":{"background":"a348","sprites":[{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a324","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……啊？」","art":{"background":"a348","sprites":[{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a256","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「神、神清气爽？」","art":{"background":"a348","sprites":[{"asset":"a1156","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「啊不不不，没什么啦！这事还是不要在意了！」","art":{"background":"a348","sprites":[{"asset":"a1729","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……嗯？」","art":{"background":"a348","sprites":[{"asset":"a1729","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我说小雨，是不是出了什么事啊？朝武的样子好像有点怪怪的」","art":{"background":"a348","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「……别担心。她这样又不是一天两天了，而且也不是芳乃的问题」","art":{"background":"a348","sprites":[{"asset":"a771","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"到底怎么回事？完全搞不懂什么意思。","art":{"background":"a348","sprites":[{"asset":"a771","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「芳乃，你也真是的，别问那种不解风情的问题」","art":{"background":"a348","sprites":[{"asset":"a204","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a424","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「可、可是啊，这个问题跟我的睡眠质量有很大的关系……」","art":{"background":"a348","sprites":[{"asset":"a204","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「你仔细看。茉子现在穿的衣服已经不是出去时穿的那套了」","art":{"background":"a348","sprites":[{"asset":"a1309","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「……啊」","art":{"background":"a348","sprites":[{"asset":"a1309","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「现在明白了吧，所以说不要多问」","art":{"background":"a348","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子・将臣","text":"「～～～～～～」\n「………………」","art":{"background":"a348","sprites":[{"asset":"a2351","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「原、原来如此。我真是粗心大意……」","art":{"background":"a348","sprites":[{"asset":"a1727","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「哈啊……这样的话，看来从今天开始我能好好睡觉了……太好了」","art":{"background":"a348","sprites":[{"asset":"a430","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「本座倒是觉得，你们就别顾虑那么多了，干脆一起睡同一间房就好了啊」","art":{"background":"a348","sprites":[{"asset":"a1353","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「这、这可不行啊」","art":{"background":"a348","sprites":[{"asset":"a1473","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2397","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「你们明明是情侣啊，为什么不行？」","art":{"background":"a348","sprites":[{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2397","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「因为住同一间房的话……我可能会控制不住自己……我开玩笑的，哈哈」","art":{"background":"a348","sprites":[{"asset":"a2348","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我也同意她的意见。","art":{"background":"a348","sprites":[{"asset":"a2348","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"如果茉子毫无防备地睡在我身边的话……我确实会忍不住动手动脚的。","art":{"background":"a348","sprites":[{"asset":"a2348","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「瞧瞧你们……多么幸福的烦恼啊」","art":{"background":"a348","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「好吧，那这事就作罢……茉子，跟你说点正事」","art":{"background":"a348","sprites":[{"asset":"a141","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「啊，是。请问是什么事呢？」","art":{"background":"a348","sprites":[{"asset":"a141","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a791","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「身体方面有什么异常吗？」","art":{"background":"a348","sprites":[{"asset":"a312","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a791","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「哎！？这个嘛，其实还蛮疼的，到现在还会隐隐作痛……不过感觉很幸福，身体也没问题」","art":{"background":"a348","sprites":[{"asset":"a312","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2348","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「谁问你这个了啊！」","art":{"background":"a348","sprites":[{"asset":"a1120","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「本座都说了是正事啊！就是指附在你身上的兽灵的事！」","art":{"background":"a348","sprites":[{"asset":"a414","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「是、是那件事吗……讨厌，我居然产生了这么羞耻的误会……」","art":{"background":"a348","sprites":[{"asset":"a2313","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「真是的……那么状况到底如何？」","art":{"background":"a348","sprites":[{"asset":"a205","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2313","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「关于那个的话，并没有什么特别的变化，也没有变成狗」","art":{"background":"a348","sprites":[{"asset":"a205","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a332","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「兽灵有没有满足的迹象？」","art":{"background":"a348","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a332","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「那种迹象……也没有」","art":{"background":"a348","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2101","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「不过没问题的。我们处得挺好的」","art":{"background":"a348","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「处得挺好？」","art":{"background":"a348","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「我们会在梦里对话……还会通过共享我的感情让它加深对恋爱的理解」","art":{"background":"a348","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「……」","art":{"background":"a348","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……嗯？小雨？」","art":{"background":"a348","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「没事，别在意。是本座想多了」","art":{"background":"a348","sprites":[{"asset":"a551","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a348","sprites":[{"asset":"a551","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我说啊，小雨」","art":{"background":"a360","sprites":[{"asset":"a207","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「嗯？怎么了？」","art":{"background":"a360","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「关于晚餐前说的事……就是茉子和兽灵共享感情的那件事，你看上去好像很在意」","art":{"background":"a360","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「当时你没有继续说下去，是有什么问题吗？」","art":{"background":"a360","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「你说那件事啊……正如当时所说，那只是本座担心过头了而已」","art":{"background":"a360","sprites":[{"asset":"a213","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"小雨说完，便结束了这个话题。","art":{"background":"a360","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a360","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"到底怎么了？是有什么让她在意的情况吗？","art":{"background":"a360","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"不过也对。茉子说会跟兽灵共享感情……这岂会不让人在意。","art":{"background":"a360","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"跟兽灵共享感情……","art":{"background":"a360","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"嗯？等等……真的能做到“只共享恋爱的感情”吗？","art":{"background":"a360","sprites":[]},"chapter":"6-5"},{"speaker":"野兽","text":"『我明白了』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「什么？怎么突然说这个？」","art":{"background":"a120","sprites":[{"asset":"a323","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『你跟我共享情感之后，我已经弄明白了』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a323","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「真、真的吗！？也就是说你满足了吗！？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a330","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『我弄明白的是，我终究无法理解人类的想法』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a330","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……是、是吗……那你只能再多跟我待一段时间了」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a334","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「反正最近也不会变成狗，只要不变狗我就没意见，你再多待一段时间也无妨」","art":{"background":"a120","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『我会遵守约定』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「但是我的感情……有这么难懂吗？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a791","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『那我问你，体验了那样的剧痛之后，你为什么还能感到幸福？』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a791","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「剧痛是指……啊、你、你是指今天的事吗！？连那种感觉都会共享吗……」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a2396","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『那是当然』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a2396","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「哈哈……真是太难为情了……」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a2320","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『所以，你是会因为疼痛而感到兴奋的类型吗？』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a2320","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「怎么可能！那只是因为……幸福远远盖过了疼痛而已」","art":{"background":"a120","sprites":[{"asset":"a279","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「因为我用全身感受到了所爱之人的温暖」","art":{"background":"a120","sprites":[{"asset":"a326","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『所爱之人的温暖……』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『那个男人有什么值得你如此中意？』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「有什么……有什么……这个……老实说，你若要问我明确的理由，我也答不上来」","art":{"background":"a120","sprites":[{"asset":"a334","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『……你真的喜欢那个男人吗？』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a628","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「喜欢。我唯独对这一点是很有自信的」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a249","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『为什么？』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a249","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「我认为这世上人无完人。无论你多么喜欢对方，对方身上总会有些地方让你难以接受」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a913","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「有时可能会因为某些小小的误会而吵起架来。有时甚至还会像今天这样感受到痛楚」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a2344","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「但即便如此……我也想跟他在一起。而他也是这么想的，所以才会为了陪在我身边而努力」","art":{"background":"a120","sprites":[{"asset":"a330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「正因为我们愿意相互磨合，而且在一起时能够感受到幸福……所以我们才会把对方当成特别的人」","art":{"background":"a120","sprites":[{"asset":"a250","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『……』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「对我来说……将臣就是那种非常特别的存在。就是这样……哈哈」","art":{"background":"a120","sprites":[{"asset":"a2348","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『……想在一起……特别的人……好吧』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『确实，你跟那个男人在一起时，内心就会很有安全感』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2626","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「那种感觉……你应该也是明白的，不是吗？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2618","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『……』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2618","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『嘁……我都说了让你忘掉了』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「对不起。但是想忘掉可不是那么容易的，毕竟是那么美好的回忆」","art":{"background":"a120","sprites":[{"asset":"a281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『别擅自下定论。我跟她并不是你想的那样』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a628","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「是这样吗？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a791","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『……哼』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a791","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『不过，也是……跟你共享了感情之后，我也想起了一些过去的事』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『虽然彼此争吵过……但只是待在一起，日子就过得很开心』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……哈哈」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a325","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『怎么了？』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a325","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「没什么，我只是觉得你的声音好像都变柔和了，看来她对你来说真的是一位十分重要的人」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a284","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『嘁……真是的，不想被人看见的东西都被你看见了』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a284","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「顺便问一下，你和那位曾经在哪里，度过了怎样的时光呢？」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a630","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『你问这个做什么？』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a630","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「如果我去了那片回忆之地，我想你应该会更加了解恋爱」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a291","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『你还真喜欢多管闲事』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a291","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「如果真的不是我说的那样，你也没必要对她如此上心吧」","art":{"background":"a120","sprites":[{"asset":"a1388","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255},{"asset":"a1043","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「你这么刻意地否定，也就意味着我没说错吧……？」","art":{"background":"a120","sprites":[{"asset":"a566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『真是不值一驳……』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":0.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"野兽","text":"『也罢。被你取笑实在是让我气不打一出来！既然你这么想刺激我，那就随你吧，哼！』","art":{"background":"a120","sprites":[{"asset":"a1388","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"6-5"}]