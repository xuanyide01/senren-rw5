[{"speaker":"将臣","text":"「哈！！！！！！！！！！！」","art":{"background":"a469","sprites":[{"asset":"a271","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「呃！？」","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"我挥下的刀尖掠过了祟神，但是这一击不至于将其祓除，反倒是一阵沉重的冲击感向我袭来。","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"手腕很痛。我似乎是被击打到了附近的树干上。","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「（不妙——）」","art":{"background":"a469","sprites":[{"asset":"a271","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-1"},{"speaker":"茉子","text":"「危险！」","art":{"background":"a469","sprites":[{"asset":"a470","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a271","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"袭来的一击被常陆拨开，朝武趁机绕到后方，冲了上去。","art":{"background":"a393","sprites":[]},"chapter":"2-1"},{"speaker":"芳乃","text":"「呀！！！！！！！」","art":{"background":"a469","sprites":[{"asset":"a391","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"鉾铃刺入了那如同污泥一般的身躯后，它才终于崩解消散。","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"上次祓禊已是一个多星期前的事。这是我第二次参与祓禊。","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"这次的行动直到结束我们也没有拌嘴，一切都很顺利。","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「（要是没有常陆在，我可能就会受伤了）」","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"茉子","text":"「辛苦您了，芳乃大人」","art":{"background":"a469","sprites":[{"asset":"a349","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"芳乃","text":"「茉子，你也辛苦了」","art":{"background":"a469","sprites":[{"asset":"a471","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a349","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"芳乃","text":"「有地……你也辛苦了」","art":{"background":"a469","sprites":[{"asset":"a413","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「啊，嗯。你们也辛苦了」","art":{"background":"a469","sprites":[{"asset":"a413","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"可能是由于刚才中了那奇怪的一招。","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"我的手腕现在有些隐隐作痛。","art":{"background":"a469","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「啊……」","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"回到房间后我重新确认了一下手腕上传来的感觉。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"如果手腕弯的角度太大就会有点痛。不过这应该不会影响日常生活。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"丛雨","text":"「手腕没事吗？」","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「被你发现了啊」","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「你挥刀的动作都走形了，肯定会弄疼手腕」","art":{"background":"a360","sprites":[{"asset":"a144","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「虽说斩击并不需要技术，但是斩击前后的动作还是得靠主人自己练好才行」","art":{"background":"a360","sprites":[{"asset":"a144","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「要是丛雨丸能更加轻松地斩断任何东西，就不会有这种事了」","art":{"background":"a360","sprites":[{"asset":"a144","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"当初弄破了朝武的衣服，只是由于一些灵力方面的影响罢了。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"这把刀在斩切现实物质的时候并没有那么锐利。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「……难不成这是一把钝刀？」","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"丛雨","text":"「才不是呢，怎么可能是钝刀呢？请不要把责任推给丛雨丸好吗」","art":{"background":"a360","sprites":[{"asset":"a144","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"不过对于刀法不好的我来说，拿一把锋利无比的刀挥来挥去确实危险，可能还是钝一点比较好。","art":{"background":"a360","sprites":[{"asset":"a144","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「可丛雨丸一开始是插在石头里的吧？」","art":{"background":"a360","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「那并不是物理意义上的插入」","art":{"background":"a360","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「丛雨丸乃神刀，专斩不属于这个世界的东西！与现实中的锋利度没有任何关系！」","art":{"background":"a360","sprites":[{"asset":"a144","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「说是“神刀”，但在我看来它更像一把“妖刀”啊」","art":{"background":"a360","sprites":[{"asset":"a144","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「什么，真是失礼！它哪里像“妖刀”了！」","art":{"background":"a360","sprites":[{"asset":"a267","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「成为这把刀的主人之后我就被奇怪的东西附体了啊……」","art":{"background":"a360","sprites":[{"asset":"a267","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「本座不是妖怪，更不是幽灵！你这种说法实在令人失望！」","art":{"background":"a360","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「那你觉得“幼刀”一词如何？啊，“幼刀”是不是正好合适啊？」","art":{"background":"a360","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「这是侮辱！主人，你这是在侮辱本座！」","art":{"background":"a360","sprites":[{"asset":"a472","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"毕竟当时那硬硬的手感始终挥之不去……","art":{"background":"a360","sprites":[{"asset":"a472","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「你是不是正在想什么让人很不爽的事情？」","art":{"background":"a360","sprites":[{"asset":"a363","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a360","sprites":[{"asset":"a363","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「都不敢看本座的眼睛了」","art":{"background":"a360","sprites":[{"asset":"a288","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「反、反正，我已经深刻认识到我的刀法有多烂了」","art":{"background":"a360","sprites":[{"asset":"a288","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"首先我必须要确保可以安全完成祓禊。","art":{"background":"a360","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"不然还没等到解开诅咒就已经命丧黄泉了……就算不至于丧命，也会身负重伤。","art":{"background":"a360","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「朝武说过她要自己应对祸祟，但她有什么具体方法吗？」","art":{"background":"a360","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「这个嘛……你是想要本座实话实说，还是委婉一点？」","art":{"background":"a360","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「听你这句话我差不多能猜到了」","art":{"background":"a360","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"祓除污秽实际上就是一种权宜之计。","art":{"background":"a360","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"要是有根除诅咒的方法，那她们早就那么做了。","art":{"background":"a360","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「现在本座只知道两件事，一是祟神会攻击朝武家的人」","art":{"background":"a360","sprites":[{"asset":"a186","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「二是尽管可以祓除祟神的污秽，但它会不断地死灰复燃」","art":{"background":"a360","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「数百年来都是这样？」","art":{"background":"a360","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「诅咒这东西可以持续这么久吗？」","art":{"background":"a360","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「各有差异。很深重的怨恨或遗愿八成都会存留很久」","art":{"background":"a360","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「哪怕施咒者已故……不，有时正是因为没有人可以控制诅咒，所以它才会失去控制」","art":{"background":"a360","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「是这样吗」","art":{"background":"a360","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「但再怎么说，持续数百年也确实太久了」","art":{"background":"a360","sprites":[{"asset":"a141","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「而且穗织的土地上涌出的温泉可以洗去污秽。那是土地神为此馈赠给我们的恩赐」","art":{"background":"a360","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「也就是说，诅咒不衰定有其因啊」","art":{"background":"a360","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「事出有因，则说明诅咒定有解法」","art":{"background":"a360","sprites":[{"asset":"a144","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「但现在我们无计可施。就算想寻找其中的缘由，也是毫无头绪」","art":{"background":"a360","sprites":[{"asset":"a185","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「也就是说…………」","art":{"background":"a360","sprites":[{"asset":"a185","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「不，还是算了」","art":{"background":"a360","sprites":[{"asset":"a185","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"如果这份怨念针对的是驱魔之人，那么朝武家族就有可能一直被袭击……？","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"想了想还是没能说出口。毕竟那种情况太令人绝望了。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"但是大家依然没有放弃，因为大家都在摸索着其他可能性。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"事到如今想必也不需要我说三道四了。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"而且我也愿意相信有解除诅咒的方法。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「总之必须把自己的生命安全放在首位」","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「得想个办法才行。不过今天——」","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「啊，呼……困了」","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"可能是因为没了紧张感，一股疲劳与倦意一下子就涌了上来。","art":{"background":"a360","sprites":[]},"chapter":"2-1"},{"speaker":"丛雨","text":"「主人，等一下。要先入浴再入寝」","art":{"background":"a360","sprites":[{"asset":"a384","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「说的也是，不洗澡的话就发臭了。毕竟出了一身汗」","art":{"background":"a360","sprites":[{"asset":"a384","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「这也是一方面，但主要还是因为主人和祟神接触过，身上已经积累了污秽」","art":{"background":"a360","sprites":[{"asset":"a141","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「穗织的温泉有洗去污秽、净化身体的能力」","art":{"background":"a360","sprites":[{"asset":"a384","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「难怪会被称为奇迹之泉」","art":{"background":"a360","sprites":[{"asset":"a384","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「各种疗养效果其实只是净化的副产物」","art":{"background":"a360","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"将臣","text":"「是吗……那我得注意下了，可不能直接睡着了」","art":{"background":"a360","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"于是我决定洗净身体后再睡。不过……","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「呼……真舒服……」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"这个浴室真是有够大的。都快跟旅馆的浴堂差不多了。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"除了收费的澡堂之外，我还是第一次见装了两个淋浴喷头的浴室。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"可能是为了让常陆家的人能够一起入浴？","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"丛雨","text":"「净化污秽绝非小事，浴室的规格自然也马虎不得」","art":{"background":"a360","sprites":[{"asset":"a226","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"丛雨","text":"「——很久以前，某位爱洗澡的巫女以此为借口强硬地把浴室给造成这样了」","art":{"background":"a360","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-1"},{"speaker":"","text":"找这么个借口就把浴室造成这样……","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"而且竟然把温泉引入私人住宅，他们家是真的很不一般啊。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"虽然我还想再多泡几次这样舒服奢侈的温泉……但这样一来要洗的衣服就变多了。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「先不说毛巾，要让待洗衣物增加我是不情愿的……」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"每次洗澡时我都是自己洗自己的衣服。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"有时候是一边洗澡一边洗衣，有时候是堆积到几天后一起洗。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"所以待洗衣物变多对我来说可是件麻烦事。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「反正我都要在这里暂住一段时间了」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「以后还有的是机会用这个浴室」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"现在我更应该关心的是——","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「要是能和她关系再好一点就好了」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"感觉和一开始比起来……似乎是好了一点。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"厚蛋烧那事也没留下什么负面影响。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"虽然最终也没能达成共识。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"但我们就算没那么亲近，至少也应该到了熟人程度了。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「如果可以的话……要是能再朝着普通朋友的方向发展一下就好了」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「唔……」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"我一边想着，一边洗净了头和身子。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"这时，更衣室那边突然从传来一阵响动。","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"","text":"是我的错觉？不对，好像确实有人在那……！","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"安晴","text":"「啊，将臣。原来你在里边啊，不好意思我都没注意到」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「呀——！安晴叔叔你这个色狼——！」","art":{"background":"a473","sprites":[]},"chapter":"2-1"},{"speaker":"将臣","text":"「不对，我期待的才不是这种剧情！」","art":{"background":"a119","sprites":[]},"chapter":"2-1"}]