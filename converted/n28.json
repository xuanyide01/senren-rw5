[{"speaker":"丛雨","text":"「主人，主——人——」","art":{"background":"a0","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a0","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「赶紧起来，主人」","art":{"background":"a0","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「啊噗！？」","art":{"background":"a126","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「你、你……别在人睡觉的时候坐肚子上，内脏都要被你坐出来了……」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「我都以为要被你弄死了」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「是主人你自己说，让本座“一定”要在这个时间叫醒你的，不是吗？」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「我确实是这么说过，也很感谢你叫我起来……但是希望你稍微考虑一下叫醒人的方法」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「你以为本座叫了你多少次了？但是你一直不起来，没办法只好用最后手段了」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「还是说，本座就不应该叫醒你？」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「不，没那回事。非常感谢，感激不尽」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「不过以后千万别坐肚子了……差点在起床时吐一地」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「那就争取自己起来，别依赖本座」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「我努力」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"不过我实在没信心能做到……","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「好了好了，主人，还不快从被窝里出来」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「喂，我说，别这样，很疼的」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"压在我肚子上的小雨前后移动着身体，催促着我起床。","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「——唔！？」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"从刚才起，就能感觉到某种柔软之物在我肚子上来来回回。","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「（……虽然胸部很寒酸，屁股倒是有着女孩子特有的柔软……）」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「（区区幼刀，屁股竟然软得这么让人恼火）」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「难得早起，再睡个回笼觉岂不是毫无意义了」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「我、我知道」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"怎么说呢……似乎一旦认同了幼刀的女性魅力，就等同于自己认输。","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"但是年轻男性早上会出现无法抑制的生理现象……","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"唯独这个绝对不能被她发现！","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「我说啊，你这样骑在我身上，我想起也起来不来啊」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"我们大清早就吵吵闹闹的，结果……","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"茉子","text":"「有地？丛雨大人？发生什么事了吗？我听你们吵了半天了……」","art":{"background":"a562","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「主人明明让本座叫醒他，却又迟迟不起」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"茉子","text":"「是吗？那么我也来助你一臂之力吧」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「哎？不不不，我起来了我起来了！我已经起来了，不能进来——」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"茉子","text":"「打扰了」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"茉子","text":"「非常抱歉。我什么都没看见。请二位继续」","art":{"background":"a563","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「怎么，莫不成主人对本座产生了情欲？」","art":{"background":"a564","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「嘴上说着什么“幼刀”什么“搓衣板”……可终究还是个年轻小男生嘛」","art":{"background":"a564","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「不——是——的！这是早上起床时常见的生理现象」","art":{"background":"a564","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「拜托了，请听我解释！」","art":{"background":"a564","sprites":[]},"chapter":"2-3"},{"speaker":"茉子","text":"「原来如此。方才的情色……啊，不，情况我已经知道了」","art":{"background":"a211","sprites":[{"asset":"a565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「你这是故意说错的吧？」","art":{"background":"a211","sprites":[{"asset":"a565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"茉子","text":"「哪里哪里，不过是稍稍咬到了舌头而已」","art":{"background":"a211","sprites":[{"asset":"a566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「我真的没有那方面的兴趣」","art":{"background":"a211","sprites":[{"asset":"a566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「事先声明，比起搓衣板，我更喜欢哈密瓜」","art":{"background":"a211","sprites":[{"asset":"a566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"茉子","text":"「可就算你昂首挺胸地暴露自己的性癖……」","art":{"background":"a211","sprites":[{"asset":"a567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"丛雨","text":"「还想不想要自己的小命了，主人」","art":{"background":"a211","sprites":[{"asset":"a568","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"茉子","text":"「先不说这了，你起这么早是要去哪？」","art":{"background":"a211","sprites":[{"asset":"a289","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「这个嘛……啊……」","art":{"background":"a211","sprites":[{"asset":"a289","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「就是那个，这里风景很怡人嘛，就让人想要赏赏清晨的景色」","art":{"background":"a211","sprites":[{"asset":"a289","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「所以接下来打算去散散步」","art":{"background":"a211","sprites":[{"asset":"a289","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"茉子","text":"「是吗，那要不我提前给你准备下早饭？」","art":{"background":"a211","sprites":[{"asset":"a322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「早饭还是老时间就行了，我先出门了」","art":{"background":"a211","sprites":[{"asset":"a322","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"我走出朝武家，开始用适当的速度慢跑。","art":{"background":"a493","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「……呼……呼……呼……呼」","art":{"background":"a493","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"我喘着粗气，向着坡道上方跑着。","art":{"background":"a493","sprites":[]},"chapter":"2-3"},{"speaker":"丛雨","text":"「刚才的借口是否过于勉强了，主人」","art":{"background":"a493","sprites":[{"asset":"a207","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「没办法啊，我想不到其他借口了」","art":{"background":"a493","sprites":[{"asset":"a207","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"丛雨","text":"「老老实实说出来又有何妨」","art":{"background":"a493","sprites":[{"asset":"a138","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「说出来的话，说不定会让朝武觉得愧疚」","art":{"background":"a493","sprites":[{"asset":"a138","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「而且我并不喜欢吹嘘自己的努力，觉得那样太俗气了」","art":{"background":"a493","sprites":[{"asset":"a207","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"丛雨","text":"「你又来了。有志气是好事，但凡事都要有个限度。要是脑筋太死板，就变成不解风情了」","art":{"background":"a493","sprites":[{"asset":"a134","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「我做锻炼又不是为了耍帅」","art":{"background":"a493","sprites":[{"asset":"a134","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「这都是为了自己，为了防止自己受伤」","art":{"background":"a493","sprites":[{"asset":"a134","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「准时过来了啊」","art":{"background":"a498","sprites":[{"asset":"a569","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「毕竟是我自己要拜托你的」","art":{"background":"a498","sprites":[{"asset":"a569","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「看来你这次是认真的。这着实让我吃了一惊」","art":{"background":"a498","sprites":[{"asset":"a570","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「我也吃惊。没想到会被误会成那种意思……」","art":{"background":"a498","sprites":[{"asset":"a570","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「怎么说来着，在年轻人里，不是在流行什么“逼艾鸥”吗？」","art":{"background":"a498","sprites":[{"asset":"a571","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「只是在“部分女性”中流行而已！」","art":{"background":"a498","sprites":[{"asset":"a571","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"丛雨","text":"「喔，男色在这个时代原来叫做逼艾鸥，本座懂了」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「（不用去记这种东西！）」","art":{"background":"a498","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「而且，你怎么会知道这种词？」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「要经营好旅社旅馆，就得多了解社会。特别是要了解年轻人的、外国人的文化」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「如果什么都不知道，就不好应对客人的投诉」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「在了解的过程中，就得知年轻人里流行逼艾鸥，莫非是我弄错了？」","art":{"background":"a498","sprites":[{"asset":"a571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「呃这个……这确实是在很少很少的一部分人群里流行……」","art":{"background":"a498","sprites":[{"asset":"a571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「但是旅馆的老板是不需要这种知识的！也不可能因为ＢＬ出现什么投诉！」","art":{"background":"a498","sprites":[{"asset":"a571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「这样啊。我这把年纪是完全无法理解，不需要的话那就再好不过了」","art":{"background":"a498","sprites":[{"asset":"a573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「不过在另一层意义上我同样吃了一惊。没想到你会低头求我锻炼你」","art":{"background":"a498","sprites":[{"asset":"a573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「我一直以为你练剑道时都很不情愿……」","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"完全被他看穿了。","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"没错，以前我都是很不情愿地听外公的话去练。","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"凭借那时候积累的经验，好歹是撑到了现在。","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"但是我马上就要支撑不住了。","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「因为我自己下定了决心，要帮上忙」","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「所以现在这样是不行的」","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"我不能让自己受伤，也不想让她受伤。为了达成这个目标，我缺少太多的东西了。","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"而且……我自己什么都不做，和每天练习神乐舞的朝武一比，就会觉得很羞愧。","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「将臣……我说句不中听的话，这真是你仔细思考后决定的吗？」","art":{"background":"a498","sprites":[{"asset":"a575","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「你是说，我只是一时兴起、只是受他人影响一时冲动？」","art":{"background":"a498","sprites":[{"asset":"a575","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「一时兴起也好受他人影响也罢，什么原因都无所谓，都不是问题」","art":{"background":"a498","sprites":[{"asset":"a569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「我想要强调的是，这件事没办法中途放弃，你要做就只能做到最后」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「说实话，你能主动跟我提起，我很高兴。但是……」","art":{"background":"a498","sprites":[{"asset":"a574","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「我听说那个是非常危险的东西」","art":{"background":"a498","sprites":[{"asset":"a576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「外公，我能理解你的担心」","art":{"background":"a498","sprites":[{"asset":"a576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「说实话，最开始我说要帮忙的时候，确实是因面子上过不去」","art":{"background":"a498","sprites":[{"asset":"a576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「但是现在想让你训练我，绝不是为了面子。为了能继续帮助朝武，我必须这么做」","art":{"background":"a498","sprites":[{"asset":"a576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「如果你担心我，那么我希望你能好好锻炼我，好让我今后也能平安无事」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「……我知道了」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「但是啊，将臣。就算是重新开始锻炼了，也不代表一下子就能变强」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「特别是对手并非人类，不知道会发生什么事情，骄傲必会吃大亏」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「首先要铭记这一点」","art":{"background":"a498","sprites":[{"asset":"a575","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「这我也清楚。总之我想把身体重新锻炼一下，感觉自己已经忘记怎么使用自己的身体了」","art":{"background":"a498","sprites":[{"asset":"a575","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「要锻炼体力，也要锻炼肌肉。我不仅要在山里来回奔波，而且丛雨丸也比竹刀要重得多」","art":{"background":"a498","sprites":[{"asset":"a575","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「以此为目的的话倒是无妨。那么这就开始吧」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「准备运动做了吗？」","art":{"background":"a498","sprites":[{"asset":"a571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「已经做过了。我是跑着过来的，身体还暖和着」","art":{"background":"a498","sprites":[{"asset":"a571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「可是……为什么要来学校？」","art":{"background":"a498","sprites":[{"asset":"a571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「总不能在游客面前挥动竹刀吧，而且现在也没有道场了」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「按理说最好是使用公民馆，可这么早那边还没开门」","art":{"background":"a498","sprites":[{"asset":"a569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「要找个能够锻炼的宽敞地方，我也只能想到这里了」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「有什么问题吗？」","art":{"background":"a498","sprites":[{"asset":"a571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「不，能避开别人的耳目也正合我意」","art":{"background":"a498","sprites":[{"asset":"a571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「那么首先从素振开始！」","art":{"background":"a498","sprites":[{"asset":"a575","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「请多多指教！」","art":{"background":"a498","sprites":[{"asset":"a575","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「开始」","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「是！」","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"做完了几项锻炼，今天的最后一个项目就是和外公实战。","art":{"background":"a498","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"他严肃的目光唤醒了我儿时的记忆，这让我不禁蜷缩起了身体。","art":{"background":"a498","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"紧张的气氛就像针一样扎着我的皮肤。","art":{"background":"a498","sprites":[]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「……」","art":{"background":"a498","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"外公为什么显得如此高大？","art":{"background":"a498","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"我和外公并没有多大的身高差，反而是我正直年少，肌肉的力量理应更胜一筹。","art":{"background":"a498","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"但现在，我却觉得自己无比地渺小。","art":{"background":"a498","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"自己就像是被毒蛇盯上的青蛙一般，绝不敢轻举妄动。","art":{"background":"a498","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"为了消除这无形的压力，我大声一喝，为自己鼓劲。","art":{"background":"a498","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「呀啊」","art":{"background":"a498","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"与此同时，外公也是一吼。","art":{"background":"a498","sprites":[]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「嘿啊！」","art":{"background":"a157","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「（到底如何才能发出这种声音啊！？）」","art":{"background":"a157","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"那吼声完全覆盖了我的声音，让我不禁畏缩起来。","art":{"background":"a157","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"趁此机会，外公冲到我近身处，将竹刀从我头上劈下。","art":{"background":"a157","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「唔！？」","art":{"background":"a126","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"就在脑门即将被打中的一瞬间，竹刀稳稳地停了下来，只感到一丝风压拂过额头。","art":{"background":"a498","sprites":[]},"chapter":"2-3"},{"speaker":"将臣","text":"「……呼……呼……」","art":{"background":"a498","sprites":[]},"chapter":"2-3"},{"speaker":"","text":"到底是什么样的肌肉……才能做出如此完美的寸止？他真的已经年入古稀了？","art":{"background":"a498","sprites":[]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「今天就到此为止吧」","art":{"background":"a498","sprites":[{"asset":"a573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「非常……感谢……呼、呼……」","art":{"background":"a498","sprites":[{"asset":"a573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"丛雨","text":"「一次像样的攻击都没打出来啊，主人」","art":{"background":"a498","sprites":[{"asset":"a261","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「实力差距太大了」","art":{"background":"a498","sprites":[{"asset":"a261","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"在３分钟的指导比试中，有效攻击全都是外公的寸止。","art":{"background":"a498","sprites":[{"asset":"a261","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「还是……完全不行……根本比不过」","art":{"background":"a498","sprites":[{"asset":"a261","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a573","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「那当然了。我每天都在训练，哪能输给半途而废的你」","art":{"background":"a498","sprites":[{"asset":"a569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「首先，你的反应太慢了。你刚才试图用眼睛看清我的剑吧？」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「我知道靠眼睛去看是没用的，但实在是无法找回以前的手感」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「我还以为你能再像样一点……看样子你是真的好几年没碰竹刀了」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「这个……对不起……」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「基础固然关键，但也必须加强锻炼体力和身体。要设计个适合你的训练计划……」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「只在早上锻炼一个小时根本没用，将臣，放学后你有空吗？」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「我先问一下……放学后是做什么锻炼？」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「我想想……」","art":{"background":"a498","sprites":[{"asset":"a576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「早上就专门锻炼体能，拿竹刀的锻炼就全放在放学后吧」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「步伐、素振、击面、切返、挂稽古……每项练一个小时，加起来要认真练上四到五个小时」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"这是要杀了我吗！？","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「你有意见？」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「也不是有意见……」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"一旦松懈，就会吃到外公毫不留情的竹刀……","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"不行，不能继续抱着这种半吊子的态度！","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「好吧，放学后也拜托了」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「你真的想好了？」","art":{"background":"a498","sprites":[{"asset":"a569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「不要用这种威胁的语气确认啊……会动摇我的决心的」","art":{"background":"a498","sprites":[{"asset":"a569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「如果这样就让你动摇了，那你最好再好好想想」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「……我、我知道了」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"不能像对待社团活动那样对待现在的锻炼。","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"我要做的可不是体育运动。","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「拜托你了！」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「嗯，回应得不错」","art":{"background":"a498","sprites":[{"asset":"a578","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"","text":"就这样，我用强有力的声音回应了外公，于是放学后也要开始锻炼了。","art":{"background":"a498","sprites":[{"asset":"a578","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「啊，但是……一上来就要做这么大的量，身体会吃不消的，如果能考虑下这点……就再好不过了」","art":{"background":"a498","sprites":[{"asset":"a578","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「行，放心，对自己外孙，我一开始肯定会留情的」","art":{"background":"a498","sprites":[{"asset":"a573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"将臣","text":"「是吗，太好了」","art":{"background":"a498","sprites":[{"asset":"a573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「那么放学后见」","art":{"background":"a498","sprites":[{"asset":"a579","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「别歇着！继续打过来！离休息还早着呢！你要不过来我就要上了！」","art":{"background":"a580","sprites":[]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「挥得这么乱，根本无法攻破对方的防御！要这样！」","art":{"background":"a580","sprites":[]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「怎么了？只会磨嘴皮子？就不能再多使点劲儿在剑上？这个样子马上就会被反击！就像这样！」","art":{"background":"a580","sprites":[]},"chapter":"2-3"},{"speaker":"玄十郎","text":"「呀啊啊啊啊啊啊啊啊啊啊！」","art":{"background":"a580","sprites":[]},"chapter":"2-3"}]