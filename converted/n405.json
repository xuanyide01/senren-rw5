[{"speaker":"将臣","text":"「但毕竟还要上学，总不能跑出去玩」","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「我还想抽一些时间来学习」","art":{"background":"a493","sprites":[{"asset":"a1211","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"说的也是。","art":{"background":"a493","sprites":[{"asset":"a1211","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"蕾娜昨晚一直在研究那本古书，研究到很晚才睡。","art":{"background":"a493","sprites":[{"asset":"a1211","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「好不容易有一天自由时间……我还挺想跟你好好亲热亲热的」","art":{"background":"a493","sprites":[{"asset":"a1224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「哈哈，还是等正事办完之后再说吧」","art":{"background":"a493","sprites":[{"asset":"a1224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「当务之急是解除诅咒，为一切画上一个完美的句号」","art":{"background":"a493","sprites":[{"asset":"a1224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「这样我们才能毫无顾虑地在一起做想做的事」","art":{"background":"a493","sprites":[{"asset":"a1224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「嗯……嘿嘿，说的也是」","art":{"background":"a493","sprites":[{"asset":"a3632","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「那我就去学习啦，先失陪一会儿」","art":{"background":"a493","sprites":[{"asset":"a3630","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「有什么我能帮忙的就尽管说」","art":{"background":"a493","sprites":[{"asset":"a3630","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"昨晚我也是跟蕾娜一起睡的，但是并没有进入那个梦境。","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"驹川大夫和小雨都说，如果想看梦境的后续，恐怕得等到宿体复原之后。","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"美津叶","text":"『宿体分裂成许多个碎片之后，宿体中的记忆可能也碎得七零八落了』","art":{"background":"a120","sprites":[{"asset":"a545","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"美津叶","text":"『只要宿体能够复原，其中的记忆或许也就能完整地再现了』","art":{"background":"a120","sprites":[{"asset":"a547","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"丛雨","text":"『也就是说，剩下的记忆可能并不是在蕾娜的那块碎片里，而是在主人那里』","art":{"background":"a120","sprites":[{"asset":"a1299","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"重要的信息应该已经全部获取到了。","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"无论我们的猜想是对的还是错的，我们要做的事也不会有什么变化。","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"将臣","text":"「也就是说，目前不用做什么特别的事，跟平常一样就行了」","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「是呀！所以……将臣」","art":{"background":"a493","sprites":[{"asset":"a697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"蕾娜靠了过来，紧紧地挽住了我的胳膊。","art":{"background":"a493","sprites":[{"asset":"a695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「哎……哎？跟平常一样的话，不是只用牵手就行了吗？」","art":{"background":"a493","sprites":[{"asset":"a695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「到了学校之后，我得专心学习」","art":{"background":"a493","sprites":[{"asset":"a1233","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「所以，到学校之前，我想再多感受下你的体温……不行吗？」","art":{"background":"a493","sprites":[{"asset":"a3961","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「怎么会不行呢，就、就是有点不好走路」","art":{"background":"a493","sprites":[{"asset":"a3961","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「慢慢走就行啦。反正学校也不会逃走」","art":{"background":"a493","sprites":[{"asset":"a903","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"也罢，这点小事不算什么。","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"明天，蕾娜就要去执行最重要的任务了。","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"所以今天就满足下她的小心愿吧。","art":{"background":"a493","sprites":[]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「怎么了，今天巫女大人她们都请假了吗？」","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「嗯，她们家里有点事」","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"到了中午，廉太郎来到了我的座位上。","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"今天大家都留在神社，忙着做最后的准备。","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"毕竟昨天说好了把接下来的准备都交给她们，所以我也不好多问，到现在都完全不知道她们在干什么。","art":{"background":"a599","sprites":[{"asset":"a518","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「之前你跟蕾娜也早退了」","art":{"background":"a599","sprites":[{"asset":"a740","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「而且蕾娜现在还在读一本看上去超难的书」","art":{"background":"a599","sprites":[{"asset":"a513","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「唔～～～～这里是这样，所以那里就是这个意思，唔……」","art":{"background":"a599","sprites":[{"asset":"a3644","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「她刚才还去找古文老师问问题了吧」","art":{"background":"a599","sprites":[{"asset":"a745","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「好像是的」","art":{"background":"a599","sprites":[{"asset":"a745","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"我一边说着，一边夹起一块藕夹，递到蕾娜嘴边。","art":{"background":"a599","sprites":[{"asset":"a723","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「啊～嗯，唔」","art":{"background":"a599","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「……你这家伙，在朋友面前也敢公然秀恩爱啊」","art":{"background":"a599","sprites":[{"asset":"a737","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「哎？我这只是在协助她学习而已啊」","art":{"background":"a599","sprites":[{"asset":"a737","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「她说她连吃饭的时间都想利用起来」","art":{"background":"a599","sprites":[{"asset":"a737","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「是吗？」","art":{"background":"a599","sprites":[{"asset":"a520","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「将臣，给我葡萄糖！我的大脑在渴求葡萄糖」","art":{"background":"a599","sprites":[{"asset":"a1220","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「ＯＫ，想吃甜食的话，这里刚好有大学芋，来，张嘴～」","art":{"background":"a599","sprites":[{"asset":"a1220","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「啊～唔～～～真好吃啊」","art":{"background":"a599","sprites":[{"asset":"a696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「有你喂我吃，这甜味都比平时浓郁了两倍～」","art":{"background":"a599","sprites":[{"asset":"a702","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「哈哈，可能是因为我喂你的时候，在心里念了美味加倍的咒语」","art":{"background":"a599","sprites":[{"asset":"a702","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「嘿嘿，难怪这么好吃！」","art":{"background":"a599","sprites":[{"asset":"a754","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「这不是秀恩爱是什么啊！」","art":{"background":"a599","sprites":[{"asset":"a1499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「啊？我们这不是跟平时一样吗？」","art":{"background":"a599","sprites":[{"asset":"a1499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"……大概。","art":{"background":"a599","sprites":[{"asset":"a1499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"不过，今天情况特殊，还是希望廉太郎不要见怪。","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"毕竟蕾娜上课的时候连教科书都没工夫看，一直在研究那本古书。","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"尽管这会影响到她的成绩，但也是没办法的事。","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"所以比平时多慰劳她一下，也是应该的。","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「我觉得你的常识已经混乱了。不过，好吧」","art":{"background":"a599","sprites":[{"asset":"a513","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「我就不打扰你们了」","art":{"background":"a599","sprites":[{"asset":"a1497","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「抱歉啦」","art":{"background":"a599","sprites":[{"asset":"a1497","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「最近都没怎么陪你玩」","art":{"background":"a599","sprites":[{"asset":"a1497","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「没事啦，你跟一大老爷们说这干什么」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「怎么说呢，我也知道你最近很忙」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「而且你之前也说过吧，等到能说的时候，会全部告诉我们的」","art":{"background":"a599","sprites":[{"asset":"a738","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「也不想想咱俩谁跟谁，这些我都理解」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「嗯，谢谢你，廉太郎」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「等我这边忙完了，咱们再重温下友情？」","art":{"background":"a599","sprites":[{"asset":"a502","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「哈哈哈！不用跟我搞这些」","art":{"background":"a599","sprites":[{"asset":"a519","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「要是哪天我有新女朋友了，肯定也会把你晾在一边，优先陪女朋友」","art":{"background":"a599","sprites":[{"asset":"a515","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「哈哈，那咱们就扯平了啊」","art":{"background":"a599","sprites":[{"asset":"a515","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎","text":"「那还用说」","art":{"background":"a599","sprites":[{"asset":"a748","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「将——臣！唔……我的大脑又缺葡萄糖了……」","art":{"background":"a599","sprites":[{"asset":"a722","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「啊，抱歉抱歉……给，张开嘴巴～」","art":{"background":"a599","sprites":[{"asset":"a722","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「啊～唔……唔，嗯，真好吃♪」","art":{"background":"a599","sprites":[{"asset":"a697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"回过头来，发现廉太郎已经去了别处。","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"虽然他有些方面很轻浮，但也正因如此，我们交流起来才可以这么随性。","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"新的女朋友……","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"有朝一日，廉太郎应该也能找到理解他优点的女生……","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"廉太郎的声音","text":"「嘿，你有ＬＩＮＥ吗？加一个嘛」","art":{"background":"a599","sprites":[{"asset":"a519","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎的声音","text":"「来加个ＬＩＮＥ呗，哎？别这么说嘛，加一下加一下」","art":{"background":"a599","sprites":[{"asset":"a499","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a599","sprites":[{"asset":"a499","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"这家伙，竟然在学校里面勾搭女生！！","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"小春的声音","text":"「廉哥，你在干什么啊！？人渣，人渣！你真是个人渣！！」","art":{"background":"a599","sprites":[{"asset":"a3962","position":"85%","x":180,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎的声音","text":"「呃，小春！？好疼，好疼啊！不是你想的那样啊」","art":{"background":"a599","sprites":[{"asset":"a3962","position":"85%","x":180,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a2240","position":"85%","x":-180,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-1"},{"speaker":"廉太郎的声音","text":"「我只是反思了下自己，觉得在学校里面也应该表现得积极一点……唔啊！？」","art":{"background":"a599","sprites":[{"asset":"a3962","position":"85%","x":180,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a1498","position":"85%","x":-180,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"廉太郎找到女朋友的日子，恐怕还很遥远。","art":{"background":"a599","sprites":[]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「……抱歉，将臣」","art":{"background":"a599","sprites":[{"asset":"a1235","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「嗯？怎么了」","art":{"background":"a599","sprites":[{"asset":"a1235","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「一直让你陪我感觉也不太好，你可以去陪他玩一会儿的」","art":{"background":"a599","sprites":[{"asset":"a1231","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「不不不，你没看见他刚才在干什么吗！」","art":{"background":"a599","sprites":[{"asset":"a1231","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「当然了，你要是跟廉太郎一起玩的话，我肯定希望你们玩点别的……」","art":{"background":"a599","sprites":[{"asset":"a1213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「你不用在意的，我现在这样也挺开心」","art":{"background":"a599","sprites":[{"asset":"a1213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「唔……可是我感觉，我还需要很久」","art":{"background":"a599","sprites":[{"asset":"a1224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「没事，多久我都ＯＫ！」","art":{"background":"a599","sprites":[{"asset":"a1224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「毕竟你看书的时候，我可以一直陪着你嘛」","art":{"background":"a599","sprites":[{"asset":"a1224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「将臣……」","art":{"background":"a599","sprites":[{"asset":"a710","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「不过，我在身边你会不会很难集中注意力？」","art":{"background":"a599","sprites":[{"asset":"a710","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「……不会的」","art":{"background":"a599","sprites":[{"asset":"a3598","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「我也希望……你能陪在我身边」","art":{"background":"a599","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「只有跟你在一起，我才能拿出全部的实力」","art":{"background":"a599","sprites":[{"asset":"a734","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「那就太好了」","art":{"background":"a599","sprites":[{"asset":"a734","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"我摸了摸蕾娜的头。","art":{"background":"a599","sprites":[{"asset":"a734","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"她的头发实在是太柔顺了。","art":{"background":"a599","sprites":[{"asset":"a734","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「不过，等我看完之后，我会安排一段二人时间的」","art":{"background":"a599","sprites":[{"asset":"a1232","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「在那之前你就稍微等等吧」","art":{"background":"a599","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「真的吗？那我就先期待着吧，你加油啊」","art":{"background":"a599","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「好的！嘿嘿，你就好好期待吧」","art":{"background":"a599","sprites":[{"asset":"a894","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「唔唔唔……好了，应该是搞定了！」","art":{"background":"a3423","sprites":[{"asset":"a895","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"蕾娜攥着稿纸，高兴地站了起来。","art":{"background":"a3423","sprites":[{"asset":"a895","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"窗外已近日暮，斜阳渐浓。","art":{"background":"a3423","sprites":[{"asset":"a895","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「辛苦了！感觉你也是相当用功啊」","art":{"background":"a3423","sprites":[{"asset":"a698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「将臣！让你久等了」","art":{"background":"a3423","sprites":[{"asset":"a721","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"我来了个热烈的拥抱，又摸了摸她的头，以示慰劳。","art":{"background":"a3423","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"她也面带羞色，紧紧地抱住了我。","art":{"background":"a3423","sprites":[{"asset":"a705","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「嘿嘿。今天我可用功了，你可要好好夸奖下我才行哦」","art":{"background":"a3423","sprites":[{"asset":"a903","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「可以呀……真棒真棒」","art":{"background":"a3423","sprites":[{"asset":"a903","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「嘻嘻嘻，每到这时你都会特别温柔，我最喜欢这样了」","art":{"background":"a3423","sprites":[{"asset":"a697","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「继续，继续啦～～我真想永远保持这样」","art":{"background":"a3423","sprites":[{"asset":"a721","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「哈哈，但你手里的稿子，还要全部背下来才行吧？」","art":{"background":"a3423","sprites":[{"asset":"a721","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「……嗯～～～～」","art":{"background":"a3423","sprites":[{"asset":"a3643","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"蕾娜看上去有点伤脑筋。","art":{"background":"a3423","sprites":[{"asset":"a3643","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「我觉得，等到晚上再背应该也没问题」","art":{"background":"a3423","sprites":[{"asset":"a695","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「而且，这些内容基本都是跟驹川大夫一边商量一边定下来的，仔细一看，其实也就这一点」","art":{"background":"a3423","sprites":[{"asset":"a698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"确实，一张稿纸就已经写下了所有的内容。","art":{"background":"a3423","sprites":[{"asset":"a698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"但是上面写着很多难懂的汉字，一想到这些全都是蕾娜写的，就知道她写得多么辛苦了。","art":{"background":"a3423","sprites":[{"asset":"a698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"而且我知道，蕾娜从前天就开始写了，整整两天半的时间，她都在准备这个东西。","art":{"background":"a3423","sprites":[{"asset":"a698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「真的是，累得不行……不过也很有成就感」","art":{"background":"a3423","sprites":[{"asset":"a3598","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「而且，现在都傍晚了吧」","art":{"background":"a3423","sprites":[{"asset":"a1211","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「嗯？啊，确实」","art":{"background":"a3423","sprites":[{"asset":"a1211","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「毕竟让你等了那么久，现在不好好亲热下可不行」","art":{"background":"a3423","sprites":[{"asset":"a1232","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「你不用在意啦」","art":{"background":"a3423","sprites":[{"asset":"a1232","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「我能一整天陪在你身边，就已经很满足了」","art":{"background":"a3423","sprites":[{"asset":"a1232","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「那——可——不——行！咱们的二人时光，也是非～～常宝贵的」","art":{"background":"a3423","sprites":[{"asset":"a2083","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「就算很忙，就算有什么事情……我也不愿意将就」","art":{"background":"a3423","sprites":[{"asset":"a719","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「……蕾娜」","art":{"background":"a3423","sprites":[{"asset":"a719","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「难道……你不这么觉得吗？」","art":{"background":"a3423","sprites":[{"asset":"a3675","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「怎么会呢」","art":{"background":"a3423","sprites":[{"asset":"a3675","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"我也紧紧地抱住了蕾娜。","art":{"background":"a3423","sprites":[{"asset":"a3675","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「呜啊～！嘿嘿……从你的举动中，我感受到了你的心情」","art":{"background":"a3423","sprites":[{"asset":"a3963","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「不过，现在还是希望你能明确地说出来」","art":{"background":"a3423","sprites":[{"asset":"a3806","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「嗯……我爱你，蕾娜」","art":{"background":"a3423","sprites":[{"asset":"a3806","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「我随时都可以向上帝发誓，我也爱着你～」","art":{"background":"a3423","sprites":[{"asset":"a698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"轻轻地，我们双唇相接……不过——","art":{"background":"a3423","sprites":[{"asset":"a698","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「唔……啊，嗯……唔……」","art":{"background":"a3964","sprites":[]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「哈啊，将臣……将臣……唔……嗯～」","art":{"background":"a3964","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"她直接把舌头伸了进来。","art":{"background":"a3964","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"也罢。","art":{"background":"a3964","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"反正现在其他学生都回去了。","art":{"background":"a3964","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"说不定，现在学校里面只剩我们俩了。","art":{"background":"a3964","sprites":[]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「唔……嗯……将臣，你也把舌头伸进来了呀，唔！嗯……」","art":{"background":"a3965","sprites":[]},"chapter":"8-1"},{"speaker":"将臣","text":"「嗯，蕾娜……蕾娜，我爱你，嗯……」","art":{"background":"a3965","sprites":[]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「啊……唔……现在，我们可以尽情地……亲热了」","art":{"background":"a3965","sprites":[]},"chapter":"8-1"},{"speaker":"将臣","text":"「当然了，尽情亲热吧……嗯？」","art":{"background":"a3965","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"突然，我感觉哪里不对劲。","art":{"background":"a3964","sprites":[]},"chapter":"8-1"},{"speaker":"","text":"但下一秒，蕾娜就按着我的肩膀，让我坐在了椅子上。","art":{"background":"a3423","sprites":[]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「呃、那个……将臣，我们可以进入下一步吗？」","art":{"background":"a3423","sprites":[{"asset":"a3966","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「等、等等，你的意思是……」","art":{"background":"a3423","sprites":[{"asset":"a3966","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「…………大概就是你想的那样」","art":{"background":"a3423","sprites":[{"asset":"a3967","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「你、你想呀，在芳乃家，大家都在……而且今晚我还有别的事……」","art":{"background":"a3423","sprites":[{"asset":"a1241","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「所以，我想趁现在……补充一下你的温暖」","art":{"background":"a3423","sprites":[{"asset":"a3968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「啊，这个……好吧」","art":{"background":"a3423","sprites":[{"asset":"a3968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"一想到明天的事，我也能理解她的心情。","art":{"background":"a3423","sprites":[{"asset":"a3968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"说实话，我其实也很渴望她的温暖。","art":{"background":"a3423","sprites":[{"asset":"a3968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"我就是觉得现在这个情况下，可能有点不合适。","art":{"background":"a3423","sprites":[{"asset":"a3968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"","text":"但既然她都这么主动了，那我身为男人肯定也该表示下才行。","art":{"background":"a3423","sprites":[{"asset":"a3968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"将臣","text":"「来吧，蕾娜。我也想补充一下你的温暖」","art":{"background":"a3423","sprites":[{"asset":"a3968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「…………好的，将臣」","art":{"background":"a3423","sprites":[{"asset":"a3966","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"},{"speaker":"蕾娜","text":"「今天……我也会让你尽情感受的」","art":{"background":"a3423","sprites":[{"asset":"a3699","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-1"}]