[{"speaker":"将臣","text":"「你眼睛下面沾了沙子」","art":{"background":"a19","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"1-1"},{"speaker":"芦花","text":"「这是泪痣好吗！」","art":{"background":"a19","sprites":[{"asset":"a26","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"1-1"},{"speaker":"将臣","text":"「开玩笑啦，开玩笑」","art":{"background":"a19","sprites":[{"asset":"a26","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"1-1"},{"speaker":"芦花","text":"「拿别人的身体特征开玩笑可不是什么好事」","art":{"background":"a19","sprites":[{"asset":"a27","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"1-1"},{"speaker":"将臣","text":"「你不喜欢泪痣吗？抱歉，太久不见没把握好分寸」","art":{"background":"a19","sprites":[{"asset":"a27","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"1-1"},{"speaker":"将臣","text":"「我就是有点害羞。放心吧，我觉得你的泪痣很可爱」","art":{"background":"a19","sprites":[{"asset":"a27","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"1-1"},{"speaker":"芦花","text":"「真是的……都这么多年交情了，现在有什么害羞的嘛」","art":{"background":"a19","sprites":[{"asset":"a28","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"1-1"},{"speaker":"","text":"虽然芦花姐的笑容还是跟小时候一样和蔼可亲，但我难免觉得有些害羞。","art":{"background":"a19","sprites":[{"asset":"a8","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"1-1"},{"speaker":"","text":"毕竟……芦花姐真的非常漂亮。","art":{"background":"a19","sprites":[{"asset":"a8","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"1-1"}]