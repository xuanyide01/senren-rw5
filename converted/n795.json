[{"speaker":"将臣","text":"「小、小春……我要射了……」","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯……唔唔……射吧，把精液射出来吧，哥哥」","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「就这样，射在你的里面……」","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯，嗯，就这样一直连在一起……求求你了，射出来吧，哥哥」","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「啊、啊，去了」","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"小春用她的所有接受了我。","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"他真是令人怜惜得无与伦比。","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"而我又想征服这样的小春……","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「啊，啊啊！哥哥……啊，啊，啊……哥哥！」","art":{"background":"a4331","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「我喜欢你，小春！」","art":{"background":"a4331","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「我也是，我也喜欢哥哥，我喜欢你，喜欢你，喜欢你喜欢你喜欢你……嗯嗯！」","art":{"background":"a4331","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊」","art":{"background":"a4332","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我的下体被小春紧紧包裹着，在其中尽情地到达了高潮。","art":{"background":"a4332","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯啊，嗯！嗯！嗯嗯……嗯嗯！」","art":{"background":"a4332","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"射精剧烈得让我眼前泛白。","art":{"background":"a4332","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"简直就像精液都反冲到了我的大脑中一样……","art":{"background":"a4332","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「哈，哈啊……哈啊……啊，啊啊啊啊啊………\n嗯嗯……！」","art":{"background":"a4333","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"小春一边接受我射出的精液，一边对我温柔地微笑。","art":{"background":"a4333","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「我能感觉到……它在我的肚子里一跳一跳的……哈啊，好厉害，好满啊……嗯」","art":{"background":"a4334","sprites":[]},"chapter":"8-2"}]