[{"speaker":"","text":"这就是小雨的计划。","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"","text":"她不打算抑制宿体发射的信号，而是想反过来利用它寻找碎片。","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"","text":"朝武虽然害怕被附体，但她还是同意了这个方案。","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"","text":"我们不会干预信号，而是将她的身体拱手让出。","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"芳乃","text":"「那我睡了……晚、晚安」","art":{"background":"a916","sprites":[{"asset":"a1366","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"将臣","text":"「晚安」","art":{"background":"a916","sprites":[{"asset":"a1366","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"茉子","text":"「晚安」","art":{"background":"a916","sprites":[{"asset":"a350","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「……」","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"丛雨","text":"「睡着了吗？」","art":{"background":"a916","sprites":[{"asset":"a384","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「……还没」","art":{"background":"a916","sprites":[{"asset":"a384","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「……」","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"茉子","text":"「睡着了吗？」","art":{"background":"a916","sprites":[{"asset":"a1370","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「……没呢」","art":{"background":"a916","sprites":[{"asset":"a1370","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「……」","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"将臣","text":"「睡着了？」","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"芳乃","text":"「我都说了还没呢」","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"将臣","text":"「是吗……」","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"芳乃","text":"「……」","art":{"background":"a916","sprites":[]},"chapter":"3-6"},{"speaker":"茉子・丛雨・将臣","text":"『……』","art":{"background":"a916","sprites":[{"asset":"a196","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1370","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"},{"speaker":"茉子・丛雨・将臣","text":"『……我盯……』","art":{"background":"a916","sprites":[{"asset":"a288","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a1371","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「……呜……我受够了！这是在干什么呀，故意气我吗！？」","art":{"background":"a916","sprites":[{"asset":"a377","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「你们一直在那边问问问问个不停，还这样盯着我，我怎么可能睡得着！」","art":{"background":"a916","sprites":[{"asset":"a379","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"将臣","text":"「抱歉，我太担心了」","art":{"background":"a916","sprites":[{"asset":"a379","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「我要过一小会才能睡着的，你们快点到别的地方等着」","art":{"background":"a916","sprites":[{"asset":"a1372","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"将臣","text":"「可是，要是发生了什么……」","art":{"background":"a916","sprites":[{"asset":"a1372","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「茉子留在房间里就好」","art":{"background":"a916","sprites":[{"asset":"a378","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"将臣","text":"「可是……」","art":{"background":"a916","sprites":[{"asset":"a378","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「真是的……我要是就这样睡过去，岂不是要被你看到睡脸了吗……」","art":{"background":"a916","sprites":[{"asset":"a1365","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"将臣","text":"「……睡脸？」","art":{"background":"a916","sprites":[{"asset":"a1365","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"芳乃","text":"「反正你知道我会紧张就行了，你快点去另一边等我」","art":{"background":"a916","sprites":[{"asset":"a378","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-6"},{"speaker":"茉子","text":"「这里就交给我吧」","art":{"background":"a916","sprites":[{"asset":"a1373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"},{"speaker":"将臣","text":"「……」","art":{"background":"a916","sprites":[{"asset":"a1373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"},{"speaker":"","text":"虽然我有些许不安……不过她说的也有道理，被人盯着确实如坐针毡，无法入眠。","art":{"background":"a916","sprites":[{"asset":"a1373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"},{"speaker":"将臣","text":"「好，那我去起居室等着」","art":{"background":"a916","sprites":[{"asset":"a1373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-6"}]