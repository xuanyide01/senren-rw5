[{"speaker":"","text":"我们沉浸在了性爱的余温之中。","art":{"background":"a1425","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"皎洁月光之下，是半裸相交的我们二人。","art":{"background":"a1425","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"随后过了一阵，我们开始整理衣衫。","art":{"background":"a1425","sprites":[]},"chapter":"8-5"},{"speaker":"将臣","text":"「明天还有正事呢，我们该回去了，小雨」","art":{"background":"a1425","sprites":[{"asset":"a3181","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-5"},{"speaker":"丛雨","text":"「是啊」","art":{"background":"a1425","sprites":[{"asset":"a3188","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-5"},{"speaker":"丛雨","text":"「可是我们竟然在这种地方做了……」","art":{"background":"a1425","sprites":[{"asset":"a3098","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-5"},{"speaker":"丛雨","text":"「未免也太大胆了，要反省才行」","art":{"background":"a1425","sprites":[{"asset":"a3182","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1425","sprites":[{"asset":"a3182","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-5"},{"speaker":"","text":"小雨如此说道……","art":{"background":"a1425","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"而我则微笑着抚摸她的头。","art":{"background":"a1425","sprites":[]},"chapter":"8-5"},{"speaker":"将臣","text":"「没关系的」","art":{"background":"a119","sprites":[]},"chapter":"8-5"},{"speaker":"将臣","text":"「今晚的事，只有你我……还有它知道」","art":{"background":"a119","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"我抬头仰望明月。","art":{"background":"a119","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「……」","art":{"background":"a119","sprites":[{"asset":"a3110","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-5"},{"speaker":"丛雨","text":"「……是啊」","art":{"background":"a119","sprites":[{"asset":"a3181","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-5"},{"speaker":"丛雨","text":"「今晚应该可以睡个安稳觉了……」","art":{"background":"a119","sprites":[{"asset":"a3174","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-5"},{"speaker":"","text":"小雨和我一样微笑着抬头望明月。","art":{"background":"a119","sprites":[{"asset":"a3174","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-5"},{"speaker":"","text":"我一边感受着依靠在我身边的少女，一边想到……","art":{"background":"a119","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"是时候了……","art":{"background":"a119","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"一直以来都注视着小雨的明月啊……","art":{"background":"a119","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"如若可以，也请为她祈祷吧……","art":{"background":"a119","sprites":[]},"chapter":"8-5"}]