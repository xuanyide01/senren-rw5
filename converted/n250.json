[{"speaker":"丛雨","text":"「那么约会的情况如何？」","art":{"background":"a348","sprites":[{"asset":"a139","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「就变了一次狗，除此之外没什么问题」","art":{"background":"a348","sprites":[{"asset":"a139","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「诅咒呢……？」","art":{"background":"a348","sprites":[{"asset":"a435","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「没什么大的变化」","art":{"background":"a348","sprites":[{"asset":"a328","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「那么……还是当作没有解除比较好」","art":{"background":"a348","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「有没有什么办法确认诅咒解除呢？」","art":{"background":"a348","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「茉子被附体的时候，看到了兽灵的模样对吧？」","art":{"background":"a348","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「是的。就是之前的祟神的样子」","art":{"background":"a348","sprites":[{"asset":"a132","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a329","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「那么，如果它已经满足了的话，应该会有什么反应才对……」","art":{"background":"a348","sprites":[{"asset":"a204","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a329","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「如果假装谈恋爱不行的话……看来只能真的谈一场恋爱看看了」","art":{"background":"a348","sprites":[{"asset":"a1473","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子・将臣","text":"『……』","art":{"background":"a348","sprites":[{"asset":"a2342","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「（怎么办？看来还是应该和他们说一下吧？）」","art":{"background":"a348","sprites":[{"asset":"a2342","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「（是的。虽然有点难为情……但我觉得必须和他们报告一下才行）」","art":{"background":"a348","sprites":[{"asset":"a2291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「怎么了？你们俩面面相觑的，发生什么事了吗？」","art":{"background":"a348","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1473","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「是有什么事瞒着我们吗？难道是今天约会的事？」","art":{"background":"a348","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a449","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「也不能说是瞒着……我们只是有一件事还没向大家报告」","art":{"background":"a348","sprites":[{"asset":"a321","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「是重要的事吗？」","art":{"background":"a348","sprites":[{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a321","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「从某种意义上来看，是非常重要的」","art":{"background":"a348","sprites":[{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a957","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「怎么了？到底发生什么事了？」","art":{"background":"a348","sprites":[{"asset":"a363","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「呃——那个……咳咳」","art":{"background":"a348","sprites":[]},"chapter":"6-1"},{"speaker":"将臣","text":"「我们不打算演临时情侣了。从今天起，我和常陆将成为真正的情侣」","art":{"background":"a348","sprites":[]},"chapter":"6-1"},{"speaker":"丛雨","text":"「不是临时的……而是真正的情侣？」","art":{"background":"a348","sprites":[{"asset":"a549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「是的」","art":{"background":"a348","sprites":[{"asset":"a549","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「那也就是说……茉子真的……恋爱了？」","art":{"background":"a348","sprites":[{"asset":"a935","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2342","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「……是的……是这样的」","art":{"background":"a348","sprites":[{"asset":"a935","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2314","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「我……我喜欢有地……」","art":{"background":"a348","sprites":[{"asset":"a935","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2342","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「我也喜欢常陆。所以我就向她表白了」","art":{"background":"a348","sprites":[{"asset":"a935","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2342","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「然后我答应了……我们就成为情侣了……」","art":{"background":"a348","sprites":[{"asset":"a935","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2313","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「……茉子和有地……成了情侣……」","art":{"background":"a348","sprites":[{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2313","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「恭喜你！」","art":{"background":"a348","sprites":[{"asset":"a451","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「哎、啊、嗯……非、非常感谢……」","art":{"background":"a348","sprites":[{"asset":"a280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「也恭喜有地了」","art":{"background":"a348","sprites":[{"asset":"a1014","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「谢谢你，朝武」","art":{"background":"a348","sprites":[{"asset":"a1014","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「哎哟，主人和茉子居然凑成了一对。这还真是意外……不对，倒也没那么意外」","art":{"background":"a348","sprites":[{"asset":"a277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「你们俩本来就很般配」","art":{"background":"a348","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"朝武和小雨都觉得这是大喜事。","art":{"background":"a348","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"她们的表情和话语都非常真诚，还从心底里为我们献上了祝福。","art":{"background":"a348","sprites":[]},"chapter":"6-1"},{"speaker":"芳乃","text":"「你们能成为情侣确实是喜事……」","art":{"background":"a348","sprites":[{"asset":"a1712","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「这就意味着，茉子是用真正的恋爱让兽灵实现了愿望」","art":{"background":"a348","sprites":[{"asset":"a1309","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1712","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「但是现在却依然没有解除附体……」","art":{"background":"a348","sprites":[{"asset":"a185","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1712","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「是不是了解恋爱的方式有问题呢？」","art":{"background":"a348","sprites":[{"asset":"a185","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1711","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「现在还说不准」","art":{"background":"a348","sprites":[{"asset":"a204","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1711","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「茉子，本座不是怀疑你的感情，但是想问一下，至今为止你是怎么看待主人的？」","art":{"background":"a348","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「怎么看待他……我就觉得他是个好人啊」","art":{"background":"a348","sprites":[{"asset":"a132","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a628","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「有没有把他当成能让你心动的异性来看待？」","art":{"background":"a348","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a628","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「没、没有。因为当时有地的身份是芳乃大人的未婚夫，所以我根本没有那种想法」","art":{"background":"a348","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a318","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「你不用顾虑我的事」","art":{"background":"a348","sprites":[{"asset":"a446","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「我真的不是在顾虑芳乃大人。当时觉得他是个温柔的好人，但我真的从来没有把他当作异性来看待」","art":{"background":"a348","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a348","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"我真不想知道这种事！真是令人伤心……","art":{"background":"a348","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"正是因为这是句无心之言，才更让我受伤。","art":{"background":"a348","sprites":[]},"chapter":"6-1"},{"speaker":"茉子","text":"「但是，不知道什么时候开始……有地的温柔让我怦然心动」","art":{"background":"a348","sprites":[{"asset":"a1458","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「那么我们是不是可以理解为，你是最近才开始有这种感觉的？」","art":{"background":"a348","sprites":[{"asset":"a263","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a256","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「啊，没错，是这样的。这是最近才有的感觉」","art":{"background":"a348","sprites":[{"asset":"a263","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a913","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「而且我……一直没有往“喜欢有地”这方面去想」","art":{"background":"a348","sprites":[{"asset":"a263","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a326","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「原来如此。那么如果要了解恋爱，现在只是个开头吧？」","art":{"background":"a348","sprites":[{"asset":"a1357","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a326","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"将臣","text":"「只是开头？」","art":{"background":"a348","sprites":[{"asset":"a1357","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a628","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「正视自己的感情，和主人成为了情侣，然后开始享受恋爱」","art":{"background":"a348","sprites":[{"asset":"a182","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「这样才算尝到了恋爱的滋味吗？」","art":{"background":"a348","sprites":[{"asset":"a182","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1473","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「是的。总之本座觉得，你们要先累积恋爱的经验，才能让我们对茉子的状况进行正确的判断」","art":{"background":"a348","sprites":[{"asset":"a129","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1473","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「也就是说……让他们别管那么多，该亲热就亲热，是这个意思吗？」","art":{"background":"a348","sprites":[{"asset":"a129","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"丛雨","text":"「嗯，就是这个意思」","art":{"background":"a348","sprites":[{"asset":"a130","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子・将臣","text":"『……』","art":{"background":"a348","sprites":[{"asset":"a2340","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"……虽然能得到认同我很高兴，但把这种事摆在台面上说，实在让人羞涩难耐啊！","art":{"background":"a348","sprites":[{"asset":"a2340","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「不管怎样，茉子、有地，恭喜你们了」","art":{"background":"a348","sprites":[{"asset":"a1014","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2342","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「非、非常感谢」","art":{"background":"a348","sprites":[{"asset":"a1014","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2562","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「抱歉，芳乃大人。又要在您这叨扰一段时间了」","art":{"background":"a916","sprites":[{"asset":"a280","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「这种事不用在意。能够跟茉子住在一起我很开心的」","art":{"background":"a916","sprites":[{"asset":"a953","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a280","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「还有……那个……有地的事也……」","art":{"background":"a916","sprites":[{"asset":"a953","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a321","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「哎？我知道了，你在意的是他曾经是我的未婚夫这件事吧？你用不着顾虑我的」","art":{"background":"a916","sprites":[{"asset":"a623","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a321","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「我觉得有地确实是个很棒的人。但是……现在我心里更加确定了，我和他之间并没有恋爱感情」","art":{"background":"a916","sprites":[{"asset":"a623","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「因为我现在啊，从心底里为你们感到高兴」","art":{"background":"a916","sprites":[{"asset":"a1014","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「如果我对他抱有恋爱感情的话，我应该很嫉妒你们才对。但是我完全没有这种感觉」","art":{"background":"a916","sprites":[{"asset":"a623","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「……芳乃大人……」","art":{"background":"a916","sprites":[{"asset":"a550","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「所以恭喜你，茉子」","art":{"background":"a916","sprites":[{"asset":"a953","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a550","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「……嗯……非常感谢，芳乃大人」","art":{"background":"a916","sprites":[{"asset":"a953","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1010","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「不用顾虑太多，你们想怎么亲热都行哦」","art":{"background":"a916","sprites":[{"asset":"a259","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1010","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「怎么亲热都行……」","art":{"background":"a916","sprites":[{"asset":"a259","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2351","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「对了。干脆从今天开始，你就跟有地睡一个房间吧？不用睡在我房间里了」","art":{"background":"a916","sprites":[{"asset":"a1014","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2351","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「这、这怎么行……！？这个建议虽然有点诱人……不过还是……」","art":{"background":"a916","sprites":[{"asset":"a1014","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2319","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「是吗？明明不用顾虑我的」","art":{"background":"a916","sprites":[{"asset":"a2399","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2319","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「总之，今天是茉子脱单的大喜日子。不要脸色这么阴沉啦，去洗个澡，换换心情吧」","art":{"background":"a916","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「好的……」","art":{"background":"a473","sprites":[{"asset":"a2371","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"……芳乃大人看上去神色如常。","art":{"background":"a473","sprites":[{"asset":"a2563","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"之前我还很担心芳乃大人会不会很在意，不过现在看来没这回事。","art":{"background":"a473","sprites":[{"asset":"a2563","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"她是从心底里祝福我和有地的爱情。","art":{"background":"a473","sprites":[{"asset":"a2563","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「那么真的不用顾虑芳乃大人吗……？」","art":{"background":"a473","sprites":[{"asset":"a2564","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「我可以毫无顾虑地跟有地……亲热……」","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"不过“亲热”到底是要做哪些事呢？","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"按照少女漫画里的描写，应该是约会、享受和男友在一起的时间、接吻……然后就是次日清晨的床上特写了。","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「那就是说要做爱……要和有地做爱……」","art":{"background":"a473","sprites":[{"asset":"a2565","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「～～～呜呜呜」","art":{"background":"a473","sprites":[{"asset":"a2566","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「想、想象了一下……那、那个外星人，红通通的外星人，要进入我的身体……」","art":{"background":"a473","sprites":[{"asset":"a2567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"当然了，既然我们是情侣，迟早要做这种事的。","art":{"background":"a473","sprites":[{"asset":"a2568","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"所以说我也有点想和有地……在一个房间里同床共枕。","art":{"background":"a473","sprites":[{"asset":"a2568","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"可是……我现在的状况不太妙。","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"如果真的睡在一起，我可能会控制不住自己。","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"万一有地强行要求……我可能会顺势答应他的。","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"但如果我在过程中变成了狗的话……就会发生无法想象的悲剧了……","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"那样实在是太对不起有地了。","art":{"background":"a473","sprites":[{"asset":"a2569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"而且……光是接了吻，身体就变得那么热了。","art":{"background":"a473","sprites":[{"asset":"a2568","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「如果做爱的话，会变成什么样……」","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"虽然心里很不安……但我也很好奇那会是什么滋味。","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"不止是接吻，还要做爱……","art":{"background":"a473","sprites":[{"asset":"a2406","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「可能我比自己想象的还下流得多」","art":{"background":"a473","sprites":[{"asset":"a2570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"茉子","text":"「可是……那么大的外星人，真的插得进来吗？有、有点害怕……」","art":{"background":"a473","sprites":[{"asset":"a2367","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"芳乃","text":"「那就睡觉吧。我关灯咯」","art":{"background":"a916","sprites":[{"asset":"a2571","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-1"},{"speaker":"","text":"……","art":{"background":"a1331","sprites":[]},"chapter":"6-1"},{"speaker":"","text":"房间里的灯灭了，我静静闭上了眼睛。","art":{"background":"a1331","sprites":[]},"chapter":"6-1"},{"speaker":"茉子","text":"「……」","art":{"background":"a1331","sprites":[]},"chapter":"6-1"},{"speaker":"茉子","text":"「……唉……」","art":{"background":"a1331","sprites":[]},"chapter":"6-1"}]