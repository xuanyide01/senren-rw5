[{"speaker":"","text":"在天空变成橘红色之前，我们下了山。","art":{"background":"a54","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"虽然时间短暂，但我们都过得很开心。","art":{"background":"a54","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"最重要的是，今天收获了一些淡水鱼和野菜。","art":{"background":"a54","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"虽然不足以分给所有人，但廉太郎并没有必要带回去。","art":{"background":"a54","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"所以今天的成果都被我们和蕾娜平分了。","art":{"background":"a54","sprites":[]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「今天非常感谢你们。我过得很开心！」","art":{"background":"a54","sprites":[{"asset":"a960","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「不仅买了可爱的衣服，还收获了几条鱼」","art":{"background":"a54","sprites":[{"asset":"a1103","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不客气，我也很开心」","art":{"background":"a54","sprites":[{"asset":"a1103","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「是的。我也过得很开心」","art":{"background":"a54","sprites":[{"asset":"a953","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a246","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「毕竟美味的晚饭也有着落了」","art":{"background":"a54","sprites":[{"asset":"a953","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a251","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「哎呀，今天真是很棒的一天啊」","art":{"background":"a54","sprites":[{"asset":"a96","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「那，我就在这里告辞了」","art":{"background":"a54","sprites":[{"asset":"a1041","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「我送你到半路」","art":{"background":"a54","sprites":[{"asset":"a1041","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a934","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「不麻烦你了。我记得路」","art":{"background":"a54","sprites":[{"asset":"a960","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a934","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「那么，诸位，学校见」","art":{"background":"a54","sprites":[{"asset":"a978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「嗯。下周一见」","art":{"background":"a54","sprites":[{"asset":"a956","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a246","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「到时候请跟我讲讲你们的厨师长是怎么做菜的啊」","art":{"background":"a54","sprites":[{"asset":"a956","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a251","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「我知道了！那么各位，请多保重」","art":{"background":"a54","sprites":[{"asset":"a966","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"蕾娜用力挥了挥手，然后便沿着坡道跑了下去。","art":{"background":"a54","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「好了，我们也回去吧」","art":{"background":"a54","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「今天真的很谢谢你，鞍马同学。下次有机会的话再一起出来玩吧」","art":{"background":"a54","sprites":[{"asset":"a60","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a953","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a246","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「那么，我们告辞了」","art":{"background":"a54","sprites":[{"asset":"a60","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a953","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a247","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「再见」","art":{"background":"a54","sprites":[{"asset":"a60","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a953","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a247","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「啊，哦……」","art":{"background":"a54","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a953","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a247","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「……」","art":{"background":"a54","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「果然完全没戏啊……唉……我也回去吧」","art":{"background":"a54","sprites":[{"asset":"a102","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「我回来了」","art":{"background":"a1104","sprites":[{"asset":"a964","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「我们回来了」","art":{"background":"a1104","sprites":[{"asset":"a964","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"安晴","text":"「欢迎回家。晚饭有着落吗？如果来不及的话，咱们就叫外卖或者偶尔在外面吃一顿吧？」","art":{"background":"a1104","sprites":[{"asset":"a245","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a964","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「不，不用担心。今天采了野菜，还钓了鱼」","art":{"background":"a1104","sprites":[{"asset":"a245","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a964","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「这条鱼是我钓的。它游得可有精神了，所以肉质也应该会很好的」","art":{"background":"a1104","sprites":[{"asset":"a245","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1105","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"安晴","text":"「哦，那真令人期待」","art":{"background":"a1104","sprites":[{"asset":"a358","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1105","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"安晴","text":"「今天玩得开心吗？」","art":{"background":"a1104","sprites":[{"asset":"a359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「嗯，很开心」","art":{"background":"a1104","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"爱吃甜食的朝武，高高兴兴学钓鱼的朝武，这些都是她不曾向我展示过的一面。","art":{"background":"a1104","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"我还是第一次见到那样的她……真是太可爱了。","art":{"background":"a1104","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"朝武开心地走回了房间，她整个人好像依旧沉浸在那份快乐之中。","art":{"background":"a1104","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「好了，我也该去为晚饭做准备了」","art":{"background":"a1104","sprites":[{"asset":"a1106","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"安晴","text":"「……」","art":{"background":"a1104","sprites":[{"asset":"a248","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"安晴","text":"「将臣」","art":{"background":"a1104","sprites":[{"asset":"a245","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「嗯？怎么了？」","art":{"background":"a1104","sprites":[{"asset":"a245","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"安晴","text":"「我好久没见到她那样的表情了。真的很谢谢你，将臣」","art":{"background":"a1104","sprites":[{"asset":"a359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不。没什么好谢我的」","art":{"background":"a1104","sprites":[{"asset":"a359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我也玩得很开心」","art":{"background":"a1104","sprites":[{"asset":"a359","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"安晴","text":"「是吗……嗯，你和她在一起觉得开心，我也很高兴」","art":{"background":"a1104","sprites":[{"asset":"a248","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「哦，主人。欢迎回家」","art":{"background":"a1107","sprites":[{"asset":"a133","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我回来了」","art":{"background":"a1107","sprites":[{"asset":"a133","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「今天是你更早啊」","art":{"background":"a1107","sprites":[{"asset":"a133","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「嗯。本座提早一些结束了」","art":{"background":"a1107","sprites":[{"asset":"a135","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「对了，主人，你今天去山里了吧？」","art":{"background":"a1107","sprites":[{"asset":"a475","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「有、有什么……问题吗？白天进山里应该没什么问题吧」","art":{"background":"a1107","sprites":[{"asset":"a475","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「本座没有生气。虽然并没有问题……但本座应该说过让你好好休息吧？」","art":{"background":"a1107","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「你误会了」","art":{"background":"a1107","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我们只是避开人群，在山里钓几条鱼挖几颗野菜而已。这也是为了调节心情嘛」","art":{"background":"a1107","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「而且朝武玩得也很开心」","art":{"background":"a1107","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「是吗。那就好」","art":{"background":"a1107","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"小雨满意地点了点头。","art":{"background":"a1107","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「那么，本座有事报告主人」","art":{"background":"a1107","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「报告……难道是？」","art":{"background":"a1107","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「主人，本座找到了」","art":{"background":"a1107","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「那个碎片吗！？到、到底是在哪儿！？」","art":{"background":"a1107","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「主人，冷静点。很快就要日落了。你难道晚上了还想进山里吗？」","art":{"background":"a1107","sprites":[{"asset":"a414","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1107","sprites":[{"asset":"a414","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「好吧。那就明天锻炼结束后去取吧」","art":{"background":"a1107","sprites":[{"asset":"a414","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"不过，那么大一座山，竟然都让她给找到了……","art":{"background":"a1107","sprites":[{"asset":"a139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"}]