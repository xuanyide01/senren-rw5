[{"speaker":"","text":"就这样，接吻成为了我们日常的交流方式。","art":{"background":"a1","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"几天后，总算到了周末。","art":{"background":"a1","sprites":[]},"chapter":"7-2"},{"speaker":"安晴","text":"「说来，你们两个今天有什么打算？」","art":{"background":"a211","sprites":[{"asset":"a244","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「――！？什么打算……是指？」","art":{"background":"a211","sprites":[{"asset":"a2097","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"安晴","text":"「难得休一次假，我就想你们会不会去约个会啊什么的……」","art":{"background":"a211","sprites":[{"asset":"a309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「约会，是吗？」","art":{"background":"a211","sprites":[{"asset":"a309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"这么说来……由于我们满脑子只想着做爱，约会之类的事该怎么办还完全没决定。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"虽然我有在尽力克制自己……但还是忍不住啊。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"因为太过期待，我实在保持不了冷静。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「并没有什么计划……」","art":{"background":"a211","sprites":[{"asset":"a309","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a1724","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"安晴","text":"「是吗？那……不好意思，中午的时候你们能帮我一些忙吗？」","art":{"background":"a211","sprites":[{"asset":"a245","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a1724","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"安晴","text":"「有个认识的朋友拜托我进行祈祷」","art":{"background":"a211","sprites":[{"asset":"a245","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a1473","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我明白了。这种小事的话没问题」","art":{"background":"a211","sprites":[{"asset":"a245","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a1723","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「那个……顺便问一句，祈祷要花多久时间？」","art":{"background":"a211","sprites":[{"asset":"a244","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「毕竟我从来没有祈祷过」","art":{"background":"a211","sprites":[{"asset":"a244","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"安晴","text":"「不需要多少时间。最多也就二三十分钟吧」","art":{"background":"a211","sprites":[{"asset":"a358","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「是吗，比我想象中还短啊」","art":{"background":"a211","sprites":[{"asset":"a358","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"如果要花几个小时的话，我就头疼了。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"只是几十分钟的话，就算要约会的话也完全来得及。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"茉子","text":"「你们两个今天真的没安排吗？」","art":{"background":"a211","sprites":[{"asset":"a630","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"安晴","text":"「哎？难道说你们优先我这边的事情了？如果有计划的话，优先办你们的事也可以的啊」","art":{"background":"a211","sprites":[{"asset":"a244","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「不，并没什么计划」","art":{"background":"a211","sprites":[{"asset":"a244","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"……不管父母有多豁达，也总不能说“计划去做爱”吧。","art":{"background":"a211","sprites":[{"asset":"a244","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「爸爸，你真的不用顾虑我们的。神社的工作也是很重要的」","art":{"background":"a211","sprites":[{"asset":"a243","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a622","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「而且，如果周围人觉得巫女因为谈恋爱而怠慢了本职工作，这也是一个大问题」","art":{"background":"a211","sprites":[{"asset":"a243","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a446","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"安晴","text":"「是吗。那我也不多说了，今天就拜托你了」","art":{"background":"a211","sprites":[{"asset":"a248","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a446","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「将臣，我一个人擅自做决定真是对不起。我也是顺水推舟不自觉就……」","art":{"background":"a275","sprites":[{"asset":"a429","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「不，你别介意。你的话也很有道理，我理解你的心情」","art":{"background":"a275","sprites":[{"asset":"a429","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"身为巫女，芳乃至今为止在外人面前一直保持着坚定的态度。","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"如果因为要和我约会撂下了本职工作，周围的大人……特别是不了解详细内幕的人或许会认为她堕落了。","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"这有点不太妙。","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我想挺起胸膛和芳乃交往。为此，我尽可能不想让别人对我们指指点点。","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「不用在意我」","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「而且一个小时都用不到吧？那就没什么好介意的」","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我会尽可能早点回来的」","art":{"background":"a275","sprites":[{"asset":"a435","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「虽然你的心意我很高兴，但祈祷时太过着急的话不太好」","art":{"background":"a275","sprites":[{"asset":"a435","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我只是说尽量，尽量。所以回来之后……那个……」","art":{"background":"a275","sprites":[{"asset":"a424","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我们按照约定……一起……做爱吧？」","art":{"background":"a275","sprites":[{"asset":"a2098","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「嗯」","art":{"background":"a275","sprites":[{"asset":"a2098","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"她这么可爱地邀请我做爱……真的有男人能拒绝这样的邀请吗？","art":{"background":"a275","sprites":[{"asset":"a2099","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我二话不说疯狂点头。","art":{"background":"a275","sprites":[{"asset":"a2099","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「那，路上小心」","art":{"background":"a275","sprites":[{"asset":"a2099","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「……盯……」","art":{"background":"a275","sprites":[{"asset":"a790","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"芳乃不满地斜视着目送她离开的我。","art":{"background":"a275","sprites":[{"asset":"a790","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「呃，啊……？我哪里做错了？」","art":{"background":"a275","sprites":[{"asset":"a790","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「也不是说做错了……」","art":{"background":"a275","sprites":[{"asset":"a1713","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………啊」","art":{"background":"a275","sprites":[{"asset":"a1713","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"想起来了。","art":{"background":"a275","sprites":[{"asset":"a1713","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「路上小心。啾……」","art":{"background":"a275","sprites":[{"asset":"a1713","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「嗯……嘿嘿。我走了」","art":{"background":"a275","sprites":[{"asset":"a2100","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"对，看来她确实是在索要一个道别吻。","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"芳乃心情愉快地走向神社。","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「……那么，在她去忙的这段时间，我做什么好呢」","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我待在房间里也静不下来。","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"不，我会被满脑子的妄想弄得失控的。","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「～～～呼，哈……去转换下心情吧」","art":{"background":"a275","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「所以，有什么我能帮忙的事情吗？」","art":{"background":"a211","sprites":[{"asset":"a323","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「帮忙啊……」","art":{"background":"a211","sprites":[{"asset":"a2101","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「什么都可以」","art":{"background":"a211","sprites":[{"asset":"a2101","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「但是，午饭都吃完了，也收拾干净了……」","art":{"background":"a211","sprites":[{"asset":"a242","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「你现在准备去做什么？」","art":{"background":"a211","sprites":[{"asset":"a242","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「用洗衣机洗衣服，晒被子，还有就是打扫了」","art":{"background":"a211","sprites":[{"asset":"a249","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「啊，那我来打扫」","art":{"background":"a211","sprites":[{"asset":"a249","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「不做点什么我感觉静不下来。所以让我帮忙吧」","art":{"background":"a211","sprites":[{"asset":"a628","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「我知道了。那就拜托你了」","art":{"background":"a211","sprites":[{"asset":"a291","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「那么，开始动手吧」","art":{"background":"a211","sprites":[{"asset":"a291","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我并不讨厌打扫……准确来说，所有家务活都不讨厌。","art":{"background":"a1","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"但老家有妈妈，这里也有常陆在，所以我并不常做。","art":{"background":"a1","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"总之先打开吸尘器清理下地板吧。","art":{"background":"a1","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「嗯，嗯……好！大概就这样了」","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我把榻榻米和地板清理干净，顺便把家里用水的地方也打扫了一遍。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"由于用水的地方要日常认真清理的话需要花很多时间，所以打扫完后我心里有了一些成就感。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"茉子","text":"「有地，辛苦你了。今天真的很谢谢你」","art":{"background":"a211","sprites":[{"asset":"a330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「啊，没事的。没碍到你的话就好」","art":{"background":"a211","sprites":[{"asset":"a330","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「怎么可能会碍到我呢。连水龙头周围都清理得这么干净，真是帮大忙了」","art":{"background":"a211","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「听到你这么说我很开心」","art":{"background":"a211","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"但可能是由于长时间保持着不习惯的姿势，给腰部增添了一些负担。","art":{"background":"a211","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「真的很谢谢你」","art":{"background":"a211","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「请不要这么客气。我反倒是要感谢你给我家务活做」","art":{"background":"a211","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「我喜欢做家务，而且这也是我的本分」","art":{"background":"a211","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我回来了」","art":{"background":"a211","sprites":[{"asset":"a410","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「啊，芳乃大人，欢迎回来」","art":{"background":"a211","sprites":[{"asset":"a410","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a291","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「欢迎回来。祈祷那边怎么样？」","art":{"background":"a211","sprites":[{"asset":"a410","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a291","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「顺利结束了。你才是……这是怎么了？」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「哎？什么怎么了？」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「浑身大汗的」","art":{"background":"a211","sprites":[{"asset":"a1888","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"用手擦了擦额头，能明确地感觉到汗水。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「因为打扫得很投入……」","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「难道我现在浑身汗臭味？」","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「倒是没有臭味」","art":{"background":"a211","sprites":[{"asset":"a1302","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「有地来帮我打扫。结果他似乎一不小心就投入起来了」","art":{"background":"a211","sprites":[{"asset":"a2102","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a284","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「然后将所有看见的，连细小的污垢都擦干净了」","art":{"background":"a211","sprites":[{"asset":"a2102","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a284","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「是这样啊」","art":{"background":"a211","sprites":[{"asset":"a1293","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a284","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「今天因为有有地的帮忙，比平常还要干净」","art":{"background":"a211","sprites":[{"asset":"a1293","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a291","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「那么，我该去准备晚饭了」","art":{"background":"a211","sprites":[{"asset":"a1293","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"常陆要是出去买东西的话，那就只剩我们俩了……","art":{"background":"a211","sprites":[{"asset":"a1293","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃・将臣","text":"『………』","art":{"background":"a211","sprites":[{"asset":"a2103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我禁不住和芳乃四目相对。","art":{"background":"a211","sprites":[{"asset":"a2103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"常陆自然没有忽视这一点。","art":{"background":"a211","sprites":[{"asset":"a2103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「……啊」","art":{"background":"a211","sprites":[{"asset":"a631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「啊哈，原～来如此」","art":{"background":"a211","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「！？」","art":{"background":"a211","sprites":[{"asset":"a331","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「那，我出去买晚饭用的菜了」","art":{"background":"a211","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「今天或许会花不少时间，两位请慢慢享受」","art":{"background":"a211","sprites":[{"asset":"a291","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"茉子","text":"「那么那么～我告辞了」","art":{"background":"a211","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"常陆没给我们反驳的机会就急急忙忙地走掉了。","art":{"background":"a211","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「……难道说，她发现了？」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「毫无疑问」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「～～～不过这是为什么啊，我们明明又没有什么可疑的行为……」","art":{"background":"a211","sprites":[{"asset":"a2103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「如果去问本人，她肯定会回答“因为是忍者”吧」","art":{"background":"a211","sprites":[{"asset":"a2103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"不过最关键的原因还是我们正好在那一刻做了眼神交流吧。","art":{"background":"a211","sprites":[{"asset":"a2103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「……呜……」","art":{"background":"a211","sprites":[{"asset":"a2104","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「不过……现在说这个也没用。被发现了也没办法」","art":{"background":"a211","sprites":[{"asset":"a2105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「也是。一直介意下去……或许也没什么好事」","art":{"background":"a211","sprites":[{"asset":"a2105","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"视线再次相交。","art":{"background":"a211","sprites":[{"asset":"a2106","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"她迷离的双眼，火热的呼吸又重新点燃了我因为打扫而忘却的欲望。","art":{"background":"a211","sprites":[{"asset":"a2106","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「那、那个……可以吗？」","art":{"background":"a211","sprites":[{"asset":"a2107","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"芳乃并没有明确说“可以怎么样”，她只是默默地把身体凑了过来。","art":{"background":"a211","sprites":[{"asset":"a2107","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"事到如今已无需多余的语言。","art":{"background":"a211","sprites":[{"asset":"a2107","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我也一直希望这么做。","art":{"background":"a211","sprites":[{"asset":"a2107","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我现在就想立刻抱住她，亲吻她，褪去她的衣物――啊，不，等等！？","art":{"background":"a211","sprites":[{"asset":"a2107","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………」","art":{"background":"a211","sprites":[{"asset":"a1888","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我急忙后退，跟她保持与方才同样的距离。","art":{"background":"a211","sprites":[{"asset":"a1888","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「那个……将臣？」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「啊，不，不是的。就是你看，我浑身都是汗嘛。我打算先把身体洗干净」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我一身臭汗，你也觉得有点脏吧？」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"呃……怎么感觉我跟个女孩子家一样。但我并不是在开玩笑。","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"现在虽然她说没臭味，若是我们贴在一起的话，或许就会觉得我臭了。","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"但在那种状态下芳乃也应该不会说出口，只是她对我的印象会变差。","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我想先去浴室把汗冲一冲。那个，真不好意思要你等」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「不，本就是因为我让你久等了才会这样的」","art":{"background":"a211","sprites":[{"asset":"a1294","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「那，不好意思，你稍微等一下。我很快就回来」","art":{"background":"a211","sprites":[{"asset":"a1294","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「不过听了你的话，我也想先去洗澡……」","art":{"background":"a211","sprites":[{"asset":"a2108","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「芳乃也流汗了？祈祷有这么辛苦吗？」","art":{"background":"a211","sprites":[{"asset":"a2108","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「不、不是的，祈祷本身并不会有激烈的运动」","art":{"background":"a211","sprites":[{"asset":"a784","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我和爸爸都没有流什么汗……」","art":{"background":"a211","sprites":[{"asset":"a2109","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………？」","art":{"background":"a211","sprites":[{"asset":"a2109","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「可能是因为一直在想着约定的原因……这个，我，这，那个……」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"芳乃满脸通红低着头。","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"双脚也互相扭扭捏捏地蹭个不停……啊。","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「难道……你、你湿了？」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「再、再怎么样也请不要说得这么直接！应、应该还没到湿的程度……」","art":{"background":"a211","sprites":[{"asset":"a2111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「但、但是……陷入比自己想象中还要害羞的状态的可能性也不是没有……」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"既然如此，那听到我要去洗澡，她也想把自己的身子洗干净是很正常的。","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「那，你先吧」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「不、不用。还是你先吧」","art":{"background":"a211","sprites":[{"asset":"a2108","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我，那个……如果先去洗的话，在等待的时候，那个……或许又会弄脏的」","art":{"background":"a211","sprites":[{"asset":"a2104","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………」","art":{"background":"a211","sprites":[{"asset":"a2104","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"这么夸张吗！？","art":{"background":"a211","sprites":[{"asset":"a2104","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"女生光是想象就能这么湿的吗！？","art":{"background":"a211","sprites":[{"asset":"a2104","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"啊，不，貌似有些男性也会不经过接触就射精的。","art":{"background":"a211","sprites":[{"asset":"a2104","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「……或者……那个……」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………？」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「家里的浴室很大对吧」","art":{"background":"a211","sprites":[{"asset":"a2103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「是啊。不是很大，是相当大」","art":{"background":"a211","sprites":[{"asset":"a2103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「大、大得两个人一起进去也……没问题是吧」","art":{"background":"a211","sprites":[{"asset":"a2112","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………」","art":{"background":"a211","sprites":[{"asset":"a2112","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「而且，那个……这个……办那种事不是会弄脏很多地方的吗」","art":{"background":"a211","sprites":[{"asset":"a2113","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「而且把刚打扫干净的房间弄脏貌似也不太好」","art":{"background":"a211","sprites":[{"asset":"a2114","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「请你说点什么啊……」","art":{"background":"a211","sprites":[{"asset":"a2111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「……芳乃」","art":{"background":"a211","sprites":[{"asset":"a2111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我、我在！？」","art":{"background":"a211","sprites":[{"asset":"a2115","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我们一起去洗澡吧」","art":{"background":"a211","sprites":[{"asset":"a2115","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「如如如如果，不会给你添麻烦……的话……」","art":{"background":"a211","sprites":[{"asset":"a2114","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「虽然我也确实很在意我一身臭汗……但我也受不了了」","art":{"background":"a211","sprites":[{"asset":"a2114","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我现在可是在拼命地忍耐……你看」","art":{"background":"a211","sprites":[{"asset":"a2114","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「啊……还、还是这么硬，这么热……」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「一想到芳乃，我这里就变成这样了」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「但，我不想因为浑身汗臭被你讨厌，所以一直在忍耐」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「用不着忍耐的。我会……把你的身体给……洗干净的」","art":{"background":"a211","sprites":[{"asset":"a2104","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「所以我们就放心做吧……约好的做爱……」","art":{"background":"a211","sprites":[{"asset":"a2116","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「嗯，当然要做。我已经忍不住了」","art":{"background":"a211","sprites":[{"asset":"a2116","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「虽然算不上是什么交换条件，不过那个……」","art":{"background":"a211","sprites":[{"asset":"a2110","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「如果我身上陷入了很羞耻的状态……也请你见谅……」","art":{"background":"a211","sprites":[{"asset":"a2111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我反而觉得高兴死了」","art":{"background":"a211","sprites":[{"asset":"a2111","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我抓住芳乃的手，就这样快步往浴室走去。","art":{"background":"a211","sprites":[]},"chapter":"7-2"}]