[{"speaker":"芦花","text":"「拜托了」","art":{"background":"a1677","sprites":[{"asset":"a1579","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"芦花姐端出她做的水晶冰沙。","art":{"background":"a1677","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"叔叔用勺子挖了一勺放入嘴中。","art":{"background":"a1677","sprites":[]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「嗯……」","art":{"background":"a1677","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"他闭上眼睛细细品尝，表情仍旧严肃。","art":{"background":"a1677","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「怎……怎么样？」","art":{"background":"a1677","sprites":[{"asset":"a1692","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「这与其说是雪葩，吃起来更像是刨冰啊」","art":{"background":"a1677","sprites":[{"asset":"a1692","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「是的。口感很清爽吧？」","art":{"background":"a1677","sprites":[{"asset":"a991","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「偏甜的桃子味……这个余味是梅子吗」","art":{"background":"a1677","sprites":[{"asset":"a991","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「梅子不会喧宾夺主，和桃子的甜味相得益彰。口中的回味是一股清甜的梅子香气」","art":{"background":"a1677","sprites":[{"asset":"a991","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"之后芦花姐继续着对水晶冰沙的研究，最后终于做出了让叔叔满意的作品。","art":{"background":"a4478","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"为了能够尝到果肉的口感，以果泥为底料，并且为了让回味更加清爽而采用梅子调节了口味。","art":{"background":"a4478","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我也有幸品尝了试作品，滋味无可挑剔。","art":{"background":"a4478","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"话虽如此，我的舌头也只是门外汉的舌头。","art":{"background":"a1677","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我不确定这样的味道对于长年从事甜品制作的叔叔来说是否合格。","art":{"background":"a1677","sprites":[]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「水果只有桃子吗？」","art":{"background":"a1677","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「不。我正在考虑用西瓜之类的去做。我打算挑几样作为堂食限定的商品」","art":{"background":"a1677","sprites":[{"asset":"a1577","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我还打算推出咖啡和抹茶口味的水晶冰沙让客人可以打包带走」","art":{"background":"a1677","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「这种做法……你觉得如何？」","art":{"background":"a1677","sprites":[{"asset":"a1564","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「……」","art":{"background":"a1677","sprites":[{"asset":"a1564","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「嗯……好吧。毕竟接下来的季节，像这样清爽的甜品会比较受欢迎」","art":{"background":"a1677","sprites":[{"asset":"a1564","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「试试看也无妨吧？」","art":{"background":"a1677","sprites":[{"asset":"a1563","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「真、真的？可以吗？」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「就先这么决定了。你就在夏天推出这款产品看看顾客的反应吧」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「是否要正式采用，或者纳入常规菜单……嗯，就看大家的反响如何了」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「那么……口味方面如何呢？」","art":{"background":"a1677","sprites":[{"asset":"a1692","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「……嗯，还不错」","art":{"background":"a1677","sprites":[{"asset":"a1692","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「味道上需要微调吗？」","art":{"background":"a1677","sprites":[{"asset":"a1564","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「苹果……」","art":{"background":"a1677","sprites":[{"asset":"a1564","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「哎？」","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「苹果之类的……可能不错」","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「虽然搭配桃子那种甜味水果后味道很平衡，不过苹果更加清爽的口味可能也很适合夏天」","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我、我明白了……你的意思莫非是，由我来做？」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花的父亲","text":"「你都做到这一步了。这款水晶冰沙商品，你就试着负责到底吧」","art":{"background":"a1677","sprites":[{"asset":"a1696","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「……」","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"叔叔的口气有些生硬。","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"他并非没有提出建议。","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"可即便如此，关于要不要用苹果，甚至包括这款商品的口味在内，他都全权交给芦花姐负责。","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"这就意味着……他完全认可了她的成长。","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"这种事以往从未发生过。","art":{"background":"a1677","sprites":[{"asset":"a2442","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「嗯！」","art":{"background":"a1677","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"芦花姐点了点头，露出像孩子一样的天真笑容。","art":{"background":"a1677","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「～～～♪」","art":{"background":"a1","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「两份抹茶芭菲，拜托了」","art":{"background":"a967","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「明白」","art":{"background":"a967","sprites":[{"asset":"a994","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「～～～♪」","art":{"background":"a967","sprites":[{"asset":"a995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……」","art":{"background":"a967","sprites":[{"asset":"a986","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「姐姐好像心情很不错的样子。发生了什么事吗？」","art":{"background":"a967","sprites":[{"asset":"a1012","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「发生了点好事」","art":{"background":"a967","sprites":[{"asset":"a1012","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「什么？难不成哥哥送了她什么礼物吗？」","art":{"background":"a967","sprites":[{"asset":"a968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「很遗憾，不是那种事」","art":{"background":"a967","sprites":[{"asset":"a968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「最近我们俩的见面时间反而还减少了呢」","art":{"background":"a967","sprites":[{"asset":"a968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「是吗？已经没新鲜感了？」","art":{"background":"a967","sprites":[{"asset":"a1030","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「不是啦。只是因为她工作很忙而已」","art":{"background":"a967","sprites":[{"asset":"a1030","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"她一会儿忙着谈进货事宜，一会儿忙于钻研冰沙制作。","art":{"background":"a967","sprites":[{"asset":"a1030","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"我实在不忍心打搅她工作，所以最近两人亲热的机会很少。","art":{"background":"a967","sprites":[{"asset":"a1030","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"但是这种牺牲是值得的——","art":{"background":"a967","sprites":[{"asset":"a1030","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「不光是我，她的作品还得到了叔叔的认可哦」","art":{"background":"a967","sprites":[{"asset":"a1030","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「哎——是这样啊？」","art":{"background":"a967","sprites":[{"asset":"a986","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「虽然实际作为商品推出，应该还要等一段时间」","art":{"background":"a967","sprites":[{"asset":"a986","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「但是得到了叔叔的认可……对她来说应该是很值得高兴的事」","art":{"background":"a967","sprites":[{"asset":"a986","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「我记得做咖啡的时候，她不也得到认可了吗？」","art":{"background":"a967","sprites":[{"asset":"a980","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「那一次最后还是由叔叔帮忙调整了味道」","art":{"background":"a967","sprites":[{"asset":"a980","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「但这次叔叔连这部分的工作都全权交给了芦花姐」","art":{"background":"a967","sprites":[{"asset":"a980","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"这说明他进一步认可了芦花姐，认为她足以担任店的支柱。","art":{"background":"a967","sprites":[{"asset":"a980","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"对于曾对自己的软弱无力感到自卑的芦花姐来说，没有比这更令人高兴的事了。","art":{"background":"a967","sprites":[{"asset":"a980","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「所以这次新商品的意义跟以往完全不同哦」","art":{"background":"a967","sprites":[{"asset":"a980","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春","text":"「……听得我都有点好奇了。不知道能不能求她给我做一份」","art":{"background":"a967","sprites":[{"asset":"a3700","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「接下来她还会进行各种试制改进的，去要一份来吃应该没问题吧？」","art":{"background":"a967","sprites":[{"asset":"a3700","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"千代","text":"「喂喂，你们俩个给我好好工作啊」","art":{"background":"a967","sprites":[{"asset":"a980","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"小春・将臣","text":"『是，对不起！』","art":{"background":"a967","sprites":[{"asset":"a1030","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"那天的芦花姐一直边工作边哼着小曲，心情很是开心。","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"这种状态直到晚上关店打烊都没有改变。","art":{"background":"a119","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"打烊后的店内只剩下我们俩。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"芦花姐愉快地练着三味线。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我愣愣地望着芦花姐，听着她的三味线的琴声。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「……」","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"今晚三味线的音色欢乐轻快，就像在反映芦花姐的心情……不知是不是我的错觉？","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"总之芦花姐好像很高兴，她的水晶冰沙能够得到认可真是太好了。","art":{"background":"a1700","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「……阿将？你在笑什么啊？」","art":{"background":"a1700","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「我只是很高兴看到你这么幸福」","art":{"background":"a1700","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「嘿嘿嘿，谢谢你。这一切都要归功于你啦」","art":{"background":"a1700","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「这不过是你自己的努力开花结果罢了」","art":{"background":"a1700","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「能够得到叔叔的认可，对你来说肯定没有比这更开心的事了吧」","art":{"background":"a1700","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「嗯——应该说是又不是吧……」","art":{"background":"a1700","sprites":[{"asset":"a1577","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「咦？是这样吗？」","art":{"background":"a1700","sprites":[{"asset":"a1577","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「我当然很高兴的。但要说没有比这更开心的事……可能言过其实了吧」","art":{"background":"a1700","sprites":[{"asset":"a1577","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「更令人开心的事……也是有的」","art":{"background":"a1700","sprites":[{"asset":"a990","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「比如？」","art":{"background":"a1700","sprites":[{"asset":"a990","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「哎哟，这还要问啊？你就不能动动脑子吗」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"将臣","text":"「……唔」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"芦花","text":"「来，到我这来。我教你弹三味线」","art":{"background":"a1700","sprites":[{"asset":"a990","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-2"},{"speaker":"","text":"我拿起三味线，随即感到后背多了几分重量……","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"不过那是一种非常柔软温暖的重量。","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"紧贴在一起之后，内心好像就舒展了开来。","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「我确实很高兴能得到爸爸的认可。不过呢，阿将」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「能够和喜欢的人成为恋人，能够像这样紧紧贴在一起……就是无比幸福的事情」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「阿将，我最喜欢你了……嘿嘿」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「我也最喜欢你了」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「对不起哦，我这阵子很忙，你一定寂寞了吧？」","art":{"background":"a4481","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「我是很寂寞。但是不要紧，能看到你的努力开花结果，我也非常开心」","art":{"background":"a4481","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「……谢谢你……」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"说罢，芦花姐压在我背上的重量又多了几分。","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"这样一来……胸部顶在背后的触感当然也越发鲜明。","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「……芦花姐……顶到了哦？」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「是我故意在顶你啦……你心里明明很清楚」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「意思是……」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「意思是……在忍耐的人不只你一个」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「我也很寂寞哦……但如果再贪图享乐的话可能就会让努力付之东流，所以我就忍了下来」","art":{"background":"a4181","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「但现在不必忍了？」","art":{"background":"a4181","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「今天轻松一下应该没关系吧？毕竟能够得到认可我很高兴……」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「不能光忍着，偶尔也要奖励一番……振奋精神是很重要的哦。而且也能让干劲保持下去♪」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「阿将也一样吧？你也想得到前阵子的补偿吧？」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"她的语气色色的。","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"她的眼珠此刻应该已经变成爱心形状了吧。","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"耳边听到了这样的话语……","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我体内的兴奋也渐渐抬头。","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「想啊，当然想啊」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「……来振奋一下精神吧？」","art":{"background":"a4481","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a4481","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「店门已经关好了吧？」","art":{"background":"a4481","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「没问题。已经不会有人再进来了」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「我说……今天你想怎么做？」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「我要享受芦花姐胸部的触感」","art":{"background":"a4479","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「嘿嘿，很老实，很好……」","art":{"background":"a4480","sprites":[]},"chapter":"8-2"}]