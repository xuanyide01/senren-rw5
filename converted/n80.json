[{"speaker":"将臣","text":"「廉太郎，不好意思，你能帮忙教教她们吗？」","art":{"background":"a1044","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「哎？我当然不介意……这种机会我求之不得啊。那你去干嘛？」","art":{"background":"a1044","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「也没什么大不了的……就是有点私事要去办」","art":{"background":"a1044","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「……嗨，搞了半天是要上厕所啊。用不着这么绕来绕去的，又不是小孩子了」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"让他这么一直误会下去也好。","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不好意思，麻烦你了………………不过仔细想想，感觉有点不放心啊」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「哎，你这话什么意思啊」","art":{"background":"a1044","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「没什么，我就是有点担心你会不会对她们俩做什么不该做的事」","art":{"background":"a1044","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「你怎么跟小春一样，一点都不信任我啊」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「你有那么多前科，谁敢信任你」","art":{"background":"a1044","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「再怎么说她都是巫女大人，我怎么可能图谋不轨啊」","art":{"background":"a1044","sprites":[{"asset":"a71","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「蕾娜那边也是，爷爷都吩咐过我了。不该干的事我肯定不会干」","art":{"background":"a1044","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"看来廉太郎也还是懂得分寸的。","art":{"background":"a1044","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「当然了，我也想跟她们搞好关系，肯定还是会闲聊几句的」","art":{"background":"a1044","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「总不会这样也不行吧？」","art":{"background":"a1044","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「那倒是可以」","art":{"background":"a1044","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我可能会离开比较久，接下来就交给你了」","art":{"background":"a1044","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「喂喂喂，怪不得你这么难为情，搞了半天原来是大号啊」","art":{"background":"a1044","sprites":[{"asset":"a103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「麻烦你走远点啊，味道飘到这边来就尴尬了」","art":{"background":"a1044","sprites":[{"asset":"a1040","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「知道了知道了」","art":{"background":"a1044","sprites":[{"asset":"a1040","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"将她们交给廉太郎后，我踏进了丛林深处。","art":{"background":"a1044","sprites":[{"asset":"a1040","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「唔……」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"集中视线，仔细观察地面。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"时不时挖挖土，拨开落叶。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"但没什么奇怪的地方。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"地上只有普通的石头。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「果然很难发现啊」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"毕竟连小雨都毫无收获。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"以前商量的时候也早就明白很难用肉眼去发现了。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"不过……既然来都来了，全部都交给小雨一个人，我也过意不去。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我也做我力所能及的事吧，虽然这可能只是自我满足。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"然而……","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「这样找下去何止是自我满足，搞不好还会无功而返」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「不，不能打退堂鼓。必须得相信绝对能找到！」","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我振作精神，开始重新寻找碎片。","art":{"background":"a1096","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"——在那之后，我找了很多地方，却什么也没发现。真是一语成谶，到头来只得无功而返。","art":{"background":"a1","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"老是呆在山里或许会让大家担心的。","art":{"background":"a1","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"该到此为止了……","art":{"background":"a1","sprites":[]},"chapter":"3-2"}]