[{"speaker":"廉太郎","text":"「咦？将臣，这么晚你在这里做什么？」","art":{"background":"a1141","sprites":[{"asset":"a87","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「是廉太郎啊。我就散个步，想点事情」","art":{"background":"a1141","sprites":[{"asset":"a87","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"廉太郎","text":"「想事情？」","art":{"background":"a1141","sprites":[{"asset":"a1019","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"廉太郎","text":"「真少见啊。不过，在这里遇见也算是机缘巧合，有什么心事就跟我说说呗」","art":{"background":"a1141","sprites":[{"asset":"a96","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「不，算了吧，问题已经解决了」","art":{"background":"a1141","sprites":[{"asset":"a96","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"廉太郎","text":"「什、什么嘛……一脸轻松的，好诡异啊」","art":{"background":"a1141","sprites":[{"asset":"a98","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「别在意！」","art":{"background":"a1141","sprites":[{"asset":"a98","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「咱们一起去芦花姐那边吧」","art":{"background":"a1141","sprites":[{"asset":"a98","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"廉太郎","text":"「啊？早关门了」","art":{"background":"a1141","sprites":[{"asset":"a105","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「那去你房间也行。今天我想玩玩」","art":{"background":"a1141","sprites":[{"asset":"a105","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"廉太郎","text":"「想玩玩……也行吧」","art":{"background":"a1141","sprites":[{"asset":"a73","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「以后也请多指教了，廉太郎」","art":{"background":"a1141","sprites":[{"asset":"a73","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"廉太郎","text":"「你今天真的很诡异啊……」","art":{"background":"a1141","sprites":[{"asset":"a932","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「都说了别在意这些小事！」","art":{"background":"a1141","sprites":[{"asset":"a932","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"就这样，我的新生活开始了。","art":{"background":"a119","sprites":[]},"chapter":"3-7"}]