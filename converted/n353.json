[{"speaker":"","text":"这是小雨开始上学后的第一个星期天。","art":{"background":"a1","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我约她午后一起前去外公的旅馆。","art":{"background":"a1","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「为什么要去找玄十郎啊，主人」","art":{"background":"a19","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「不是已经不用练刀了吗」","art":{"background":"a19","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「行了行了，跟我来」","art":{"background":"a19","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我和她一边慢悠悠地走，一边晃着牵起的手。","art":{"background":"a19","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「你就当是陪我散散步吧」","art":{"background":"a19","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我稍微捏紧了这双我握了无数次的手，朝她笑了笑。","art":{"background":"a19","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「这倒无所谓……」","art":{"background":"a19","sprites":[{"asset":"a186","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「不过那旅馆都去了那么多次了。算了，无所谓啦」","art":{"background":"a19","sprites":[{"asset":"a224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"她耸了耸肩，最后还是老老实实地跟了过来。","art":{"background":"a19","sprites":[{"asset":"a224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我们到了旅馆。","art":{"background":"a49","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「怎么有车停在这，有客人吗」","art":{"background":"a49","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「也不算是客人……哎呀，待会你就懂了」","art":{"background":"a49","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「啊？什么意思呀」","art":{"background":"a49","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"小雨听了我的话之后一脸茫然疑惑。","art":{"background":"a49","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「行啦，大家都在等着呢。进去吧」","art":{"background":"a49","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"说完，我就越过熟知的车辆向大门走去。","art":{"background":"a49","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「今天的主人怎么有点莫名其妙的……」","art":{"background":"a49","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"小雨只是疑惑地歪了歪头，和我牵着手走向了门口。","art":{"background":"a49","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「打扰了」","art":{"background":"a2764","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「玄十郎，身体怎么样……嗯？」","art":{"background":"a2888","sprites":[{"asset":"a263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"小雨看了客厅里的人一眼，瞪大了眼睛。","art":{"background":"a2888","sprites":[{"asset":"a263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"客厅内已有三人。","art":{"background":"a2888","sprites":[{"asset":"a263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"其中一人当然是外公。","art":{"background":"a2888","sprites":[{"asset":"a93","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"幸弘","text":"「哎呀，初次见面。我是将臣的父亲，有地幸弘」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"都子","text":"「我是她的妈妈，有地都子。我家儿子一直受你照顾了」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「……什么？！」","art":{"background":"a2888","sprites":[{"asset":"a265","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「是、是主人的父亲和母亲？！」","art":{"background":"a2888","sprites":[{"asset":"a142","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"小雨惊讶得瞪圆了眼睛。","art":{"background":"a2888","sprites":[{"asset":"a142","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「嗯，是我请他们今天到这来的」","art":{"background":"a2888","sprites":[{"asset":"a142","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「怎、怎么不早点说呀！」","art":{"background":"a2888","sprites":[{"asset":"a140","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「本座也要做好心理准备才行啊……」","art":{"background":"a2888","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"幸弘","text":"「没事没事，不用那么拘谨」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"幸弘","text":"「放轻松一点」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"都子","text":"「不过还真是个可爱的小姑娘呀」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"都子","text":"「简直就像是日本人偶一样」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「哎、哎呀，母亲大人，您、您过奖了……！」","art":{"background":"a2888","sprites":[{"asset":"a2992","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"小雨突然被表扬，惹得她手足无措。","art":{"background":"a2888","sprites":[{"asset":"a2992","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"她只得当场慌慌张张地用双手遮住通红的脸。","art":{"background":"a2888","sprites":[{"asset":"a2992","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"玄十郎","text":"「来，将臣。现在所有人都到场了」","art":{"background":"a2888","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"玄十郎","text":"「你不是有事要说吗？说吧」","art":{"background":"a2888","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"外公看向我。","art":{"background":"a2888","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我点了点头，一本正经地朝前跪坐。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"然后……","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「爸爸，妈妈，还有外公」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「我想要和这个女孩结婚，一直在穗织生活下去」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「我在此恳求你们的同意」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我朝他们三人低下头，如此宣布道。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我告诉他们我想留下来。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"以及想和小雨白头偕老。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「什、什么？！我们要做夫妇吗？！」","art":{"background":"a2888","sprites":[{"asset":"a1120","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「主人，本座怎么从没听说过这档子事？！」","art":{"background":"a2888","sprites":[{"asset":"a2995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我身边的小雨不知所措，原本就通红的脸更红了。","art":{"background":"a2888","sprites":[{"asset":"a2995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「我觉得这就是所谓的给你幸福」","art":{"background":"a2888","sprites":[{"asset":"a2995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「所以我想和你许下约定。我说过的话，我就要做到」","art":{"background":"a2888","sprites":[{"asset":"a2995","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我微笑着看向小雨。","art":{"background":"a2888","sprites":[{"asset":"a3383","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「小雨，请和我结婚吧」","art":{"background":"a2888","sprites":[{"asset":"a3383","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「我想和你结为夫妻，居住于此」","art":{"background":"a2888","sprites":[{"asset":"a3383","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「这是我有地将臣一生的愿望」","art":{"background":"a2888","sprites":[{"asset":"a3383","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"我在双亲和外公的面前向茫然的她求婚了。","art":{"background":"a2888","sprites":[{"asset":"a3383","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「主、主人……」","art":{"background":"a2888","sprites":[{"asset":"a224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「呜呜，主人……！」","art":{"background":"a2888","sprites":[{"asset":"a3278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"小雨的眼眶中开始蓄起泪珠。","art":{"background":"a2888","sprites":[{"asset":"a3278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"但是她却笑了。","art":{"background":"a2888","sprites":[{"asset":"a3278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"这是我见过的，她最开心的笑容。","art":{"background":"a2888","sprites":[{"asset":"a3278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"她笑得如此幸福。","art":{"background":"a2888","sprites":[{"asset":"a3278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"都子","text":"「真是的，他还没跟人家女孩子说清楚吗？」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"幸弘","text":"「丛雨小姐，你愿意嫁给我家这个蠢儿子吗？」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"从我双亲的口吻中听得出他们已经同意了。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"他们苦笑着。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「愿、愿意……」","art":{"background":"a2888","sprites":[{"asset":"a3281","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「我只想嫁给主人……不，是将臣」","art":{"background":"a2888","sprites":[{"asset":"a3278","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"丛雨","text":"「从今以后请多多指教……」","art":{"background":"a2888","sprites":[{"asset":"a3285","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"这次换小雨向在场大人们正坐，深深低下了头。","art":{"background":"a2888","sprites":[{"asset":"a3285","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"此刻她已不是“丛雨大人”。","art":{"background":"a2888","sprites":[{"asset":"a3285","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"她只是一介普通的女子，小雨。","art":{"background":"a2888","sprites":[{"asset":"a3285","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"都子","text":"「小雨，你就叫我妈吗吧」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"幸弘","text":"「那就叫我爸爸吧」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"玄十郎","text":"「那我就是外公了」","art":{"background":"a2888","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"","text":"爸爸、妈妈和外公都满脸欢喜地说道。","art":{"background":"a2888","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"尾声"},{"speaker":"将臣","text":"「谢谢你们……！」","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"得到家人祝福的欣喜让我浑身颤抖。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我好高兴。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"他们都接受了小雨。","art":{"background":"a2888","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「主人！」","art":{"background":"a3384","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「哇？！」","art":{"background":"a3384","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"小雨突然扑到了我的身上抱紧了我，我差点就要被她压倒。","art":{"background":"a3384","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「本座孤独生活了五百年，现在却拥有了这么多家人……！」","art":{"background":"a3385","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「主人给了本座那么多、那么多……！」","art":{"background":"a3385","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「对本座来说，主人才是活神仙……！」","art":{"background":"a3385","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"她将脸埋入了我的胸前抽噎道。","art":{"background":"a3385","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我极力抑制住心中的爱怜之情，轻轻地抱紧了她――抱紧了我的新娘。","art":{"background":"a3385","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"随后我笑着说道。","art":{"background":"a3385","sprites":[]},"chapter":"尾声"},{"speaker":"将臣","text":"「从今以后“主人”二字可就有其他的意味了」","art":{"background":"a3385","sprites":[]},"chapter":"尾声"},{"speaker":"丛雨","text":"「啊哈哈，是啊，老公……！」","art":{"background":"a3386","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"听了我们的对话，在场的人都笑了起来。","art":{"background":"a3386","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我绝不会忘记今天。","art":{"background":"a3386","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我已经不是那个在城市中碌碌无为的我了。","art":{"background":"a3386","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"我已经下了决心，要与深爱的少女一起在这片土地生活下去。我对此无比自豪。","art":{"background":"a3386","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"谢谢你。","art":{"background":"a3386","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"谢谢你，小雨。","art":{"background":"a3386","sprites":[]},"chapter":"尾声"},{"speaker":"","text":"谢谢你等待了漫长的五百年，与我相遇……","art":{"background":"a3386","sprites":[]},"chapter":"尾声"}]