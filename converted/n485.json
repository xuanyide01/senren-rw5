[{"speaker":"","text":"于是我和小春做好了心理准备，前往外公那里。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"不知道他会有什么反应……我真的很害怕。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"但是我和小春的事情不可能一直瞒下去。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"而且更重要的是，我自己并不认为这是一件必须要隐瞒的事情。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"所以我不想躲躲藏藏，而是要正大光明地迎战障碍。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"我希望我们能光明磊落地走在镇上。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"不是以表兄妹，而是以一对情侣的身份。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"小春","text":"「哥哥」","art":{"background":"a49","sprites":[{"asset":"a64","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「小春，早上好」","art":{"background":"a49","sprites":[{"asset":"a64","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「嗯、嗯……早上好」","art":{"background":"a49","sprites":[{"asset":"a68","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"小春似乎也无法掩盖自己内心的紧张……","art":{"background":"a49","sprites":[{"asset":"a68","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"没办法，因为接下来我们要让外公认可一件非同小可的事情。","art":{"background":"a49","sprites":[{"asset":"a68","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「爷爷呢？」","art":{"background":"a49","sprites":[{"asset":"a61","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我告诉他有话要说，让他在屋里等着了」","art":{"background":"a49","sprites":[{"asset":"a61","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「是、是吗……顺便问一下，他今天心情如何？」","art":{"background":"a49","sprites":[{"asset":"a2976","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「不能说好也不能说不好吧。至少不算坏」","art":{"background":"a49","sprites":[{"asset":"a2976","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「不过仔细想一想，根本就没见外公心情非常好过」","art":{"background":"a49","sprites":[{"asset":"a2976","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「嗯……这倒也是」","art":{"background":"a49","sprites":[{"asset":"a2978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「虽然他并不是完全没有笑容……但是也从没见他笑嘻嘻的」","art":{"background":"a49","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我也没见过，所以就放弃去等他心情好的日子了。不过他今天的心情确实不算坏」","art":{"background":"a49","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「嗯，是啊。那……我们走吧」","art":{"background":"a49","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「好的」","art":{"background":"a49","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「打扰了」","art":{"background":"a0","sprites":[]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「嗯」","art":{"background":"a0","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「让你久等了」","art":{"background":"a2888","sprites":[{"asset":"a93","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「早、早上好，爷爷」","art":{"background":"a2888","sprites":[{"asset":"a3733","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「哦，早上好。小春也一起吗？」","art":{"background":"a2888","sprites":[{"asset":"a3733","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a603","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「嗯。因为要说的事情和我的未来也有很大关系……」","art":{"background":"a2888","sprites":[{"asset":"a2985","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a603","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「是吗」","art":{"background":"a2888","sprites":[{"asset":"a90","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"在深入询问之前，外公端正了坐姿。","art":{"background":"a2888","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"我和小春在外公正面挺直身板坐下。","art":{"background":"a2888","sprites":[]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「你们俩表情都这么严肃，到底是要说什么事？」","art":{"background":"a2888","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「其实……那个……」","art":{"background":"a2888","sprites":[{"asset":"a3263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「外公，我们想跟你说一件严肃的事情」","art":{"background":"a2888","sprites":[{"asset":"a90","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「……」","art":{"background":"a2888","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"外公用沉默催促着我们。","art":{"background":"a2888","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"我轻轻吸了一口气，让自己下定了决心，随后目不转睛地看着外公。","art":{"background":"a2888","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"然后——","art":{"background":"a2888","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我喜欢小春」","art":{"background":"a2888","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「……」","art":{"background":"a2888","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"外公的眉毛向上抽了一下。","art":{"background":"a2888","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"但是他依旧没有说话，而是继续直视着我和小春。","art":{"background":"a2888","sprites":[{"asset":"a3263","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「我也喜欢哥哥。是、是喜欢作为一名男性的他……我的感情……是认真的」","art":{"background":"a2888","sprites":[{"asset":"a3329","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我们现在正在作为恋人交往」","art":{"background":"a2888","sprites":[{"asset":"a3329","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我们没有随便玩玩的意思。按照现在的情况下去……我肯定会和小春结婚」","art":{"background":"a2888","sprites":[{"asset":"a3329","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「至少我是真的想和她结婚」","art":{"background":"a2888","sprites":[{"asset":"a3329","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「我的想法和哥哥一样。我认真思考过我们的关系，在此基础上，我依旧希望有朝一日能和他结婚」","art":{"background":"a2888","sprites":[{"asset":"a4161","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「…………然后呢？」","art":{"background":"a2888","sprites":[{"asset":"a90","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我想让外公正式承认这件事」","art":{"background":"a2888","sprites":[{"asset":"a90","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「为什么要跟我说？结婚的事情应该和你们父母商量才对」","art":{"background":"a2888","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「当然，我也会去问候舅舅舅妈。但是我想先和你说一声」","art":{"background":"a2888","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我和小春是表兄妹。两人开始认真交往的话……」","art":{"background":"a2888","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「可能会给生活在这个镇子上的舅舅舅妈以及外公你添麻烦」","art":{"background":"a2888","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"这个镇子很小，任何事情都会飞快地传播开来。","art":{"background":"a2888","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"因为我们是表兄妹，传播过程中很可能会被加上一些子虚乌有的事情。","art":{"background":"a2888","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"到时候不单单是我们两个当事人，还可能波及到我们周围的人。","art":{"background":"a2888","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"所以必须事先告知他们。","art":{"background":"a2888","sprites":[]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「我也确实有一些担忧的事……但是你们既然来找我了，说明你们已经下定决心了吧」","art":{"background":"a2888","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春・将臣","text":"『嗯！』","art":{"background":"a2888","sprites":[{"asset":"a3325","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「那么将臣，我们换个地方吧」","art":{"background":"a2888","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「哎？」","art":{"background":"a2888","sprites":[{"asset":"a93","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「男子汉之间的对话不需要语言」","art":{"background":"a2888","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「呀啊啊啊啊啊！」","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"外公高声吼叫着，击中我带在头上的面部护具。","art":{"background":"a1","sprites":[]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「怎么了，将臣。你的决心就这么不堪一击吗？」","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「你若对小春是真心，那就从我这里赢下一分吧。还是说，你的真心就区区这种程度？」","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「还、还没完呢！」","art":{"background":"a1","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「放马过来！」","art":{"background":"a1","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「呀啊啊啊啊啊啊啊啊————！」","art":{"background":"a1","sprites":[{"asset":"a575","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「差得远呢！」","art":{"background":"a1","sprites":[{"asset":"a931","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「哥、哥哥……」","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「啊……啊……啊……啊……」","art":{"background":"a580","sprites":[{"asset":"a570","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「啊……啊……」","art":{"background":"a580","sprites":[{"asset":"a570","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「怎、怎么了，呼吸……咳咳……呼吸都乱了」","art":{"background":"a580","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「外公你比我还要……呼、呼……」","art":{"background":"a580","sprites":[{"asset":"a577","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「还是说，你这就不行了？」","art":{"background":"a580","sprites":[{"asset":"a930","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「还、还没完……呼、呼……」","art":{"background":"a580","sprites":[{"asset":"a930","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"我已经和外公交手了几小时呢？","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"手臂无力，腿脚生疼。被打得头都有些晕了。","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"可恶……明明我更有体力……","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"虽然打中过外公几下，但是没打出过一次有效打击。","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"……这把年纪为什么还能坚持这么长时间？","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「呼………………唔唔！」","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「好，来吧！」","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"外公再次握紧竹刀摆好架势。","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"但是我已经没有余力了。","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「呀啊啊啊啊啊啊啊啊啊啊啊啊啊！！」","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"我发出嘶哑的吼声，从上段径直挥下，击向外公。","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"外公牢牢盯着我竹刀的轨迹……但却一动不动。","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"我的攻击终于打到了外公的头部防具上。","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「……啊……啊……外、外公？」","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「是我输了」","art":{"background":"a580","sprites":[{"asset":"a570","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「我手脚都不受控制了，这次是我没比过你的耐力」","art":{"background":"a580","sprites":[{"asset":"a578","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「那、那……」","art":{"background":"a580","sprites":[{"asset":"a578","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「按你的意思来吧。但是你们要自己去跟父母说」","art":{"background":"a580","sprites":[{"asset":"a573","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「谢、谢谢外公！」","art":{"background":"a580","sprites":[{"asset":"a573","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「谢谢」","art":{"background":"a580","sprites":[{"asset":"a573","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「小春……」","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"小春","text":"「……哥哥……」","art":{"background":"a580","sprites":[{"asset":"a4246","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「谢谢你，为了我，你那么地、那么地努力」","art":{"background":"a580","sprites":[{"asset":"a63","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「也不能那么说，这也是为了我自己」","art":{"background":"a580","sprites":[{"asset":"a63","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「不过……真是累了」","art":{"background":"a580","sprites":[{"asset":"a63","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「嗯。我都看到了，全部都看到了」","art":{"background":"a580","sprites":[{"asset":"a66","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"说着，小春紧紧抱住了我。","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"我也抱住她那小小的身体——","art":{"background":"a580","sprites":[]},"chapter":"8-4"},{"speaker":"小春","text":"「唔……哥哥，防具的臭味真重……」","art":{"background":"a580","sprites":[{"asset":"a2978","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「这、这没办法啊！防具的臭味是剑道的宿命啊」","art":{"background":"a580","sprites":[{"asset":"a2978","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「而且就凭我的本事，不做到这种程度根本没法赢外公！」","art":{"background":"a580","sprites":[{"asset":"a2978","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「我这我知道。哥哥的努力我都看在了眼里，我也很高兴……」","art":{"background":"a580","sprites":[{"asset":"a3262","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「但是这个味道，实在是……」","art":{"background":"a580","sprites":[{"asset":"a3260","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「……就不能忍忍吗！哼，我偏要抱得更紧！」","art":{"background":"a580","sprites":[{"asset":"a3260","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「哎！？啊，不要啊哥哥，臭死了臭死了！难闻死了」","art":{"background":"a580","sprites":[{"asset":"a3255","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「我本来就不反对你们」","art":{"background":"a4007","sprites":[{"asset":"a91","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「哎？」","art":{"background":"a4007","sprites":[{"asset":"a91","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"泡了澡、洗掉了汗水的我正喝着茶，总算喘过一口气来。就在这时，外公突然说出了这话。","art":{"background":"a4007","sprites":[{"asset":"a91","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「只是想试探一下你是否下定了决心」","art":{"background":"a4007","sprites":[{"asset":"a93","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「但是……真的不要紧吗？」","art":{"background":"a4007","sprites":[{"asset":"a93","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「不会被人说三道四吗……」","art":{"background":"a4007","sprites":[{"asset":"a3262","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a93","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「没问题。毕竟这里是“穗织”」","art":{"background":"a4007","sprites":[{"asset":"a3262","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a602","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「这是什么意思？」","art":{"background":"a4007","sprites":[{"asset":"a3262","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a602","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「其他地方都嫌弃穗织，几乎没有人会嫁过来或者入赘」","art":{"background":"a4007","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「要说例外，也就是巫女大人了」","art":{"background":"a4007","sprites":[{"asset":"a90","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「那也就是说……」","art":{"background":"a4007","sprites":[{"asset":"a61","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「若是亲兄妹结婚，那不仅违法，镇上的人的态度也都会大不一样……」","art":{"background":"a4007","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「但是堂亲表亲之间结婚，在这里是常有的事。而且越往久了说，就越是常见」","art":{"background":"a4007","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a4007","sprites":[{"asset":"a772","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"这么一说……好像还真没错。","art":{"background":"a4007","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"附近地区的人都不会来到这里，只有远方的人才会过来。","art":{"background":"a4007","sprites":[]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「当然了，也不能断言说绝对不会有问题。所以将臣，如果有个万一，你要保护好小春」","art":{"background":"a4007","sprites":[{"asset":"a94","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「嗯」","art":{"background":"a4007","sprites":[{"asset":"a94","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「既然下了这个决心，就要坚持下来」","art":{"background":"a4007","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我知道」","art":{"background":"a4007","sprites":[{"asset":"a91","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"玄十郎","text":"「那就好」","art":{"background":"a4007","sprites":[{"asset":"a558","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「那么……今天天已经很晚了」","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"小春","text":"「还是改天再和我爸爸妈妈说吧」","art":{"background":"a3001","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「嗯，改天吧」","art":{"background":"a3001","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"花的时间比预计的要长。","art":{"background":"a3001","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"另外……我也累了……","art":{"background":"a3001","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「哦？你们俩怎么都在这儿？」","art":{"background":"a3001","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a60","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「廉哥」","art":{"background":"a3001","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a60","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「今天你是来帮忙的吗？」","art":{"background":"a3001","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a60","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「是啊，终于干完活要回去了……你们呢？」","art":{"background":"a3001","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1019","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「刚和外公说完话，跟他汇报了我和小春开始交往的事」","art":{"background":"a3001","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1019","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「另外也说了，今后我们打算结婚」","art":{"background":"a3001","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1019","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「哦嚯，没想到你们的感情认真到了这种程度……」","art":{"background":"a3001","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「那爷爷是怎么说的？」","art":{"background":"a3001","sprites":[{"asset":"a84","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「让我坚持自己的决定，有什么事情时要好好保护小春」","art":{"background":"a3001","sprites":[{"asset":"a84","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「真像是他会说的话」","art":{"background":"a3001","sprites":[{"asset":"a4342","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「然后他说要考验下我的决心，让我和他比试了好几个小时」","art":{"background":"a3001","sprites":[{"asset":"a4342","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「啊……这也真像他会做的事」","art":{"background":"a3001","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「但是和爷爷战斗的哥哥……真是帅呆了」","art":{"background":"a3001","sprites":[{"asset":"a4078","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「谢谢，能听到你这么说我很开心」","art":{"background":"a3001","sprites":[{"asset":"a4078","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「不要啊……我要是去汇报结婚，他该不会让我也做这种事情吧」","art":{"background":"a3001","sprites":[{"asset":"a4343","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「操心这个之前，你首先得有个女朋友吧？」","art":{"background":"a3001","sprites":[{"asset":"a78","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a87","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「你个平胸妹说什么」","art":{"background":"a3001","sprites":[{"asset":"a78","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a79","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「……哼！」","art":{"background":"a3001","sprites":[{"asset":"a3258","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a79","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「哦？」","art":{"background":"a3001","sprites":[{"asset":"a3258","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a79","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"但是没想到小春露出从容的笑容，哼了一声。","art":{"background":"a3001","sprites":[{"asset":"a3258","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a79","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「你这么从容到底是什么情况？」","art":{"background":"a3001","sprites":[{"asset":"a3258","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a71","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「也有人喜欢这种的」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a71","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「……是吗。毕竟将臣性格好，他不过是在顾及你的心情罢了」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a932","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「不是你说的那样……」","art":{"background":"a3001","sprites":[{"asset":"a95","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a932","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「你真的确定要跟这家伙结婚？」","art":{"background":"a3001","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「这家伙一点儿也不可爱，还是个平胸妹」","art":{"background":"a3001","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「小春很可爱的，至于胸部，对我来说小春这样已经足够了」","art":{"background":"a3001","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「还有啊，结婚后记得叫我“哥”」","art":{"background":"a3001","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a3001","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「……我拒绝」","art":{"background":"a3001","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「你这么认真地拒绝，让我很受伤啊」","art":{"background":"a3001","sprites":[{"asset":"a79","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「喂，哥哥！？」","art":{"background":"a3001","sprites":[{"asset":"a3325","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「开玩笑啦，开玩笑」","art":{"background":"a3001","sprites":[{"asset":"a3325","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"不，一半是真实想法。","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"管廉太郎叫“哥”……到时候，我每次这么喊他，他肯定都会窃笑。","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"真想稍微揍他一顿。","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「廉太郎，不用担心那种事情」","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「我会负起责任，让我们幸福的」","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"小春","text":"「哎…………」","art":{"background":"a3001","sprites":[{"asset":"a61","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「……」","art":{"background":"a3001","sprites":[{"asset":"a1019","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「笨蛋，这话对她本人说去」","art":{"background":"a3001","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「哎？」","art":{"background":"a3001","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「啊，从没对我说过呢」","art":{"background":"a3001","sprites":[{"asset":"a2976","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「糟了！」","art":{"background":"a3001","sprites":[{"asset":"a2976","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「不好意思啊，我先被将臣求婚了」","art":{"background":"a3001","sprites":[{"asset":"a2976","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a96","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「不要啊，还给我！不对，不要缠着哥哥！」","art":{"background":"a3001","sprites":[{"asset":"a3736","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a96","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「哈哈哈。那么，为了不被将臣推倒，我要回去了！」","art":{"background":"a3001","sprites":[{"asset":"a60","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「你们反正刚被爷爷认可，正高兴着呢，要过一会儿才会回去对吧？」","art":{"background":"a3001","sprites":[{"asset":"a1023","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「……这个……」","art":{"background":"a3001","sprites":[{"asset":"a4165","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"廉太郎","text":"「我先回去了。咱妈要是问起来……我就帮你糊弄过去。那我走了」","art":{"background":"a3001","sprites":[{"asset":"a85","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"廉太郎挥着手走掉了。","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"这种关心他怎么这么熟练……想想就来气。","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「小春，我觉得他其实是在担心你」","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"小春","text":"「这个……嗯……我也知道」","art":{"background":"a3001","sprites":[{"asset":"a2978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「但是他总是说些多余的话」","art":{"background":"a3001","sprites":[{"asset":"a3323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「这倒是」","art":{"background":"a3001","sprites":[{"asset":"a3323","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「刚才他也……」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「哥哥，我问你……那个……真、真的……喜欢我这种贫乳吗？」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「喜欢」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「再说了，你也没那么贫乳吧。你这根本不算是平胸妹，也不是断崖绝壁，也不是搓衣板，也不是太平——」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「……」","art":{"background":"a3001","sprites":[{"asset":"a2978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「哎，怎么了？」","art":{"background":"a3001","sprites":[{"asset":"a2978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「说这么多词出来……我会很低落啦」","art":{"background":"a3001","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"是指胸围继续低落吗？","art":{"background":"a3001","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"廉太郎说不定会这样开个玩笑糊弄过去，但是我可没这种勇气。","art":{"background":"a3001","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「所以我不是说了吗，你又不是那样」","art":{"background":"a3001","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我真的很喜欢你……非常喜欢你」","art":{"background":"a3001","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「不是因为喜欢你的胸部所以才喜欢你」","art":{"background":"a3001","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我喜欢的是鞍马小春这个女孩子」","art":{"background":"a3001","sprites":[{"asset":"a3329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「哥哥……」","art":{"background":"a3001","sprites":[{"asset":"a70","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「所以你用不着在意那种小事」","art":{"background":"a3001","sprites":[{"asset":"a70","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「果然你觉得小啊……」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我不是说胸，是说问题的大小」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「……」","art":{"background":"a3001","sprites":[{"asset":"a3263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「还有什么不安的地方吗？」","art":{"background":"a3001","sprites":[{"asset":"a3263","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「其实我……想起了一件不得了的事情，哥哥」","art":{"background":"a3001","sprites":[{"asset":"a2985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「不得了的事情？」","art":{"background":"a3001","sprites":[{"asset":"a2985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「我们那个……发生了性行为……但是还没接、接吻过……吧？」","art":{"background":"a3001","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a3001","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「……啊」","art":{"background":"a3001","sprites":[{"asset":"a4129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"经她这么一说，我才发现还真是这样。","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"之前是以练习的名义……让她露出性器，然后顺水推舟……","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"并没有回到过最开始的环节上。","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"将臣","text":"「莫非……这让你不安？」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「不、不是的。也算不上不安」","art":{"background":"a3001","sprites":[{"asset":"a67","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「但是，那个……说到情侣，果然还是要接吻的吧？」","art":{"background":"a3001","sprites":[{"asset":"a3257","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「可是我们之间没接吻过……我就不禁会想，哥哥是不是果然对我的身体没兴趣呢……」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「说什么呢，怎么可能不对你的身体兴奋！」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「不兴奋的话，哪能射出来那么多！」","art":{"background":"a3001","sprites":[{"asset":"a3262","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「这、这个……嗯，确实射出来很多」","art":{"background":"a3001","sprites":[{"asset":"a4344","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「……」","art":{"background":"a3001","sprites":[{"asset":"a4344","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"将臣","text":"「我明白了。那么就向你证明一下，我到底多么痴迷于你的魅力」","art":{"background":"a3001","sprites":[{"asset":"a4344","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"小春","text":"「哎？哎？哥、哥哥？」","art":{"background":"a3001","sprites":[{"asset":"a70","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-4"},{"speaker":"","text":"我抓住小春的手，直接把她拉到了没有人迹的地方。","art":{"background":"a3001","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"从别的视角来看，我或许像是在强行拉拽着小春。","art":{"background":"a119","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"但是小春一点也没有不情愿的举动。","art":{"background":"a119","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"她反倒是紧紧握着我的手，不让我松开。","art":{"background":"a119","sprites":[]},"chapter":"8-4"},{"speaker":"","text":"就这样，我们来到了没有其他人的地方……","art":{"background":"a119","sprites":[]},"chapter":"8-4"}]