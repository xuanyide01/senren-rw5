[{"speaker":"将臣","text":"「我会想着一个人，会希望她高兴，希望她露出笑容」","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"说着，我直直地看着芦花姐。","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"不能一直逃避下去。","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"哪怕为了能坦率面对小春……我必须明确自己的态度。","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「……呼……」","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"我轻轻呼出一口气，让自己冷静下来。","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「哥哥……？」","art":{"background":"a48","sprites":[{"asset":"a61","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「……抱歉，小春」","art":{"background":"a48","sprites":[{"asset":"a61","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「我有些话要和芦花姐说。所以……」","art":{"background":"a48","sprites":[{"asset":"a61","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「是吗……嗯，我知道了」","art":{"background":"a48","sprites":[{"asset":"a4246","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"小春笑着微微点头，但是她的笑容里却夹杂着些许寂寞。","art":{"background":"a48","sprites":[{"asset":"a4246","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「真的很抱歉」","art":{"background":"a48","sprites":[{"asset":"a4246","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「不用道歉，哥哥」","art":{"background":"a48","sprites":[{"asset":"a68","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「接下来我没有排班，所以今天我就回去了，姐姐」","art":{"background":"a48","sprites":[{"asset":"a95","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a29","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「哎？啊，但是……」","art":{"background":"a48","sprites":[{"asset":"a95","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a2982","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「不用那么担心我，我一个人没问题的」","art":{"background":"a48","sprites":[{"asset":"a68","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a2982","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「我已经尽了自己最大的努力了，所以按照约定，咱们还是好姐妹」","art":{"background":"a48","sprites":[{"asset":"a64","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a2982","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「……谢谢你，小春」","art":{"background":"a48","sprites":[{"asset":"a64","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a3725","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「不，我才要道谢。要加油哦，姐姐」","art":{"background":"a48","sprites":[{"asset":"a83","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a3725","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「嗯」","art":{"background":"a48","sprites":[{"asset":"a83","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a36","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「……？」","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"两人的这段对话……到底是什么意思？","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"她们俩到底心领神会了什么？","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"我是一头雾水……但是看着两人的表情，却察觉到现在的气氛根本容不得我插嘴。","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"将臣","text":"「芦花姐，刚才你们……」","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「那个啊……嗯……算是女孩子之间的秘密」","art":{"background":"a48","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"也就是说……不能告诉我这个男性吗。","art":{"background":"a48","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「好了不说这些了，赶紧回店里研究水晶冰沙吧！」","art":{"background":"a48","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「得在天气真正变热之前，达到能当商品的水准才行。你也要来帮忙哦」","art":{"background":"a48","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「好啊，当然没问题」","art":{"background":"a48","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「一定要争取把它做得足够好吃。好吃诀窍就是……做的时候心里想着某个人开心品尝时的表情……没错吧？」","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「我是这么做的」","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「那个水晶冰沙……也是为了让那个人能够高兴，拼命想出来的」","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「哦，这样啊……原来如此。那么顺便问一句，真的只是顺便——」","art":{"background":"a48","sprites":[{"asset":"a4236","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「你脑海里的那个笑容……到底是谁的笑容呢？」","art":{"background":"a48","sprites":[{"asset":"a2982","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「………………啊？」","art":{"background":"a48","sprites":[{"asset":"a2982","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「啊，抱歉！等下！刚才的不算！当我什么都没说！」","art":{"background":"a48","sprites":[{"asset":"a2982","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「我也真是的，那种事情怎么说得出口嘛，抱歉抱歉，哈哈哈」","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「不，我不是那个意思……你这是在认真问我？」","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"我这人虽然是个木头脑袋，但芦花姐也没比我强多少。","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"不对，她或许只是装作没注意到……？","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"如果她注意到了，那也就是说……我必须明明白白地说出来？","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「我知道了。芦花姐，其实我有一个请求。我——」","art":{"background":"a48","sprites":[{"asset":"a23","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「等、等一下！」","art":{"background":"a48","sprites":[{"asset":"a4203","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「这次又怎么了！？」","art":{"background":"a48","sprites":[{"asset":"a4203","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「呃，那个……其实啊，我也对你有个请求」","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「所以呢……我能先说吗？你看，女士优先嘛」","art":{"background":"a48","sprites":[{"asset":"a4248","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「当然没关系」","art":{"background":"a48","sprites":[{"asset":"a4248","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「谢谢……啊，但是在说之前要先深呼吸。吸……呼……吸——……呼——……」","art":{"background":"a48","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"芦花姐调整着呼吸，肩膀大幅度起伏着。","art":{"background":"a48","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"但是她显然没有成功。因为她的声音依旧颤抖着。","art":{"background":"a48","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「那、那个……听我说，阿将……我那个……」","art":{"background":"a48","sprites":[{"asset":"a4205","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「你能在我这里工作，真的太好了。店铺慢慢好起来了，销售额也……不不我想说的不是这些」","art":{"background":"a48","sprites":[{"asset":"a4249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a48","sprites":[{"asset":"a4249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「总而言之，我……那个，这次的水晶冰沙我也很感激你，包括仙贝也是，还有——」","art":{"background":"a48","sprites":[{"asset":"a4250","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「芦花姐，我喜欢你」","art":{"background":"a48","sprites":[{"asset":"a4250","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「——！」","art":{"background":"a48","sprites":[{"asset":"a4203","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「你、你为什么先说了啊！？说好的女士优先呢！？」","art":{"background":"a48","sprites":[{"asset":"a4251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「因为你太啰嗦了嘛」","art":{"background":"a48","sprites":[{"asset":"a4251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「那是因为……太不好意思了没法一下子说出来啊……我可从没说出过这种话」","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「我也是第一次对别人说这种话。但是我说出来了」","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「这毫无疑问是我真正的想法，所以我能明明白白地说出来」","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「我喜欢你，我希望你能当我女朋友，这就是我的请求」","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「～～～……！」","art":{"background":"a48","sprites":[{"asset":"a24","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「阿将，你总在我意想不到的时候表现得像个男子汉。这让我……不由得想依赖你……」","art":{"background":"a48","sprites":[{"asset":"a4215","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「你总是把这种反差摆在我眼前，真的太卑鄙了……姐姐我好气啊」","art":{"background":"a48","sprites":[{"asset":"a4252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「那么……对于我的请求，你怎么想的呢？」","art":{"background":"a48","sprites":[{"asset":"a4252","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「……不、不要……」","art":{"background":"a48","sprites":[{"asset":"a4204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「什么！？」","art":{"background":"a48","sprites":[{"asset":"a4204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"她喝醉的时候都吐露出那种话了，怎么想也应该很稳妥了吧！？","art":{"background":"a48","sprites":[{"asset":"a4204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「我不要止步于女朋友。比起女朋友……我更想嫁给你……」","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「……」","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"或许这就是芦花姐竭尽全力的反抗吧。","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"不过这算是反抗吗？倒不如说更加深入了……","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「嫁给我……一定要现在吗？」","art":{"background":"a48","sprites":[{"asset":"a4247","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「也不是一定要现在……但是反正你都说出来了，还不如直接一步到位……」","art":{"background":"a48","sprites":[{"asset":"a4253","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"芦花姐的语气听起来就像是在闹别扭。","art":{"background":"a48","sprites":[{"asset":"a4253","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"她这种孩子气的地方和在店里示人的那一面完全不同……倒是有一种别样的可爱。","art":{"background":"a48","sprites":[{"asset":"a4253","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「那我重新说」","art":{"background":"a48","sprites":[{"asset":"a4253","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「芦花，请嫁给我吧」","art":{"background":"a48","sprites":[{"asset":"a4253","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「……」","art":{"background":"a48","sprites":[{"asset":"a4254","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「我好开心……开心极了。因为我的心意和你一模一样」","art":{"background":"a48","sprites":[{"asset":"a4255","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「阿将，我喜欢你，不是喜欢作为发小的你，而是喜欢作为异性、作为一名男性的你」","art":{"background":"a48","sprites":[{"asset":"a4256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「所以，请你娶了我吧！」","art":{"background":"a48","sprites":[{"asset":"a4257","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「嗯！」","art":{"background":"a48","sprites":[{"asset":"a4257","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"就这样，我和芦花姐共同迈出了新的一步。","art":{"background":"a1","sprites":[]},"chapter":"7-1"}]