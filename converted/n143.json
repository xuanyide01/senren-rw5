[{"speaker":"蕾娜","text":"「打扰了」","art":{"background":"a1","sprites":[]},"chapter":"3-7"},{"speaker":"安晴","text":"「呀，这么早是怎么了？」","art":{"background":"a211","sprites":[{"asset":"a1405","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「这还用问吗！」","art":{"background":"a211","sprites":[{"asset":"a1406","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1405","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「昨晚完全没消息，我很担心！」","art":{"background":"a211","sprites":[{"asset":"a1407","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「哦，原来是这样，那真是让你担心了」","art":{"background":"a211","sprites":[{"asset":"a357","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「不过没关系，大家都没事。只是回来得很晚所以没联系你」","art":{"background":"a211","sprites":[{"asset":"a244","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「肯定只是不想吵醒你吧」","art":{"background":"a211","sprites":[{"asset":"a248","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「就算这样，那也至少应该留个邮件吧」","art":{"background":"a211","sprites":[{"asset":"a1361","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「嗯，你说的也是」","art":{"background":"a211","sprites":[{"asset":"a245","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「那将臣他们还在睡吗？」","art":{"background":"a211","sprites":[{"asset":"a1020","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a244","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「这个啊……」","art":{"background":"a211","sprites":[{"asset":"a1020","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a357","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「……唉……」","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"宿体被放在卓袱台上。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"现在的宿体是巴掌大的球体，中央有一团白白的雾气。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"我不懂石头的价值，但我知道这块石头很漂亮。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"不过现在我望着这块石头也只能叹气……","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「你怎么了，将臣，为什么叹气？」","art":{"background":"a275","sprites":[{"asset":"a1361","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「我听说昨天的祓禊不是很顺利吗……？」","art":{"background":"a275","sprites":[{"asset":"a1408","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「嗯，是啊。祓禊确实挺顺利的」","art":{"background":"a275","sprites":[{"asset":"a1408","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「可是——」","art":{"background":"a275","sprites":[{"asset":"a1408","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"我转了转眼前的水晶。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"直到转出来一块小小的缝隙。","art":{"background":"a1409","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"那块缝隙刚好可以塞下一块碎片。","art":{"background":"a1409","sprites":[]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「好像还差了一块」","art":{"background":"a275","sprites":[{"asset":"a1053","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「是啊……」","art":{"background":"a275","sprites":[{"asset":"a1053","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"昨天我们还以为碎片已经齐了。","art":{"background":"a1409","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"但是实际凑起来一看，还缺了一块。","art":{"background":"a1409","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「当然，考虑到至今为止的努力，这已经是历史性的进步了」","art":{"background":"a1409","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「我们距离集齐碎片的目标也真的只差最后一步了」","art":{"background":"a1409","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「但就是觉得想不通……」","art":{"background":"a1409","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"昨天那一连串的事情，给人感觉就是要集齐了啊。","art":{"background":"a273","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"结果竟然还没完呢……","art":{"background":"a273","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"而且我最在意的是，不够的只有一块。","art":{"background":"a273","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"一次性出现了那么多祟神，很难想象会有一块碎片偶然没有变成祟神。","art":{"background":"a273","sprites":[{"asset":"a1388","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"会缺一块很可能有什么原因。","art":{"background":"a273","sprites":[{"asset":"a1388","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"是不是有什么特别的理由让那碎片不能变成祟神？","art":{"background":"a273","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"或者说是像蕾娜那时候一样，是因为些什么原因转跑到其他地方去了？","art":{"background":"a273","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"不论是什么情况，我感觉要想找到应该不容易。","art":{"background":"a273","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「当然，我也知道这并不是什么一定要叹气的事情」","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「看这缺的样子……大概还差一块，还是有进步的」","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「就是呀，只剩一块了」","art":{"background":"a275","sprites":[{"asset":"a963","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「……」","art":{"background":"a275","sprites":[{"asset":"a963","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「嗯，是啊！只要再找到一块就行了！」","art":{"background":"a275","sprites":[{"asset":"a963","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"我可没空失落。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"要是不赶紧找出来，这巨大的宿体搞不好会再次变成祟神。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"比昨天那个还强……恐怕就真的没救了。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「对了！你的耳鸣怎么样了！？虽然现在问好像有点晚了」","art":{"background":"a275","sprites":[{"asset":"a1020","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「这问得还真是有些晚啊」","art":{"background":"a275","sprites":[{"asset":"a1410","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「今天没事，我现在是好得不能再好的好」","art":{"background":"a275","sprites":[{"asset":"a1103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「是吗，那就好」","art":{"background":"a275","sprites":[{"asset":"a1103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「另外这个不会再像昨天那样闪烁了吧？」","art":{"background":"a275","sprites":[{"asset":"a975","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「这个我也不清楚」","art":{"background":"a275","sprites":[{"asset":"a975","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"宿体变强了，碎片还缺一块。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"那么它完全有可能再次产生昨天那样的信号，或者某些其他反应。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"但是宿体还是一动不动，乖乖的。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"当然，这份平静也是让我害怕的原因。","art":{"background":"a275","sprites":[]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「昨天那个是在呼唤吧？」","art":{"background":"a275","sprites":[{"asset":"a1411","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「是啊」","art":{"background":"a275","sprites":[{"asset":"a1411","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「那现在会不会是因为太过靠近，所以没有呼唤的必要？」","art":{"background":"a275","sprites":[{"asset":"a1065","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「是这样吗？」","art":{"background":"a275","sprites":[{"asset":"a1065","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"真是的话那倒好了……","art":{"background":"a275","sprites":[{"asset":"a1065","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「对了，芳乃和茉子呢？」","art":{"background":"a275","sprites":[{"asset":"a975","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「嗯？对哦……她们人呢」","art":{"background":"a275","sprites":[{"asset":"a975","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「而且小雨好像也不见了」","art":{"background":"a275","sprites":[{"asset":"a975","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「主人……噢，你在啊」","art":{"background":"a275","sprites":[{"asset":"a1412","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a975","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「早上好，小雨」","art":{"background":"a275","sprites":[{"asset":"a1412","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a960","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「早」","art":{"background":"a275","sprites":[{"asset":"a130","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a960","position":"右中","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「怎么了，主人，你还在看着宿体叹气吗？」","art":{"background":"a275","sprites":[{"asset":"a1353","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「刚才还在叹气呢」","art":{"background":"a275","sprites":[{"asset":"a1353","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「但现在已经不叹气了。反正只差一块了，还是乐观点去寻找最后那一块吧！」","art":{"background":"a275","sprites":[{"asset":"a1353","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「嗯，那就好。我们走吧」","art":{"background":"a275","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「走……去哪？」","art":{"background":"a275","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「去回收最后一块碎片」","art":{"background":"a275","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「什么！？你知道在哪吗！？」","art":{"background":"a275","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「只是推测。行了，赶紧走吧」","art":{"background":"a275","sprites":[{"asset":"a139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「丛雨大人，我们已经做好准备了」","art":{"background":"a118","sprites":[{"asset":"a1413","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「准备？」","art":{"background":"a118","sprites":[{"asset":"a1065","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1413","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「我说，你们到底打算在神社里做什么？」","art":{"background":"a118","sprites":[{"asset":"a1065","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1413","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「不是说了吗？回收碎片啊」","art":{"background":"a118","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"言毕，小雨站在了我的面前。","art":{"background":"a118","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「本座一直觉得很奇怪」","art":{"background":"a118","sprites":[{"asset":"a1414","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「为何主人能碰到本座？为何主人的意识会被碎片吸引？」","art":{"background":"a118","sprites":[{"asset":"a1357","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「而且，本座也很好奇宿体发射信号的原因」","art":{"background":"a118","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「……你觉得原因在我？」","art":{"background":"a118","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"也是。在宿体发射信号的那天，宿体“呼唤”过我。","art":{"background":"a118","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"宿体是为了寻求某种反应，才会发出信号的吗？不，这怎么可能……","art":{"background":"a118","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「宿体回应了主人的呼唤。照常理来说这种事情不可能发生」","art":{"background":"a118","sprites":[{"asset":"a1353","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「但就是发生了……」","art":{"background":"a118","sprites":[{"asset":"a1353","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「这意味着什么？」","art":{"background":"a118","sprites":[{"asset":"a1353","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「你可真迟钝啊，主人。都说到这份上了，正常人都该听懂了吧」","art":{"background":"a118","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「也就是说，最后那块碎片在主人体内」","art":{"background":"a118","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「啊？在我体内……为什么会这样？」","art":{"background":"a118","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「主人，你是不是吃过碎片？」","art":{"background":"a118","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「我怎么可能吃石头呢」","art":{"background":"a118","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「有没有可能是无意间进入了身体？毕竟是那么小的碎片」","art":{"background":"a118","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「哎？确实……我小时候在山上摔过，完全有可能是通过类似的途径……」","art":{"background":"a118","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"小时候我确实偶尔会上山玩。","art":{"background":"a1036","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"但年龄太小，很多事都记不清了。","art":{"background":"a1036","sprites":[]},"chapter":"3-7"},{"speaker":"茉子","text":"「对了……以前你不是说自己溺水的时候喝了几口河水吗？」","art":{"background":"a118","sprites":[{"asset":"a256","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「……啊，嗯……」","art":{"background":"a118","sprites":[{"asset":"a256","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"那时我还以为自己要死了呢，一阵扑腾，喝了不少玩意儿。","art":{"background":"a1044","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"如果碎片真是那时候进入了嘴里，那也不奇怪。","art":{"background":"a1044","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"最后一块碎片真的在我体内？","art":{"background":"a1044","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「但这样的到底应该怎么回收？总不会……要我做手术吧？」","art":{"background":"a118","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「碎片没有和肉体融合，而是和灵魂融合了」","art":{"background":"a118","sprites":[{"asset":"a226","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「但那归根结底也还是异物，并没有彻底合而为一」","art":{"background":"a118","sprites":[{"asset":"a1414","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「宿体变得这么完整，只要主人向它搭话，它大概自己就会离开」","art":{"background":"a118","sprites":[{"asset":"a133","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「搭话……也就是想着让它回到原来的地方去吗？」","art":{"background":"a118","sprites":[{"asset":"a133","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「嗯。只要用坚定的意志向它诉说就行。为了这个我们也做了不少准备」","art":{"background":"a118","sprites":[{"asset":"a130","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「噢，刚才朝武说做好准备就是为了这个啊」","art":{"background":"a118","sprites":[{"asset":"a193","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「是的。丛雨大人让我去献舞了」","art":{"background":"a118","sprites":[{"asset":"a1134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「现在这个房间的污秽已经被祓除，本座也增强了神力，让碎片更容易脱离出来」","art":{"background":"a118","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"茉子","text":"「那么，有地」","art":{"background":"a118","sprites":[{"asset":"a1020","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a428","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「加油，将臣」","art":{"background":"a118","sprites":[{"asset":"a1041","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a428","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「啊，嗯，好」","art":{"background":"a118","sprites":[{"asset":"a1041","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a428","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"常陆将宿体递给我。","art":{"background":"a118","sprites":[{"asset":"a329","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"宿体缺了一个口。缺的那块，就在我体内？","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"尽管不太相信，我依然遵从了小雨的指示。","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"我闭上眼，将意识专注于眼前的宿体。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「（……）」","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"没有确凿的证据能表明宿体碎片真的在我体内……","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"但我希望它真的是在我体内。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"我希望大家能从诅咒当中获得解放。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"这不止是为了我自己。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"也是为了被诅咒牵连进来的所有人。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"最重要的一点……这也是为了那只化为犬神后，被禁锢于宿体中的兽灵。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"我曾梦见一段被斩首的记忆。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"再加上昨天感受到的憎恨与悲伤的巨浪。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"几百年如一日，一直怨恨着什么，我觉得它才是最痛苦的。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"我也不知道自己究竟是被犬神的思绪感化了，还是对它产生了同情。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"不过……我觉得要是放着不管，它就太可悲了。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「（……我想让它从痛苦中解放）」","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「（另外……还想对它说句谢谢）」","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「（是它让我在这里与大家相遇。虽然搜集碎片的过程很辛苦，但我真的很感激它）」","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"正当种种心绪在胸中盘旋之时，我手中的宿体忽然热了起来。","art":{"background":"a0","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「——好烫！」","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"我吓得睁开了眼，发现手里的宿体开始放射白光。","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"它没有变黑，也没有放射红光。","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"这种反应我还是第一次见，但完全没觉得危险。","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"反倒感觉有些莫名的温暖。","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"最重要的是……","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「还……真的在体内」","art":{"background":"a1415","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"我用手转了转像是块小水晶球的宿体。","art":{"background":"a1415","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"它没有一处豁口，变成了完美的球体。","art":{"background":"a1415","sprites":[]},"chapter":"3-7"},{"speaker":"芳乃","text":"「宿体真的全都……」","art":{"background":"a118","sprites":[{"asset":"a181","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"茉子","text":"「集齐了，芳乃大人！」","art":{"background":"a118","sprites":[{"asset":"a287","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「恭喜！」","art":{"background":"a118","sprites":[{"asset":"a1103","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「这样一来……诅咒就解开了吗？」","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"丛雨","text":"「也不能一口咬定。本座只是推断搜集宿体可以解开诅咒」","art":{"background":"a118","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「暂时还需要看看情况……不过大概已经没问题了」","art":{"background":"a118","sprites":[{"asset":"a135","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"看小雨那放松的表情，我明白她并不是在哄我开心。","art":{"background":"a118","sprites":[{"asset":"a135","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「接下来只要请安晴去供奉这宿体就行了」","art":{"background":"a118","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「这样一来，用于诅咒的力量也会变成保佑的力量」","art":{"background":"a118","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「我、我去叫爸爸！」","art":{"background":"a118","sprites":[{"asset":"a1416","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「好，祈祷结束了」","art":{"background":"a118","sprites":[{"asset":"a174","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「以后我每天都会祈祷的，放心吧」","art":{"background":"a118","sprites":[{"asset":"a172","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「拜托了」","art":{"background":"a118","sprites":[{"asset":"a172","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「这也是神主的工作。毕竟……至今为止我完全没帮上什么忙」","art":{"background":"a118","sprites":[{"asset":"a197","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「把你牵连进来，真对不起」","art":{"background":"a118","sprites":[{"asset":"a173","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「不，我没觉得自己是被牵连了」","art":{"background":"a118","sprites":[{"asset":"a173","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「而且……小雨果然说得不错啊」","art":{"background":"a118","sprites":[{"asset":"a173","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「丛雨丸选择你并不是偶然，而是必然。这是主人的命运」","art":{"background":"a270","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「主人并不是被随意选出来的。丛雨丸选择主人是因为主人有能力」","art":{"background":"a270","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"我回想起那时小雨说过的话。","art":{"background":"a270","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"我的体内有宿体的碎片。","art":{"background":"a270","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"换言之，要是我不在，那就根本不可能集齐宿体。","art":{"background":"a270","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"所以，我相信……","art":{"background":"a270","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「或许，这真的是命运的安排」","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"丛雨","text":"「是啊。不止是主人，在座的所有人能像这样相遇，肯定都是命运的安排」","art":{"background":"a118","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「意思是，也包括我吗？」","art":{"background":"a118","sprites":[{"asset":"a1361","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「当然了。要不是你带着碎片过来，我们也没法集齐宿体」","art":{"background":"a118","sprites":[{"asset":"a136","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1361","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「能听你们这么说我好开心，嘻嘻」","art":{"background":"a118","sprites":[{"asset":"a136","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a978","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「能和各位相遇我也很开心！以后也请多指教了」","art":{"background":"a118","sprites":[{"asset":"a960","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"茉子","text":"「是啊，我也觉得」","art":{"background":"a118","sprites":[{"asset":"a963","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1134","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a287","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「以后也要请多指教了」","art":{"background":"a118","sprites":[{"asset":"a963","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1417","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a287","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「嗯，嗯」","art":{"background":"a118","sprites":[{"asset":"a172","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「什……什么啊，爸爸，眼神怎么这么温暖……这是怎么了？」","art":{"background":"a118","sprites":[{"asset":"a171","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a180","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「没什么，只是觉得开心。我家芳乃……竟然有了这么亲密的朋友」","art":{"background":"a118","sprites":[{"asset":"a173","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a180","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「以后也请各位多多照顾我家女儿了！」","art":{"background":"a118","sprites":[{"asset":"a192","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「爸、爸爸！别做这种羞人的事啊，真是的！」","art":{"background":"a118","sprites":[{"asset":"a1133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「没、没吧，当爹的说这种话很正常——」","art":{"background":"a118","sprites":[{"asset":"a187","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1418","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「你不害羞我害羞！」","art":{"background":"a118","sprites":[{"asset":"a187","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1419","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「哎……是吗？」","art":{"background":"a118","sprites":[{"asset":"a187","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1419","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「不管怎么说，真是太好了……太好了，芳乃……」","art":{"background":"a118","sprites":[{"asset":"a172","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1420","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「爸、爸爸……都说了，你这样子太让人难为情了……」","art":{"background":"a118","sprites":[{"asset":"a172","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a199","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「抱歉，但我太高兴了……真是太好了」","art":{"background":"a118","sprites":[{"asset":"a197","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a199","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「……」","art":{"background":"a118","sprites":[{"asset":"a197","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1418","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"安晴叔叔依然是一副感动得要哭出来的表情。","art":{"background":"a118","sprites":[{"asset":"a197","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1418","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"想必他肯定经历过无数艰难困苦，才会露出这样的表情。","art":{"background":"a118","sprites":[{"asset":"a197","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1418","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"一想到这里，我也只能默默地继续看着他了。","art":{"background":"a118","sprites":[{"asset":"a197","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1418","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「哦，对了，说到以后的事情，将臣」","art":{"background":"a118","sprites":[{"asset":"a174","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「啊？怎么了？」","art":{"background":"a118","sprites":[{"asset":"a174","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「将臣，今后你有什么打算？」","art":{"background":"a118","sprites":[{"asset":"a1421","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「原本就是因为诅咒的事情才会请你留在穗织，现在你已经不必继续被束缚在这里了」","art":{"background":"a118","sprites":[{"asset":"a1422","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"芳乃","text":"「啊……」","art":{"background":"a118","sprites":[{"asset":"a1423","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a256","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"茉子","text":"「也对。有地可以选择回去」","art":{"background":"a118","sprites":[{"asset":"a1423","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a913","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「……嗯？什么回去？」","art":{"background":"a118","sprites":[{"asset":"a1053","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「将臣不是穗织的人。他的家在一个更繁华的地方」","art":{"background":"a118","sprites":[{"asset":"a1424","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a173","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「是这样的吗，将臣？」","art":{"background":"a118","sprites":[{"asset":"a1037","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「啊，是的……嗯，差不多」","art":{"background":"a118","sprites":[{"asset":"a1037","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「那么，将臣会离开穗织吗？」","art":{"background":"a118","sprites":[{"asset":"a1361","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「毕竟年轻人更喜欢住城里。而且，那里也是将臣的老家」","art":{"background":"a118","sprites":[{"asset":"a1361","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1422","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"蕾娜","text":"「那就真是太遗憾了……」","art":{"background":"a118","sprites":[{"asset":"a1038","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1422","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「这个嘛……呃……」","art":{"background":"a118","sprites":[{"asset":"a1038","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1422","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「……」","art":{"background":"a118","sprites":[{"asset":"a1038","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1422","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「算了，现在聊这个也没意义」","art":{"background":"a118","sprites":[{"asset":"a771","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"茉子","text":"「说得对。反正也不是必须立刻决定的事情」","art":{"background":"a118","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"安晴","text":"「是我太急促了。你别客气，在咱们家你想住多久就住多久」","art":{"background":"a118","sprites":[{"asset":"a171","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「谢谢」","art":{"background":"a118","sprites":[{"asset":"a171","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"也是……","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"诅咒解除后，我就没有理由必须留在这里了。","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"","text":"我也可以回家……","art":{"background":"a118","sprites":[]},"chapter":"3-7"},{"speaker":"将臣","text":"「……」","art":{"background":"a360","sprites":[]},"chapter":"3-7"},{"speaker":"丛雨","text":"「主人，你怎么了？你怎么一直发呆呀」","art":{"background":"a360","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「啊，没……想事情呢」","art":{"background":"a360","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「对了，现在问这个或许太晚了」","art":{"background":"a360","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「什么？」","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「我体内没有碎片了……那我会不会从此看不见小雨了？」","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「我是因为有碎片，所以才能看见、碰到小雨的吧？」","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「现在还能对话，说明至少没有立竿见影的影响」","art":{"background":"a360","sprites":[{"asset":"a128","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「就算碎片的影响会消失，那也是更久之后的事了」","art":{"background":"a360","sprites":[{"asset":"a129","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「是吗……跟蕾娜一样啊。那就好」","art":{"background":"a360","sprites":[{"asset":"a129","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「要是我跟小雨之间的关系就此改变那就太叫人伤心了」","art":{"background":"a360","sprites":[{"asset":"a129","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「嗯。不过主人，除了看不见之外，本座肩上的使命也很可能会就此结束」","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「你的意思是……啊」","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"诅咒解除后，小雨作为丛雨丸管理者的任务也就完成了。","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「小雨，难不成……你会消失？」","art":{"background":"a360","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「谁知道呢。本座一直作为神的使者留在世间」","art":{"background":"a360","sprites":[{"asset":"a1414","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「兴许会像普通人一样迎来死亡，也有可能会得到其他的任务」","art":{"background":"a360","sprites":[{"asset":"a1309","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「……这」","art":{"background":"a360","sprites":[{"asset":"a1309","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「别露出这么寂寞的表情。本座和主人你们之间已经有了很深的关系」","art":{"background":"a360","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「本座当然要好好见证一下你们到底能不能得到幸福」","art":{"background":"a360","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「神灵应当也会允许本座实现这点小小的愿望吧。所以主人，你就快点让本座放心吧」","art":{"background":"a360","sprites":[{"asset":"a277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「但你要是消失了，那我反倒会幸福不起来」","art":{"background":"a360","sprites":[{"asset":"a277","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「哈哈，这话听着讨人喜欢，但你可别拿本座当挡箭牌」","art":{"background":"a360","sprites":[{"asset":"a771","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「我知道的」","art":{"background":"a360","sprites":[{"asset":"a771","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「话说回来，我吸收了碎片，竟然还一点事都没有啊」","art":{"background":"a360","sprites":[{"asset":"a139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「万一不走运，我甚至……有可能变成祟神吧？」","art":{"background":"a360","sprites":[{"asset":"a139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「也许是有这个可能吧。如果主人被负面感情支配，那主人的灵魂可能也会被污秽所玷污」","art":{"background":"a360","sprites":[{"asset":"a144","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「也就是说，你从未打心底产生过仇恨，你的成长环境足够幸福」","art":{"background":"a360","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「成长环境……」","art":{"background":"a360","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"将臣","text":"「……」","art":{"background":"a360","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"丛雨","text":"「你好像有些不太高兴啊，主人。要不转换一下心情去吹吹晚风冷静冷静吧？」","art":{"background":"a360","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-7"},{"speaker":"","text":"……","art":{"background":"a119","sprites":[]},"chapter":"3-7"}]