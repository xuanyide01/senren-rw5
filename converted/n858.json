[{"speaker":"小春","text":"「辛苦了」","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「辛苦了，小春」","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花的父亲","text":"「那我们也先回去了」","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花的母亲","text":"「和她说一下，要记得把门关好」","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯。我知道了」","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"小春回去了，叔叔阿姨也从店里离开了。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"店里再次只剩下我和芦花姐。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"但是，我不是为了亲热才留在这里的。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「让你久等啦——阿将。给，这是西瓜味的水晶冰沙」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哇，是西瓜啊……确实是夏天最值得吃的东西了」","art":{"background":"a1700","sprites":[{"asset":"a995","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「快快快，请吃吃看吧」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我开动了」","art":{"background":"a1700","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我用勺子挖下了一块赤红色的冷饮，送入了口中。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"口中传来了西瓜淡淡的甜味。而且西瓜特有的涩味被去除了，口感提升了一大截。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「嗯，很好吃。虽然很好吃……」","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「但是单独吃这个的话，对我来说有点不够吃……如果这是饭后吃的甜点就好了」","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「是因为口感太清淡了吗？」","art":{"background":"a1700","sprites":[{"asset":"a1576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我还是更喜欢你之前给我做的蜜瓜冰沙」","art":{"background":"a1700","sprites":[{"asset":"a1576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「蜜瓜啊。对，那是我非常满意的作品」","art":{"background":"a1700","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「可是啊……毕竟是蜜瓜嘛，成本就有点……不过确实很好吃就是了」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「对于叔叔在材料上的讲究，芦花姐是不是也有些感同身受了？」","art":{"background":"a1700","sprites":[{"asset":"a1582","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「唔……确实。只要知道某个材料能做出好吃的东西……就怎么都想用它来做」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「但是不行。这一点必须要从经营者的角度来考虑才行」","art":{"background":"a1700","sprites":[{"asset":"a987","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「所以呢……还是用桃子和苹果之类的做冰沙比较现实吧？」","art":{"background":"a1700","sprites":[{"asset":"a1576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我倒是挺喜欢桃子的……但会不会很贵？」","art":{"background":"a1700","sprites":[{"asset":"a1576","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「呃，应该说勉强能盈利吧。反正不会赤字，如果能当招牌点心做出名声的话……应该可以吧？」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「当作揽客用的商品咯」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「反正菜单也越来越丰富了，我觉得菜单上加一个这种商品也没什么问题吧」","art":{"background":"a1700","sprites":[{"asset":"a1571","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「当然这件事还是要和爸爸妈妈征求一下意见的」","art":{"background":"a1700","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这样啊」","art":{"background":"a1700","sprites":[{"asset":"a1688","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「好嘞，我决定了！用桃子和苹果来拼一拼吧。我去和爸爸也说一下」","art":{"background":"a1700","sprites":[{"asset":"a991","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我觉得这主意不错」","art":{"background":"a1700","sprites":[{"asset":"a991","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯，谢谢」","art":{"background":"a1700","sprites":[{"asset":"a1573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那我们差不多准备回去了？」","art":{"background":"a1700","sprites":[{"asset":"a1573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊，阿姨让我提醒你把门关好」","art":{"background":"a1700","sprites":[{"asset":"a1573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「我知道我知道。那我去换一下衣服」","art":{"background":"a1700","sprites":[{"asset":"a3261","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"说罢，芦花姐去了后场。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"……我也在回去之前检查一下吧。","art":{"background":"a1700","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"嗯……东西都收拾好了，没有忘记的东西。","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"煤气和电源都没问题。门窗……也都关好了。","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「久等啦」","art":{"background":"a1700","sprites":[{"asset":"a44","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「芦花姐，厨房那边我检查过了，没问题」","art":{"background":"a1700","sprites":[{"asset":"a44","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯，谢谢。那只要把大门关上就可以走了」","art":{"background":"a1700","sprites":[{"asset":"a33","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"芦花姐一边这么说着，一边开始掏钥匙。","art":{"background":"a1700","sprites":[{"asset":"a33","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「咦、咦？」","art":{"background":"a1700","sprites":[{"asset":"a38","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「芦花姐？」","art":{"background":"a1700","sprites":[{"asset":"a38","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「钥匙……不见了……？不会吧，为什么！？」","art":{"background":"a1700","sprites":[{"asset":"a21","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊？不会是弄丢了吧？」","art":{"background":"a1700","sprites":[{"asset":"a21","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「不、不知道」","art":{"background":"a1700","sprites":[{"asset":"a45","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那也总不能把门开着。要不让叔叔或者阿姨回来一趟？」","art":{"background":"a1700","sprites":[{"asset":"a45","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「还是说我去帮你拿过来？」","art":{"background":"a1700","sprites":[{"asset":"a45","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「啊，不是。店大门的钥匙就在我身上啊」","art":{"background":"a1700","sprites":[{"asset":"a30","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「那找不到的是……」","art":{"background":"a1700","sprites":[{"asset":"a30","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「我家里的钥匙……」","art":{"background":"a1700","sprites":[{"asset":"a35","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"于是，我们开始在店里寻找。但即使我们像做大扫除一样把店里翻了个遍，也没找到芦花姐的钥匙。","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"芦花姐家里是不会自动上锁的，所以她一定是锁完门在外面把钥匙丢了。","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"问了镇上的警署，也说没有人捡到了送过来。","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"这种情况下，本该去拜托芦花姐的房东才对……但是芦花姐的房东似乎年事已高。","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"所以已经睡着了。","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"因此，芦花姐没法进自己的家门了——","art":{"background":"a119","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「打扰了……」","art":{"background":"a4007","sprites":[{"asset":"a2982","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"于是她就只能在我房间里过一晚上了。","art":{"background":"a4007","sprites":[{"asset":"a2982","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「对不起哦，都怪我太粗心了」","art":{"background":"a4007","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我无所谓啦……倒是你那边没问题吗？不知道钥匙掉在哪里的话会很不放心吧？」","art":{"background":"a4007","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯，没错。明天就得赶紧让人把锁换了才行……」","art":{"background":"a4007","sprites":[{"asset":"a4219","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这样的话我也能放心了」","art":{"background":"a4007","sprites":[{"asset":"a4219","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"一想到有陌生人拿着芦花姐房间的钥匙，我就担心得不行。","art":{"background":"a4007","sprites":[{"asset":"a4219","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「要花多少钱呢？应该不会便宜了……唉……突然出来一笔开销还是挺肉疼的」","art":{"background":"a4007","sprites":[{"asset":"a4405","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「如果有需要的话我也可以出钱的」","art":{"background":"a4007","sprites":[{"asset":"a4405","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「哈哈哈，我没穷到那种程度啦。再怎么说我也已经是个社会人了」","art":{"background":"a4007","sprites":[{"asset":"a28","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「这种事……影响说大不大，只不过心情总会有些沮丧呢」","art":{"background":"a4007","sprites":[{"asset":"a45","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我懂你的心情」","art":{"background":"a4007","sprites":[{"asset":"a45","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"即使是小事，只要一想到“哎呀，我搞砸了——”，心情就会很沮丧。","art":{"background":"a4007","sprites":[{"asset":"a45","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「没想到……芦花姐的内心还挺纤细的？原来你是会在意这种事的人啊？」","art":{"background":"a4007","sprites":[{"asset":"a45","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「唔，什么叫“没想到”？」","art":{"background":"a4007","sprites":[{"asset":"a11","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「措辞，只是一种措辞」","art":{"background":"a4007","sprites":[{"asset":"a11","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「……我怎么觉得你说得非常直接啊」","art":{"background":"a4007","sprites":[{"asset":"a27","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「……虽然我不会让自己一直闷闷不乐……不过有时还是会因为突然想起的糗事而懊丧不已。」","art":{"background":"a4007","sprites":[{"asset":"a15","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这样啊？」","art":{"background":"a4007","sprites":[{"asset":"a15","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"她一定是那种，会反复确认自己的家门到底有没有锁的人。","art":{"background":"a4007","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"但即便如此，她还是会让门窗大开，忘东忘西。","art":{"background":"a4007","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「哎呀，没事，我来安慰安慰你吧」","art":{"background":"a4007","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯……谢谢你，阿将」","art":{"background":"a4007","sprites":[{"asset":"a35","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我张开双手，芦花姐就凑过来靠在了我胸前。","art":{"background":"a4007","sprites":[{"asset":"a35","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"我紧紧抱住了她，芦花姐深深吐了一口气，似乎觉得很舒服。","art":{"background":"a4007","sprites":[{"asset":"a35","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯……啊……热乎起来了～」","art":{"background":"a4007","sprites":[{"asset":"a4100","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这话什么意思？」","art":{"background":"a4007","sprites":[{"asset":"a4100","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「被阿将这样紧紧抱住的时候，冷透了的心就会回暖啦」","art":{"background":"a4007","sprites":[{"asset":"a15","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「是吗，只要有帮上忙就行」","art":{"background":"a4007","sprites":[{"asset":"a15","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「芦花姐的身体抱起来真的很舒服哦」","art":{"background":"a4007","sprites":[{"asset":"a15","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「你是说……我胖了？」","art":{"background":"a4007","sprites":[{"asset":"a3725","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「别生气，我的意思是身材刚刚好」","art":{"background":"a4007","sprites":[{"asset":"a3725","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"好有压迫感的笑容……","art":{"background":"a4007","sprites":[{"asset":"a3725","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"所谓如履薄冰就是指这种感觉吧。","art":{"background":"a4007","sprites":[{"asset":"a3725","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「那就好。但是今后也得好好注意，不能变胖才行……」","art":{"background":"a4007","sprites":[{"asset":"a3306","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「你身材很好，我觉得没必要在意这方面」","art":{"background":"a4007","sprites":[{"asset":"a3306","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「别这么说啦——就是这种松懈的态度，才会让人在不经意间胖起来……」","art":{"background":"a4007","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"这样吗……","art":{"background":"a4007","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"不过她说得也对。剑道的锻炼也是一样的道理，一旦逃了一次，就会一直拖延下去……这是常有的事。","art":{"background":"a4007","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「话说你在志那都旅馆住过吗？」","art":{"background":"a4007","sprites":[{"asset":"a53","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「没有啦。这里一晚上的价钱可不便宜」","art":{"background":"a4007","sprites":[{"asset":"a2982","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这样啊。那刚好趁这个机会在这里好好住一晚上吧。今天一天也很累吧？去泡个温泉也不错吧？」","art":{"background":"a4007","sprites":[{"asset":"a2982","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「啊？房间里没有浴室吗？」","art":{"background":"a4007","sprites":[{"asset":"a4","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「有倒是有。要我帮你把浴室准备一下吗？」","art":{"background":"a4007","sprites":[{"asset":"a4","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「这个嘛……阿将也一起洗吗？」","art":{"background":"a4007","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我确实也想这样，不过我要先把给你的被褥拿过来才行」","art":{"background":"a4007","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"这间房间是为了应对突发事件才留着的房间。","art":{"background":"a4007","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"所以没有堆放什么杂物，也没有被当成仓库放满其他的备品。","art":{"background":"a4007","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"和其他正常房间比起来，这间房间反而更清静。","art":{"background":"a4007","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「……我说，阿将……我不能和你睡一个被褥吗？」","art":{"background":"a4007","sprites":[{"asset":"a4249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「………」","art":{"background":"a4007","sprites":[{"asset":"a4249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"睡一个被褥……","art":{"background":"a4007","sprites":[{"asset":"a4249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我是完全不介意……可是，我可能会忍不住」","art":{"background":"a4007","sprites":[{"asset":"a4249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"不……应该说，我已经忍不住了。","art":{"background":"a4007","sprites":[{"asset":"a14","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"","text":"因为紧紧抱着芦花姐，切身感受着她的体温，我的下面已经失控了。","art":{"background":"a4007","sprites":[{"asset":"a14","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「别说这么不解风情的话，阿将」","art":{"background":"a4007","sprites":[{"asset":"a4401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「芦花姐……」","art":{"background":"a4007","sprites":[{"asset":"a4401","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「把钥匙弄丢了，打击真的超大的啦……能再好好安慰我一下吗」","art":{"background":"a4007","sprites":[{"asset":"a35","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「怎么今天突然就开始撒娇了」","art":{"background":"a4007","sprites":[{"asset":"a35","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芦花","text":"「姐姐也偶尔会想撒撒娇啦。难道说……你不喜欢跟你撒娇的姐姐吗？」","art":{"background":"a4007","sprites":[{"asset":"a30","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"},{"speaker":"将臣","text":"「你撒娇的样子太可爱了，我最喜欢了！」","art":{"background":"a4007","sprites":[{"asset":"a30","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"后日谈"}]