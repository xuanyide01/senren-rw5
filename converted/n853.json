[{"speaker":"芦花","text":"「哈咿、哈、哈啊——哈啊——不行了，脑袋里乱成了一团……哈啊啊啊……」","art":{"background":"a4510","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「芦花姐……」","art":{"background":"a4510","sprites":[]},"chapter":"8-2"},{"speaker":"芦花","text":"「哈啊、哈啊、哈啊……不过就算被弄得一团乱，我也喜欢……我最喜欢你了」","art":{"background":"a4510","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「我也最喜欢你了，芦花姐……」","art":{"background":"a4510","sprites":[]},"chapter":"8-2"}]