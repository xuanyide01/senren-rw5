[{"speaker":"将臣","text":"「芳乃……我能撕破它吗？」","art":{"background":"a2254","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「撕、撕破……」","art":{"background":"a2256","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我想撕破」","art":{"background":"a2256","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「非得撕？」","art":{"background":"a2255","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「非得！」","art":{"background":"a2255","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「唔……唔唔……我知道了。既然你这么说……」","art":{"background":"a2257","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"获得芳乃的同意之后，我用手指用力往左右拽裤袜。","art":{"background":"a2257","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"伴随着一阵布料撕裂的声音，芳乃的身体轻轻一阵颤抖。","art":{"background":"a2258","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「……哇啊，这……好像有点不妙」","art":{"background":"a2258","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「不、不妙是……什么意思？」","art":{"background":"a2259","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「这可真让人兴奋」","art":{"background":"a2259","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"就好像在强行侵犯芳乃一样。","art":{"background":"a2259","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"这种从未体验过的情景让我不禁停止了呼吸。","art":{"background":"a2259","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"而芳乃似乎也比往常都要兴奋？","art":{"background":"a2259","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"隔着内裤都能看出来，她那里已经泛滥了。","art":{"background":"a2259","sprites":[]},"chapter":"后日谈"}]