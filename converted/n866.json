[{"speaker":"将臣","text":"「芦花姐，射了……我，要射了」","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯、嗯嗯……嗯嗯……嗯嗯！？嗯、嗯、嗯、嗯、嗯嗯嗯嗯！」","art":{"background":"a4543","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"如同最后一吻一般，我将肉棒顶在芦花姐深处的肉壁上，拧动着腰杆。","art":{"background":"a4543","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"如同在用肉棒舔舐着肉壁一般，不断蹭着芦花姐的最深处。","art":{"background":"a4543","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"这一连串追击让我也迎来了难以抵抗的快感之潮。","art":{"background":"a4543","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯咕呜呜呜呜呜呜！嗯——！嗯———！嗯呜呜呜呜————呜呜呜！」","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊啊、芦花姐……我、我要射了！！」","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯呀……嗯啊、嗯啊、嗯嗯嗯嗯啊———！嗯咕、嗯咕嗯咕嗯咕……嗯嗯嗯——————！」","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"芦花姐的里面正因绝顶而扭动。","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我慌忙把肉棒拔了出来，同时，一股热流涌了上来——","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯嗯嗯！？嗯呀……嗯啊、嗯、嗯、嗯……嗯唔——嗯唔——！」","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"芦花姐喘着粗气，粘稠的精液汹涌地射在了她的肌肤上。","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"精液无止尽地，不停歇地从我的肉棒中射出来。","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"这次射精的量和势头甚至让我感到了晕眩。","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"然后在经过不知多少次的痉挛之后……我的射精终于停了下来。","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「啊……啊……啊……」","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"}]