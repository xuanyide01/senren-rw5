[{"speaker":"丛雨","text":"「主人，早上了」","art":{"background":"a562","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「已经到点了吗……」","art":{"background":"a562","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"根本没睡够……","art":{"background":"a562","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"但是必须赶快规范作息。","art":{"background":"a562","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"不能一直让朝武担心我。","art":{"background":"a562","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「必须起来了」","art":{"background":"a562","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「……」","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"感觉有些奇怪。","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「（怎么回事……感觉哪里不对劲）」","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"特别是背后，好像有什么东西在爬……？","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"但也不觉得痒。","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「……」","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"我猛地回头望去。","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"然而只能看到一如既往的景象。因为这里距离住宅区有一段距离，所以没有一个行人。","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"丛雨","text":"「……嗯？怎么了，主人」","art":{"background":"a493","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「没什么……只是感觉到有什么奇怪的气息……」","art":{"background":"a493","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「刚才似乎有人在我背后……？」","art":{"background":"a493","sprites":[{"asset":"a132","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「你、你该不会是想说有鬼吧？」","art":{"background":"a493","sprites":[{"asset":"a796","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「唔……」","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「算了，当我没说」","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"丛雨","text":"「唔、喂，不要留下这么个微妙的反应就算了！会让本座更加在意的啊！」","art":{"background":"a493","sprites":[{"asset":"a796","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"总觉得自己在被人注视着……估计只是错觉。","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"难道这也是因为睡眠不足？","art":{"background":"a493","sprites":[]},"chapter":"2-7"},{"speaker":"丛雨","text":"「不要无视本座，主人！」","art":{"background":"a493","sprites":[{"asset":"a142","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「早上好」","art":{"background":"a498","sprites":[{"asset":"a569","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"玄十郎","text":"「嗯，看你这样子，昨天应该很顺利吧」","art":{"background":"a498","sprites":[{"asset":"a619","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「这都是多亏了外公」","art":{"background":"a498","sprites":[{"asset":"a619","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「虽然碰到点危险，不过身体下意识地就动了起来」","art":{"background":"a498","sprites":[{"asset":"a619","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「我想，这都多亏了这些天的锻炼」","art":{"background":"a498","sprites":[{"asset":"a619","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"玄十郎","text":"「锻炼派上用场是好事」","art":{"background":"a498","sprites":[{"asset":"a570","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"玄十郎","text":"「但是千万不能骄傲自满」","art":{"background":"a498","sprites":[{"asset":"a569","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「“这次不过是偶然解决掉了，并不代表自己变强了”，对吧？」","art":{"background":"a498","sprites":[{"asset":"a569","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「这我自己再清楚不过了」","art":{"background":"a498","sprites":[{"asset":"a569","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"玄十郎","text":"「没有自大就好。那么开始今天的锻炼吧」","art":{"background":"a498","sprites":[{"asset":"a579","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「请多多指教」","art":{"background":"a498","sprites":[{"asset":"a579","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「就是这么一回事」","art":{"background":"a493","sprites":[{"asset":"a509","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a753","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「最近他放学后回去得很晚，也是在做这种锻炼？」","art":{"background":"a493","sprites":[{"asset":"a797","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a753","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「应该是的。其实放学后的锻炼似乎更加艰苦」","art":{"background":"a493","sprites":[{"asset":"a797","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a798","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「为什么……到底是从什么时候开始锻炼的……？」","art":{"background":"a493","sprites":[{"asset":"a490","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a798","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「他应该是感受到了自己的无力吧」","art":{"background":"a493","sprites":[{"asset":"a490","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a799","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「然后，芳乃大人您也是原因之一」","art":{"background":"a493","sprites":[{"asset":"a490","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a585","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「……哎？我？」","art":{"background":"a493","sprites":[{"asset":"a800","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「看到芳乃大人您每天刻苦练习、努力献舞，他大概深受感动吧」","art":{"background":"a493","sprites":[{"asset":"a509","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a801","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「……」","art":{"background":"a493","sprites":[{"asset":"a478","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a801","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「他每天早上也并不是睡过头，大都是因为要做刚才那番锻炼的缘故吧」","art":{"background":"a493","sprites":[{"asset":"a478","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a753","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「当然了，上课时打瞌睡肯定不是什么好事」","art":{"background":"a493","sprites":[{"asset":"a490","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a802","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「但是我觉得，们就这样再观望一阵子也未尝不可吧」","art":{"background":"a493","sprites":[{"asset":"a490","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a803","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「我该说什么好……这实在是……实在是……」","art":{"background":"a493","sprites":[{"asset":"a757","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a803","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"我做完了早上的锻炼，回到朝武家后……","art":{"background":"a1","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「万分抱歉！」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"迎接我的是下跪谢罪的一幕。","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"为什么要下跪？","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「我不明是非，认定你生活懒散，说了极其失礼的话」","art":{"background":"a805","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「万分抱歉！」","art":{"background":"a806","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「那个……你可不可以先抬起头？虽然我不太清楚到底发生了什么」","art":{"background":"a806","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「……」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"可就算我这么说了，她也丝毫没有抬头的意思。","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"这……该怎么办啊……","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「那个……怎么了？怎么突然说这话？」","art":{"background":"a211","sprites":[]},"chapter":"2-7"},{"speaker":"茉子","text":"「芳乃大人昨天不是指责你又是睡懒觉、又是上课打瞌睡，生活太懒散了吗？」","art":{"background":"a211","sprites":[{"asset":"a583","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「朝武说得很对，根本用不着道歉……伏地谢罪也太夸张了」","art":{"background":"a211","sprites":[{"asset":"a583","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「我才应该跟你们道歉呢」","art":{"background":"a211","sprites":[{"asset":"a583","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「但是，你之所以会那样，其实是有原因的吧？」","art":{"background":"a211","sprites":[{"asset":"a801","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「原因也不过是……哎？」","art":{"background":"a211","sprites":[{"asset":"a801","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「难道……被发现了？」","art":{"background":"a211","sprites":[{"asset":"a801","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「不光是早上，你放学后也去锻炼了吧？」","art":{"background":"a211","sprites":[{"asset":"a715","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「……」","art":{"background":"a211","sprites":[{"asset":"a715","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"偷偷努力的事情竟然被发现了，突然感觉好难为情啊。","art":{"background":"a211","sprites":[{"asset":"a715","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「即便如此，我疏于自我管理也是事实」","art":{"background":"a211","sprites":[{"asset":"a715","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「但是芳乃大人在毫不知情的情况下责备了你，这让她十分愧疚」","art":{"background":"a211","sprites":[{"asset":"a476","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「可我还是……」","art":{"background":"a211","sprites":[{"asset":"a476","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「真顽固，脑子就不能灵活一点吗」","art":{"background":"a211","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「这既是芳乃大人的长处，也是她的短处了」","art":{"background":"a211","sprites":[{"asset":"a798","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"过于较真也很成问题啊……","art":{"background":"a211","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「真的，快抬起头来吧，那些话我根本不在意的」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「这可不行」","art":{"background":"a805","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「朝武，我觉得你昨天说的很对」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「生活懒散是不好的，一旦在这方面松懈下来，就有可能导致严重后果」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「而且你本来就是在担心我，根本没必要道歉」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「我希望你今后也能对我严格要求」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「所以这事你就别在意了……可以吗？」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「不行」","art":{"background":"a805","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"她毫不犹豫地拒绝了。","art":{"background":"a805","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"丝毫没有想要抬头的迹象。","art":{"background":"a805","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「……这该怎么办啊」","art":{"background":"a805","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「为了赎罪，我愿意做任何事情」","art":{"background":"a805","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「不用这么小题大做吧」","art":{"background":"a805","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「哪怕你让我在煎鸡蛋上浇酱油……我也会从命，我会强忍着泪水……将调味酱……封印起来」","art":{"background":"a807","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「我的决心就是这么壮烈」","art":{"background":"a807","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"说得倒是很悲壮，但这决心未免太廉价了吧。","art":{"background":"a807","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「只要你发话，不加糖的厚蛋烧我也愿意吃给你看」","art":{"background":"a807","sprites":[]},"chapter":"2-7"},{"speaker":"","text":"这决心真的很廉价啊。","art":{"background":"a807","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「拜托了，快抬起头来。虽说我只是在名义上是你的未婚夫，但毕竟也是未婚夫」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「让自己的未婚妻下跪的男人可不是什么好男人。所以……」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「……」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「……唉。就算你说要赎罪…………」","art":{"background":"a804","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「……常陆……」","art":{"background":"a211","sprites":[]},"chapter":"2-7"},{"speaker":"茉子","text":"「不要用那种小奶狗一样可爱的目光看我……」","art":{"background":"a211","sprites":[{"asset":"a808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「别偷着乐了，快帮帮忙」","art":{"background":"a211","sprites":[{"asset":"a808","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「才没有偷着乐呢」","art":{"background":"a211","sprites":[{"asset":"a809","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「只是……芳乃大人一旦这样了，你就算拿千斤顶来都撬不动她」","art":{"background":"a211","sprites":[{"asset":"a809","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「怎么能这样……」","art":{"background":"a211","sprites":[{"asset":"a809","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"为什么被道歉的我反而成了被胁迫的一方？","art":{"background":"a211","sprites":[{"asset":"a809","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「既然如此，主人直接下个命令不就完事儿了吗？」","art":{"background":"a211","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「……」","art":{"background":"a211","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"干脆说“让我揉揉胸部”得了……","art":{"background":"a211","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「啊，看你这表情，八成在想什么不轨之事」","art":{"background":"a211","sprites":[{"asset":"a288","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「瞎说！告诉你！我就只在区区一瞬间想过那种失礼的事情！」","art":{"background":"a211","sprites":[{"asset":"a288","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「你看，果然有在想」","art":{"background":"a211","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「只是一瞬间而已啊！」","art":{"background":"a211","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「再说了，要是真提了无礼的请求，常陆肯定会阻止我的，对吧？」","art":{"background":"a211","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「呵呵」","art":{"background":"a211","sprites":[{"asset":"a810","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"这笑容，太可怕了……","art":{"background":"a211","sprites":[{"asset":"a810","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「……唉……好吧。那我就拜托你一件事」","art":{"background":"a811","sprites":[]},"chapter":"2-7"},{"speaker":"将臣","text":"「总之能不能先抬起头来听我说？」","art":{"background":"a811","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「……我知道了」","art":{"background":"a811","sprites":[]},"chapter":"2-7"},{"speaker":"芳乃","text":"「那么，具体是要拜托什么事？」","art":{"background":"a211","sprites":[{"asset":"a586","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「啊……说这话有点难为情啊……」","art":{"background":"a211","sprites":[{"asset":"a586","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「哎哟，原来是要拜托难为情的事？」","art":{"background":"a211","sprites":[{"asset":"a812","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a586","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「别开玩笑。只是稍微有点害羞罢了」","art":{"background":"a211","sprites":[{"asset":"a812","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a586","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「……」","art":{"background":"a211","sprites":[{"asset":"a812","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a586","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a813","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「常陆，你也把你的杀气收起来！」","art":{"background":"a211","sprites":[{"asset":"a812","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a586","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a813","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「到底要拜托什么呢？」","art":{"background":"a211","sprites":[{"asset":"a478","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「那个……」","art":{"background":"a211","sprites":[{"asset":"a478","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「能不能认同我呢？」","art":{"background":"a211","sprites":[{"asset":"a478","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「……嗯？认同……这……认同你是未、未婚夫吗？」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「这个……也包含在内吧？之前你不是说过吗」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「“既然彼此都是被强加的婚约，一起想办法渡过这一关就好了”」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「哎呀……芳乃大人还说过这种话？」","art":{"background":"a211","sprites":[{"asset":"a814","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a720","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「而且是面无表情冷冰冰地说的」","art":{"background":"a211","sprites":[{"asset":"a815","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a814","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a720","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「我、我的语气可没有那么冰冷」","art":{"background":"a211","sprites":[{"asset":"a815","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a495","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a720","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「芳乃大人……」","art":{"background":"a211","sprites":[{"asset":"a480","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「我也没办法啊！这是为了避免他接近祟神！」","art":{"background":"a211","sprites":[{"asset":"a495","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「万一拉近了关系，会把他卷进去的啊」","art":{"background":"a211","sprites":[{"asset":"a816","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「但是现在你已经不需要顾虑那种问题了」","art":{"background":"a211","sprites":[{"asset":"a816","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「所以我想和你改善下关系……至少要变成普通朋友的关系」","art":{"background":"a211","sprites":[{"asset":"a816","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「现在这样……不算普通朋友吗？」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「因为这种小事就下跪，哪里算普通朋友」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「而且，朋友之间根本不会让对方下跪的」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「所以，希望你以后不要这么做了，不要再过于客气过于恭敬，让我们成为普通的朋友吧」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「然后让我们一起解开诅咒吧」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"我希望我们能够更了解对方。","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"就像之前做饭时那样。","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「这样一来，也不会再出现这种误会了」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「所以……」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「请和我一起寻找解开诅咒的方法吧」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「这……到头来，不还是和以前一样吗？」","art":{"background":"a211","sprites":[{"asset":"a797","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「成为朋友，互相了解对方，这是很大的一个变化」","art":{"background":"a211","sprites":[{"asset":"a797","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「这……倒也是，一直关系紧张的话确实很累人」","art":{"background":"a211","sprites":[{"asset":"a797","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「这话轮得到你来说？都是你一个人把气氛弄得那么紧张吧」","art":{"background":"a211","sprites":[{"asset":"a474","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「丛雨大人！？」","art":{"background":"a211","sprites":[{"asset":"a817","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「反而是有地一直在努力跟您搭话吧？」","art":{"background":"a211","sprites":[{"asset":"a586","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a715","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「连茉子也这么说！？」","art":{"background":"a211","sprites":[{"asset":"a818","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a715","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「那紧张的气氛，让我这个看客都累得不轻」","art":{"background":"a211","sprites":[{"asset":"a818","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a819","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「……唔……对不起」","art":{"background":"a211","sprites":[{"asset":"a820","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「过去的事情就不需要道歉了，重要的是今后」","art":{"background":"a211","sprites":[{"asset":"a820","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「能接受我的请求吗？」","art":{"background":"a211","sprites":[{"asset":"a490","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「这……」","art":{"background":"a211","sprites":[{"asset":"a797","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「不行吗」","art":{"background":"a211","sprites":[{"asset":"a797","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「不……我愿意接受。今后也请多多关照」","art":{"background":"a211","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「谢谢！」","art":{"background":"a211","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"总算获得了认同！","art":{"background":"a211","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"不过朝武现在的态度还是很拘谨。","art":{"background":"a211","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"虽然我也没想着马上就能变得亲近。","art":{"background":"a211","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「还是太拘谨了」","art":{"background":"a211","sprites":[{"asset":"a205","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a586","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「不应该这么拘谨吗？」","art":{"background":"a211","sprites":[{"asset":"a205","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a478","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「本座认为，用更亲密的语气才像是朋友」","art":{"background":"a211","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a478","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「……朋友……」","art":{"background":"a211","sprites":[{"asset":"a207","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a797","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「总之你先试试把自己礼貌的语气改得更随意一点？」","art":{"background":"a211","sprites":[{"asset":"a130","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a797","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「万望不吝赐教？」","art":{"background":"a211","sprites":[{"asset":"a130","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a821","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「这明明更生硬了」","art":{"background":"a211","sprites":[{"asset":"a205","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a821","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「要更随意、更可爱、更亲密」","art":{"background":"a211","sprites":[{"asset":"a822","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「不是有很多年轻人使用的词汇吗？」","art":{"background":"a211","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「年轻人啊……」","art":{"background":"a211","sprites":[{"asset":"a797","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「可爱……随意……亲密……可爱、随意、亲密、可爱、随意、亲密」","art":{"background":"a211","sprites":[{"asset":"a757","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「请……请多几教」","art":{"background":"a211","sprites":[{"asset":"a823","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子・将臣","text":"『……』","art":{"background":"a211","sprites":[{"asset":"a823","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a824","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「噗噗！」","art":{"background":"a211","sprites":[{"asset":"a812","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a823","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a824","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「——啊！？」","art":{"background":"a211","sprites":[{"asset":"a812","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a825","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a824","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「……请多几教……？」","art":{"background":"a211","sprites":[{"asset":"a812","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a825","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a824","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「芳乃大人大概是想让“请多指教”听起来更亲和一些，想来想去最终选了这么一个词……」","art":{"background":"a211","sprites":[{"asset":"a720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「我猜也是……可是，在穗织这边朋友之间都会说“请多几教”吗？」","art":{"background":"a211","sprites":[{"asset":"a720","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「不，我也是第一次听到这种说法」","art":{"background":"a211","sprites":[{"asset":"a753","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「本座倒是很久以前有所耳闻。可是这“请多几教”……呜噗噗！」","art":{"background":"a211","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「………………」","art":{"background":"a211","sprites":[{"asset":"a826","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「现在该怎么办……？我也回一句请多几教比较好？」","art":{"background":"a211","sprites":[{"asset":"a591","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「既然芳乃大人都这么努力了，你就回一句意思意思呗？」","art":{"background":"a211","sprites":[{"asset":"a715","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「对，说的也是」","art":{"background":"a211","sprites":[{"asset":"a715","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"将臣","text":"「请多几教，朝武」","art":{"background":"a211","sprites":[{"asset":"a826","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a494","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"茉子","text":"「我也是，今后请请多几教，芳乃大人」","art":{"background":"a211","sprites":[{"asset":"a827","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a828","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"芳乃","text":"「呜呜呜呜呜呜呜哇啊啊啊啊啊啊啊啊啊啊啊啊啊！」","art":{"background":"a211","sprites":[{"asset":"a829","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a828","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"2-7"},{"speaker":"丛雨","text":"「这话可能轮不到笑出声的本座来说……总之快住手吧，你们真把她弄哭了」","art":{"background":"a211","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"2-7"},{"speaker":"","text":"就这样，我们两人的关系……翻开了崭新的一页？","art":{"background":"a1","sprites":[]},"chapter":"2-7"}]