[{"speaker":"芳乃","text":"「茉子，有地，我希望你们今天出去约会」","art":{"background":"a211","sprites":[{"asset":"a253","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「哎？」","art":{"background":"a211","sprites":[{"asset":"a253","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「出什么事了吗……？怎么突然说这个」","art":{"background":"a211","sprites":[{"asset":"a431","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a550","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「毕竟今天学校也放假，我想让你们共度情侣的时光」","art":{"background":"a211","sprites":[{"asset":"a622","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a550","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「可是……」","art":{"background":"a211","sprites":[{"asset":"a622","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a321","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「家务方面不用担心。我一直在坚持练习做家务，你身为我的老师应该十分清楚才对」","art":{"background":"a211","sprites":[{"asset":"a426","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a321","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「话是这么说……」","art":{"background":"a211","sprites":[{"asset":"a426","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a567","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「本座也觉得这主意不错」","art":{"background":"a211","sprites":[{"asset":"a196","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「小雨……」","art":{"background":"a211","sprites":[{"asset":"a196","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「毕竟兽灵还附在你身上」","art":{"background":"a211","sprites":[{"asset":"a261","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「你们不要总是原地踏步，要去尝试各种以前没做过的事。明白吗，要敢于尝试」","art":{"background":"a211","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……嗯？」","art":{"background":"a211","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"小雨这话让人有些在意……是我的错觉吗？","art":{"background":"a211","sprites":[{"asset":"a312","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「你看，丛雨大人都这么说了。所以你们俩再去好好约一次会吧。好吗？」","art":{"background":"a211","sprites":[{"asset":"a446","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「真的算我求你们了，快去约会吧……！」","art":{"background":"a211","sprites":[{"asset":"a420","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"她的眼神中带着某种毅然决然的味道，简直就像在瞪我和茉子一样。","art":{"background":"a211","sprites":[{"asset":"a420","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「行了，别白费芳乃的一番好意，就乖乖按她说的去做吧」","art":{"background":"a211","sprites":[{"asset":"a141","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……但这也太突然了……也不知道将臣有没有其他安排？」","art":{"background":"a211","sprites":[{"asset":"a280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我当然没问题」","art":{"background":"a211","sprites":[{"asset":"a280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「难得她们这么有心，我们就恭敬不如从命吧」","art":{"background":"a211","sprites":[{"asset":"a280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「所以茉子，如果你也有空的话，就跟我去约会吧」","art":{"background":"a211","sprites":[{"asset":"a280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯，那就拜托你了」","art":{"background":"a211","sprites":[{"asset":"a2628","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a211","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「让你久等了，将臣」","art":{"background":"a211","sprites":[{"asset":"a2505","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「哪儿的话，这种等待也是约会的乐趣之一嘛」","art":{"background":"a211","sprites":[{"asset":"a2505","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「这身衣服很适合你，看着非常可爱」","art":{"background":"a211","sprites":[{"asset":"a2505","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「哈哈，谢谢夸奖」","art":{"background":"a211","sprites":[{"asset":"a2499","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「不过……就是有点可惜啊」","art":{"background":"a211","sprites":[{"asset":"a2499","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「哎？什么可惜？」","art":{"background":"a211","sprites":[{"asset":"a2503","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「因为你这身打扮是特别的，我不太想让其他男的看到」","art":{"background":"a211","sprites":[{"asset":"a2503","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「哎？啊、对不起。我马上换掉」","art":{"background":"a211","sprites":[{"asset":"a2554","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「啊，不不，没事的。虽然我一方面不想让人看到……但另一方面也想和别人炫耀」","art":{"background":"a211","sprites":[{"asset":"a2554","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我想让大家看看，这么可爱的女孩子是我的女朋友」","art":{"background":"a211","sprites":[{"asset":"a2554","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……将臣……」","art":{"background":"a211","sprites":[{"asset":"a2629","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「这句话太羞耻了啦～」","art":{"background":"a211","sprites":[{"asset":"a2456","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「哈哈……我也这么想。不过这是我的真心话」","art":{"background":"a211","sprites":[{"asset":"a2456","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「谢谢……」","art":{"background":"a211","sprites":[{"asset":"a2542","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「虽然很难为情，但还是很开心……嘻嘻」","art":{"background":"a211","sprites":[{"asset":"a2533","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「那我们走吧」","art":{"background":"a211","sprites":[{"asset":"a2533","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我向茉子伸出了手。她微微一笑，将我的手紧紧握住。","art":{"background":"a211","sprites":[{"asset":"a2533","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯」","art":{"background":"a211","sprites":[{"asset":"a2630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"于是我们便手牵着手离开了家。","art":{"background":"a211","sprites":[]},"chapter":"6-5"},{"speaker":"芳乃","text":"「这样就可以了吗？」","art":{"background":"a211","sprites":[{"asset":"a1712","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「谁知道呢。我们能做的也就是给他们创造机会了」","art":{"background":"a211","sprites":[{"asset":"a1414","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「总不能对他们说“茉子天天自慰闹得芳乃睡不着觉，你们赶紧找个机会把事情办了吧”」","art":{"background":"a211","sprites":[{"asset":"a1374","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「您说的也没错，可是……」","art":{"background":"a211","sprites":[{"asset":"a1414","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a439","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「只能祈祷主人是个有骨气的男人了」","art":{"background":"a211","sprites":[{"asset":"a196","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a439","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「如果有地没骨气的话……？」","art":{"background":"a211","sprites":[{"asset":"a196","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"丛雨","text":"「呃……俗话说，“忍一时风平浪静，退一步海阔天空”」","art":{"background":"a211","sprites":[{"asset":"a914","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芳乃","text":"「怎么这样啊啊啊啊……」","art":{"background":"a211","sprites":[{"asset":"a1718","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"于是我们就开始了第二次的约会。","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"不过——","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「……去哪里好呢？」","art":{"background":"a19","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「哪里都行，我不介意」","art":{"background":"a19","sprites":[{"asset":"a2631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"因为这场约会来得太过突然，所以完全没有考虑要去哪里。","art":{"background":"a19","sprites":[{"asset":"a2631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"这种时候，我要是能二话不说把她带去一个有情调的地方，那就相当有面子了。然而我这只是第二次约会……","art":{"background":"a19","sprites":[{"asset":"a2631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"糟糕……这阵子我太得意忘形了，这种事至少该在脑海里预演一下才对。","art":{"background":"a19","sprites":[{"asset":"a2631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……对不起，我完全没有想过要去哪里」","art":{"background":"a19","sprites":[{"asset":"a2631","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「不不，没事啦。只要能像这样跟你在一起我就很幸福了」","art":{"background":"a19","sprites":[{"asset":"a2632","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「即便只是手牵着手，我就已经很满足了……哈哈」","art":{"background":"a19","sprites":[{"asset":"a2500","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"虽然很荣幸能听到她这么说，但实在是有些丢人。","art":{"background":"a19","sprites":[{"asset":"a2500","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"居然让女孩子说出这种话，看来我必须表现得更像个男人才行。","art":{"background":"a19","sprites":[{"asset":"a2500","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"……可是，我根本想不到什么好主意啊。","art":{"background":"a19","sprites":[{"asset":"a2500","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「哎呀呀？这不是将臣和茉子吗」","art":{"background":"a19","sprites":[{"asset":"a2633","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「蕾娜」","art":{"background":"a19","sprites":[{"asset":"a2633","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"跟上次不同，即便茉子打扮成现在这样，蕾娜还是一下子就认出来了。","art":{"background":"a19","sprites":[{"asset":"a1144","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"果然同性之间很容易认出来吗？","art":{"background":"a19","sprites":[{"asset":"a1144","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「你在工作吗？」","art":{"background":"a19","sprites":[{"asset":"a1144","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「是的。掌柜的让我送东西」","art":{"background":"a19","sprites":[{"asset":"a943","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「将臣和茉子……莫非你们正在约会？」","art":{"background":"a19","sprites":[{"asset":"a943","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……你看出来了？」","art":{"background":"a19","sprites":[{"asset":"a1144","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2634","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「嗯，那当然啦！因为你们手牵着手那么要好，除了约会还能是什么啊」","art":{"background":"a19","sprites":[{"asset":"a943","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2634","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「谢谢你，蕾娜。我们能够像现在这样交往，都是多亏了你那时的建议」","art":{"background":"a19","sprites":[{"asset":"a943","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2631","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「我只是把我临时想到的点子说出来了而已，没什么好道谢的啦」","art":{"background":"a19","sprites":[{"asset":"a1152","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2631","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「但要是没有你那句话，我们可能就不会成为这样手牵手的情侣了」","art":{"background":"a19","sprites":[{"asset":"a1152","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2631","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「能帮上你们的忙就好啦♪」","art":{"background":"a19","sprites":[{"asset":"a943","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「恭喜你们，你们已经不是临时情侣，而是真正的情侣啦」","art":{"background":"a19","sprites":[{"asset":"a943","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「谢谢你」","art":{"background":"a19","sprites":[{"asset":"a943","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「哎呀，不小心打扰到你们约会了。抱歉抱歉」","art":{"background":"a19","sprites":[{"asset":"a2635","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「谈不上什么打扰啦」","art":{"background":"a19","sprites":[{"asset":"a2635","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「是啊。我们真的非常感谢你」","art":{"background":"a19","sprites":[{"asset":"a2630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「哈哈，你们说得我好难为情啊」","art":{"background":"a19","sprites":[{"asset":"a951","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「不过我也还有工作在身，差不多该回去了」","art":{"background":"a19","sprites":[{"asset":"a2636","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「这样啊，抱歉，打扰你赶路了」","art":{"background":"a19","sprites":[{"asset":"a2636","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「不，没事啦。看到你们俩幸福美满的样子，我也觉得很幸福」","art":{"background":"a19","sprites":[{"asset":"a1155","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「总有一天我也会遇上心上人，我们也要手牵手，亲吻对方，然后……………」","art":{"background":"a19","sprites":[{"asset":"a2637","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「啊哇！？啊哇哇，我怎么在大街上想这种不知羞耻的事啊……！」","art":{"background":"a19","sprites":[{"asset":"a2638","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"蕾娜","text":"「辣、辣偶就告迟啦」","art":{"background":"a19","sprites":[{"asset":"a2639","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2501","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「好的。我们学校见」","art":{"background":"a19","sprites":[{"asset":"a2639","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-27.272727272727266,"opacity":255},{"asset":"a2499","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"蕾娜慌慌张张地跑掉了。","art":{"background":"a19","sprites":[{"asset":"a2499","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"她到底在车水马龙的大街上想些什么啊……","art":{"background":"a19","sprites":[{"asset":"a2499","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"根本不用问她本人，看她的反应就已经能猜出大半。而且……我最近也一直在想同样的事。","art":{"background":"a19","sprites":[{"asset":"a2499","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「总之我们先牵着手到处走走吧」","art":{"background":"a19","sprites":[{"asset":"a2499","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……好」","art":{"background":"a19","sprites":[{"asset":"a2630","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"总之……一边闲逛一边前往田心屋吧。","art":{"background":"a19","sprites":[{"asset":"a2630","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"先把目标定为跟茉子一起把菜单上的东西都点一遍。","art":{"background":"a19","sprites":[{"asset":"a2630","position":"左近","x":-130,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「欢迎光临——」","art":{"background":"a967","sprites":[{"asset":"a1011","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我们是两个人，还有位子吗？」","art":{"background":"a967","sprites":[{"asset":"a1011","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「是哥哥和常陆学姐啊。哇，学姐这身衣服好好看啊！太可爱了！」","art":{"background":"a967","sprites":[{"asset":"a968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「谢谢夸奖」","art":{"background":"a967","sprites":[{"asset":"a2640","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「难不成这套衣服是……决胜服？」","art":{"background":"a967","sprites":[{"asset":"a968","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2640","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「目前只在约会的时候穿过……所以也可以这么说吧」","art":{"background":"a967","sprites":[{"asset":"a968","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2493","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「也就是说，你们跟传闻中说的一样，是真的在交往啊……哇啊……哥哥和……学姐……」","art":{"background":"a967","sprites":[{"asset":"a2641","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2493","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「这么意外吗？」","art":{"background":"a967","sprites":[{"asset":"a2641","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2493","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「啊，不是的。我不是觉得意外，只是在感叹情侣原来是这个样子的」","art":{"background":"a967","sprites":[{"asset":"a2642","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「毕竟……廉哥那个人你们也知道，他的情况根本不能拿来参考」","art":{"background":"a967","sprites":[{"asset":"a1024","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「啊……说的也是」","art":{"background":"a967","sprites":[{"asset":"a1024","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「所以我是第一次看到身边有人在交往……看起来真棒，甚至有点向往」","art":{"background":"a967","sprites":[{"asset":"a1687","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"芦花","text":"「欢迎光临——」","art":{"background":"a967","sprites":[{"asset":"a1573","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芦花","text":"「这不是阿将和常陆吗。咦？今天也约会？」","art":{"background":"a967","sprites":[{"asset":"a996","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯，我们在约会。不过……这次不是临时的……」","art":{"background":"a967","sprites":[{"asset":"a2640","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"芦花","text":"「也就是说……」","art":{"background":"a967","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"芦花姐盯着我们直看。","art":{"background":"a967","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"但在下个瞬间，她马上就露出了笑容。","art":{"background":"a967","sprites":[{"asset":"a1696","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芦花","text":"「哇哦——！真是可喜可贺！」","art":{"background":"a967","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「这也是多亏了芦花姐上次给我们帮忙。谢谢你」","art":{"background":"a967","sprites":[{"asset":"a985","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「谢谢马庭姐。大家都夸你给我选的衣服非常好看，我也非常喜欢」","art":{"background":"a967","sprites":[{"asset":"a994","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2499","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芦花","text":"「能帮上忙就好」","art":{"background":"a967","sprites":[{"asset":"a995","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2499","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芦花","text":"「啊，很抱歉让你们一直站着」","art":{"background":"a967","sprites":[{"asset":"a1564","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「啊，是呀」","art":{"background":"a967","sprites":[{"asset":"a1687","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「那么两位客人，这边请」","art":{"background":"a967","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"小春带着我和茉子入了座。","art":{"background":"a967","sprites":[]},"chapter":"6-5"},{"speaker":"小春","text":"「请问要点些什么呢？」","art":{"background":"a967","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我要抹茶」","art":{"background":"a967","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「我要焙茶。另外……有什么甜点可以推荐的吗？」","art":{"background":"a967","sprites":[{"asset":"a2501","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「布丁和蕨饼已经吃过了，还有别的吗？」","art":{"background":"a967","sprites":[{"asset":"a1029","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芦花","text":"「我想想……那么茶冻如何？」","art":{"background":"a967","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「啊，好像很好吃！那就麻烦来一份茶冻吧」","art":{"background":"a967","sprites":[{"asset":"a2499","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"小春","text":"「明白了」","art":{"background":"a967","sprites":[{"asset":"a989","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a991","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"芦花","text":"「请慢慢坐」","art":{"background":"a967","sprites":[{"asset":"a989","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a994","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"然后两人咯咯地笑着走回了后厨，一路上还时不时偷偷观察我和茉子。","art":{"background":"a967","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"端上来的茶冻很好吃，不枉我们如此期待。","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"但端上来的茶冻只有一盘。","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"吃茶冻的勺子也只给了一把。","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「（又被你们算计了啊……）」","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"不过我们确实没有明确要求要两人份的。","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"这是我的疏忽，由不得我抱怨。","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"即便我想再点一份或者再要个汤匙，芦花姐恐怕也是不会搭理我的。","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"而且——","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「将臣……来，啊——」","art":{"background":"a1","sprites":[{"asset":"a2630","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"茉子出乎意料地积极。","art":{"background":"a1","sprites":[{"asset":"a2630","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我没办法拒绝她……而且说实话，我也乐在其中。","art":{"background":"a1","sprites":[{"asset":"a2630","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"最后我们把店员和其他客人的目光抛在脑后，好好享受了一番二人时光。","art":{"background":"a1","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「呼……果然茶冻也很好吃」","art":{"background":"a1032","sprites":[{"asset":"a2643","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「嗯，在别地方真尝不到这么好吃的茶冻」","art":{"background":"a1032","sprites":[{"asset":"a2643","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「不止加了砂糖，还加了黑糖进去，这是最让人称赞的」","art":{"background":"a1032","sprites":[{"asset":"a2501","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我这才发现时间一下子过去了两个多小时。","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"这两个多小时，我们的对话流畅又自然，相处得十分愉快。","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"没错……只要跟茉子在一起，我就很幸福了。","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"但是……还不够。","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"在牵手的时候，以及每次相互喂食的时候，茉子的存在都占满了我的大脑。","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"茉子是我最爱的人，我想感受她的一切……她的声音、她的体温、她那柔软的身体……我都想据为己有。","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"这些念头让我的心跳不断加速。","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"难道是因为我是男人才会这样吗？","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"身为女性的茉子……不会像我这样关注对方吗？","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1032","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「那接下来做什么呢？」","art":{"background":"a1032","sprites":[{"asset":"a2505","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「你有什么主意吗？比如购物？」","art":{"background":"a1032","sprites":[{"asset":"a2505","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「不，我没什么特别想做的」","art":{"background":"a1032","sprites":[{"asset":"a2514","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「只要能跟你在一起，做什么都行」","art":{"background":"a1032","sprites":[{"asset":"a2630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「那么……牵着手散步？或是……」","art":{"background":"a1032","sprites":[{"asset":"a2630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1032","sprites":[{"asset":"a2630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「你不介意的话……要不要找个能够两人独处的地方？」","art":{"background":"a1032","sprites":[{"asset":"a2630","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……哎？两人独处是指……」","art":{"background":"a1032","sprites":[{"asset":"a2629","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……应该就是你想的那样。我喜欢你，茉子」","art":{"background":"a1032","sprites":[{"asset":"a2629","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"面对我的注视，茉子红着脸低下了头。","art":{"background":"a1032","sprites":[{"asset":"a2458","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"但是……她并没有放开我的手。","art":{"background":"a1032","sprites":[{"asset":"a2458","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"不，她反而握得更紧了一些，仿佛是在表示她的决心。","art":{"background":"a1032","sprites":[{"asset":"a2458","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1032","sprites":[{"asset":"a2458","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我当然也用力回握她的手。然后——","art":{"background":"a1032","sprites":[{"asset":"a2458","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「——在、在哪里……才能两人独处呢？」","art":{"background":"a1032","sprites":[{"asset":"a2528","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……这个——」","art":{"background":"a1032","sprites":[{"asset":"a2528","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"啊……虽然一时冲动开了口，但其实我并没有考虑过这个问题。","art":{"background":"a1032","sprites":[{"asset":"a2528","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"有什么合适的地方吗？","art":{"background":"a1032","sprites":[{"asset":"a2528","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"快想，快想想！呃……嗯……！","art":{"background":"a1032","sprites":[{"asset":"a2528","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「将臣……？」","art":{"background":"a1032","sprites":[{"asset":"a2543","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「请、请等一下！那个……」","art":{"background":"a1032","sprites":[{"asset":"a2543","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"在我无比烦恼的时候，手机铃声突然响了起来。","art":{"background":"a1032","sprites":[{"asset":"a2543","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「啊，对不起。是我的手机」","art":{"background":"a1032","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「来电话了？」","art":{"background":"a1032","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「是短信。啊……是我妈妈发来的……」","art":{"background":"a1032","sprites":[{"asset":"a2503","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「怎么会特地发短信给你，有急事吗？」","art":{"background":"a1032","sprites":[{"asset":"a2503","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「不是，她说她要开车去城里购物，问我有没有什么要买的」","art":{"background":"a1032","sprites":[{"asset":"a2501","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「喔，原来是这样」","art":{"background":"a1032","sprites":[{"asset":"a2501","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「现在才去城里购物的话……应该要花上好几个小时吧」","art":{"background":"a1032","sprites":[{"asset":"a2452","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「嗯。应该是吧」","art":{"background":"a1032","sprites":[{"asset":"a2452","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「在这段时间里……我家里，应该没人……」","art":{"background":"a1032","sprites":[{"asset":"a2451","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a1032","sprites":[{"asset":"a2451","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……」","art":{"background":"a1032","sprites":[{"asset":"a2458","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「茉、茉子。我现在……可以去你的房间坐坐吗？」","art":{"background":"a1032","sprites":[{"asset":"a2458","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「……可、可以……」","art":{"background":"a1032","sprites":[{"asset":"a2524","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……打扰了」","art":{"background":"a2330","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「请、请进……」","art":{"background":"a2330","sprites":[{"asset":"a2497","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我是第二次来这里了。","art":{"background":"a2330","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"没想到我会以男朋友的身份造访这个房间……","art":{"background":"a2330","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"这事就算告诉那时的我，我应该也不会信吧。","art":{"background":"a2330","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「……」","art":{"background":"a2330","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"好、好紧张啊。在芦花姐的店里明明不会这样的……","art":{"background":"a2330","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「……」","art":{"background":"a2330","sprites":[{"asset":"a2528","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"紧张的不只是我，茉子好像也一样。","art":{"background":"a2330","sprites":[{"asset":"a2528","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"明明是在自己的房间，她却眼神飘忽不定，一副坐立不安的样子。","art":{"background":"a2330","sprites":[{"asset":"a2528","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「啊，对不起，我竟然忘记给客人上茶了。我、我这就去泡」","art":{"background":"a2330","sprites":[{"asset":"a2496","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「等等！茶就不用了，毕竟刚刚才喝过」","art":{"background":"a2330","sprites":[{"asset":"a2496","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我有更重要的事情想跟你说」","art":{"background":"a2330","sprites":[{"asset":"a2496","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「好……好的……」","art":{"background":"a2330","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我的话似乎让茉子屏住了呼吸。","art":{"background":"a2330","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我轻轻吸了一口气，抬头面对茉子。","art":{"background":"a2330","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我喜欢你，太喜欢你了」","art":{"background":"a2330","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"心跳得更快了。","art":{"background":"a2330","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我好像在用全身倾诉着对茉子的爱。","art":{"background":"a2330","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我喜欢你……所以我想拥有你」","art":{"background":"a2330","sprites":[{"asset":"a2541","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「——」","art":{"background":"a2330","sprites":[{"asset":"a2529","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我想要你的全部。想要你的全部温暖……」","art":{"background":"a2330","sprites":[{"asset":"a2529","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「但如果你不愿意的话，请你直说——」","art":{"background":"a2330","sprites":[{"asset":"a2529","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯、啾……啾……嗯、啾咕、啾咕……」","art":{"background":"a2644","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"茉子用她的双唇塞住我喋喋不休的嘴巴。","art":{"background":"a2644","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"就像在表示什么都不必多说了。","art":{"background":"a2644","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"面对那对双唇的柔软触感，我拼命压制下来的欲望一下子爆发出来。","art":{"background":"a2644","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"在大脑下达指令前，我的嘴已经自动开始应战。","art":{"background":"a2644","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯、啾、啾……啾……嗯、呼……嗯、啾、啾……哈啊、哈啊、啾、啾唔、啾、啾」","art":{"background":"a2645","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"面对我双唇的攻势，不服输的茉子变得更加积极主动。","art":{"background":"a2645","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"即便脸已经涨得通红，她也绝不松开纠缠在一起的双唇。","art":{"background":"a2645","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"她在换气的同时，还在拼命贪求我的嘴唇。","art":{"background":"a2645","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「哈啊、哈啊、哈唔……啾、嗯嗯、啾、啾唔……嗯、嗯啊、哈嗯」","art":{"background":"a2645","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"茉子张开嘴想要喘气。","art":{"background":"a2645","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"而我用自己的舌头代替空气钻入她的嘴里。","art":{"background":"a2645","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯呼！？嗯、嗯嗯！？」","art":{"background":"a2646","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「嗯……啾、啾噜……」","art":{"background":"a2646","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯唔……嗯、嗯嗯、嗯噜、滋溜……啾、滋溜、滋溜……啾、啾溜啾溜……」","art":{"background":"a2647","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"措手不及的茉子好像一度陷入困惑。","art":{"background":"a2647","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"但是她并没有抗拒，而是温柔地接受了滑入嘴中的我的舌头。","art":{"background":"a2647","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「啾溜……啾、啾溜、滋啾……嗯啾、滋溜滋溜……」","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"不光是嘴唇，沾满了唾液的舌头也交缠在一起。","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"这就是……情侣之间的吻。","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯唔唔、啾、啾……啾溜、嗯唔、嗯唔……将臣……嗯、滋溜滋溜、啾、啾……」","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"将臣","text":"「……茉子，我喜欢你……好喜欢……啾、啾咕啾溜」","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯啊、啾溜……滋溜、滋溜滋溜、嗯呼——不、不行啦……滋溜、滋溜滋溜、嗯嗯啾……这么亲、不可以……滋溜」","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"虽然嘴上说着不行，但茉子的舌头却缠了上来，卖力程度丝毫不亚于我。","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"后来她甚至没时间好好喘气，口水不断从嘴角流下。","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「哈唔、嗯、啾、滋溜滋溜……啊嗯、讨厌、不行……嗯嗯、啾、啾……滋溜滋溜、啾噜噜」","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"不愧是情侣之间的接吻……跟之前完全不同。","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"之前的吻虽然会让身体产生飘飘然的感觉……但这种吻会让人有种全身发麻的感觉。","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「啾、啾、滋溜滋溜……哈啊、哈啊、啾唔、嗯嗯……滋溜滋溜、嗯、啾噜噜……」","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"我一味贪求着她那柔软的双唇和舌头。","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"茉子当然也一样。","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"她的眼睛已经微微失神，舌头就像是要将我口中的一切舔干舐净。","art":{"background":"a2648","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯、啾噜……啾、啾、啾噜啾噜……哈啊啊、嗯嗯、嗯嗯———！」","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"彼此都是第一次深吻。","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"虽然还很生疏，但我们都在用舌头探索让对方更舒服的吻法。","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"……不妙了。","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"虽说是深吻，但彼此接触到的还只是嘴唇而已。","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"","text":"然而我的内裤里却已经膨胀到快要爆炸了。","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「嗯、啾噜……嗯、噗啊」","art":{"background":"a2649","sprites":[]},"chapter":"6-5"},{"speaker":"茉子","text":"「哈、哈啊……哈啊……嗯嗯……嗯、哈啊啊啊……」","art":{"background":"a2330","sprites":[{"asset":"a2650","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「明明只是接吻而已……我却变得这么下流……哈啊、哈啊……」","art":{"background":"a2330","sprites":[{"asset":"a2450","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"茉子扭扭捏捏地摇动着身体。","art":{"background":"a2330","sprites":[{"asset":"a2450","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"连她那细微的动作，好像都在诱惑着我。","art":{"background":"a2330","sprites":[{"asset":"a2450","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「我早就已经精虫上脑了」","art":{"background":"a2330","sprites":[{"asset":"a2450","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「哎？啊……好、好厉害……又变成外星人了」","art":{"background":"a2330","sprites":[{"asset":"a2459","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「都说了这不是外星人！」","art":{"background":"a2330","sprites":[{"asset":"a2459","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"我的性器把内裤和外裤高高顶起。","art":{"background":"a2330","sprites":[{"asset":"a2459","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"","text":"它已经肿胀到隐隐作痛的地步……其实真的有点痛，因为角度不太好……","art":{"background":"a2330","sprites":[{"asset":"a2459","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「所以，茉子……」","art":{"background":"a2330","sprites":[{"asset":"a2459","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「那那那个，我想事先确认一下……」","art":{"background":"a2330","sprites":[{"asset":"a2448","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「你你你你说过自己并不讨厌下流的女孩对吧？」","art":{"background":"a2330","sprites":[{"asset":"a2510","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「如果她只在我面前下流，那就是我最喜欢的类型了」","art":{"background":"a2330","sprites":[{"asset":"a2510","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"茉子","text":"「那、那那那……请你绝对不要觉得恶心哦」","art":{"background":"a2330","sprites":[{"asset":"a2651","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"},{"speaker":"将臣","text":"「……哎？」","art":{"background":"a2330","sprites":[{"asset":"a2651","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"6-5"}]