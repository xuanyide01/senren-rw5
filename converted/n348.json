[{"speaker":"丛雨","text":"「主人，主人！」","art":{"background":"a0","sprites":[]},"chapter":"9-2"},{"speaker":"丛雨","text":"「主人！主人！」","art":{"background":"a0","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"我感觉有人在摇我的被子。","art":{"background":"a0","sprites":[]},"chapter":"9-2"},{"speaker":"将臣","text":"「嗯？」","art":{"background":"a0","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"被叫醒后，我睡眼惺忪的视野之中……","art":{"background":"a202","sprites":[]},"chapter":"9-2"},{"speaker":"丛雨","text":"「你终于起来了呀」","art":{"background":"a202","sprites":[{"asset":"a3371","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「早上好呀，主人」","art":{"background":"a202","sprites":[{"asset":"a3372","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"是身着我们学院校服的小雨……也就是绫。","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「早上好，你已经换好校服了吗？」","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「我们还没打扫神社呢，扫完了再换啊」","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「话是这么说没错，但是本座忍不住了嘛」","art":{"background":"a202","sprites":[{"asset":"a3374","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"没错。","art":{"background":"a202","sprites":[{"asset":"a3374","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"从今天开始，她就要到我们的学院上学。","art":{"background":"a202","sprites":[{"asset":"a3374","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"这是她享受普通女孩生活的第一步。","art":{"background":"a202","sprites":[{"asset":"a3374","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「很合身啊，小雨……不，小绫」","art":{"background":"a202","sprites":[{"asset":"a3375","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「啊哈哈！这段时间你叫本座小雨也没事」","art":{"background":"a202","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「就当作是昵称吧」","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「哦，还可以这样用啊」","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「不说这个了，先帮本座看看校服有没有什么奇怪的地方？」","art":{"background":"a202","sprites":[{"asset":"a3376","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"她在我跟前转了一圈。","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"新的校服裙在空中划出了一道美丽的弧线。","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「嗯，从头到尾都很可爱」","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「不愧是我的女朋友」","art":{"background":"a202","sprites":[{"asset":"a3373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「哈哈哈！你就那么喜欢本座穿校服的样子吗」","art":{"background":"a202","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「本座想到了。下次就用这套衣服来“玩情趣”吧」","art":{"background":"a202","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「小雨，女孩子不要把“情趣”这种词挂在嘴边」","art":{"background":"a202","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"虽然外表幼小，但她的内在却像个专讲黄段子的成年女性。","art":{"background":"a202","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"这个就先不说了。","art":{"background":"a202","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「从今天开始你和小春就是同班同学了」","art":{"background":"a202","sprites":[{"asset":"a3372","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「你在说什么呢，本座当然是要和你做同班同学」","art":{"background":"a202","sprites":[{"asset":"a3377","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「本座才不想和你分在不同的班呢。别再捉弄本座了」","art":{"background":"a202","sprites":[{"asset":"a3378","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「我没有捉弄你，年龄要和年级相符啊」","art":{"background":"a202","sprites":[{"asset":"a3378","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「什么？！主人你居然把本座当小孩子看！」","art":{"background":"a202","sprites":[{"asset":"a3379","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"丛雨","text":"「本座可比你年长五百岁呢」","art":{"background":"a202","sprites":[{"asset":"a3380","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"将臣","text":"「照这么说那更不可能在同一个班了吧？！」","art":{"background":"a202","sprites":[{"asset":"a3380","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"9-2"},{"speaker":"","text":"小雨要适应普通女孩的生活，还真是任重而道远啊。","art":{"background":"a202","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"不过也无所谓。","art":{"background":"a202","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"这条路就让我陪着她慢慢走吧。","art":{"background":"a202","sprites":[]},"chapter":"9-2"},{"speaker":"所有人","text":"『我们出发了』","art":{"background":"a1","sprites":[]},"chapter":"9-2"},{"speaker":"安晴","text":"「路上小心」","art":{"background":"a1","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"我们四个人朝着安晴叔叔挥挥手，走向学院。","art":{"background":"a1","sprites":[]},"chapter":"9-2"},{"speaker":"丛雨","text":"「快点，走快点呀，主人！」","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"将臣","text":"「不用走那么快也不会迟到啦」","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"小雨兴高采烈地拉着我的手向前跑去。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"我的手也清楚地感受到了她的体温。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"身边许多人都看向了她，并向她问好。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"他们都说“丛雨大人，路上小心”。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"不过……","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"丛雨","text":"「我希望你们能叫我小雨！」","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"每次她都回报以光彩夺目的笑容。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"是啊……","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"那个作为祭品承受了五百年孤独的少女已经不在了。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"她也再也不会仰望月亮，暗自哭泣了。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"丛雨丸对她说……","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"“祝你幸福”。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"我在悄悄心底起誓。","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"对得到供奉的战友起誓……","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"小雨……","art":{"background":"a3381","sprites":[]},"chapter":"9-2"},{"speaker":"丛雨","text":"「主人……！」","art":{"background":"a3382","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"我一定会给你幸福。","art":{"background":"a3382","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"我要让你成为天下最幸福的人。","art":{"background":"a3382","sprites":[]},"chapter":"9-2"},{"speaker":"","text":"我要把你五百年来失去的幸福，全部赠予给你……","art":{"background":"a3382","sprites":[]},"chapter":"9-2"}]