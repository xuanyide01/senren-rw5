[{"speaker":"丛雨","text":"「嗯？！嗯、嗯……」","art":{"background":"a3224","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"我在小雨嘴里射出了大量白浊液体。","art":{"background":"a3224","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「嗯、嗯、嗯、嗯、嗯……」","art":{"background":"a3224","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「嗯……咕嘟」","art":{"background":"a3224","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"她喝下了我的精液。","art":{"background":"a3224","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"但她的嘴太小，容纳不下全部，一些精液溢了出来。","art":{"background":"a3224","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「呼、呼、嗯、啾、啾、嗯、啾……」","art":{"background":"a3225","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「这就是主人的味道……啾、啾……」","art":{"background":"a3225","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"她不仅没嫌弃，还仔细地把沾在我那上面的精液都舔了。","art":{"background":"a3225","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「啊，小雨，我说……」","art":{"background":"a3225","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"刚射完被这样舔着好痒的。","art":{"background":"a3225","sprites":[]},"chapter":"6-4"},{"speaker":"","text":"可她完全没有停手的意思。","art":{"background":"a3225","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「……好苦啊，主人」","art":{"background":"a3226","sprites":[]},"chapter":"6-4"},{"speaker":"将臣","text":"「那不舔也没关系」","art":{"background":"a3226","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「不行，太浪费了」","art":{"background":"a3226","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「这些全都是本座的」","art":{"background":"a3226","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「知道主人味道的只有本座一个……」","art":{"background":"a3226","sprites":[]},"chapter":"6-4"},{"speaker":"丛雨","text":"「呵呵，一想到这里，本座也开心起来啦……」","art":{"background":"a3226","sprites":[]},"chapter":"6-4"}]