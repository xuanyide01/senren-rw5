[{"speaker":"美津叶","text":"「唔，嗯……」","art":{"background":"a1130","sprites":[{"asset":"a548","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「资料该找的也都找了，差不多该直接研究一下这块碎片了」","art":{"background":"a1130","sprites":[{"asset":"a548","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「可是，到底该怎么研究呢？」","art":{"background":"a1130","sprites":[{"asset":"a879","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「一眼看上去只是普通的石头」","art":{"background":"a1130","sprites":[{"asset":"a545","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「嗯……总之得做一番尝试才行」","art":{"background":"a1130","sprites":[{"asset":"a865","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「如果这真的是水晶，那硬度应该是很高的」","art":{"background":"a1130","sprites":[{"asset":"a532","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「那就先检测下硬度好了……稍微削一小片应该没问题吧？」","art":{"background":"a1130","sprites":[{"asset":"a876","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「正好也想对细小的碎片做一些实验」","art":{"background":"a1130","sprites":[{"asset":"a532","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「唉……我这简直跟个炼金术师似的」","art":{"background":"a1130","sprites":[{"asset":"a875","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"美津叶","text":"「……」","art":{"background":"a1130","sprites":[]},"chapter":"3-2"},{"speaker":"美津叶","text":"「好，就这样了。那么，接下来再试试这样……」","art":{"background":"a1130","sprites":[{"asset":"a865","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}