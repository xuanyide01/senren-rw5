[{"speaker":"将臣","text":"「芳乃，我要直接射出来了」","art":{"background":"a2262","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「好、好的……射出来吧，直接射到我了里面，用力射出来……啊啊啊」","art":{"background":"a2264","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「啊、啊……唔、啊啊啊……快点、快点快点……不然我、就要先……唔啊、呜、唔唔——！」","art":{"background":"a2263","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「唔、唔……不行，要射了……！」","art":{"background":"a2263","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「唔啊啊、啊、啊啊啊啊啊啊啊啊啊啊啊啊啊啊——————————！」","art":{"background":"a2262","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「唔啊啊、啊……啊、啊、唔、唔啊啊啊啊啊……！」","art":{"background":"a2270","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我的阳具连根插入芳乃体内，将我积攒的欲望一股脑释放出来。","art":{"background":"a2270","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「唔呀、啊啊、啊——啊——唔、唔啊啊啊、啊啊啊啊……」","art":{"background":"a2271","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"——咕嘟！咕嘟！","art":{"background":"a2271","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"喷吐而出的精液每一次撞击芳乃的阴道，都会让与我同时高潮的芳乃的身体猛烈震颤。","art":{"background":"a2271","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「唔唔、哈呀、啊……啊……唔、唔唔唔……射出来了、射在我的体内、好猛烈、好多……啊、啊」","art":{"background":"a2272","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"——咕嘟……！","art":{"background":"a2273","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"当喷出最后一滴精液后，我缓缓抽出阳具。","art":{"background":"a2273","sprites":[]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「唔、唔唔唔……唔唔啊、啊啊啊……」","art":{"background":"a2274","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"只见阳具上沾满了精液和爱液。","art":{"background":"a2274","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"那个刚才一直吸吮着阳具的洞穴也变得软趴趴的，里面流出了粘稠的白色液体。","art":{"background":"a2274","sprites":[]},"chapter":"后日谈"}]