[{"speaker":"将臣","text":"「小、小春……我、要射了……」","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯……唔唔……好啊，射吧，哥哥……嗯嗯，再射出好多好多精液来吧……哈啊，哈啊」","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「小春……小春……」","art":{"background":"a4327","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「哥哥……啊啊啊，哥哥……」","art":{"background":"a4330","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我们呼唤着对方的名字，让意识都交融在了一起。我朝着不远处的快感的高峰急速攀登，运动腰身。","art":{"background":"a4330","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"最后放任自己于阵阵快感的浪潮中……","art":{"background":"a4330","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「小春，我去了，要射了！」","art":{"background":"a4330","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯，啊，啊，啊，来吧，啊！射吧射吧，哥哥……哈啊哈啊哈啊……嗯嗯！」","art":{"background":"a4329","sprites":[]},"chapter":"8-2"},{"speaker":"将臣","text":"「小春！」","art":{"background":"a4329","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯嗯嗯嗯，啊啊啊啊啊啊啊啊啊啊啊，哥哥——！」","art":{"background":"a4331","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「嗯啊，嗯，嗯，嗯……嗯嗯！」","art":{"background":"a4332","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"迎来高潮的我急忙将阴茎拔出。","art":{"background":"a4332","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"这时大量的精液都挥洒在了小春的小腹。","art":{"background":"a4332","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「啊，哈啊……哈啊……哈啊……嗯嗯，嗯嗯……」","art":{"background":"a4333","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我就像是贫血了似的，眼前直打闪。","art":{"background":"a4333","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我的射精居然剧烈到了这个地步。","art":{"background":"a4333","sprites":[]},"chapter":"8-2"},{"speaker":"","text":"我射出的所有精液都落到了小春的肌肤上，将她洁白的身躯染得更加纯白。","art":{"background":"a4333","sprites":[]},"chapter":"8-2"},{"speaker":"小春","text":"「哈啊……好厉害……哥哥的这个好热啊……哈啊，哈啊哈啊……」","art":{"background":"a4334","sprites":[]},"chapter":"8-2"}]