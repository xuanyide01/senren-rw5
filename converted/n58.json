[{"speaker":"将臣","text":"「唔唔……」","art":{"background":"a275","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我在熟悉的房间里醒来，缓缓起身。","art":{"background":"a275","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「……要赶紧换上衣服」","art":{"background":"a275","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"都这么大岁数了，不能老让人家叫自己起床。","art":{"background":"a275","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我必须努力点……！","art":{"background":"a275","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「今天也拜托您了」","art":{"background":"a498","sprites":[]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「哇……将臣这家伙竟然真的在锻炼」","art":{"background":"a498","sprites":[{"asset":"a928","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「廉太郎？你怎么在这儿？」","art":{"background":"a498","sprites":[{"asset":"a928","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「因为爷爷说你又开始练习剑道了」","art":{"background":"a498","sprites":[{"asset":"a84","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「而且还是你自己要求的，这更让我怀疑自己的耳朵了」","art":{"background":"a498","sprites":[{"asset":"a102","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「所以就过来亲眼确认一下！」","art":{"background":"a498","sprites":[{"asset":"a87","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「这么早过来，就为了这个？」","art":{"background":"a498","sprites":[{"asset":"a87","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「这是一半原因，另一半是……被强迫了」","art":{"background":"a498","sprites":[{"asset":"a77","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「你也是太松懈了。不说让你每天晨练，但你也得偶尔参加一次啊」","art":{"background":"a498","sprites":[{"asset":"a575","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「结果我就有了大麻烦……今天可是难得的休息日啊」","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「哎……啊啊啊啊」","art":{"background":"a498","sprites":[{"asset":"a106","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「偶尔活动活动身体也挺好的」","art":{"background":"a498","sprites":[{"asset":"a106","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「没想到能从你口中听到这话……」","art":{"background":"a498","sprites":[{"asset":"a929","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「不过，你为什么又开始练剑道了啊？」","art":{"background":"a498","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「嗯？这个嘛……算是……为了身体健康？」","art":{"background":"a498","sprites":[{"asset":"a87","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「你身体哪里不好吗？」","art":{"background":"a498","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不是那样。我只是觉得每天懒懒散散的对身体不太好」","art":{"background":"a498","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「可是这锻炼强度也太高了吧」","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「这个下午的锻炼是什么鬼啊，光是切返都要练一小时，谁锻炼身体会练这么猛啊」","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「啊……这个嘛……其实我也累得想吐、累得想死、累得想哭啊」","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"不过，练的那些技巧也确实让我在祓禊的时候派上了用场。","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「爷爷还是这么折磨人啊」","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「早上只有单纯的体能训练，还是对身体很有好处的」","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「你们俩别叽叽歪歪的了，要开始锻炼了」","art":{"background":"a498","sprites":[{"asset":"a575","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎・将臣","text":"『是』","art":{"background":"a498","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"就这样，我开始和廉太郎一起做那些锻炼。","art":{"background":"a1","sprites":[]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「廉太郎！别躺那，给我坚持跑完！」","art":{"background":"a1","sprites":[{"asset":"a930","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「好——嘞！」","art":{"background":"a1","sprites":[{"asset":"a930","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a106","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「唔……肚子……岔气了……」","art":{"background":"a1","sprites":[{"asset":"a77","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「都说了别歇着，廉太郎！！」","art":{"background":"a1","sprites":[{"asset":"a931","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a77","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「好————嘞！」","art":{"background":"a1","sprites":[{"asset":"a931","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a105","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「廉太郎！！！」","art":{"background":"a1","sprites":[{"asset":"a930","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a105","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「好——————嘞！」","art":{"background":"a1","sprites":[{"asset":"a930","position":"85%","x":240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255},{"asset":"a77","position":"85%","x":-240,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「好，今天就练到这儿吧」","art":{"background":"a498","sprites":[{"asset":"a569","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「呼，呼，呼……非常……感谢……呼……呼……」","art":{"background":"a498","sprites":[{"asset":"a77","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「你没事吧？」","art":{"background":"a498","sprites":[{"asset":"a77","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「我真的……不行了……两眼都冒金星了」","art":{"background":"a498","sprites":[{"asset":"a106","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「真亏你能每天都能练这么多」","art":{"background":"a498","sprites":[{"asset":"a929","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「现在我的身体也开始习惯这种锻炼了。不过还是完全比不过外公」","art":{"background":"a498","sprites":[{"asset":"a929","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我从没打出过哪怕一次有效打击」","art":{"background":"a498","sprites":[{"asset":"a929","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「你准备动作太明显了」","art":{"background":"a498","sprites":[{"asset":"a570","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「你一直急着想出手，让别人一眼就能看穿你想干什么」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「……原来是这样……？」","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"准备动作太明显……","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"虽然听说过这词，但是从没深切体会过。","art":{"background":"a498","sprites":[{"asset":"a572","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「你啊你，怎么比以前还认真……？」","art":{"background":"a498","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「以后你要不要也一起锻炼？」","art":{"background":"a498","sprites":[{"asset":"a928","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「免了，我可受不了」","art":{"background":"a498","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「运动完后吃饭更香哦」","art":{"background":"a498","sprites":[{"asset":"a73","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「这么严酷的训练，别说更香，不吐出来就不错了！」","art":{"background":"a498","sprites":[{"asset":"a932","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「幸好今天是周六，要是还得上学，那我肯定要翘课了」","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「要喝水吗？」","art":{"background":"a498","sprites":[{"asset":"a77","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"廉太郎没回话，伸手就把水抢了过去。","art":{"background":"a498","sprites":[{"asset":"a933","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"然后大口喝了起来。","art":{"background":"a498","sprites":[{"asset":"a933","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「噗哈，呼……活过来了」","art":{"background":"a498","sprites":[{"asset":"a934","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「好了，既然完事儿了，我也该回去了」","art":{"background":"a498","sprites":[{"asset":"a934","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「对了，你今天有什么计划吗？」","art":{"background":"a498","sprites":[{"asset":"a60","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「下午要跟外公锻炼，除此之外就没别的事了」","art":{"background":"a498","sprites":[{"asset":"a60","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「呜哇……还真要再练啊，偶尔也休息休息嘛」","art":{"background":"a498","sprites":[{"asset":"a929","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「每天都练这么猛，反而会练坏身子的啊」","art":{"background":"a498","sprites":[{"asset":"a71","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「也是……偶尔休息个一两天也挺好」","art":{"background":"a498","sprites":[{"asset":"a579","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「外公？」","art":{"background":"a498","sprites":[{"asset":"a579","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「今天就轻松点，只练习步法和素振好了」","art":{"background":"a498","sprites":[{"asset":"a573","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「结果还是免不了素振和步法……」","art":{"background":"a498","sprites":[{"asset":"a98","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a571","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「这是基础中的基础，要想练好就必须不断地夯实基础」","art":{"background":"a498","sprites":[{"asset":"a98","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a570","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「你也真够辛苦的……不过你拜托爷爷的时候，应该就已经做好心理准备了吧」","art":{"background":"a498","sprites":[{"asset":"a73","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a570","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「那么，既然爷爷也同意了，要不要出去玩玩？」","art":{"background":"a498","sprites":[{"asset":"a96","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「玩？去哪玩？」","art":{"background":"a498","sprites":[{"asset":"a96","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「还没想好，我下午也闲着」","art":{"background":"a498","sprites":[{"asset":"a60","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"廉太郎","text":"「总之待会儿先去田心屋碰头吧」","art":{"background":"a498","sprites":[{"asset":"a96","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「这个……」","art":{"background":"a498","sprites":[{"asset":"a96","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"既然不是偷懒，是名正言顺地休息的话……去玩一玩也无妨。","art":{"background":"a498","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「行，在芦花姐的店里碰头是吧」","art":{"background":"a498","sprites":[]},"chapter":"3-2"},{"speaker":"玄十郎","text":"「对了。既然你们要出去玩，那我拜托你们一件事」","art":{"background":"a498","sprites":[{"asset":"a569","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「能跟你们说个事吗？」","art":{"background":"a211","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「怎么了？什么事？」","art":{"background":"a211","sprites":[{"asset":"a246","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「遇到什么麻烦了吗？」","art":{"background":"a211","sprites":[{"asset":"a445","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a246","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不是的，我想问一下今天你们俩有什么安排」","art":{"background":"a211","sprites":[{"asset":"a445","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a246","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「已经打扫完了卫生洗完了衣服，接下来就是做午饭、收衣服，还有就是准备晚饭了」","art":{"background":"a211","sprites":[{"asset":"a445","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「我和平常一样，要去献舞……剩下的时间准备用来学习」","art":{"background":"a211","sprites":[{"asset":"a434","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「如果方便的话，要不要一起出去玩？其实今天我要和廉太郎一起逛街」","art":{"background":"a211","sprites":[{"asset":"a434","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a249","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「你的意思是让我们也一起去？」","art":{"background":"a211","sprites":[{"asset":"a935","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「偶尔也要放松放松嘛」","art":{"background":"a211","sprites":[{"asset":"a935","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「本座认为这是个好主意」","art":{"background":"a211","sprites":[{"asset":"a137","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「芳乃，茉子，你们都没有和其他人一起玩过吧？」","art":{"background":"a211","sprites":[{"asset":"a133","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「不过……这是否会妨碍到你们？」","art":{"background":"a211","sprites":[{"asset":"a280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「怎么可能妨碍呢，我巴不得你们来」","art":{"background":"a211","sprites":[{"asset":"a280","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「只是去逛街的话，我倒也不介意」","art":{"background":"a211","sprites":[{"asset":"a444","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「谢谢了。抱歉啊，突然约你们出去玩」","art":{"background":"a211","sprites":[{"asset":"a444","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「不用在意，我们不是说好了吗，要了解对方」","art":{"background":"a211","sprites":[{"asset":"a936","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「就是啊，你们俩可是请多几教之友哦」","art":{"background":"a211","sprites":[{"asset":"a249","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「别说了啊啊啊啊啊啊！\n别再提那事儿了啊啊啊啊啊啊！」","art":{"background":"a211","sprites":[{"asset":"a937","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"莫非常陆是个天生的小恶魔？","art":{"background":"a211","sprites":[{"asset":"a256","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「对不起，芳乃大人。我诚心诚意跟您道歉，所以请不要生这么大的气」","art":{"background":"a938","sprites":[{"asset":"a622","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a292","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「我也不是在生气」","art":{"background":"a938","sprites":[{"asset":"a424","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a292","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「真的吗？那您怎么从刚才到现在一句话都不说呢？」","art":{"background":"a938","sprites":[{"asset":"a424","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a321","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「这是因为……」","art":{"background":"a938","sprites":[{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a321","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「和朋友出去玩该怎么办才好？我第一次出去玩，非常紧张……而且胸口怦怦直跳……」","art":{"background":"a938","sprites":[{"asset":"a939","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「是、是不是应该穿正装呢？」","art":{"background":"a938","sprites":[{"asset":"a435","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「不过是出去玩罢了，穿现在这身衣服就行」","art":{"background":"a938","sprites":[{"asset":"a332","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「但是……至少要穿新衣服吧」","art":{"background":"a938","sprites":[{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a286","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「不需要做到这种地步啦」","art":{"background":"a938","sprites":[{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a332","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「但是……难得受邀，万一我显得不礼貌，\n会给邀请我的有地添麻烦的……」","art":{"background":"a938","sprites":[{"asset":"a919","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a332","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「您想太多了，根本不需要那么正式」","art":{"background":"a938","sprites":[{"asset":"a919","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a324","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「您和平常一样就好，不用想那么多」","art":{"background":"a938","sprites":[{"asset":"a919","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a291","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「这反而是最难办的啊。到底该怎么办啊……」","art":{"background":"a938","sprites":[{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a291","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「……」","art":{"background":"a938","sprites":[{"asset":"a429","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a323","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「怎么了？」","art":{"background":"a938","sprites":[{"asset":"a940","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a323","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「没什么，不过是第一次看到芳乃大人如此烦恼罢了」","art":{"background":"a938","sprites":[{"asset":"a940","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a291","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「别幸灾乐祸了，快帮帮我！」","art":{"background":"a938","sprites":[{"asset":"a941","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a291","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「我都说了，您不用想那么多啦」","art":{"background":"a938","sprites":[{"asset":"a941","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a292","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「爸爸，我出门啦」","art":{"background":"a316","sprites":[{"asset":"a171","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a426","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"安晴","text":"「好的，慢走」","art":{"background":"a316","sprites":[{"asset":"a197","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a426","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「那么，本座也前去探索了」","art":{"background":"a316","sprites":[{"asset":"a137","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「丛雨大人，真是抱歉。我们把事情都甩给您了」","art":{"background":"a316","sprites":[{"asset":"a137","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「不必在意。倒是你，可别把自己逼得太紧了。今天机会难得，就好好休息一番吧」","art":{"background":"a316","sprites":[{"asset":"a128","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「与其向本座道歉，不如多留下一些青春的回忆。这才是你应该享受的」","art":{"background":"a316","sprites":[{"asset":"a942","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a926","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「……」","art":{"background":"a316","sprites":[{"asset":"a942","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「而且本座也很开心。在主人出现之前，本座都只能在一旁看着」","art":{"background":"a316","sprites":[{"asset":"a771","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"丛雨","text":"「现在本座也终于有了事情可做，岂会有怨言。总之，放心交给本座便可」","art":{"background":"a316","sprites":[{"asset":"a130","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a445","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「……谢谢您」","art":{"background":"a316","sprites":[{"asset":"a130","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a623","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「那么，在哪里碰头呢？」","art":{"background":"a54","sprites":[{"asset":"a632","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「跟廉太郎碰头之前，我们先去一趟志那都庄吧」","art":{"background":"a54","sprites":[{"asset":"a632","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「这是要……」","art":{"background":"a54","sprites":[{"asset":"a434","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「～～～♪」","art":{"background":"a49","sprites":[{"asset":"a943","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"我们到了志那都庄后，看到蕾娜正在心情愉悦地打扫着大门。","art":{"background":"a49","sprites":[{"asset":"a943","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「哦？将臣？还有芳乃和茉子也来了」","art":{"background":"a49","sprites":[{"asset":"a943","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「怎么了？莫非是要找大当家？」","art":{"background":"a49","sprites":[{"asset":"a944","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「不，今天我们不是来找外公，而是来找你的」","art":{"background":"a49","sprites":[{"asset":"a944","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「我吗？对不起，我现在正在工作，可能没什么时间」","art":{"background":"a49","sprites":[{"asset":"a945","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「咦？外公没跟你说吗？」","art":{"background":"a49","sprites":[{"asset":"a945","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「跟我说什么？」","art":{"background":"a49","sprites":[{"asset":"a946","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「你今天下午可以不用干活」","art":{"background":"a49","sprites":[{"asset":"a946","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「……嗯？这还真没跟我说过」","art":{"background":"a49","sprites":[{"asset":"a947","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「这么说来……掌柜的还没有告诉我把这里打扫完之后要去干什么」","art":{"background":"a49","sprites":[{"asset":"a947","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"心子","text":"「列支敦瑙尔小姐，你已经打扫完了吗？」","art":{"background":"a49","sprites":[{"asset":"a947","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a50","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「掌柜的，您的吩咐奴婢已经办妥了」","art":{"background":"a49","sprites":[{"asset":"a948","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a50","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"心子","text":"「……用词太客气，又变得很奇怪了」","art":{"background":"a49","sprites":[{"asset":"a948","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a554","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「好的……对不起」","art":{"background":"a49","sprites":[{"asset":"a949","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a554","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"心子","text":"「你的日语还是得再多练练啊」","art":{"background":"a49","sprites":[{"asset":"a949","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a52","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「请多多指教」","art":{"background":"a49","sprites":[{"asset":"a948","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a52","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「那个，猪谷阿姨」","art":{"background":"a49","sprites":[{"asset":"a948","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a52","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"心子","text":"「大当家和我说过了」","art":{"background":"a49","sprites":[{"asset":"a50","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"心子","text":"「真是对不起，给您添麻烦了，列支敦瑙尔小姐就拜托您照顾了」","art":{"background":"a49","sprites":[{"asset":"a52","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「好的，没问题」","art":{"background":"a49","sprites":[{"asset":"a52","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"心子","text":"「那么列支敦瑙尔小姐，今天就好好休息吧」","art":{"background":"a49","sprites":[{"asset":"a52","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"说完这话，猪谷阿姨就回旅馆了。","art":{"background":"a49","sprites":[]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「今天放假啊……真是没想到」","art":{"background":"a49","sprites":[{"asset":"a950","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「所以呢，要不要一起出去玩？」","art":{"background":"a49","sprites":[{"asset":"a950","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「既然如此，我有一个请求」","art":{"background":"a49","sprites":[{"asset":"a951","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「什么请求」","art":{"background":"a49","sprites":[{"asset":"a445","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「我想穿芳乃穿的这种衣服！」","art":{"background":"a49","sprites":[{"asset":"a943","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a434","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「毕竟难得来一趟穗织嘛」","art":{"background":"a49","sprites":[{"asset":"a952","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a434","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「好的，那我们去买衣服吧」","art":{"background":"a49","sprites":[{"asset":"a952","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a953","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「我的谢意如滔滔镪水烂漫不绝」","art":{"background":"a49","sprites":[{"asset":"a954","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「那我先去换衣服去，请稍等片刻」","art":{"background":"a49","sprites":[{"asset":"a955","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「这里就是卖衣服的店」","art":{"background":"a19","sprites":[{"asset":"a924","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「哇哦！就是这种，我想要的就是这种」","art":{"background":"a19","sprites":[{"asset":"a653","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a924","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「要入疆随俗」","art":{"background":"a19","sprites":[{"asset":"a665","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"难道你还想跑出日本吗？","art":{"background":"a19","sprites":[{"asset":"a665","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「那我们赶紧进去吧！」","art":{"background":"a19","sprites":[{"asset":"a665","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a956","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「可是，如果卖的衣服太高档，那就糟了……」","art":{"background":"a19","sprites":[{"asset":"a648","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a956","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"芳乃","text":"「这里的衣服种类很多，应该不要紧」","art":{"background":"a19","sprites":[{"asset":"a648","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a953","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"蕾娜和朝武一边说着，一边走进了店里。","art":{"background":"a19","sprites":[]},"chapter":"3-2"},{"speaker":"茉子","text":"「不过，我稍微有点担心，\n不知道有没有适合她那身材的衣服」","art":{"background":"a19","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「确实啊，那身材……」","art":{"background":"a19","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"撞上去都软绵绵的……","art":{"background":"a19","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"她现在穿的衬衫也被顶得高高的，肚脐眼都露出来了。","art":{"background":"a19","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"……那件衬衫原本是能盖住腹部的吧？","art":{"background":"a19","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「和服这种衣服，只要尺寸差不太多就行了吧？」","art":{"background":"a19","sprites":[{"asset":"a957","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「可是现在的和服款式变化很大，袖子、衣肩、身长……基本都和现代的服装没什么区别了」","art":{"background":"a19","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「这倒也是」","art":{"background":"a19","sprites":[{"asset":"a913","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「不过最近游客也经常来买，可选的尺寸应该还是很多的」","art":{"background":"a19","sprites":[{"asset":"a958","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「既然如此，那就应该能买到吧？总之这方面就交给你了」","art":{"background":"a19","sprites":[{"asset":"a958","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「你不一起来帮着挑选衣服吗？」","art":{"background":"a19","sprites":[{"asset":"a959","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「我的审美不行啊」","art":{"background":"a19","sprites":[{"asset":"a959","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「在旁边看女孩子换衣服也是一种乐趣哦，嘻嘻」","art":{"background":"a19","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「确实挺想进去看看的……但是里面都是女性，有点不好意思」","art":{"background":"a19","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"店里女性这么多，进去了也不知道呆在哪儿好。","art":{"background":"a19","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"要是一个人在店里面转来转去，说不定会被当成可疑分子。","art":{"background":"a19","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"将臣","text":"「一时半会儿出不来的话，就告诉我一声」","art":{"background":"a19","sprites":[{"asset":"a251","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"茉子","text":"「好的，那么我也过去了」","art":{"background":"a19","sprites":[{"asset":"a632","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"说罢，常陆也高高兴兴地进了和服店。","art":{"background":"a19","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"我决定在店外边消磨一下时间。","art":{"background":"a19","sprites":[]},"chapter":"3-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a19","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"不过今天太阳有点毒，天气挺热的。","art":{"background":"a19","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"希望她们挑选衣服不会花太多时间。","art":{"background":"a19","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"女性买东西都很慢。听说在国外也是一样。","art":{"background":"a1","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"但她们几个不到一小时就买好了。","art":{"background":"a1","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"鉴于蕾娜原本没有买衣服的计划，挑得算很快了。","art":{"background":"a1","sprites":[]},"chapter":"3-2"},{"speaker":"","text":"说实话，我以为要花更多时间的。","art":{"background":"a1","sprites":[]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「蹡嘞个蹡！换衣完毕！」","art":{"background":"a19","sprites":[{"asset":"a960","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"蕾娜开开心心地跑出了和服店。","art":{"background":"a19","sprites":[{"asset":"a960","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"她现在的打扮完全不同于刚才，非常地适合她。","art":{"background":"a19","sprites":[{"asset":"a960","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"","text":"还配合衣服换了发型……实在是太可爱了。","art":{"background":"a19","sprites":[{"asset":"a960","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"3-2"},{"speaker":"蕾娜","text":"「怎么样呀，将臣。有没有哪里奇怪？」","art":{"background":"a19","sprites":[{"asset":"a961","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"3-2"}]