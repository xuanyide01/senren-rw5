[{"speaker":"芳乃","text":"「嗯嗯，嗯呼……嗯，嗯嗯嗯，嗯呼……」","art":{"background":"a2140","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"不知道是第几次的痉挛结束后，我的射精总算停止了。","art":{"background":"a2140","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"但芳乃的颤抖还没停止。","art":{"background":"a2140","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「呀啊，啊，啊，这是怎么，啊啊，啊，啊，不行，忍不、住……」","art":{"background":"a2142","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「对不起，我，对不起，啊，啊啊啊啊啊啊啊啊啊啊啊啊啊……」","art":{"background":"a2140","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"温暖的液体汹涌地溅在我的两腿之间。","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"这……和刚才的粘液不一样？","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"虽然很暖，但并不粘稠，并且还很顺畅。而且这个量……","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「这是……」","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「啊，啊啊啊啊啊……对不起，对不起……请不要看，讨厌，讨厌」","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"芳乃拼命地道歉。","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"她现在的表情前所未有地羞耻。","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我就像是小孩子一样……啊啊啊……但是停不下来，尿尿停不下来……嗯嗯」","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"果然是失禁了啊。","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"芳乃满脸通红，在我的身上颤抖。","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"她最后身体轻轻地抖了一下，随后全身瘫软了下来。","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我紧紧地抱住将整个体重都靠在我身上的她。","art":{"background":"a2143","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「哈，呼，呼……对不起，真的很对不起。我居然会这样……」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「你舒服到高潮了是吗？我好开心」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「高潮……呼……呼……我不是很清楚」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「大脑里一片空白，耳朵也在嗡嗡作响……呼……呼……就像身体不是自己的了一样」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「甚、甚至还失禁了……呜呜呜……我到底都做了些什么啊」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「用不着在意的」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"真庆幸这里是澡堂。","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「所以，身体还能动吗？」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「哎？啊……对不起。似乎还有点不太行……」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「是吗。那我来帮你洗」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「哎！？洗、洗什么……」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「就是那个，尿尿了就得洗干净才行啊」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「这确实是没错」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「我知道的。我不会再做坏心眼的事的」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「………真的吗？……你要保证哦」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"将臣","text":"「嗯」","art":{"background":"a2144","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我做得确实有点过头了。","art":{"background":"a1851","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"而且我的眼睛都有点花。","art":{"background":"a1851","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"再做下去的话两人都会虚脱过去的。","art":{"background":"a1851","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我温柔地抬起芳乃的身体，按照约定正常地帮她清洗了身体。","art":{"background":"a1851","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"――洗完澡后，我们在芳乃的房间度过着悠闲的时间。","art":{"background":"a1","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"这是一段情意浓浓的时光。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"虽然第一次的时候也很厉害……但这一次更加厉害。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"无论是从快感的角度，还是从幸福的角度来看都很厉害。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"芳乃","text":"「让你看到我丢脸的样子了……唉……」","art":{"background":"a938","sprites":[{"asset":"a439","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「这样的芳乃也很可爱」","art":{"background":"a938","sprites":[{"asset":"a439","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「……能听到你这么说……」","art":{"background":"a938","sprites":[{"asset":"a439","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「不过，我觉得你今天有点太坏心眼了」","art":{"background":"a938","sprites":[{"asset":"a423","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「是、是吗？」","art":{"background":"a938","sprites":[{"asset":"a423","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「是啊。我都觉得自己大脑好像要不正常了」","art":{"background":"a938","sprites":[{"asset":"a429","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「这……真的很抱歉」","art":{"background":"a938","sprites":[{"asset":"a429","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「你真是好色」","art":{"background":"a938","sprites":[{"asset":"a621","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"芳乃气鼓鼓地嘟着嘴唇。","art":{"background":"a938","sprites":[{"asset":"a621","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"但是，她的表情又突然变成了微笑。","art":{"background":"a938","sprites":[{"asset":"a621","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「但是，我好幸福……」","art":{"background":"a938","sprites":[{"asset":"a2100","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………」","art":{"background":"a938","sprites":[{"asset":"a2100","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「啊！那个，我指的不是快感之类的……该怎么说好呢」","art":{"background":"a938","sprites":[{"asset":"a1728","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我特别满足！」","art":{"background":"a938","sprites":[{"asset":"a1014","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「啊啊！？这样反而让误会更深了是吧！？」","art":{"background":"a938","sprites":[{"asset":"a1709","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「不会啊。我没有误会」","art":{"background":"a938","sprites":[{"asset":"a1709","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我也一样。仅仅只是两人在一起，心里就好像被填满了一样」","art":{"background":"a938","sprites":[{"asset":"a1709","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我现在特别幸福」","art":{"background":"a938","sprites":[{"asset":"a1709","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「……嗯」","art":{"background":"a938","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「虽然很满足……但做爱果然也不能割舍啊」","art":{"background":"a938","sprites":[{"asset":"a1473","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「……下流……」","art":{"background":"a938","sprites":[{"asset":"a425","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我也不是说现在就做」","art":{"background":"a938","sprites":[{"asset":"a425","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我只是说，以后也还想继续做那种事」","art":{"background":"a938","sprites":[{"asset":"a425","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「不行吗？」","art":{"background":"a938","sprites":[{"asset":"a425","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「怎么会不行呢。我也……还想和你继续做更多次……」","art":{"background":"a938","sprites":[{"asset":"a1721","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「但、但是，只是做爱也是不行的哦」","art":{"background":"a938","sprites":[{"asset":"a254","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我知道」","art":{"background":"a938","sprites":[{"asset":"a254","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我将芳乃的身体拉过来，温柔地抱住她。","art":{"background":"a938","sprites":[{"asset":"a254","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「呵呵呵……真的好幸福。仅仅只是和你待在一起就能这么幸福……」","art":{"background":"a938","sprites":[{"asset":"a2145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「所以我才能接受那么激烈的做爱哦」","art":{"background":"a938","sprites":[{"asset":"a1728","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「………」","art":{"background":"a938","sprites":[{"asset":"a1728","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「虽然和喜欢的人结合很舒服，但更多的还是满足……我现在特别，特别特别满足」","art":{"background":"a938","sprites":[{"asset":"a1721","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「我还是第一次……有这样的感悟」","art":{"background":"a938","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我也是第一次这么舒服」","art":{"background":"a938","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「但是……还不足够。我现在有多么幸福，有多么喜欢你……我想传达给你的事情还有好多好多呢」","art":{"background":"a938","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「我也一样啊」","art":{"background":"a938","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"将臣","text":"「今后我们也永远……在一起吧」","art":{"background":"a938","sprites":[{"asset":"a953","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"芳乃","text":"「嗯……」","art":{"background":"a938","sprites":[{"asset":"a1014","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-2"},{"speaker":"","text":"我们静静地相互拥抱。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"虽然做爱很舒服……但只是像这样怀抱彼此，我就感觉很幸福了。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"确实，这样的心境还是第一次。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"心意相通是这么令人高兴的一件事情。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"只是跟身心相连的人待在一起，内心就可以这么满足。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"只要我们在一起，今后肯定还会有更多的新发现。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我现在就已经迫不及待了。","art":{"background":"a938","sprites":[]},"chapter":"7-2"},{"speaker":"","text":"我怀着这样的心意，牢牢地抱住了芳乃的身体。","art":{"background":"a938","sprites":[]},"chapter":"7-2"}]