[{"speaker":"将臣","text":"「还是用本地特色菜来吸引人吧」","art":{"background":"a56","sprites":[{"asset":"a263","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「可是啊主人，这已经有人在做了啊」","art":{"background":"a56","sprites":[{"asset":"a1374","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「说的也是」","art":{"background":"a56","sprites":[{"asset":"a1374","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"现在是第二天的早上。","art":{"background":"a56","sprites":[{"asset":"a1374","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我在一边打扫院内，一边和小雨商讨如何振兴小镇。","art":{"background":"a56","sprites":[{"asset":"a1374","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「必须得找个能代替丛雨丸的卖点才行」","art":{"background":"a56","sprites":[{"asset":"a1357","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座觉得比起食物，还是开展些什么活动更好」","art":{"background":"a56","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「活动啊……」","art":{"background":"a56","sprites":[{"asset":"a1309","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"搞些盛大的活动比较好吧。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"那就弄些唱歌跳舞的活动？","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我一下子想到的也只有……","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「本地偶像？」","art":{"background":"a56","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「啊？」","art":{"background":"a56","sprites":[{"asset":"a283","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"小雨傻了眼。","art":{"background":"a56","sprites":[{"asset":"a283","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「你想想啊，可以让可爱的女孩子唱歌跳舞来宣传这个镇子啊」","art":{"background":"a56","sprites":[{"asset":"a283","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「比如“穗织４８”」","art":{"background":"a56","sprites":[{"asset":"a283","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「那谁来做偶像啊」","art":{"background":"a56","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「只要可爱的话谁都行吧」","art":{"background":"a56","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「喂喂喂，主人……」","art":{"background":"a56","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「对哦，想来穗织里可爱的女孩子和大美人都挺多的不是吗」","art":{"background":"a56","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「这行得通吧？」","art":{"background":"a56","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"如果朝武和常陆上场的话一定能招揽到很多人气。","art":{"background":"a56","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「主人，你现在在想芳乃和茉子吧」","art":{"background":"a56","sprites":[{"asset":"a144","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「你说得动她们吗？连本座都做不到」","art":{"background":"a56","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a56","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我想象了一下。","art":{"background":"a56","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"芳乃","text":"「让、让我们成为偶像……？！」","art":{"background":"a211","sprites":[{"asset":"a1131","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a289","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"茉子","text":"「有地，你是认真的吗？！」","art":{"background":"a211","sprites":[{"asset":"a1131","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2601","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"芳乃","text":"「有地来，该吃药了，这有水」","art":{"background":"a211","sprites":[{"asset":"a915","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a2601","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"茉子","text":"「不，芳乃大人，我们把他带去给驹川大夫诊断一下吧」","art":{"background":"a211","sprites":[{"asset":"a915","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1034","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"在我的想象中她们就已经把我当作疯子了。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「唔啊……！」","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我擅自胡思乱想，又独自消沉。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「我也不行啊……！」","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座就说嘛」","art":{"background":"a56","sprites":[{"asset":"a204","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「主人的思想都被世俗所毒害了」","art":{"background":"a56","sprites":[{"asset":"a144","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「那、那我们设计个吉祥物怎么样？」","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「啊，做套小雨的毛绒公仔服如何？」","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「搞个丛雨小怪之类的」","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座都说你的思想太世俗了！」","art":{"background":"a56","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我被她骂了一通。","art":{"background":"a56","sprites":[{"asset":"a134","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「穗织有着独特的文化」","art":{"background":"a56","sprites":[{"asset":"a141","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「我们必须要以此为基础设计出相应的卖点」","art":{"background":"a56","sprites":[{"asset":"a138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「做这种目光短浅的活动是不可能长期招来客人的」","art":{"background":"a56","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「你说得很对……」","art":{"background":"a56","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"看来我的心灵都被世俗污染了。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我不禁感到失落。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我为自己肤浅的想法而感到悲哀。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"于是，我弯下腰继续打扫院内。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「哎呀，主人不要那么失落嘛」","art":{"background":"a56","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"小雨轻轻地飘起来，慢慢地摸我的头。","art":{"background":"a56","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"感觉就像是昨天一样温柔。","art":{"background":"a56","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「主人不是很了解穗织」","art":{"background":"a56","sprites":[{"asset":"a139","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「但是本座知道穗织的每一个细节」","art":{"background":"a56","sprites":[{"asset":"a133","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「我们两个人做搭档，一定能想出绝妙的点子来」","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「此话怎讲？」","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「意思就是说，对于本座这种本地人来说再自然不过的东西……」","art":{"background":"a56","sprites":[{"asset":"a942","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「对主人这样的外来人来说，可能就是十分新奇的东西」","art":{"background":"a56","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座和主人一起，不就能发现这种被当地人忽略的美吗？」","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「哦，说的对啊！」","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我们想要招揽来的就是像我这样的外来人。","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"能吸引我眼球的东西，对其他的游客来说也肯定很有价值。","art":{"background":"a56","sprites":[{"asset":"a130","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「主人，有点干劲了吗？」","art":{"background":"a56","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「有干劲了，小雨你真是我的天使」","art":{"background":"a56","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「主人，你这套说辞也是有够俗的……」","art":{"background":"a56","sprites":[{"asset":"a138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「啊哈哈！现在不正是需要充满世俗气的我来多观察吗？」","art":{"background":"a56","sprites":[{"asset":"a138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「嗯，就是这么回事吧」","art":{"background":"a56","sprites":[{"asset":"a474","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「今天是星期天，吃完早餐以后你能陪我出去走走吗？」","art":{"background":"a56","sprites":[{"asset":"a474","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「嗯，没问题」","art":{"background":"a56","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"这下就决定了接下来要做的事。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"既然如此，那我便快些打扫完院内吧。","art":{"background":"a56","sprites":[]},"chapter":"5-2"},{"speaker":"所有人","text":"『我开动了！』","art":{"background":"a211","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"朝武家假日的早饭时间开始了。","art":{"background":"a211","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「我吃饱了！」","art":{"background":"a211","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"然后只有我一个人飞速解决了早饭。","art":{"background":"a211","sprites":[]},"chapter":"5-2"},{"speaker":"茉子","text":"「这就吃完了？！」","art":{"background":"a211","sprites":[{"asset":"a959","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"芳乃","text":"「有地，不细嚼慢咽的话不好消化……」","art":{"background":"a211","sprites":[{"asset":"a420","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「抱歉啊，今天有些急事」","art":{"background":"a211","sprites":[{"asset":"a420","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「小雨我们走！」","art":{"background":"a211","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「好的，主人」","art":{"background":"a211","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「我出发了！今天我可能晚点才回来，不用准备我的午饭了！」","art":{"background":"a211","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我匆匆和他们说完话，急忙冲出家门。","art":{"background":"a211","sprites":[]},"chapter":"5-2"},{"speaker":"安晴","text":"「今天是周日啊，将臣他怎么那么急匆匆的」","art":{"background":"a211","sprites":[{"asset":"a244","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"安晴","text":"「难不成是约了女孩子？」","art":{"background":"a211","sprites":[{"asset":"a306","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"芳乃","text":"「爸爸，你怎么又往这个方向想了，这样不好哦」","art":{"background":"a211","sprites":[{"asset":"a622","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"茉子","text":"「丛雨大人和他一起出去了，应该不是那样的」","art":{"background":"a211","sprites":[{"asset":"a434","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1168","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"芳乃","text":"「有地到底有什么事？」","art":{"background":"a211","sprites":[{"asset":"a921","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1168","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"茉子","text":"「我感觉像是在计划些什么……」","art":{"background":"a211","sprites":[{"asset":"a553","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我走在以往和朝武他们一起上学的路上。","art":{"background":"a493","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"而现在是小雨在我身边。","art":{"background":"a493","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"也可能因为是假日的早晨，一切都让人觉得倍感新鲜。","art":{"background":"a493","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「怎么了？主人？好像很兴奋的样子」","art":{"background":"a493","sprites":[{"asset":"a363","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「嗯，感觉心情很好」","art":{"background":"a493","sprites":[{"asset":"a363","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我甚至想一蹦三尺高。","art":{"background":"a493","sprites":[{"asset":"a363","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「穗织的空气真的很清新，所以我一大清早就觉得心情舒畅」","art":{"background":"a493","sprites":[{"asset":"a363","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座倒是不太清楚，有这么一回事吗？」","art":{"background":"a493","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「到了晚上，星星的数量也和城市里完全不一样」","art":{"background":"a493","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"这就是空气好的证明。","art":{"background":"a493","sprites":[{"asset":"a207","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「星星的数量多到都不想数了」","art":{"background":"a493","sprites":[{"asset":"a138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「我以前住的地方最多只能看到五、六颗星星」","art":{"background":"a493","sprites":[{"asset":"a138","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「真的吗？那样的夜空还真是寂寥啊」","art":{"background":"a493","sprites":[{"asset":"a261","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「那天空岂不是很黑吗」","art":{"background":"a493","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「然而街上倒是灯火阑珊」","art":{"background":"a493","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"便利店和快餐店的招牌闪着五彩的光。","art":{"background":"a1","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"每个季节都会变化的华丽彩灯。","art":{"background":"a1","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"回想起来，我才发觉我身边的环境变化非常大。","art":{"background":"a1","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「对了，开发些观星旅游路线怎么样」","art":{"background":"a493","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「我觉得穗织的星空值得一看」","art":{"background":"a493","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「唔，这不失为一种方案……」","art":{"background":"a493","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「可是这样的活动在别的地方也能举办呀」","art":{"background":"a493","sprites":[{"asset":"a261","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「穗织的星空确实美丽，但却说不上是特色」","art":{"background":"a493","sprites":[{"asset":"a213","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「没点“容易看到流星”之类的卖点怎么能行」","art":{"background":"a493","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「是吗，说的也对……」","art":{"background":"a493","sprites":[{"asset":"a373","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"果然不容易找到招揽游客的方法啊。","art":{"background":"a493","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「唔…………」","art":{"background":"a493","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我们一边开动脑筋一边走。","art":{"background":"a493","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「哇？！」","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我光顾着想问题了，都没注意脚下。","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我的运动鞋的鞋头被车辙绊了一下。","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「主人，危险！」","art":{"background":"a54","sprites":[{"asset":"a142","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"就在我快要摔倒的时候，小雨及时扶了我右手一把。","art":{"background":"a54","sprites":[{"asset":"a142","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「做得好啊，小雨！」","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我一边被她扶着，一边用左手对她竖了个大拇指。","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「好你个头啊」","art":{"background":"a54","sprites":[{"asset":"a196","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「你走路太不专心了，多注意一点啊」","art":{"background":"a54","sprites":[{"asset":"a141","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「要是你受伤了，哪还谈得上振兴小镇呢」","art":{"background":"a54","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"小雨的嘴角都不满地撇了下去。","art":{"background":"a54","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"随后她又更用力地握住了我的手。","art":{"background":"a54","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"她这一举动是想要我振作起来来吗。","art":{"background":"a54","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「抱歉抱歉」","art":{"background":"a54","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「我不会再冒失了，谢谢你」","art":{"background":"a54","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我也用力地回握她的手。","art":{"background":"a54","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我以此表达我的感谢和亲近之情。","art":{"background":"a54","sprites":[{"asset":"a282","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「……」","art":{"background":"a54","sprites":[{"asset":"a1192","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「你、你知道就好」","art":{"background":"a54","sprites":[{"asset":"a210","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"小雨的脸都被染得通红。","art":{"background":"a54","sprites":[{"asset":"a210","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"而我们也完全没有松开对方手的意思。","art":{"background":"a54","sprites":[{"asset":"a210","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「……」","art":{"background":"a54","sprites":[{"asset":"a3004","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a54","sprites":[{"asset":"a3004","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"……我的心跳开始加速。","art":{"background":"a54","sprites":[{"asset":"a3004","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"不知为何感觉脸好烫。","art":{"background":"a54","sprites":[{"asset":"a3004","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"就算如此，我总不能甩开小雨主动握过来的手。","art":{"background":"a54","sprites":[{"asset":"a3004","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"不，我也不想松手。","art":{"background":"a54","sprites":[{"asset":"a3004","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"？？？","text":"「哇，是将臣和小雨呀」","art":{"background":"a54","sprites":[{"asset":"a3004","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨・将臣","text":"『！？』","art":{"background":"a54","sprites":[{"asset":"a265","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"突然传来的招呼声吓得我们两人一个激灵。","art":{"background":"a54","sprites":[{"asset":"a265","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「早上好呀！」","art":{"background":"a54","sprites":[{"asset":"a960","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"这声音出自开朗的蕾娜之口。","art":{"background":"a54","sprites":[{"asset":"a960","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「啊、嗯、早上好啊」","art":{"background":"a54","sprites":[{"asset":"a960","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「早、早安，蕾娜」","art":{"background":"a54","sprites":[{"asset":"a960","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a277","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我们的声音都莫名发抖。","art":{"background":"a54","sprites":[{"asset":"a960","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a277","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"甚至都有些破音了。","art":{"background":"a54","sprites":[{"asset":"a960","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a277","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「你们一大早在做什么呀？」","art":{"background":"a54","sprites":[{"asset":"a3005","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a277","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「啊，你们牵着手呢！关系还是那么好」","art":{"background":"a54","sprites":[{"asset":"a1015","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a3006","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「哎？不，这个……」","art":{"background":"a54","sprites":[{"asset":"a1015","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a3006","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「蕾娜，你误会了！这是因为刚才主人要跌倒了」","art":{"background":"a54","sprites":[{"asset":"a1015","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1189","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「没事没事，你们不用在意」","art":{"background":"a54","sprites":[{"asset":"a963","position":"出","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a1189","position":"左中","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「我其实很会察言观色的。毕竟要招待客人嘛」","art":{"background":"a54","sprites":[{"asset":"a960","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「你们放心，我一定会跟大家保密的」","art":{"background":"a54","sprites":[{"asset":"a960","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「喂，你根本没懂啊！」","art":{"background":"a54","sprites":[{"asset":"a960","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「蕾娜你别误会！」","art":{"background":"a54","sprites":[{"asset":"a140","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我们两个人都在拼命辩解。","art":{"background":"a54","sprites":[{"asset":"a140","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「哪里哪里，我都懂的」","art":{"background":"a54","sprites":[{"asset":"a960","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「这就是所谓的欲迎还拒对吧？」","art":{"background":"a54","sprites":[{"asset":"a978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「现在用这句话形容不太对吧！」","art":{"background":"a54","sprites":[{"asset":"a978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"这家伙真是完全没搞懂啊。","art":{"background":"a54","sprites":[{"asset":"a978","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「那么很会察言观色的我，就赶紧走人不继续做电灯泡了」","art":{"background":"a54","sprites":[{"asset":"a1041","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"蕾娜","text":"「再会了！」","art":{"background":"a54","sprites":[{"asset":"a960","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"不知道为什么，蕾娜微笑着将右手支在额头上。","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"她敬了一礼，随后便跑着离去了。","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「……这下怎么办啊，主人」","art":{"background":"a54","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「蕾娜肯定误以为本座与主人是“卿侣”了」","art":{"background":"a54","sprites":[{"asset":"a186","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「小雨，那读作“情侣”」","art":{"background":"a54","sprites":[{"asset":"a186","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「读音不是重点！」","art":{"background":"a54","sprites":[{"asset":"a609","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「明天我们要在学校和她解释清楚，主人」","art":{"background":"a54","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「嗯，我懂」","art":{"background":"a54","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"虽然可能会很费事就是了。","art":{"background":"a54","sprites":[{"asset":"a145","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「那我们走吧」","art":{"background":"a54","sprites":[{"asset":"a224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「嗯」","art":{"background":"a54","sprites":[{"asset":"a224","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我和小雨又再次前进。","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"而我们的紧握手仍未松开。","art":{"background":"a54","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我心想……穗织的卖点应该就在丰富的自然资源上吧。于是我们进到了山中。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"池水清澈见底，反射着粼粼波光。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「我这个城市人光是看到这番景象，就感觉心灵被净化了……」","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"一阵凉意萦绕在心头。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"真是治愈人心。这就是负离子的美妙啊。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「主人！」","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"嗯？","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我看向小雨的声音传来的方向。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"只见小雨站在清流之中。","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"眼前，一位和风美少女与身边的大自然融为一体。","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"这番景象真是美如画啊。","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「有鲑鱼啊！还有小螃蟹！」","art":{"background":"a3008","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「是吗，不错啊」","art":{"background":"a3008","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"真不愧是名副其实的乡村风情。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"城里的水沟河里肯定没有这种东西。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"春季的河流摸起来是什么感觉呢？","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我站在溪边，弯下腰摸了摸水流。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「哇……」","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"溪流比我想象中的还要冰凉。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"虽然不至于把手冻伤，但足以让体温迅速下降。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我立刻把手抽了出来。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「小雨，你不冷吗？」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「你在说什么呢，主人」","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座碰不到除了主人以外的任何物体」","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座感受不到冷暖」","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「更不用说水的触感」","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「啊，抱歉……」","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我下意识地用正常人的感受跟她交谈了。","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"对啊，小雨是直到最近才能触碰到物体的。","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"在此之前她虽然可以跟朝武和常陆对话，但她甚至没法碰到她们的手。","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「……」","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我不禁埋怨起说话不经大脑的自己。","art":{"background":"a3009","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「喂，主人」","art":{"background":"a3010","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「别这样低头，快抬起头来」","art":{"background":"a3010","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「把胸挺起来！」","art":{"background":"a3010","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"但是当事人小雨似乎丝毫没有在意这点。","art":{"background":"a3010","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「嗯、嗯」","art":{"background":"a3010","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"听小雨这么说，我抬起头又看向了她。","art":{"background":"a3010","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"小雨笑嘻嘻的，神情如常。","art":{"background":"a3010","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「主人啊，你真的是个会把喜怒哀乐都写在脸上的人」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"小雨露出一丝苦笑。","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「是、是吗？」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我自己也不太清楚。","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「是啊，但这也说明主人有多诚实」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「这可是一种美德。主人，你可要好好珍惜啊」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「谢谢夸奖」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"现在反倒是她在给我加油打气。","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"她果然是个体贴的女孩。","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「而且本座根本不在意。所以主人也没什么好介怀的」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「如今本座每天都过得比以前快乐得多，这反而是多亏了主人的到来」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「所以啊，本座希望主人能自豪地活下去」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「唔……可这只是因为我体质特殊罢了」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「难就难在我觉得自己没什么可自豪的」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「我又不像外公那样是个剑术大师」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「也不像朝武和常陆那样有明确的人生目标」","art":{"background":"a3007","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"虽然我确实付出了相应的努力，但走到这一步有很大程度只是顺势而为罢了。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我还没法做到挺起胸膛啊。","art":{"background":"a1044","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「玄十郎他也不是一生下来就这样的哦」","art":{"background":"a1044","sprites":[{"asset":"a224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"离开溪流的小雨站在了我的身边。","art":{"background":"a1044","sprites":[{"asset":"a224","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「他在主人这个年纪的时候也烦恼过各种各样的事情」","art":{"background":"a1044","sprites":[{"asset":"a771","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「其实他的心思也算是很纤细的。本座看着都觉得闹心」","art":{"background":"a1044","sprites":[{"asset":"a362","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「毕竟本座没法与他搭话，也只能看看他」","art":{"background":"a1044","sprites":[{"asset":"a771","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「外公也会这样？」","art":{"background":"a1044","sprites":[{"asset":"a771","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"难以置信。","art":{"background":"a1044","sprites":[{"asset":"a771","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"可既然一直待在穗织的小雨都这么说了，那肯定不会有错。","art":{"background":"a1044","sprites":[{"asset":"a771","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「芳乃和茉子倒是很特别」","art":{"background":"a1044","sprites":[{"asset":"a141","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「毕竟出身不同。一般人到了主人现在的年纪，都会看不清前路的」","art":{"background":"a1044","sprites":[{"asset":"a474","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「所以主人不必担心，你一定没问题的」","art":{"background":"a1044","sprites":[{"asset":"a136","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「你可是让穗织恢复了和平啊」","art":{"background":"a1044","sprites":[{"asset":"a182","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座可以保证，主人会是一个前程似锦的年轻人」","art":{"background":"a1044","sprites":[{"asset":"a129","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"她又握紧了我的手。","art":{"background":"a1044","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"手上感受到了清晰的触感。","art":{"background":"a1044","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「小雨，你的手真的有点冷啊」","art":{"background":"a1044","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我知道这是为什么。","art":{"background":"a1044","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"所以我也握紧了她的手，以给她一些温暖。","art":{"background":"a1044","sprites":[{"asset":"a137","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「是、是吗？」","art":{"background":"a1044","sprites":[{"asset":"a208","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「应该是主人的手太暖和了……！」","art":{"background":"a1044","sprites":[{"asset":"a3011","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"小雨满脸通红地笑了。","art":{"background":"a1044","sprites":[{"asset":"a3011","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"兴许是因为春季的阳光吧……","art":{"background":"a1044","sprites":[{"asset":"a3011","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我觉得她的这副笑容光彩夺目。","art":{"background":"a1044","sprites":[{"asset":"a3011","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「太阳都落得这么低了」","art":{"background":"a3012","sprites":[{"asset":"a266","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「我们得回去了，主人」","art":{"background":"a3012","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「啊，嗯……」","art":{"background":"a3012","sprites":[{"asset":"a132","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"山中一下子就暗了下来。","art":{"background":"a580","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"虽然现在已经不会有祟神出没了，但是黑乎乎的夜路确实很危险。","art":{"background":"a580","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"可是……","art":{"background":"a580","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「弄到最后还是没什么结果啊……」","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我和小雨在山中四处踩点。","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"企图找出一些可能成为观光名胜的景点。","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"可是我们只找到了一些野菜和蘑菇。","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"这些都是已经可以在穗织镇上买到的东西。","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「我们这才找了一天呢，主人」","art":{"background":"a3012","sprites":[{"asset":"a223","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「事情怎么可能进展得那么顺利呢」","art":{"background":"a3012","sprites":[{"asset":"a136","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「唉，话是这么说没错」","art":{"background":"a3012","sprites":[{"asset":"a136","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"不过我还是觉得很可惜。","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"我无意间停下了脚步，环顾四周。","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「本座都让你快些回去了」","art":{"background":"a3012","sprites":[{"asset":"a1353","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「走吧主人，得加快脚步了」","art":{"background":"a3012","sprites":[{"asset":"a130","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"有双手抵在我的后背。","art":{"background":"a3012","sprites":[{"asset":"a130","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"小雨在推着我。","art":{"background":"a3012","sprites":[{"asset":"a130","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「知道了，知道了」","art":{"background":"a3012","sprites":[{"asset":"a130","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我无可奈何地迈出步子。","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"","text":"今天真要一无所获地打道回府了吗。","art":{"background":"a3012","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「莫要着急」","art":{"background":"a3012","sprites":[{"asset":"a551","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「罗马不是一天建成的」","art":{"background":"a3012","sprites":[{"asset":"a182","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「现在我们不是要建罗马，而是穗织」","art":{"background":"a3012","sprites":[{"asset":"a182","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「换成穗织也是一回事」","art":{"background":"a3012","sprites":[{"asset":"a128","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「从今往后也要脚踏实地好好努力」","art":{"background":"a3012","sprites":[{"asset":"a129","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"丛雨","text":"「打起精神来！要笑着面对困难！」","art":{"background":"a3012","sprites":[{"asset":"a624","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"将臣","text":"「好、好的！」","art":{"background":"a3012","sprites":[{"asset":"a624","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我一边被她推揉着背后一边抬起头，试图强打精神。","art":{"background":"a580","sprites":[]},"chapter":"5-2"},{"speaker":"将臣","text":"「明天也要加油！加油！」","art":{"background":"a580","sprites":[]},"chapter":"5-2"},{"speaker":"丛雨","text":"「加油！」","art":{"background":"a580","sprites":[{"asset":"a1623","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我鼓起干劲喊了一声，身后的小雨跟着应和。","art":{"background":"a580","sprites":[{"asset":"a1623","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"心中冒出一阵暖意。","art":{"background":"a580","sprites":[{"asset":"a1623","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"},{"speaker":"","text":"我觉得我有精神了一些。","art":{"background":"a580","sprites":[{"asset":"a1623","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"5-2"}]