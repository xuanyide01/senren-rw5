[{"speaker":"丛雨","text":"「嗯！嗯……」","art":{"background":"a3445","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我在她的嘴里射出了精液。","art":{"background":"a3445","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「嗯，嗯，嗯，嗯……」","art":{"background":"a3446","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「啾，嗯，咕咚，嗯，啾，嗯……」","art":{"background":"a3445","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"小雨咽了好几口。","art":{"background":"a3445","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"她喝着我的精液，舔了舔我的龟头。","art":{"background":"a3445","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「啾，啾，啾，嗯……」","art":{"background":"a3447","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「小、小雨，我刚刚才射完，这样我很痒……」","art":{"background":"a3447","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"在射完精之后，她也没有松开我的阳具。","art":{"background":"a3447","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我忍耐着瘙痒和快感，不禁叫出了声音。","art":{"background":"a3447","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「嗯，啊，嗯，啊，又热又浓的东西流出来了……」","art":{"background":"a3448","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「还是这么精神……」","art":{"background":"a3448","sprites":[]},"chapter":"后日谈"},{"speaker":"丛雨","text":"「明明每天晚上都被本座服侍……」","art":{"background":"a3449","sprites":[]},"chapter":"后日谈"}]