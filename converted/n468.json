[{"speaker":"玄十郎","text":"「喔，这确实味道不错」","art":{"background":"a1","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"外公吃过芦花姐拿出的样品后，点头说道。","art":{"background":"a2888","sprites":[]},"chapter":"7-1"},{"speaker":"玄十郎","text":"「你觉得怎么样，猪谷小姐」","art":{"background":"a2888","sprites":[{"asset":"a90","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"心子","text":"「我觉得能做出这种味道，肯定没有任何问题」","art":{"background":"a2888","sprites":[{"asset":"a50","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a90","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"玄十郎","text":"「列支敦瑙尔小姐，你认为呢？」","art":{"background":"a2888","sprites":[{"asset":"a50","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a603","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"蕾娜","text":"「嗯……仙贝非常好吃！」","art":{"background":"a2888","sprites":[{"asset":"a943","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"蕾娜","text":"「这个仙贝散发着浓郁的香味，非常不错！」","art":{"background":"a2888","sprites":[{"asset":"a943","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"玄十郎","text":"「好，那就这么定了」","art":{"background":"a2888","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"玄十郎","text":"「既然能有这种品质，那我们就买你们的仙贝当茶点吧。如果有必要的话，也可以放店里卖」","art":{"background":"a2888","sprites":[{"asset":"a602","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「真的吗！谢谢玄十郎先生！」","art":{"background":"a2888","sprites":[{"asset":"a18","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「谢谢爷爷！」","art":{"background":"a2888","sprites":[{"asset":"a63","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"玄十郎","text":"「别介意。这也不是因为人情，是靠味道决定的」","art":{"background":"a2888","sprites":[{"asset":"a50","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a603","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"心子","text":"「想必其他的旅馆也会喜欢的」","art":{"background":"a2888","sprites":[{"asset":"a52","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a603","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「谢谢夸奖！」","art":{"background":"a2888","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「另外这个仙贝是哥哥烤的哦，很厉害吧」","art":{"background":"a2888","sprites":[{"asset":"a95","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"蕾娜","text":"「什么！将臣竟然能烤出这么好吃的仙贝！？」","art":{"background":"a2888","sprites":[{"asset":"a1147","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「烤仙贝我可是练了很久的，连马庭叔叔都认可了我的手艺」","art":{"background":"a2888","sprites":[{"asset":"a1147","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"玄十郎","text":"「是吗……是将臣烤的啊」","art":{"background":"a2888","sprites":[{"asset":"a602","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"玄十郎","text":"「你已经彻底变成甜品屋的店员了啊。总之，能找到让自己热衷的事物是件好事」","art":{"background":"a2888","sprites":[{"asset":"a602","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"玄十郎","text":"「今后也要专心修行」","art":{"background":"a2888","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「我知道」","art":{"background":"a2888","sprites":[{"asset":"a603","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「～～～♪」","art":{"background":"a48","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「哈哈，姐姐你真高兴啊」","art":{"background":"a48","sprites":[{"asset":"a66","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a6","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「那可不，今天去的那些店家全都获得了好评」","art":{"background":"a48","sprites":[{"asset":"a66","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a18","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"","text":"去过志那都庄后，我们又去了很多家旅馆推销，大家全都认可了这个仙贝的味道。","art":{"background":"a1","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"当然了，每家情况不一样。","art":{"background":"a1","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"虽然没能让所有旅馆都选择从我们这里进货，但大家对我们的态度都很好。","art":{"background":"a1","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"看这样子，今后是不愁销量了。","art":{"background":"a1","sprites":[]},"chapter":"7-1"},{"speaker":"将臣","text":"「我也要加油啊」","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"今后也没空在早上锻炼了。","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"早上必须帮忙烤仙贝。","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"把这件事告诉外公时，外公一开始显得有些寂寞。","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"","text":"但是看到我找到了新的目标，他马上就开始为我鼓劲。","art":{"background":"a48","sprites":[]},"chapter":"7-1"},{"speaker":"芦花","text":"「今后也请多多指教」","art":{"background":"a48","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「我才要请你多多指教」","art":{"background":"a48","sprites":[{"asset":"a6","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「但是也不能把活全都交给你干，我也得学会烤仙贝才行」","art":{"background":"a48","sprites":[{"asset":"a4236","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「那我也要学！我想帮上店里的忙」","art":{"background":"a48","sprites":[{"asset":"a2985","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a5","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「谢谢小春。不过烤仙贝还挺难的。我之前试着烤了一片，结果糟透了」","art":{"background":"a48","sprites":[{"asset":"a2985","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a45","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「这么难吗？」","art":{"background":"a48","sprites":[{"asset":"a70","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a45","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「阿将，你有什么窍门吗？」","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「窍门？窍门啊……」","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「可能是一想到某人会开开心心地品尝我烤的仙贝，就很有动力吧？虽然这个道理也适用于做其他事」","art":{"background":"a48","sprites":[{"asset":"a29","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"7-1"},{"speaker":"芦花","text":"「这意思是……你的心里会一直想着某个人吗？」","art":{"background":"a48","sprites":[{"asset":"a61","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a29","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"小春","text":"「是、是这样吗，哥哥」","art":{"background":"a48","sprites":[{"asset":"a3257","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a29","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"},{"speaker":"将臣","text":"「这个……」","art":{"background":"a48","sprites":[{"asset":"a3257","position":"右","x":240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255},{"asset":"a29","position":"左","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"7-1"}]