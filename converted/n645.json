[{"speaker":"将臣","text":"「射得好猛烈……又全都射出来了」","art":{"background":"a2935","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「我也……啊、啊……又去了一次……好激烈……好爽……啊、啊……嗯嗯」","art":{"background":"a2937","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「嗯、我……已经动不了了」","art":{"background":"a2937","sprites":[]},"chapter":"后日谈"},{"speaker":"将臣","text":"「我也一样。所以就用这个姿势休息一会儿吧」","art":{"background":"a2937","sprites":[]},"chapter":"后日谈"},{"speaker":"茉子","text":"「好，我赞成……嗯嗯」","art":{"background":"a2937","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"铃声在某处响起。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"即便如此我们也没有动。我们两人就像折叠在一起，久久没有离去。","art":{"background":"a1","sprites":[]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「啊，打铃了」","art":{"background":"a599","sprites":[{"asset":"a745","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"芳乃","text":"「唉……他们俩也真是的」","art":{"background":"a599","sprites":[{"asset":"a700","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a1490","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"后日谈"},{"speaker":"蕾娜","text":"「好啦好啦。两个人幸福就好」","art":{"background":"a599","sprites":[{"asset":"a695","position":"出","x":180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255},{"asset":"a1490","position":"出","x":-180,"y":0,"zx":100,"zy":100,"z":-42.857142857142854,"opacity":255}]},"chapter":"后日谈"},{"speaker":"廉太郎","text":"「话是这么说，可是连课都不上的话……我看他们都幸福傻了吧？」","art":{"background":"a599","sprites":[{"asset":"a520","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"后日谈"},{"speaker":"比奈实","text":"「又又又又又是他们俩吗——————！！」","art":{"background":"a1","sprites":[{"asset":"a2938","position":"85%","x":0,"y":0,"zx":100,"zy":100,"z":-39.39393939393939,"opacity":255}]},"chapter":"后日谈"}]