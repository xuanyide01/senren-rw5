[{"speaker":"将臣","text":"「唔！」","art":{"background":"a3357","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「啊，啊啊！」","art":{"background":"a3360","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"我在要射精时将阴茎从她的体内抽出，纯白的精液洒落在她的全身各处，点缀了她洁白的肌肤。","art":{"background":"a3360","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「哈啊，哈啊，哈啊……」","art":{"background":"a3361","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「嗯，啊……哈，主人……」","art":{"background":"a3363","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「到处都是主人的味道……」","art":{"background":"a3363","sprites":[]},"chapter":"8-5"},{"speaker":"丛雨","text":"「是本座最爱最爱的主人的味道……」","art":{"background":"a3363","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"小雨看着我，恍恍惚惚地说道。","art":{"background":"a3364","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"我也感觉到了。","art":{"background":"a3364","sprites":[]},"chapter":"8-5"},{"speaker":"","text":"这是一股我的精液和她的爱液混杂而来的味道。","art":{"background":"a3364","sprites":[]},"chapter":"8-5"}]