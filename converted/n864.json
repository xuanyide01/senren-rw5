[{"speaker":"将臣","text":"「芦花姐，我要射在里面了」","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯唔！嗯啊！嗯嗯啊啊！嗯、嗯嗯、嗯、嗯、嗯嗯嗯嗯！！」","art":{"background":"a4543","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"芦花姐的头上下晃着，这是同意了吗？还是说又开始痉挛了？","art":{"background":"a4543","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我无法作出判断，也来不及思考这些了。","art":{"background":"a4543","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯——！嗯——！嗯嗯！嗯、嗯、嗯、嗯、嗯、嗯——」","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯嗯嗯嗯嗯嗯嗯！！」","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"芦花姐迎来了第二次激烈的痉挛。","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"同时我也在芦花姐的小穴里开闸解放。","art":{"background":"a4542","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯嗯咕咕咕呜呜呜呜……！！嗯咕、咕呜呜……嗯呀、呀……嗯、唔呜呜——嗯唔！！」","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"——噗咻！噗咻咻！","art":{"background":"a4546","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"可能是因为一直憋到了现在的关系，精液以惊人的势头从肉棒里喷了出来，根本不带停。","art":{"background":"a4546","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯！嗯！嗯嗯嗯……嗯呀、唔——唔呜呜———嗯嗯、嗯嗯！嗯嗯——————」","art":{"background":"a4546","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"肉棒不断喷吐着精液。","art":{"background":"a4546","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"我的心脏剧烈跳动，身体失去了平衡感，晃晃悠悠差点倒下。","art":{"background":"a4546","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"漫长的射精终于结束了，我慢慢地将肉棒从芦花姐的小穴里拔了出来。","art":{"background":"a4546","sprites":[]},"chapter":"后日谈"},{"speaker":"芦花","text":"「嗯唔、嗯嗯嗯……嗯——呜呜呜呜……嗯嗯」","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"},{"speaker":"","text":"刚射进去的精液如同逆流一般，从芦花姐的双腿间汩汩地流了出来。","art":{"background":"a4545","sprites":[]},"chapter":"后日谈"}]