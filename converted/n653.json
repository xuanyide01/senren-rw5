[{"speaker":"将臣","text":"「呃！」","art":{"background":"a3076","sprites":[]},"chapter":"5-4"},{"speaker":"","text":"我在射精之前将那家伙抽了出来。","art":{"background":"a3076","sprites":[]},"chapter":"5-4"},{"speaker":"","text":"嘶！","art":{"background":"a3082","sprites":[]},"chapter":"5-4"},{"speaker":"丛雨","text":"「啊！」","art":{"background":"a3083","sprites":[]},"chapter":"5-4"},{"speaker":"","text":"我的精液将小雨的身体染成了白色。","art":{"background":"a3083","sprites":[]},"chapter":"5-4"},{"speaker":"","text":"精子源源不断地从顶端冒出来。","art":{"background":"a3083","sprites":[]},"chapter":"5-4"},{"speaker":"","text":"看着自己那玩意儿，我大大地呼了一口气。","art":{"background":"a3083","sprites":[]},"chapter":"5-4"},{"speaker":"","text":"第一次做爱比我想象中还要甜蜜，同时我也感到了强烈的疲劳。","art":{"background":"a3083","sprites":[]},"chapter":"5-4"}]