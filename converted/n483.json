[{"speaker":"将臣","text":"「蕨饼和芭菲做好了」","art":{"background":"a1","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「好的」","art":{"background":"a1","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「嗯，看上去很好吃的样子。哥哥厉害」","art":{"background":"a967","sprites":[{"asset":"a968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「那当然了，要是做得不好吃，可是会影响甜品屋信誉的」","art":{"background":"a967","sprites":[{"asset":"a968","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「不过看上去真的很好吃啊。我也好想吃芭菲～」","art":{"background":"a967","sprites":[{"asset":"a4336","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「关门后我会做给你吃的」","art":{"background":"a967","sprites":[{"asset":"a4336","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「真的吗！？哇，谢谢哥哥！」","art":{"background":"a967","sprites":[{"asset":"a989","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「别闲聊了，客人还等着呢」","art":{"background":"a967","sprites":[{"asset":"a989","position":"出","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「好的♪」","art":{"background":"a967","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"","text":"小春把菜品放到托盘上，喜眉笑目地端向餐桌。","art":{"background":"a967","sprites":[]},"chapter":"8-3"},{"speaker":"将臣","text":"「那么，我也要努力工作了」","art":{"background":"a967","sprites":[]},"chapter":"8-3"},{"speaker":"芦花","text":"「……盯……」","art":{"background":"a967","sprites":[{"asset":"a1566","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「怎……怎么了啊，芦花姐」","art":{"background":"a967","sprites":[{"asset":"a1566","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「哎呀，就是觉得你们二人关系真好」","art":{"background":"a967","sprites":[{"asset":"a994","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「是、是吗？我们一直不都关系很好吗？」","art":{"background":"a967","sprites":[{"asset":"a994","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「确实一直关系都很好……但是总觉得你们的气氛不一样了」","art":{"background":"a967","sprites":[{"asset":"a1576","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「有、有吗？」","art":{"background":"a967","sprites":[{"asset":"a1576","position":"出","x":-240,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「……阿将……你们做过了吧？」","art":{"background":"a967","sprites":[{"asset":"a1562","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「——！？！？」","art":{"background":"a967","sprites":[{"asset":"a1562","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「……」","art":{"background":"a967","sprites":[{"asset":"a1568","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a967","sprites":[{"asset":"a1568","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「做过了……是指做什么？」","art":{"background":"a967","sprites":[{"asset":"a1568","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「哎？我……可以说出来吗？」","art":{"background":"a967","sprites":[{"asset":"a1562","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「对不起，还是请饶过我吧」","art":{"background":"a967","sprites":[{"asset":"a1562","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「但、但是……你是怎么知道的？」","art":{"background":"a967","sprites":[{"asset":"a1562","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「都说了是看你们之间的气氛。我也不知道该怎么表达出来……你们的气氛似乎比以前更亲密了」","art":{"background":"a967","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「这……是一眼就能看出来的程度？」","art":{"background":"a967","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「嗯……也许是因为我一直关注着你们，并且知道你们的情况，才能看出来吧」","art":{"background":"a967","sprites":[{"asset":"a996","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「所以说也没那么明显」","art":{"background":"a967","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「是吗」","art":{"background":"a967","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"","text":"没办法，毕竟芦花姐是我们身边的人。","art":{"background":"a967","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"","text":"可是就算不明显，我还是要学着控制下自己的表情才行。","art":{"background":"a967","sprites":[{"asset":"a1567","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「不过你们关系进展顺利，也是件好事。就这样继续下去，获得幸福吧，阿将」","art":{"background":"a967","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「芦花姐……谢谢你」","art":{"background":"a967","sprites":[{"asset":"a994","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"芦花","text":"「嗯」","art":{"background":"a967","sprites":[{"asset":"a992","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"","text":"获得幸福吗……","art":{"background":"a1","sprites":[]},"chapter":"8-3"},{"speaker":"","text":"但是在那之前，还有一个不得不克服的障碍。","art":{"background":"a1","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「我开动啦」","art":{"background":"a119","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「（大口吃着）……啊……芭菲真好吃～……」","art":{"background":"a4337","sprites":[]},"chapter":"8-3"},{"speaker":"将臣","text":"「原来你不止喜欢仙贝啊」","art":{"background":"a4337","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「嗯？嗯，甜食我也很喜欢的」","art":{"background":"a4338","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「不过啊，之所以喜欢……肯定因为这是哥哥做的，嘿嘿」","art":{"background":"a4339","sprites":[]},"chapter":"8-3"},{"speaker":"将臣","text":"「……」","art":{"background":"a4339","sprites":[]},"chapter":"8-3"},{"speaker":"","text":"看到小春笑得如此灿烂……我真是幸福极了。","art":{"background":"a4339","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「嗯？怎么了？」","art":{"background":"a4340","sprites":[]},"chapter":"8-3"},{"speaker":"将臣","text":"「没事，我就是觉得你的笑容很可爱」","art":{"background":"a4340","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「哎，嘿嘿……不要啦，说得再好听也没好处的」","art":{"background":"a4341","sprites":[]},"chapter":"8-3"},{"speaker":"将臣","text":"「我也没想要什么好处」","art":{"background":"a4341","sprites":[]},"chapter":"8-3"},{"speaker":"","text":"为了守护她的笑容……我要做的事情是……","art":{"background":"a4341","sprites":[]},"chapter":"8-3"},{"speaker":"将臣","text":"「我说，小春」","art":{"background":"a1700","sprites":[]},"chapter":"8-3"},{"speaker":"小春","text":"「嗯？怎么了？」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「我想把我们的事情告诉外公」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「……哎？」","art":{"background":"a1700","sprites":[{"asset":"a981","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「我们不是表兄妹吗？所以……他可能不会同意我们在一起」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「嗯、嗯……」","art":{"background":"a1700","sprites":[{"asset":"a3650","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「但是我想永远和你在一起」","art":{"background":"a1700","sprites":[{"asset":"a3650","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「所以，我打算说服外公」","art":{"background":"a1700","sprites":[{"asset":"a3650","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「……我知道了，说得对」","art":{"background":"a1700","sprites":[{"asset":"a1702","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「嗯，我也要努力！」","art":{"background":"a1700","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「没事，这里就交给我这个男人来想办法吧」","art":{"background":"a1700","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「不能这么说，哥哥。这是我们两人的问题。既然要努力，那就两人一起努力吧」","art":{"background":"a1700","sprites":[{"asset":"a970","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「这样肯定能更有勇气」","art":{"background":"a1700","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「……说得也是。好的，我明白了，那就两人一起努力」","art":{"background":"a1700","sprites":[{"asset":"a989","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「嗯！」","art":{"background":"a1700","sprites":[{"asset":"a968","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-50.0,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「但是……如果外公生气了……可能会发生想都不敢去想的事情」","art":{"background":"a1700","sprites":[{"asset":"a986","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「是、是啊……要是他拿着木刀砍过来该怎么办？」","art":{"background":"a1700","sprites":[{"asset":"a3650","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「应该不至于这样对待自己的外孙和孙女吧……」","art":{"background":"a1700","sprites":[{"asset":"a3650","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「但是……你看过爷爷真正生气的样子吗？」","art":{"background":"a1700","sprites":[{"asset":"a984","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「这个……真没有」","art":{"background":"a1700","sprites":[{"asset":"a984","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"","text":"这么一想，确实有点害怕。","art":{"background":"a1700","sprites":[{"asset":"a984","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"","text":"外公平时都是那种样子，实在想象不出他在恋爱方面持什么态度。","art":{"background":"a1700","sprites":[{"asset":"a984","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"","text":"而廉太郎又是另当别论。","art":{"background":"a1700","sprites":[{"asset":"a984","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"将臣","text":"「总之，先找个他心情好的日子吧……？」","art":{"background":"a1700","sprites":[{"asset":"a984","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"小春","text":"「嗯、嗯。我觉得这是个好主意，哥哥」","art":{"background":"a1700","sprites":[{"asset":"a1005","position":"中","x":0,"y":0,"zx":100,"zy":100,"z":-33.33333333333333,"opacity":255}]},"chapter":"8-3"},{"speaker":"","text":"总而言之，这是必须克服的障碍。","art":{"background":"a119","sprites":[]},"chapter":"8-3"},{"speaker":"","text":"而且是必须要靠自己的力量克服的障碍。","art":{"background":"a119","sprites":[]},"chapter":"8-3"},{"speaker":"","text":"只要克服外公这个障碍，那么今后无论遇到什么障碍都会是小菜一碟了。","art":{"background":"a119","sprites":[]},"chapter":"8-3"},{"speaker":"","text":"所以我才想首先克服这个最大的障碍！！","art":{"background":"a119","sprites":[]},"chapter":"8-3"}]